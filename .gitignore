.DS_Store
DerivedData/
.build/
*.xcuserstate
xcuserdata/
LocalDictation.xcodeproj/project.xcworkspace/xcuserdata/

# Local signing and release artifacts
*.dmg
*.pkg
*.ipa
*.provisionprofile
*.p12

# Credentials that belong to whoever is signing and releasing, never to the
# repository. The App Store Connect API key notarization needs is a .p8, and
# Apple lets it be downloaded exactly once — so it lives beside the project
# rather than in Downloads, and it is ignored by name as well as by directory.
# The same rules are duplicated in .git/info/exclude, which is shared by every
# worktree and applies on every branch, including ones that predate this file.
/Secrets/
*.p8
AuthKey_*

# Local model weights, evaluation corpora, and audio artifacts.
# Anchored to the repository root so LocalDictation/Models/ (source) is still tracked.
/Models/
/Recordings/
/Benchmark/
*.wav
*.m4a


# The marketing site is a separate repository: igskak/localdictation-website
/website/

# Marketing and commercial strategy notes stay local: competitor spend, CPL
# gates, unit economics, pricing, who the customer is, and where to sell next.
/docs/LANDING.md
/docs/LANDING_IMPLEMENTATION.md
/docs/GTM.md
/docs/MONETIZATION.md
/docs/MODEL_V2.md
/docs/ICP_B2B.md
/docs/EU_EXPANSION.md

# Release artefacts from docs/PHASE_6_RELEASE.md — archives, exports, and the
# signed disk image are build output and are never committed.
build/

# Wrangler's local state for the activation service, and the throwaway signing
# identity local development runs against. Neither is a secret worth keeping,
# and both are exactly the shape of file that must never be committed anyway.
Service/.wrangler/
Service/node_modules/
Service/.dev.vars

# A parity fixture taken from a running deployment. It is about one service at
# one moment, and against production it holds real signed keys — the committed
# fixture beside it is the one that belongs in the repository.
Service/fixtures/live.json
