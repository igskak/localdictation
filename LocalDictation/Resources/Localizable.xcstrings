    "Activate the trial": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Testphase aktivieren"
          }
        }
      }
    },
    "Send me a key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel anfordern"
          }
        }
      }
    },
    "Already bought a license?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits eine Lizenz gekauft?"
          }
        }
      }
    },
    "Send my key": {
      "localizations": {
        "de": {
          "stringUnit": {
