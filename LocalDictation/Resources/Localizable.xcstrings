    "Storage": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Speicherort"}},"es":{"stringUnit":{"state":"translated","value":"Almacenamiento"}},"it":{"stringUnit":{"state":"translated","value":"Archiviazione"}},"fr":{"stringUnit":{"state":"translated","value":"Stockage"}}}},
    "Cancel": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Abbrechen"}},"es":{"stringUnit":{"state":"translated","value":"Cancelar"}},"it":{"stringUnit":{"state":"translated","value":"Annulla"}},"fr":{"stringUnit":{"state":"translated","value":"Annuler"}}}},
    "Change…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ändern …"}},"es":{"stringUnit":{"state":"translated","value":"Cambiar…"}},"it":{"stringUnit":{"state":"translated","value":"Modifica…"}},"fr":{"stringUnit":{"state":"translated","value":"Modifier…"}}}},
    "Reset": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zurücksetzen"}},"es":{"stringUnit":{"state":"translated","value":"Restablecer"}},"it":{"stringUnit":{"state":"translated","value":"Ripristina"}},"fr":{"stringUnit":{"state":"translated","value":"Réinitialiser"}}}},
    "Open Login Items": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Anmeldeobjekte öffnen"}},"es":{"stringUnit":{"state":"translated","value":"Abrir ítems de inicio"}},"it":{"stringUnit":{"state":"translated","value":"Apri Elementi login"}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrir les éléments d’ouverture"}}}},
    "Settings": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einstellungen"}},"es":{"stringUnit":{"state":"translated","value":"Ajustes"}},"it":{"stringUnit":{"state":"translated","value":"Impostazioni"}},"fr":{"stringUnit":{"state":"translated","value":"Réglages"}}}},
    "Quit": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Beenden"}},"es":{"stringUnit":{"state":"translated","value":"Salir"}},"it":{"stringUnit":{"state":"translated","value":"Esci"}},"fr":{"stringUnit":{"state":"translated","value":"Quitter"}}}},
    "Allow microphone access…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofonzugriff erlauben …"}},"es":{"stringUnit":{"state":"translated","value":"Permitir acceso al micrófono…"}},"it":{"stringUnit":{"state":"translated","value":"Consenti l’accesso al microfono…"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser l’accès au microphone…"}}}},
    "Input level": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Eingangspegel"}},"es":{"stringUnit":{"state":"translated","value":"Nivel de entrada"}},"it":{"stringUnit":{"state":"translated","value":"Livello di ingresso"}},"fr":{"stringUnit":{"state":"translated","value":"Niveau d’entrée"}}}},
    "Language": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprache"}},"es":{"stringUnit":{"state":"translated","value":"Idioma"}},"it":{"stringUnit":{"state":"translated","value":"Lingua"}},"fr":{"stringUnit":{"state":"translated","value":"Langue"}}}},
    "Get the speech model": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprachmodell laden"}},"es":{"stringUnit":{"state":"translated","value":"Obtener el modelo de voz"}},"it":{"stringUnit":{"state":"translated","value":"Scarica il modello vocale"}},"fr":{"stringUnit":{"state":"translated","value":"Obtenir le modèle vocal"}}}},
    "Dictation is blocked right now": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diktieren ist derzeit blockiert"}},"es":{"stringUnit":{"state":"translated","value":"El dictado está bloqueado ahora"}},"it":{"stringUnit":{"state":"translated","value":"La dettatura è bloccata"}},"fr":{"stringUnit":{"state":"translated","value":"La dictée est actuellement bloquée"}}}},
    "Type text for you": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Text für dich eingeben"}},"es":{"stringUnit":{"state":"translated","value":"Escribir texto por ti"}},"it":{"stringUnit":{"state":"translated","value":"Scrivi il testo per te"}},"fr":{"stringUnit":{"state":"translated","value":"Saisir le texte pour vous"}}}},
    "Check": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Prüfen"}},"es":{"stringUnit":{"state":"translated","value":"Comprobar"}},"it":{"stringUnit":{"state":"translated","value":"Controlla"}},"fr":{"stringUnit":{"state":"translated","value":"Vérifier"}}}},
    "Hold %@ and speak": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Halte %@ gedrückt und sprich"}},"es":{"stringUnit":{"state":"translated","value":"Mantén pulsado %@ y habla"}},"it":{"stringUnit":{"state":"translated","value":"Tieni premuto %@ e parla"}},"fr":{"stringUnit":{"state":"translated","value":"Maintenez %@ enfoncé et parlez"}}}},
    "Let go and the text arrives where your cursor is. That is the whole of it — there is no window to switch to and nothing to click.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Lass los, und der Text erscheint an der Cursorposition. Mehr ist nicht nötig: kein Fensterwechsel und kein Klick."}},"es":{"stringUnit":{"state":"translated","value":"Suelta la tecla y el texto aparecerá donde esté el cursor. Eso es todo: no tienes que cambiar de ventana ni hacer clic en nada."}},"it":{"stringUnit":{"state":"translated","value":"Rilascia il tasto e il testo apparirà nel punto in cui si trova il cursore. Tutto qui: non devi cambiare finestra né fare clic su nulla."}},"fr":{"stringUnit":{"state":"translated","value":"Relâchez la touche et le texte apparaît à l’emplacement du curseur. C’est tout : aucune fenêtre à ouvrir, aucun bouton à cliquer."}}}},
    "Nothing you dictate ever leaves this Mac. Nine events about setting it up and about the trial do — the install, the speech model arriving or failing to, a press that finds it still arriving, a refused microphone, the trial starting, the email ask, and the offers — with no more than an app version, a macOS version, and a random number made at install. Settings → Privacy turns them off.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nichts von dem, was du diktierst, verlässt diesen Mac. Gesendet werden neun Ereignisse zur Einrichtung und zur Testphase: die Installation, das Eintreffen des Sprachmodells oder dessen Scheitern, ein Tastendruck, der noch darauf trifft, ein abgelehntes Mikrofon, der Start der Testphase, die Abfrage der E-Mail-Adresse und das Anzeigen der Angebote – jeweils nur mit App-Version, macOS-Version und einer bei der Installation erzeugten Zufallsnummer. Unter Einstellungen → Datenschutz kannst du dies deaktivieren."}},"es":{"stringUnit":{"state":"translated","value":"Nada de lo que dictas sale de este Mac. La app sí envía nueve eventos sobre la configuración y el periodo de prueba: la instalación; el inicio, la finalización o el fallo de la descarga del modelo; un intento de dictado durante la descarga; la denegación del micrófono; el inicio de la prueba; la solicitud del correo electrónico y la visualización de las ofertas. Cada evento incluye como máximo la versión de la app, la versión de macOS y un identificador aleatorio creado al instalar. Puedes desactivarlos en Ajustes → Privacidad."}},"it":{"stringUnit":{"state":"translated","value":"Nulla di ciò che detti lascia il Mac. L’app invia però nove eventi sulla configurazione e sul periodo di prova: installazione; avvio, completamento o errore del download del modello; tentativo di dettatura durante il download; rifiuto del microfono; inizio della prova; richiesta dell’indirizzo email e visualizzazione delle offerte. Ogni evento include al massimo la versione dell’app, la versione di macOS e un identificatore casuale creato all’installazione. Puoi disattivarli in Impostazioni → Privacy."}},"fr":{"stringUnit":{"state":"translated","value":"Rien de ce que vous dictez ne quitte ce Mac. L’app envoie toutefois neuf événements concernant la configuration et l’essai : installation ; début, fin ou échec du téléchargement du modèle ; tentative de dictée pendant le téléchargement ; refus du microphone ; début de l’essai ; demande de l’adresse e-mail et affichage des offres. Chaque événement contient au maximum la version de l’app, la version de macOS et un identifiant aléatoire créé lors de l’installation. Vous pouvez les désactiver dans Réglages → Confidentialité."}}}},
    "The speech model is ready": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprachmodell ist bereit"}},"es":{"stringUnit":{"state":"translated","value":"El modelo de voz está listo"}},"it":{"stringUnit":{"state":"translated","value":"Il modello vocale è pronto"}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle vocal est prêt"}}}},
    "The speech model did not arrive": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprachmodell konnte nicht geladen werden"}},"es":{"stringUnit":{"state":"translated","value":"El modelo de voz no se ha descargado"}},"it":{"stringUnit":{"state":"translated","value":"Il modello vocale non è arrivato"}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle vocal n’est pas arrivé"}}}},
    "The speech model is downloading": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprachmodell wird geladen"}},"es":{"stringUnit":{"state":"translated","value":"El modelo de voz se está descargando"}},"it":{"stringUnit":{"state":"translated","value":"Download del modello vocale in corso"}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle vocal est en cours de téléchargement"}}}},
    "Recognition runs on this Mac, with no network and no account.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Erkennung läuft auf diesem Mac – ohne Netzwerk und ohne Konto."}},"es":{"stringUnit":{"state":"translated","value":"El reconocimiento se ejecuta en este Mac, sin red ni cuenta."}},"it":{"stringUnit":{"state":"translated","value":"Il riconoscimento viene eseguito su questo Mac, senza rete né account."}},"fr":{"stringUnit":{"state":"translated","value":"La reconnaissance s’exécute sur ce Mac, sans réseau ni compte."}}}},
    "%@ It is about %@ and needs a connection once; everything after that is offline.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ Es ist etwa %@ groß und benötigt einmalig eine Verbindung; danach funktioniert alles offline."}},"es":{"stringUnit":{"state":"translated","value":"%@ Ocupa unos %@ y necesita conexión una sola vez; después todo funciona sin conexión."}},"it":{"stringUnit":{"state":"translated","value":"%@ Occupa circa %@ e richiede una sola connessione; in seguito tutto funziona offline."}},"fr":{"stringUnit":{"state":"translated","value":"%@ Il occupe environ %@ et nécessite une seule connexion ; tout fonctionne ensuite hors ligne."}}}},
    "About %@, fetched once. It started on its own when the app launched — you can close this window and it keeps going. Afterwards recognition runs on this Mac with no network at all.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Etwa %@, einmalig geladen. Der Download begann beim App-Start automatisch und läuft weiter, wenn du dieses Fenster schließt. Danach erfolgt die Erkennung vollständig offline auf diesem Mac."}},"es":{"stringUnit":{"state":"translated","value":"Aproximadamente %@, que solo se descarga una vez. La descarga comenzó automáticamente al abrir la app; puedes cerrar esta ventana y continuará en segundo plano. Después, el reconocimiento funcionará en este Mac sin conexión."}},"it":{"stringUnit":{"state":"translated","value":"Circa %@, scaricati una sola volta. Il download è iniziato automaticamente all’avvio dell’app: puoi chiudere questa finestra e continuerà in background. In seguito il riconoscimento funzionerà su questo Mac senza alcuna connessione."}},"fr":{"stringUnit":{"state":"translated","value":"Environ %@, téléchargés une seule fois. Le téléchargement a commencé automatiquement au lancement de l’app : vous pouvez fermer cette fenêtre, il se poursuivra en arrière-plan. La reconnaissance fonctionnera ensuite sur ce Mac, sans aucune connexion."}}}},
    "No language here is called “%@”.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Keine Sprache heißt hier „%@“."}},"es":{"stringUnit":{"state":"translated","value":"No hay ningún idioma llamado «%@»."}},"it":{"stringUnit":{"state":"translated","value":"Nessuna lingua si chiama «%@»."}},"fr":{"stringUnit":{"state":"translated","value":"Aucune langue ne s’appelle « %@ »."}}}},
    "Lifetime": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dauerlizenz"}},"es":{"stringUnit":{"state":"translated","value":"De por vida"}},"it":{"stringUnit":{"state":"translated","value":"A vita"}},"fr":{"stringUnit":{"state":"translated","value":"À vie"}}}},
    "Annual": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Jahreslizenz"}},"es":{"stringUnit":{"state":"translated","value":"Anual"}},"it":{"stringUnit":{"state":"translated","value":"Annuale"}},"fr":{"stringUnit":{"state":"translated","value":"Annuel"}}}},
    "Trial": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Testphase"}},"es":{"stringUnit":{"state":"translated","value":"Periodo de prueba"}},"it":{"stringUnit":{"state":"translated","value":"Periodo di prova"}},"fr":{"stringUnit":{"state":"translated","value":"Période d’essai"}}}},
    "Lifetime license": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dauerlizenz"}},"es":{"stringUnit":{"state":"translated","value":"Licencia de por vida"}},"it":{"stringUnit":{"state":"translated","value":"Licenza a vita"}},"fr":{"stringUnit":{"state":"translated","value":"Licence à vie"}}}},
    "Ready": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bereit"}},"es":{"stringUnit":{"state":"translated","value":"Listo"}},"it":{"stringUnit":{"state":"translated","value":"Pronto"}},"fr":{"stringUnit":{"state":"translated","value":"Prêt"}}}},
    "Ready to dictate": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bereit zum Diktieren"}},"es":{"stringUnit":{"state":"translated","value":"Listo para dictar"}},"it":{"stringUnit":{"state":"translated","value":"Pronto per dettare"}},"fr":{"stringUnit":{"state":"translated","value":"Prêt à dicter"}}}},
    "Waiting for speech": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Warte auf Sprache"}},"es":{"stringUnit":{"state":"translated","value":"Esperando voz"}},"it":{"stringUnit":{"state":"translated","value":"In attesa della voce"}},"fr":{"stringUnit":{"state":"translated","value":"En attente de parole"}}}},
    "Speech": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprache"}},"es":{"stringUnit":{"state":"translated","value":"Voz"}},"it":{"stringUnit":{"state":"translated","value":"Voce"}},"fr":{"stringUnit":{"state":"translated","value":"Parole"}}}},
    "Ended (silence)": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Beendet (Stille)"}},"es":{"stringUnit":{"state":"translated","value":"Finalizado (silencio)"}},"it":{"stringUnit":{"state":"translated","value":"Terminato (silenzio)"}},"fr":{"stringUnit":{"state":"translated","value":"Terminé (silence)"}}}},
    "Ended (maximum duration)": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Beendet (Maximaldauer)"}},"es":{"stringUnit":{"state":"translated","value":"Finalizado (duración máxima)"}},"it":{"stringUnit":{"state":"translated","value":"Terminato (durata massima)"}},"fr":{"stringUnit":{"state":"translated","value":"Terminé (durée maximale)"}}}},
    "Downloading the speech model…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprachmodell wird geladen …"}},"es":{"stringUnit":{"state":"translated","value":"Descargando el modelo de voz…"}},"it":{"stringUnit":{"state":"translated","value":"Download del modello vocale…"}},"fr":{"stringUnit":{"state":"translated","value":"Téléchargement du modèle vocal…"}}}},
    "Downloading the speech model… %lld%%": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprachmodell wird geladen … %lld %%"}},"es":{"stringUnit":{"state":"translated","value":"Descargando el modelo de voz… %lld%%"}},"it":{"stringUnit":{"state":"translated","value":"Download del modello vocale… %lld%%"}},"fr":{"stringUnit":{"state":"translated","value":"Téléchargement du modèle vocal… %lld%%"}}}},
    "Loading the speech model…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprachmodell wird geladen …"}},"es":{"stringUnit":{"state":"translated","value":"Cargando el modelo de voz…"}},"it":{"stringUnit":{"state":"translated","value":"Caricamento del modello vocale…"}},"fr":{"stringUnit":{"state":"translated","value":"Chargement du modèle vocal…"}}}},
    "Preparing the speech model for this Mac. The first time on a new macOS version takes several minutes; after that it is seconds.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprachmodell wird für diesen Mac vorbereitet. Nach einer neuen macOS-Version dauert dies beim ersten Mal einige Minuten, danach nur Sekunden."}},"es":{"stringUnit":{"state":"translated","value":"Preparando el modelo de voz para este Mac. La primera vez con una nueva versión de macOS tarda varios minutos; después solo unos segundos."}},"it":{"stringUnit":{"state":"translated","value":"Preparazione del modello vocale per questo Mac. La prima volta con una nuova versione di macOS richiede diversi minuti; in seguito bastano pochi secondi."}},"fr":{"stringUnit":{"state":"translated","value":"Préparation du modèle vocal pour ce Mac. La première fois avec une nouvelle version de macOS prend plusieurs minutes ; ensuite, quelques secondes suffisent."}}}},
    "Speech model unavailable: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprachmodell nicht verfügbar: %@"}},"es":{"stringUnit":{"state":"translated","value":"El modelo de voz no está disponible: %@"}},"it":{"stringUnit":{"state":"translated","value":"Il modello vocale non è disponibile: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle vocal n’est pas disponible : %@"}}}},
    "%@ is not supported by the current speech engine": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ wird von der aktuellen Spracherkennung nicht unterstützt"}},"es":{"stringUnit":{"state":"translated","value":"El motor de voz actual no admite %@"}},"it":{"stringUnit":{"state":"translated","value":"Il motore vocale attuale non supporta %@"}},"fr":{"stringUnit":{"state":"translated","value":"Le moteur vocal actuel ne prend pas en charge %@"}}}},
    "Nothing was recorded": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Es wurde nichts aufgenommen"}},"es":{"stringUnit":{"state":"translated","value":"No se ha grabado nada"}},"it":{"stringUnit":{"state":"translated","value":"Non è stato registrato nulla"}},"fr":{"stringUnit":{"state":"translated","value":"Aucun son n’a été enregistré"}}}},
    "Transcription was cancelled": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Transkription wurde abgebrochen"}},"es":{"stringUnit":{"state":"translated","value":"La transcripción se ha cancelado"}},"it":{"stringUnit":{"state":"translated","value":"La trascrizione è stata annullata"}},"fr":{"stringUnit":{"state":"translated","value":"La transcription a été annulée"}}}},
    "Transcription failed: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Transkription fehlgeschlagen: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido transcribir: %@"}},"it":{"stringUnit":{"state":"translated","value":"Trascrizione non riuscita: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Échec de la transcription : %@"}}}},
    "No microphone input device is available": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kein Mikrofon-Eingabegerät verfügbar"}},"es":{"stringUnit":{"state":"translated","value":"No hay ningún micrófono disponible"}},"it":{"stringUnit":{"state":"translated","value":"Non è disponibile alcun microfono"}},"fr":{"stringUnit":{"state":"translated","value":"Aucun microphone n’est disponible"}}}},
    "Unsupported input format (%@)": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nicht unterstütztes Eingabeformat (%@)"}},"es":{"stringUnit":{"state":"translated","value":"El formato de entrada no es compatible (%@)"}},"it":{"stringUnit":{"state":"translated","value":"Il formato di ingresso non è supportato (%@)"}},"fr":{"stringUnit":{"state":"translated","value":"Le format d’entrée n’est pas pris en charge (%@)"}}}},
    "Audio converter unavailable (%@)": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audiokonverter nicht verfügbar (%@)"}},"es":{"stringUnit":{"state":"translated","value":"El conversor de audio no está disponible (%@)"}},"it":{"stringUnit":{"state":"translated","value":"Il convertitore audio non è disponibile (%@)"}},"fr":{"stringUnit":{"state":"translated","value":"Le convertisseur audio n’est pas disponible (%@)"}}}},
    "Audio conversion failed (%@)": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audiokonvertierung fehlgeschlagen (%@)"}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido convertir el audio (%@)"}},"it":{"stringUnit":{"state":"translated","value":"Conversione audio non riuscita (%@)"}},"fr":{"stringUnit":{"state":"translated","value":"Échec de la conversion audio (%@)"}}}},
    "Audio engine failed to start (%@)": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audio-Engine konnte nicht gestartet werden (%@)"}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido iniciar el sistema de audio (%@)"}},"it":{"stringUnit":{"state":"translated","value":"Il sistema audio non è riuscito ad avviarsi (%@)"}},"fr":{"stringUnit":{"state":"translated","value":"Le système audio n’a pas pu démarrer (%@)"}}}},
    "The input device changed during recording": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Eingabegerät wurde während der Aufnahme gewechselt"}},"es":{"stringUnit":{"state":"translated","value":"El micrófono ha cambiado durante la grabación"}},"it":{"stringUnit":{"state":"translated","value":"Il microfono è cambiato durante la registrazione"}},"fr":{"stringUnit":{"state":"translated","value":"Le microphone a changé pendant l’enregistrement"}}}},
    "No recording is in progress": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Es läuft keine Aufnahme"}},"es":{"stringUnit":{"state":"translated","value":"No hay ninguna grabación en curso"}},"it":{"stringUnit":{"state":"translated","value":"Non è in corso alcuna registrazione"}},"fr":{"stringUnit":{"state":"translated","value":"Aucun enregistrement n’est en cours"}}}},
    "The microphone changed while you were speaking, so the recording ended there. Whatever you had already said was kept.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Mikrofon wurde während des Sprechens gewechselt. Die Aufnahme wurde beendet; das bereits Gesagte blieb erhalten."}},"es":{"stringUnit":{"state":"translated","value":"El micrófono cambió mientras hablabas, por lo que la grabación terminó en ese momento. Se ha conservado todo lo que habías dicho hasta entonces."}},"it":{"stringUnit":{"state":"translated","value":"Il microfono è cambiato mentre parlavi, quindi la registrazione si è interrotta in quel momento. Tutto ciò che avevi già detto è stato conservato."}},"fr":{"stringUnit":{"state":"translated","value":"Le microphone a changé pendant que vous parliez. L’enregistrement s’est donc arrêté à ce moment-là, mais tout ce que vous aviez déjà dit a été conservé."}}}},
    "The microphone went away while you were speaking, so the recording ended there. Whatever you had already said was kept.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Mikrofon war während des Sprechens nicht mehr verfügbar. Die Aufnahme wurde beendet; das bereits Gesagte blieb erhalten."}},"es":{"stringUnit":{"state":"translated","value":"El micrófono dejó de estar disponible mientras hablabas, por lo que la grabación terminó en ese momento. Se ha conservado todo lo que habías dicho hasta entonces."}},"it":{"stringUnit":{"state":"translated","value":"Il microfono non era più disponibile mentre parlavi, quindi la registrazione si è interrotta in quel momento. Tutto ciò che avevi già detto è stato conservato."}},"fr":{"stringUnit":{"state":"translated","value":"Le microphone n’était plus disponible pendant que vous parliez. L’enregistrement s’est donc arrêté à ce moment-là, mais tout ce que vous aviez déjà dit a été conservé."}}}},
    "The recording ended early: %@. Whatever you had already said was kept.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Aufnahme wurde vorzeitig beendet: %@. Das bereits Gesagte blieb erhalten."}},"es":{"stringUnit":{"state":"translated","value":"La grabación ha terminado antes de tiempo: %@. Se ha conservado todo lo que habías dicho hasta entonces."}},"it":{"stringUnit":{"state":"translated","value":"La registrazione è terminata in anticipo: %@. Tutto ciò che avevi già detto è stato conservato."}},"fr":{"stringUnit":{"state":"translated","value":"L’enregistrement s’est arrêté plus tôt que prévu : %@. Tout ce que vous aviez déjà dit a été conservé."}}}},
    "Hotkey unavailable: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Tastenkürzel nicht verfügbar: %@"}},"es":{"stringUnit":{"state":"translated","value":"El atajo de teclado no está disponible: %@"}},"it":{"stringUnit":{"state":"translated","value":"La scorciatoia da tastiera non è disponibile: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Le raccourci clavier n’est pas disponible : %@"}}}},
    "Recording could not start: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aufnahme konnte nicht gestartet werden: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido iniciar la grabación: %@"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile avviare la registrazione: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de démarrer l’enregistrement : %@"}}}},
    "Recording stopped: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aufnahme beendet: %@"}},"es":{"stringUnit":{"state":"translated","value":"La grabación se ha detenido: %@"}},"it":{"stringUnit":{"state":"translated","value":"La registrazione si è interrotta: %@"}},"fr":{"stringUnit":{"state":"translated","value":"L’enregistrement s’est arrêté : %@"}}}},
    "Nothing was heard": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nichts gehört"}},"es":{"stringUnit":{"state":"translated","value":"No se ha oído nada"}},"it":{"stringUnit":{"state":"translated","value":"Non è stato rilevato alcun suono"}},"fr":{"stringUnit":{"state":"translated","value":"Aucun son détecté"}}}},
    "Nothing was recognized": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nichts erkannt"}},"es":{"stringUnit":{"state":"translated","value":"No se ha reconocido nada"}},"it":{"stringUnit":{"state":"translated","value":"Non è stato riconosciuto nulla"}},"fr":{"stringUnit":{"state":"translated","value":"Rien n’a été reconnu"}}}},
    "the current input device": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"das aktuelle Eingabegerät"}},"es":{"stringUnit":{"state":"translated","value":"el dispositivo de entrada actual"}},"it":{"stringUnit":{"state":"translated","value":"il dispositivo di ingresso attuale"}},"fr":{"stringUnit":{"state":"translated","value":"le périphérique d’entrée actuel"}}}},
    "That fragment has no audio to play": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Für dieses Fragment ist kein Audio zum Abspielen vorhanden"}},"es":{"stringUnit":{"state":"translated","value":"Este fragmento no tiene audio para reproducir"}},"it":{"stringUnit":{"state":"translated","value":"Questo frammento non contiene audio da riprodurre"}},"fr":{"stringUnit":{"state":"translated","value":"Ce passage ne contient aucun son à écouter"}}}},
    "Playback failed: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wiedergabe fehlgeschlagen: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido reproducir el audio: %@"}},"it":{"stringUnit":{"state":"translated","value":"Riproduzione non riuscita: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Échec de la lecture : %@"}}}},
    "Number": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zahl"}},"es":{"stringUnit":{"state":"translated","value":"Número"}},"it":{"stringUnit":{"state":"translated","value":"Numero"}},"fr":{"stringUnit":{"state":"translated","value":"Nombre"}}}},
    "Amount": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Betrag"}},"es":{"stringUnit":{"state":"translated","value":"Importe"}},"it":{"stringUnit":{"state":"translated","value":"Importo"}},"fr":{"stringUnit":{"state":"translated","value":"Montant"}}}},
    "Date": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Datum"}},"es":{"stringUnit":{"state":"translated","value":"Fecha"}},"it":{"stringUnit":{"state":"translated","value":"Data"}},"fr":{"stringUnit":{"state":"translated","value":"Date"}}}},
    "Name": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Name"}},"es":{"stringUnit":{"state":"translated","value":"Nombre"}},"it":{"stringUnit":{"state":"translated","value":"Nome"}},"fr":{"stringUnit":{"state":"translated","value":"Nom"}}}},
    "Close to “%@”": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ähnlich wie „%@“"}},"es":{"stringUnit":{"state":"translated","value":"Similar a «%@»"}},"it":{"stringUnit":{"state":"translated","value":"Simile a «%@»"}},"fr":{"stringUnit":{"state":"translated","value":"Proche de « %@ »"}}}},
    "Not a word": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kein Wort"}},"es":{"stringUnit":{"state":"translated","value":"No es una palabra"}},"it":{"stringUnit":{"state":"translated","value":"Non è una parola"}},"fr":{"stringUnit":{"state":"translated","value":"Ce n’est pas un mot"}}}},
    "%@ word": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wort auf %@"}},"es":{"stringUnit":{"state":"translated","value":"Palabra en %@"}},"it":{"stringUnit":{"state":"translated","value":"Parola in %@"}},"fr":{"stringUnit":{"state":"translated","value":"Mot en %@"}}}},
    "Uncertain": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Unsicher"}},"es":{"stringUnit":{"state":"translated","value":"Incierto"}},"it":{"stringUnit":{"state":"translated","value":"Incerto"}},"fr":{"stringUnit":{"state":"translated","value":"Incertain"}}}},
    "Spacing": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Abstände"}},"es":{"stringUnit":{"state":"translated","value":"Espaciado"}},"it":{"stringUnit":{"state":"translated","value":"Spaziatura"}},"fr":{"stringUnit":{"state":"translated","value":"Espacement"}}}},
    "Punctuation": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zeichensetzung"}},"es":{"stringUnit":{"state":"translated","value":"Puntuación"}},"it":{"stringUnit":{"state":"translated","value":"Punteggiatura"}},"fr":{"stringUnit":{"state":"translated","value":"Ponctuation"}}}},
    "Capitalization": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Großschreibung"}},"es":{"stringUnit":{"state":"translated","value":"Mayúsculas"}},"it":{"stringUnit":{"state":"translated","value":"Maiuscole"}},"fr":{"stringUnit":{"state":"translated","value":"Majuscules"}}}},
    "Filler removed": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Füllwort entfernt"}},"es":{"stringUnit":{"state":"translated","value":"Muletilla eliminada"}},"it":{"stringUnit":{"state":"translated","value":"Intercalare rimosso"}},"fr":{"stringUnit":{"state":"translated","value":"Hésitation supprimée"}}}},
    "Hold to talk": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gedrückt halten zum Sprechen"}},"es":{"stringUnit":{"state":"translated","value":"Mantener pulsado para hablar"}},"it":{"stringUnit":{"state":"translated","value":"Tieni premuto per parlare"}},"fr":{"stringUnit":{"state":"translated","value":"Maintenir pour parler"}}}},
    "Press to start and stop": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zum Starten und Stoppen drücken"}},"es":{"stringUnit":{"state":"translated","value":"Pulsar para iniciar y detener"}},"it":{"stringUnit":{"state":"translated","value":"Premi per avviare e fermare"}},"fr":{"stringUnit":{"state":"translated","value":"Appuyer pour démarrer et arrêter"}}}},
    "The microphone is open only while the key is down. Best for a sentence at a time.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Mikrofon ist nur geöffnet, solange die Taste gedrückt bleibt. Ideal für einzelne Sätze."}},"es":{"stringUnit":{"state":"translated","value":"El micrófono solo está abierto mientras mantienes pulsada la tecla. Ideal para dictar una frase cada vez."}},"it":{"stringUnit":{"state":"translated","value":"Il microfono resta aperto solo mentre tieni premuto il tasto. Ideale per una frase alla volta."}},"fr":{"stringUnit":{"state":"translated","value":"Le microphone est ouvert uniquement tant que vous maintenez la touche. Idéal pour dicter une phrase à la fois."}}}},
    "One press starts, the next finishes. Best for anything longer than a key is comfortable to hold.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ein Tastendruck startet, der nächste beendet die Aufnahme. Ideal für längere Texte."}},"es":{"stringUnit":{"state":"translated","value":"Una pulsación inicia y la siguiente termina. Es la mejor opción cuando el dictado dura más de lo que resulta cómodo mantener una tecla pulsada."}},"it":{"stringUnit":{"state":"translated","value":"Una pressione avvia e la successiva termina. Ideale quando la dettatura dura più di quanto sia comodo tenere premuto un tasto."}},"fr":{"stringUnit":{"state":"translated","value":"Une pression démarre et la suivante termine. Idéal lorsque la dictée dure plus longtemps qu’il n’est confortable de maintenir une touche."}}}},
    "Space": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Leertaste"}},"es":{"stringUnit":{"state":"translated","value":"Espacio"}},"it":{"stringUnit":{"state":"translated","value":"Spazio"}},"fr":{"stringUnit":{"state":"translated","value":"Espace"}}}},
    "Return": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zeilenschalter"}},"es":{"stringUnit":{"state":"translated","value":"Retorno"}},"it":{"stringUnit":{"state":"translated","value":"Invio"}},"fr":{"stringUnit":{"state":"translated","value":"Retour"}}}},
    "Enter": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Eingabe"}},"es":{"stringUnit":{"state":"translated","value":"Intro"}},"it":{"stringUnit":{"state":"translated","value":"Invio"}},"fr":{"stringUnit":{"state":"translated","value":"Entrée"}}}},
    "Tab": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Tabulator"}},"es":{"stringUnit":{"state":"translated","value":"Tabulador"}},"it":{"stringUnit":{"state":"translated","value":"Tabulazione"}},"fr":{"stringUnit":{"state":"translated","value":"Tabulation"}}}},
    "Escape": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Escape"}},"es":{"stringUnit":{"state":"translated","value":"Escape"}},"it":{"stringUnit":{"state":"translated","value":"Esc"}},"fr":{"stringUnit":{"state":"translated","value":"Échap"}}}},
