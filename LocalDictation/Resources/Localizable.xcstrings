    "Worth a look": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Prüfung empfohlen"}},"es":{"stringUnit":{"state":"translated","value":"Conviene revisarlo"}},"it":{"stringUnit":{"state":"translated","value":"Da controllare"}},"fr":{"stringUnit":{"state":"translated","value":"À vérifier"}}}},
    "Recording ended early": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aufnahme vorzeitig beendet"}},"es":{"stringUnit":{"state":"translated","value":"La grabación terminó antes de tiempo"}},"it":{"stringUnit":{"state":"translated","value":"La registrazione è terminata in anticipo"}},"fr":{"stringUnit":{"state":"translated","value":"L’enregistrement s’est terminé prématurément"}}}},
    "Starting up": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wird gestartet"}},"es":{"stringUnit":{"state":"translated","value":"Iniciando"}},"it":{"stringUnit":{"state":"translated","value":"Avvio"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrage"}}}},
    "Checking microphone access.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofonzugriff wird geprüft."}},"es":{"stringUnit":{"state":"translated","value":"Comprobando el acceso al micrófono."}},"it":{"stringUnit":{"state":"translated","value":"Verifica dell’accesso al microfono."}},"fr":{"stringUnit":{"state":"translated","value":"Vérification de l’accès au microphone."}}}},
    "Microphone access required": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofonzugriff erforderlich"}},"es":{"stringUnit":{"state":"translated","value":"Se necesita acceso al micrófono"}},"it":{"stringUnit":{"state":"translated","value":"Accesso al microfono richiesto"}},"fr":{"stringUnit":{"state":"translated","value":"Accès au microphone requis"}}}},
    "Grant access to enable push-to-talk dictation.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erlaube den Zugriff, um per Tastendruck zu diktieren."}},"es":{"stringUnit":{"state":"translated","value":"Concede acceso para activar el dictado mediante pulsación."}},"it":{"stringUnit":{"state":"translated","value":"Concedi l’accesso per attivare la dettatura push-to-talk."}},"fr":{"stringUnit":{"state":"translated","value":"Accordez l’accès pour activer la dictée par maintien de la touche."}}}},
    "Waiting for your answer": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Warte auf deine Antwort"}},"es":{"stringUnit":{"state":"translated","value":"Esperando tu respuesta"}},"it":{"stringUnit":{"state":"translated","value":"In attesa della tua risposta"}},"fr":{"stringUnit":{"state":"translated","value":"En attente de votre réponse"}}}},
    "Approve the macOS microphone prompt.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bestätige die Mikrofonabfrage von macOS."}},"es":{"stringUnit":{"state":"translated","value":"Acepta la solicitud de acceso al micrófono de macOS."}},"it":{"stringUnit":{"state":"translated","value":"Approva la richiesta di accesso al microfono di macOS."}},"fr":{"stringUnit":{"state":"translated","value":"Acceptez la demande d’accès au microphone de macOS."}}}},
    "Microphone access restricted": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofonzugriff eingeschränkt"}},"es":{"stringUnit":{"state":"translated","value":"El acceso al micrófono está restringido"}},"it":{"stringUnit":{"state":"translated","value":"L’accesso al microfono è limitato"}},"fr":{"stringUnit":{"state":"translated","value":"L’accès au microphone est restreint"}}}},
    "Microphone access denied": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofonzugriff verweigert"}},"es":{"stringUnit":{"state":"translated","value":"Acceso al micrófono denegado"}},"it":{"stringUnit":{"state":"translated","value":"Accesso al microfono negato"}},"fr":{"stringUnit":{"state":"translated","value":"Accès au microphone refusé"}}}},
    "A device policy blocks microphone access. Contact whoever manages this Mac.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Eine Geräterichtlinie blockiert den Mikrofonzugriff. Wende dich an die Verwaltung dieses Macs."}},"es":{"stringUnit":{"state":"translated","value":"Una política del dispositivo bloquea el acceso al micrófono. Contacta con quien administre este Mac."}},"it":{"stringUnit":{"state":"translated","value":"Un criterio del dispositivo blocca l’accesso al microfono. Contatta chi gestisce questo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Une règle de l’appareil bloque l’accès au microphone. Contactez la personne qui gère ce Mac."}}}},
    "Enable Witness under Privacy & Security → Microphone, then return here.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktiviere Witness unter Datenschutz & Sicherheit → Mikrofon und kehre dann hierher zurück."}},"es":{"stringUnit":{"state":"translated","value":"Activa Witness en Privacidad y seguridad → Micrófono y vuelve aquí."}},"it":{"stringUnit":{"state":"translated","value":"Attiva Witness in Privacy e sicurezza → Microfono, poi torna qui."}},"fr":{"stringUnit":{"state":"translated","value":"Activez Witness dans Confidentialité et sécurité → Microphone, puis revenez ici."}}}},
    "Starting capture": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aufnahme wird gestartet"}},"es":{"stringUnit":{"state":"translated","value":"Iniciando la grabación"}},"it":{"stringUnit":{"state":"translated","value":"Avvio della registrazione"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrage de l’enregistrement"}}}},
    "Opening the microphone.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofon wird geöffnet."}},"es":{"stringUnit":{"state":"translated","value":"Abriendo el micrófono."}},"it":{"stringUnit":{"state":"translated","value":"Apertura del microfono."}},"fr":{"stringUnit":{"state":"translated","value":"Ouverture du microphone."}}}},
    "Recording": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aufnahme"}},"es":{"stringUnit":{"state":"translated","value":"Grabando"}},"it":{"stringUnit":{"state":"translated","value":"Registrazione"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrement"}}}},
    "Finishing utterance": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Äußerung wird abgeschlossen"}},"es":{"stringUnit":{"state":"translated","value":"Finalizando la frase"}},"it":{"stringUnit":{"state":"translated","value":"Completamento della frase"}},"fr":{"stringUnit":{"state":"translated","value":"Fin de l’énoncé"}}}},
    "Closing the capture buffer.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aufnahmepuffer wird geschlossen."}},"es":{"stringUnit":{"state":"translated","value":"Cerrando el búfer de grabación."}},"it":{"stringUnit":{"state":"translated","value":"Chiusura del buffer di registrazione."}},"fr":{"stringUnit":{"state":"translated","value":"Fermeture de la mémoire tampon d’enregistrement."}}}},
    "Waiting for the speech model": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Warte auf das Sprachmodell"}},"es":{"stringUnit":{"state":"translated","value":"Esperando al modelo de voz"}},"it":{"stringUnit":{"state":"translated","value":"In attesa del modello vocale"}},"fr":{"stringUnit":{"state":"translated","value":"En attente du modèle vocal"}}}},
    "Transcribing": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wird transkribiert"}},"es":{"stringUnit":{"state":"translated","value":"Transcribiendo"}},"it":{"stringUnit":{"state":"translated","value":"Trascrizione in corso"}},"fr":{"stringUnit":{"state":"translated","value":"Transcription en cours"}}}},
    "Your recording is held in memory. Transcription starts the moment the model finishes loading.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine Aufnahme bleibt im Arbeitsspeicher. Die Transkription beginnt, sobald das Modell geladen ist."}},"es":{"stringUnit":{"state":"translated","value":"La grabación se mantiene en memoria. La transcripción empezará en cuanto termine de cargarse el modelo."}},"it":{"stringUnit":{"state":"translated","value":"La registrazione resta in memoria. La trascrizione inizierà non appena il modello avrà terminato il caricamento."}},"fr":{"stringUnit":{"state":"translated","value":"Votre enregistrement est conservé en mémoire. La transcription commencera dès que le modèle sera chargé."}}}},
    "Recognizing speech on this Mac. %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Spracherkennung auf diesem Mac. %@"}},"es":{"stringUnit":{"state":"translated","value":"Reconociendo voz en este Mac. %@"}},"it":{"stringUnit":{"state":"translated","value":"Riconoscimento vocale su questo Mac. %@"}},"fr":{"stringUnit":{"state":"translated","value":"Reconnaissance vocale sur ce Mac. %@"}}}},
    "Inserting": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wird eingefügt"}},"es":{"stringUnit":{"state":"translated","value":"Insertando"}},"it":{"stringUnit":{"state":"translated","value":"Inserimento"}},"fr":{"stringUnit":{"state":"translated","value":"Insertion"}}}},
    "Putting the text where you were typing.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Text wird an der bisherigen Eingabestelle eingefügt."}},"es":{"stringUnit":{"state":"translated","value":"Insertando el texto donde estabas escribiendo."}},"it":{"stringUnit":{"state":"translated","value":"Inserimento del testo nel punto in cui stavi scrivendo."}},"fr":{"stringUnit":{"state":"translated","value":"Insertion du texte là où vous écriviez."}}}},
    "Hold %@ to record.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Halte %@ zum Aufnehmen gedrückt."}},"es":{"stringUnit":{"state":"translated","value":"Mantén pulsado %@ para grabar."}},"it":{"stringUnit":{"state":"translated","value":"Tieni premuto %@ per registrare."}},"fr":{"stringUnit":{"state":"translated","value":"Maintenez %@ enfoncé pour enregistrer."}}}},
    "Press %@ to start recording.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Drücke %@, um die Aufnahme zu starten."}},"es":{"stringUnit":{"state":"translated","value":"Pulsa %@ para empezar a grabar."}},"it":{"stringUnit":{"state":"translated","value":"Premi %@ per iniziare a registrare."}},"fr":{"stringUnit":{"state":"translated","value":"Appuyez sur %@ pour commencer l’enregistrement."}}}},
    "Release %@ to finish.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Lass %@ los, um die Aufnahme zu beenden."}},"es":{"stringUnit":{"state":"translated","value":"Suelta %@ para terminar."}},"it":{"stringUnit":{"state":"translated","value":"Rilascia %@ per terminare."}},"fr":{"stringUnit":{"state":"translated","value":"Relâchez %@ pour terminer."}}}},
    "Press %@ again to finish.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Drücke %@ erneut, um die Aufnahme zu beenden."}},"es":{"stringUnit":{"state":"translated","value":"Pulsa %@ de nuevo para terminar."}},"it":{"stringUnit":{"state":"translated","value":"Premi di nuovo %@ per terminare."}},"fr":{"stringUnit":{"state":"translated","value":"Appuyez de nouveau sur %@ pour terminer."}}}},
    "%1$@ left, until %2$@. %3$@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Noch %1$@, bis %2$@. %3$@"}},"es":{"stringUnit":{"state":"translated","value":"Quedan %1$@, hasta el %2$@. %3$@"}},"it":{"stringUnit":{"state":"translated","value":"Restano %1$@, fino al %2$@. %3$@"}},"fr":{"stringUnit":{"state":"translated","value":"Il reste %1$@, jusqu’au %2$@. %3$@"}}}},
    "%1$@ · %2$lld Hz · %3$lld ch": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%1$@ · %2$lld Hz · %3$lld Kan."}},"es":{"stringUnit":{"state":"translated","value":"%1$@ · %2$lld Hz · %3$lld canales"}},"it":{"stringUnit":{"state":"translated","value":"%1$@ · %2$lld Hz · %3$lld canali"}},"fr":{"stringUnit":{"state":"translated","value":"%1$@ · %2$lld Hz · %3$lld canaux"}}}},
    "%@ It happens once. Dictation starts the moment it is here.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ Dies geschieht nur einmal. Sobald es verfügbar ist, kannst du diktieren."}},"es":{"stringUnit":{"state":"translated","value":"%@ Solo ocurre una vez. El dictado estará disponible en cuanto termine."}},"it":{"stringUnit":{"state":"translated","value":"%@ Succede una sola volta. La dettatura sarà disponibile non appena sarà pronto."}},"fr":{"stringUnit":{"state":"translated","value":"%@ Cette opération n’a lieu qu’une fois. La dictée sera disponible dès qu’elle sera terminée."}}}},
    "Some fragments in the last result are worth checking. The text is already in place.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einige Stellen im letzten Ergebnis solltest du prüfen. Der Text wurde bereits eingefügt."}},"es":{"stringUnit":{"state":"translated","value":"Conviene revisar algunos fragmentos del último resultado. El texto ya está insertado."}},"it":{"stringUnit":{"state":"translated","value":"Vale la pena controllare alcuni frammenti dell’ultimo risultato. Il testo è già stato inserito."}},"fr":{"stringUnit":{"state":"translated","value":"Certains fragments du dernier résultat méritent une vérification. Le texte est déjà inséré."}}}},
    "The trial ended %@. A license brings it back, on this Mac and one more.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Testphase endete am %@. Eine Lizenz aktiviert Witness auf diesem und einem weiteren Mac."}},"es":{"stringUnit":{"state":"translated","value":"El periodo de prueba terminó el %@. Una licencia reactiva Witness en este Mac y en otro más."}},"it":{"stringUnit":{"state":"translated","value":"Il periodo di prova è terminato il %@. Una licenza riattiva Witness su questo Mac e su un altro."}},"fr":{"stringUnit":{"state":"translated","value":"La période d’essai s’est terminée le %@. Une licence réactive Witness sur ce Mac et sur un autre."}}}},
    "The speech model is not ready": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprachmodell ist nicht bereit"}},"es":{"stringUnit":{"state":"translated","value":"El modelo de voz no está listo"}},"it":{"stringUnit":{"state":"translated","value":"Il modello vocale non è pronto"}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle vocal n’est pas prêt"}}}},
    "The speech model is still arriving": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprachmodell wird noch geladen"}},"es":{"stringUnit":{"state":"translated","value":"El modelo de voz aún se está descargando"}},"it":{"stringUnit":{"state":"translated","value":"Il modello vocale è ancora in arrivo"}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle vocal est encore en cours de téléchargement"}}}},
    "The speech model is ready. Hold %@ and speak — the text lands where your cursor is.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprachmodell ist bereit. Halte %@ gedrückt und sprich – der Text erscheint an der Cursorposition."}},"es":{"stringUnit":{"state":"translated","value":"El modelo de voz está listo. Mantén pulsado %@ y habla; el texto aparecerá donde esté el cursor."}},"it":{"stringUnit":{"state":"translated","value":"Il modello vocale è pronto. Tieni premuto %@ e parla: il testo apparirà nella posizione del cursore."}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle vocal est prêt. Maintenez %@ enfoncé et parlez : le texte apparaîtra à l’emplacement du curseur."}}}},
    "Nothing was inserted: the focus is in a password field. The text is here and was not copied.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nichts wurde eingefügt: Der Fokus befindet sich in einem Passwortfeld. Der Text ist weiterhin hier und wurde nicht kopiert."}},"es":{"stringUnit":{"state":"translated","value":"No se ha insertado nada porque el cursor está en un campo de contraseña. El texto está aquí y no se ha copiado."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato inserito nulla perché il cursore si trova in un campo password. Il testo è qui e non è stato copiato."}},"fr":{"stringUnit":{"state":"translated","value":"Rien n’a été inséré, car le curseur se trouve dans un champ de mot de passe. Le texte est ici et n’a pas été copié."}}}},
    "Copied to the clipboard. Grant Accessibility access to have it typed for you.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"In die Zwischenablage kopiert. Erlaube den Bedienungshilfen-Zugriff, damit Witness den Text für dich eingibt."}},"es":{"stringUnit":{"state":"translated","value":"Copiado al portapapeles. Concede acceso a Accesibilidad para que Witness lo escriba por ti."}},"it":{"stringUnit":{"state":"translated","value":"Copiato negli appunti. Concedi l’accesso ad Accessibilità affinché Witness lo inserisca per te."}},"fr":{"stringUnit":{"state":"translated","value":"Copié dans le presse-papiers. Accordez l’accès à Accessibilité pour que Witness saisisse le texte à votre place."}}}},
    "Copied to the clipboard — there was no other application to put it in.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"In die Zwischenablage kopiert – es gab keine andere App zum Einfügen."}},"es":{"stringUnit":{"state":"translated","value":"Copiado al portapapeles: no había otra aplicación donde insertarlo."}},"it":{"stringUnit":{"state":"translated","value":"Copiato negli appunti: non c’era un’altra applicazione in cui inserirlo."}},"fr":{"stringUnit":{"state":"translated","value":"Copié dans le presse-papiers : aucune autre application ne pouvait le recevoir."}}}},
    "Settings could not be read: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einstellungen konnten nicht gelesen werden: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se han podido leer los ajustes: %@"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile leggere le impostazioni: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de lire les réglages : %@"}}}},
    "Settings could not be saved: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einstellungen konnten nicht gespeichert werden: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se han podido guardar los ajustes: %@"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile salvare le impostazioni: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible d’enregistrer les réglages : %@"}}}},
    "The dictionary could not be read: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Wörterbuch konnte nicht gelesen werden: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido leer el diccionario: %@"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile leggere il dizionario: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de lire le dictionnaire : %@"}}}},
    "The dictionary could not be saved: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Wörterbuch konnte nicht gespeichert werden: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido guardar el diccionario: %@"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile salvare il dizionario: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible d’enregistrer le dictionnaire : %@"}}}},
    "The license record could not be read: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Lizenzdatensatz konnte nicht gelesen werden: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido leer la información de la licencia: %@"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile leggere i dati della licenza: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de lire les informations de licence : %@"}}}},
    "The license record could not be saved: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Lizenzdatensatz konnte nicht gespeichert werden: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido guardar la información de la licencia: %@"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile salvare i dati della licenza: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible d’enregistrer les informations de licence : %@"}}}},
    "That address does not look complete. The key is sent to it, so a typo means it goes nowhere.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Adresse scheint unvollständig zu sein. Prüfe sie auf Tippfehler."}},"es":{"stringUnit":{"state":"translated","value":"Esa dirección parece incompleta. La clave se enviará allí, así que comprueba que no haya ningún error."}},"it":{"stringUnit":{"state":"translated","value":"L’indirizzo sembra incompleto. La chiave verrà inviata lì, quindi controlla che non ci siano errori."}},"fr":{"stringUnit":{"state":"translated","value":"Cette adresse semble incomplète. La clé y sera envoyée : vérifiez qu’elle ne contient aucune erreur."}}}},
    "That does not look like a license key. Copy the whole line from the activation email, including the LD1 at the front.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das sieht nicht wie ein Lizenzschlüssel aus. Kopiere die vollständige Zeile aus der Aktivierungs-E-Mail, einschließlich LD1 am Anfang."}},"es":{"stringUnit":{"state":"translated","value":"Eso no parece una clave de licencia. Copia la línea completa del correo de activación, incluido LD1 al principio."}},"it":{"stringUnit":{"state":"translated","value":"Questa non sembra una chiave di licenza. Copia l’intera riga dall’email di attivazione, compreso LD1 all’inizio."}},"fr":{"stringUnit":{"state":"translated","value":"Ce texte ne ressemble pas à une clé de licence. Copiez toute la ligne de l’e-mail d’activation, y compris LD1 au début."}}}},
    "This license already covers two Macs. Release one of them before activating a third.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Lizenz wird bereits auf zwei Macs verwendet. Entferne einen davon, bevor du einen dritten aktivierst."}},"es":{"stringUnit":{"state":"translated","value":"Esta licencia ya se utiliza en dos Mac. Libera uno de ellos antes de activar un tercero."}},"it":{"stringUnit":{"state":"translated","value":"Questa licenza è già usata su due Mac. Liberane uno prima di attivarne un terzo."}},"fr":{"stringUnit":{"state":"translated","value":"Cette licence est déjà utilisée sur deux Mac. Libérez l’un d’eux avant d’en activer un troisième."}}}},
    "The activation service replied with something unreadable.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Antwort des Aktivierungsdienstes konnte nicht gelesen werden."}},"es":{"stringUnit":{"state":"translated","value":"El servicio de activación ha enviado una respuesta que Witness no puede interpretar."}},"it":{"stringUnit":{"state":"translated","value":"Il servizio di attivazione ha inviato una risposta che Witness non riesce a interpretare."}},"fr":{"stringUnit":{"state":"translated","value":"Le service d’activation a envoyé une réponse que Witness ne peut pas interpréter."}}}},
    "This address or this Mac has already had the free trial. A license keeps it dictating: €99 once, or €49 a year, both covering two Macs.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Für diese Adresse oder diesen Mac wurde die Testphase bereits genutzt. Eine Lizenz kostet einmalig 99 € oder 49 € pro Jahr und gilt für zwei Macs."}},"es":{"stringUnit":{"state":"translated","value":"Esta dirección o este Mac ya ha utilizado la prueba gratuita. Para seguir dictando, elige una licencia: 99 € en un único pago o 49 € al año, ambas para dos Mac."}},"it":{"stringUnit":{"state":"translated","value":"Questo indirizzo o questo Mac ha già utilizzato la prova gratuita. Per continuare a dettare, scegli una licenza: 99 € una tantum oppure 49 € all’anno, entrambe valide per due Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Cette adresse ou ce Mac a déjà bénéficié de l’essai gratuit. Pour continuer à dicter, choisissez une licence : 99 € en une fois ou 49 € par an, toutes deux valables pour deux Mac."}}}},
    "the shortcut is already used by macOS or another app": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"das Tastenkürzel wird bereits von macOS oder einer anderen App verwendet"}},"es":{"stringUnit":{"state":"translated","value":"macOS u otra app ya utiliza este atajo"}},"it":{"stringUnit":{"state":"translated","value":"la scorciatoia è già usata da macOS o da un’altra app"}},"fr":{"stringUnit":{"state":"translated","value":"ce raccourci est déjà utilisé par macOS ou une autre app"}}}},
    "the previous application": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"die vorherige App"}},"es":{"stringUnit":{"state":"translated","value":"la aplicación anterior"}},"it":{"stringUnit":{"state":"translated","value":"l’app precedente"}},"fr":{"stringUnit":{"state":"translated","value":"l’app précédente"}}}},
    " — %lld%% of about %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":" – %lld %% von etwa %@"}},"es":{"stringUnit":{"state":"translated","value":" — %lld%% de unos %@"}},"it":{"stringUnit":{"state":"translated","value":" — %lld%% di circa %@"}},"fr":{"stringUnit":{"state":"translated","value":" — %lld%% sur environ %@"}}}},
    "%1$@ of speech came back empty, so nothing was inserted. Say it again, or check that the language profile — %2$@ — is the one you spoke.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Erkennung für %1$@ ergab keinen Text. Sprich erneut oder prüfe, ob das Profil „%2$@“ deiner Sprache entspricht."}},"es":{"stringUnit":{"state":"translated","value":"%1$@ de voz no produjo texto, así que no se insertó nada. Vuelve a decirlo o comprueba que el perfil de idioma —%2$@— coincide con el idioma que hablaste."}},"it":{"stringUnit":{"state":"translated","value":"%1$@ di parlato non ha prodotto testo, quindi non è stato inserito nulla. Ripeti oppure verifica che il profilo linguistico — %2$@ — corrisponda alla lingua parlata."}},"fr":{"stringUnit":{"state":"translated","value":"%1$@ de parole n’a produit aucun texte, donc rien n’a été inséré. Réessayez ou vérifiez que le profil linguistique — %2$@ — correspond à la langue parlée."}}}},
    "A copy of the key is also on its way to that address. You do not need it now — it is for when you reinstall Witness or replace this Mac. If it never arrives, press the button again: the same key comes back here and the mail is retried.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Eine Kopie des Schlüssels wird auch an diese Adresse gesendet. Du brauchst sie nur nach einer Neuinstallation oder beim Austausch dieses Macs. Falls sie nicht ankommt, drücke die Taste erneut."}},"es":{"stringUnit":{"state":"translated","value":"También se enviará una copia de la clave a esa dirección. No la necesitas ahora: sirve para reinstalar Witness o sustituir este Mac. Si no llega, vuelve a pulsar el botón; aquí aparecerá la misma clave y se reintentará el envío."}},"it":{"stringUnit":{"state":"translated","value":"Una copia della chiave verrà inviata anche a quell’indirizzo. Non ti serve ora: servirà se reinstalli Witness o sostituisci questo Mac. Se non arriva, premi di nuovo il pulsante; qui tornerà la stessa chiave e l’email verrà inviata di nuovo."}},"fr":{"stringUnit":{"state":"translated","value":"Une copie de la clé sera également envoyée à cette adresse. Vous n’en avez pas besoin maintenant : elle servira si vous réinstallez Witness ou remplacez ce Mac. Si elle n’arrive pas, appuyez de nouveau sur le bouton ; la même clé reviendra ici et l’e-mail sera renvoyé."}}}},
    "A license keeps it after that, on this Mac and one more.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mit einer Lizenz kannst du danach auf diesem und einem weiteren Mac weiterarbeiten."}},"es":{"stringUnit":{"state":"translated","value":"Después, una licencia mantiene Witness activo en este Mac y en otro más."}},"it":{"stringUnit":{"state":"translated","value":"In seguito, una licenza mantiene Witness attivo su questo Mac e su un altro."}},"fr":{"stringUnit":{"state":"translated","value":"Ensuite, une licence maintient Witness actif sur ce Mac et sur un autre."}}}},
    "Activated, and there is nothing else to enter. The trial runs for ten days from today.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktiviert. Weitere Eingaben sind nicht nötig. Die Testphase läuft ab heute zehn Tage."}},"es":{"stringUnit":{"state":"translated","value":"Activado. No tienes que introducir nada más. El periodo de prueba dura diez días desde hoy."}},"it":{"stringUnit":{"state":"translated","value":"Attivato. Non devi inserire altro. Il periodo di prova dura dieci giorni da oggi."}},"fr":{"stringUnit":{"state":"translated","value":"Activé. Vous n’avez rien d’autre à saisir. La période d’essai dure dix jours à compter d’aujourd’hui."}}}},
    "Copied to the clipboard: macOS is not letting Witness press ⌘V for you. Its Accessibility permission stops applying when the app itself changes, so switching Witness off and on again in System Settings → Privacy & Security → Accessibility is what restores it.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"In die Zwischenablage kopiert: macOS erlaubt Witness derzeit nicht, ⌘V für dich zu drücken. Deaktiviere und aktiviere Witness unter Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen."}},"es":{"stringUnit":{"state":"translated","value":"Copiado al portapapeles: macOS no permite que Witness pulse ⌘V. El permiso de Accesibilidad deja de aplicarse cuando cambia la propia app; desactiva y vuelve a activar Witness en Ajustes del Sistema → Privacidad y seguridad → Accesibilidad para restablecerlo."}},"it":{"stringUnit":{"state":"translated","value":"Copiato negli appunti: macOS non consente a Witness di premere ⌘V. L’autorizzazione Accessibilità smette di essere valida quando cambia l’app; disattiva e riattiva Witness in Impostazioni di Sistema → Privacy e sicurezza → Accessibilità per ripristinarla."}},"fr":{"stringUnit":{"state":"translated","value":"Copié dans le presse-papiers : macOS n’autorise pas Witness à appuyer sur ⌘V. L’autorisation Accessibilité cesse de s’appliquer lorsque l’app change ; désactivez puis réactivez Witness dans Réglages Système → Confidentialité et sécurité → Accessibilité pour la rétablir."}}}},
    "Copied to the clipboard: that application would not accept the text directly.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"In die Zwischenablage kopiert: Diese App hat den Text nicht direkt angenommen."}},"es":{"stringUnit":{"state":"translated","value":"Copiado al portapapeles: esa aplicación no ha aceptado el texto directamente."}},"it":{"stringUnit":{"state":"translated","value":"Copiato negli appunti: l’applicazione non ha accettato direttamente il testo."}},"fr":{"stringUnit":{"state":"translated","value":"Copié dans le presse-papiers : cette application n’a pas accepté le texte directement."}}}},
    "The new dictation is on the clipboard. Check what the application pasted; Witness could not verify that it used this recording.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das neue Diktat liegt in der Zwischenablage. Prüfe, was die App eingefügt hat; Witness konnte nicht bestätigen, dass sie diese Aufnahme verwendet hat."}},"es":{"stringUnit":{"state":"translated","value":"El nuevo dictado está en el portapapeles. Comprueba lo que ha pegado la aplicación; Witness no ha podido verificar que utilizara esta grabación."}},"it":{"stringUnit":{"state":"translated","value":"La nuova dettatura è negli appunti. Controlla ciò che l’applicazione ha incollato: Witness non ha potuto verificare che abbia usato questa registrazione."}},"fr":{"stringUnit":{"state":"translated","value":"La nouvelle dictée se trouve dans le presse-papiers. Vérifiez ce que l’application a collé ; Witness n’a pas pu confirmer qu’elle avait utilisé cet enregistrement."}}}},
    "Copied to the clipboard: you moved to a different application while this was being prepared.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"In die Zwischenablage kopiert: Du hast während der Verarbeitung zu einer anderen App gewechselt."}},"es":{"stringUnit":{"state":"translated","value":"Copiado al portapapeles: cambiaste de aplicación mientras se preparaba el texto."}},"it":{"stringUnit":{"state":"translated","value":"Copiato negli appunti: sei passato a un’altra applicazione mentre il testo veniva preparato."}},"fr":{"stringUnit":{"state":"translated","value":"Copié dans le presse-papiers : vous avez changé d’application pendant la préparation du texte."}}}},
    "The trial ran out on %@. Your dictionary and settings are untouched and come straight back with a license.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Test ist am %@ abgelaufen. Wörterbuch und Einstellungen bleiben unverändert und sind mit einer Lizenz sofort wieder verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"El periodo de prueba terminó el %@. Tu diccionario y tus ajustes no han cambiado y volverán a estar disponibles al activar una licencia."}},"it":{"stringUnit":{"state":"translated","value":"Il periodo di prova è terminato il %@. Il dizionario e le impostazioni non sono cambiati e torneranno subito disponibili con una licenza."}},"fr":{"stringUnit":{"state":"translated","value":"La période d’essai s’est terminée le %@. Votre dictionnaire et vos réglages sont intacts et redeviennent immédiatement disponibles avec une licence."}}}},
    "It ran out %@. Renewing unlocks dictation again; nothing on this Mac was touched.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sie ist am %@ abgelaufen. Eine Verlängerung schaltet das Diktieren wieder frei; lokale Daten wurden nicht verändert."}},"es":{"stringUnit":{"state":"translated","value":"Caducó el %@. La renovación vuelve a activar el dictado; no se ha modificado nada en este Mac."}},"it":{"stringUnit":{"state":"translated","value":"È scaduta il %@. Il rinnovo riattiva la dettatura; nulla su questo Mac è stato modificato."}},"fr":{"stringUnit":{"state":"translated","value":"Elle a expiré le %@. Le renouvellement réactive la dictée ; rien n’a été modifié sur ce Mac."}}}},
    "It ran out on %@. Renewing unlocks dictation again on this Mac; nothing local was removed.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sie ist am %@ abgelaufen. Eine Verlängerung schaltet das Diktieren wieder frei; lokale Daten wurden nicht entfernt."}},"es":{"stringUnit":{"state":"translated","value":"Caducó el %@. La renovación vuelve a activar el dictado en este Mac; no se ha eliminado ningún dato local."}},"it":{"stringUnit":{"state":"translated","value":"È scaduta il %@. Il rinnovo riattiva la dettatura su questo Mac; nessun dato locale è stato rimosso."}},"fr":{"stringUnit":{"state":"translated","value":"Elle a expiré le %@. Le renouvellement réactive la dictée sur ce Mac ; aucune donnée locale n’a été supprimée."}}}},
    "It runs out on %@. A license keeps this Mac dictating; your dictionary and settings stay exactly as they are either way. Have a promo code? It goes in on the payment page.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sie läuft am %@ ab. Mit einer Lizenz kannst du weiter diktieren; Wörterbuch und Einstellungen bleiben unverändert. Einen Rabattcode gibst du auf der Bezahlseite ein."}},"es":{"stringUnit":{"state":"translated","value":"Termina el %@. Una licencia permite seguir dictando en este Mac; tu diccionario y tus ajustes no cambian. ¿Tienes un código promocional? Introdúcelo en la página de pago."}},"it":{"stringUnit":{"state":"translated","value":"Termina il %@. Una licenza permette di continuare a dettare su questo Mac; dizionario e impostazioni restano invariati. Hai un codice promozionale? Inseriscilo nella pagina di pagamento."}},"fr":{"stringUnit":{"state":"translated","value":"Elle se termine le %@. Une licence permet de continuer à dicter sur ce Mac ; votre dictionnaire et vos réglages restent inchangés. Vous avez un code promotionnel ? Saisissez-le sur la page de paiement."}}}},
    "Licensed to %1$@. This Mac needs nothing further — no renewal, and no connection. It covers version %2$lld and every update to it.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Lizenziert für %1$@. Dieser Mac benötigt weder Verlängerung noch Verbindung. Abgedeckt sind Version %2$lld und alle zugehörigen Updates."}},"es":{"stringUnit":{"state":"translated","value":"Licencia de %1$@. Este Mac no necesita nada más: ni renovación ni conexión. Incluye la versión %2$lld y todas sus actualizaciones."}},"it":{"stringUnit":{"state":"translated","value":"Licenza intestata a %1$@. Su questo Mac non serve altro: né rinnovo né connessione. Include la versione %2$lld e tutti i relativi aggiornamenti."}},"fr":{"stringUnit":{"state":"translated","value":"Licence accordée à %1$@. Ce Mac n’a besoin de rien d’autre : ni renouvellement ni connexion. Elle couvre la version %2$lld et toutes ses mises à jour."}}}},
    "Licensed to %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Lizenziert für %@."}},"es":{"stringUnit":{"state":"translated","value":"Licencia de %@."}},"it":{"stringUnit":{"state":"translated","value":"Licenza di %@."}},"fr":{"stringUnit":{"state":"translated","value":"Licence de %@."}}}},
    "Nothing was inserted: %@ has secure input enabled, which blocks dictation everywhere until it stops. Switching to it and clicking into an ordinary field usually clears it; quitting it always does. The text is here and was not copied.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nichts wurde eingefügt: %@ hat die sichere Eingabe aktiviert. Wechsle dorthin und klicke in ein normales Feld oder beende die App. Der Text wurde nicht kopiert."}},"es":{"stringUnit":{"state":"translated","value":"No se ha insertado nada: %@ tiene activada la entrada segura, que bloquea el dictado en todas partes hasta que se desactive. Cambia a esa app y haz clic en un campo normal; normalmente basta, y cerrarla siempre lo soluciona. El texto está aquí y no se ha copiado."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato inserito nulla: %@ ha attivato l’inserimento sicuro, che blocca la dettatura ovunque finché non viene disattivato. Passa a quell’app e fai clic in un campo normale; di solito basta, mentre chiuderla risolve sempre il problema. Il testo è qui e non è stato copiato."}},"fr":{"stringUnit":{"state":"translated","value":"Rien n’a été inséré : %@ a activé la saisie sécurisée, ce qui bloque la dictée partout jusqu’à sa désactivation. Passez à cette app et cliquez dans un champ ordinaire ; cela suffit généralement, et la quitter résout toujours le problème. Le texte est ici et n’a pas été copié."}}}},
    "Nothing was inserted: an application has secure input enabled, which blocks dictation everywhere until it stops. The text is here and was not copied.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nichts wurde eingefügt: Eine App hat die sichere Eingabe aktiviert und blockiert damit das Diktieren. Der Text wurde nicht kopiert."}},"es":{"stringUnit":{"state":"translated","value":"No se ha insertado nada: una aplicación tiene activada la entrada segura, que bloquea el dictado en todas partes hasta que se desactive. El texto está aquí y no se ha copiado."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato inserito nulla: un’applicazione ha attivato l’inserimento sicuro, che blocca la dettatura ovunque finché non viene disattivato. Il testo è qui e non è stato copiato."}},"fr":{"stringUnit":{"state":"translated","value":"Rien n’a été inséré : une application a activé la saisie sécurisée, ce qui bloque la dictée partout jusqu’à sa désactivation. Le texte est ici et n’a pas été copié."}}}},
    "Nothing was recorded yet — Witness is downloading the speech model%@. It happens once, and afterwards recognition runs entirely on this Mac. Hold %@ again when it is here; Witness will say so.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Noch nichts aufgenommen – Witness lädt das Sprachmodell%@. Dies geschieht einmalig, danach läuft die Erkennung vollständig auf diesem Mac. Halte %@ erneut gedrückt, sobald es bereit ist."}},"es":{"stringUnit":{"state":"translated","value":"Todavía no se ha grabado nada: Witness está descargando el modelo de voz%@. Solo ocurre una vez; después, el reconocimiento se ejecuta por completo en este Mac. Vuelve a mantener pulsado %@ cuando termine; Witness te avisará."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato ancora registrato nulla: Witness sta scaricando il modello vocale%@. Succede una sola volta; in seguito il riconoscimento avviene interamente su questo Mac. Tieni di nuovo premuto %@ quando sarà pronto; Witness ti avviserà."}},"fr":{"stringUnit":{"state":"translated","value":"Rien n’a encore été enregistré : Witness télécharge le modèle vocal%@. Cette opération n’a lieu qu’une fois ; la reconnaissance s’effectuera ensuite entièrement sur ce Mac. Maintenez de nouveau %@ enfoncé lorsqu’il sera prêt ; Witness vous préviendra."}}}},
    "Nothing was recorded yet — macOS is preparing the speech model for this Mac. It happens once per macOS version and takes a few minutes. Hold %@ again when it is here; Witness will say so.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Noch nichts aufgenommen – macOS bereitet das Sprachmodell für diesen Mac vor. Dies geschieht einmal pro macOS-Version und dauert einige Minuten. Halte %@ danach erneut gedrückt."}},"es":{"stringUnit":{"state":"translated","value":"Todavía no se ha grabado nada: macOS está preparando el modelo de voz para este Mac. Ocurre una vez por versión de macOS y tarda unos minutos. Vuelve a mantener pulsado %@ cuando termine; Witness te avisará."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato ancora registrato nulla: macOS sta preparando il modello vocale per questo Mac. Succede una volta per ogni versione di macOS e richiede alcuni minuti. Tieni di nuovo premuto %@ quando sarà pronto; Witness ti avviserà."}},"fr":{"stringUnit":{"state":"translated","value":"Rien n’a encore été enregistré : macOS prépare le modèle vocal pour ce Mac. Cette opération a lieu une fois par version de macOS et prend quelques minutes. Maintenez de nouveau %@ enfoncé lorsqu’il sera prêt ; Witness vous préviendra."}}}},
    "Nothing was recorded yet — the speech model is loading. That takes seconds. Hold %@ again in a moment.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Noch nichts aufgenommen – das Sprachmodell wird geladen. Das dauert nur Sekunden. Halte %@ gleich erneut gedrückt."}},"es":{"stringUnit":{"state":"translated","value":"Todavía no se ha grabado nada: el modelo de voz se está cargando. Tardará unos segundos. Vuelve a mantener pulsado %@ dentro de un momento."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato ancora registrato nulla: il modello vocale si sta caricando. Richiede pochi secondi. Tra un momento tieni di nuovo premuto %@."}},"fr":{"stringUnit":{"state":"translated","value":"Rien n’a encore été enregistré : le modèle vocal est en cours de chargement. Cela prend quelques secondes. Maintenez de nouveau %@ enfoncé dans un instant."}}}},
    "Nothing was recorded yet — the speech model is not on this Mac. The download has just started: about %@, once. The menu bar shows how far it has got and how long is left. Hold %@ again when it is here; Witness will say so.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Noch nichts aufgenommen – das Sprachmodell fehlt auf diesem Mac. Der einmalige Download von etwa %@ wurde gestartet. Die Menüleiste zeigt, wie weit er ist und wie lange es noch dauert. Halte %@ danach erneut gedrückt."}},"es":{"stringUnit":{"state":"translated","value":"Todavía no se ha grabado nada: el modelo de voz no está en este Mac. La descarga acaba de empezar: unos %@, una sola vez. La barra de menús muestra el progreso y el tiempo restante. Vuelve a mantener pulsado %@ cuando termine; Witness te avisará."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato ancora registrato nulla: il modello vocale non è presente su questo Mac. Il download è appena iniziato: circa %@, una sola volta. La barra dei menu mostra l’avanzamento e il tempo restante. Tieni di nuovo premuto %@ quando sarà pronto; Witness ti avviserà."}},"fr":{"stringUnit":{"state":"translated","value":"Rien n’a encore été enregistré : le modèle vocal n’est pas présent sur ce Mac. Le téléchargement vient de commencer : environ %@, une seule fois. La barre des menus indique la progression et le temps restant. Maintenez de nouveau %@ enfoncé lorsqu’il sera prêt ; Witness vous préviendra."}}}},
    "Nothing was recorded — the speech model is not ready. %@ Witness is trying again; the menu bar icon shows how it is going.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nichts aufgenommen – das Sprachmodell ist nicht bereit. %@ Witness versucht es erneut; den Fortschritt siehst du in der Menüleiste."}},"es":{"stringUnit":{"state":"translated","value":"No se ha grabado nada: el modelo de voz no está listo. %@ Witness lo está intentando de nuevo; el icono de la barra de menús muestra el progreso."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato registrato nulla: il modello vocale non è pronto. %@ Witness sta riprovando; l’icona nella barra dei menu mostra l’avanzamento."}},"fr":{"stringUnit":{"state":"translated","value":"Rien n’a été enregistré : le modèle vocal n’est pas prêt. %@ Witness réessaie ; l’icône de la barre des menus indique la progression."}}}},
    "That key did not verify, so nothing was changed.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Schlüssel konnte nicht bestätigt werden. Es wurde nichts geändert."}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido verificar la clave, por lo que no se ha cambiado nada."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile verificare la chiave, quindi non è cambiato nulla."}},"fr":{"stringUnit":{"state":"translated","value":"La clé n’a pas pu être vérifiée. Rien n’a donc été modifié."}}}},
    "That key was issued for a different Mac, so nothing was changed.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Schlüssel wurde für einen anderen Mac ausgestellt. Es wurde nichts geändert."}},"es":{"stringUnit":{"state":"translated","value":"La clave se emitió para otro Mac, por lo que no se ha cambiado nada."}},"it":{"stringUnit":{"state":"translated","value":"La chiave è stata emessa per un altro Mac, quindi non è cambiato nulla."}},"fr":{"stringUnit":{"state":"translated","value":"La clé a été émise pour un autre Mac. Rien n’a donc été modifié."}}}},
    "That request was missing the Mac or the key it belongs to.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"In der Anfrage fehlte der Mac oder der zugehörige Schlüssel."}},"es":{"stringUnit":{"state":"translated","value":"Falta el Mac o la clave correspondiente en la solicitud."}},"it":{"stringUnit":{"state":"translated","value":"Nella richiesta manca il Mac o la chiave corrispondente."}},"fr":{"stringUnit":{"state":"translated","value":"Le Mac ou la clé correspondante manque dans la demande."}}}},
    "The activation service has no record of that key.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Aktivierungsdienst kennt diesen Schlüssel nicht."}},"es":{"stringUnit":{"state":"translated","value":"El servicio de activación no encuentra esa clave."}},"it":{"stringUnit":{"state":"translated","value":"Il servizio di attivazione non trova questa chiave."}},"fr":{"stringUnit":{"state":"translated","value":"Le service d’activation ne trouve pas cette clé."}}}},
    "The activation service refused this request (%lld). Paste a key from your email instead, or write to support.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Aktivierungsdienst hat die Anfrage abgelehnt (%lld). Füge stattdessen einen Schlüssel aus deiner E-Mail ein oder kontaktiere den Support."}},"es":{"stringUnit":{"state":"translated","value":"El servicio de activación ha rechazado la solicitud (%lld). Pega una clave del correo que recibiste o escribe al equipo de asistencia."}},"it":{"stringUnit":{"state":"translated","value":"Il servizio di attivazione ha rifiutato la richiesta (%lld). Incolla una chiave ricevuta via email oppure contatta l’assistenza."}},"fr":{"stringUnit":{"state":"translated","value":"Le service d’activation a refusé la demande (%lld). Collez une clé reçue par e-mail ou contactez l’assistance."}}}},
    "The microphone was open for %1$@ and never picked up speech (peak level %2$@). Check that %3$@ is what you are speaking into, and that it is not muted.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Mikrofon war %1$@ geöffnet, hat aber keine Sprache erkannt (Spitzenpegel %2$@). Prüfe, ob du in %3$@ sprichst und ob es nicht stummgeschaltet ist."}},"es":{"stringUnit":{"state":"translated","value":"El micrófono estuvo abierto durante %1$@ y no detectó voz (nivel máximo %2$@). Comprueba que %3$@ sea el dispositivo al que estás hablando y que no esté silenciado."}},"it":{"stringUnit":{"state":"translated","value":"Il microfono è rimasto aperto per %1$@ senza rilevare la voce (livello di picco %2$@). Verifica che %3$@ sia il dispositivo in cui stai parlando e che non sia disattivato."}},"fr":{"stringUnit":{"state":"translated","value":"Le microphone est resté ouvert pendant %1$@ sans détecter de parole (niveau de crête %2$@). Vérifiez que %3$@ est bien le périphérique dans lequel vous parlez et qu’il n’est pas coupé."}}}},
    "This build carries no license authority key, so it cannot check any license. It is a development build.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Entwicklungs-Version enthält keinen öffentlichen Lizenzschlüssel und kann keine Lizenz prüfen."}},"es":{"stringUnit":{"state":"translated","value":"Esta compilación no contiene la clave necesaria para verificar licencias. Es una versión de desarrollo."}},"it":{"stringUnit":{"state":"translated","value":"Questa build non contiene la chiave necessaria per verificare le licenze. È una versione di sviluppo."}},"fr":{"stringUnit":{"state":"translated","value":"Cette version ne contient pas la clé nécessaire pour vérifier les licences. Il s’agit d’une version de développement."}}}},
    "This build has no activation service yet. Paste a key below instead — that path works offline and is what the app checks in either case.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Version hat noch keinen Aktivierungsdienst. Füge unten einen Schlüssel ein; dies funktioniert offline."}},"es":{"stringUnit":{"state":"translated","value":"Esta compilación aún no tiene servicio de activación. Introduce una clave abajo; funciona sin conexión y es el mismo método que comprueba la app."}},"it":{"stringUnit":{"state":"translated","value":"Questa build non dispone ancora del servizio di attivazione. Incolla una chiave qui sotto: funziona offline ed è comunque il metodo verificato dall’app."}},"fr":{"stringUnit":{"state":"translated","value":"Cette version ne dispose pas encore du service d’activation. Collez plutôt une clé ci-dessous : cette méthode fonctionne hors ligne et reste celle que l’app vérifie."}}}},
    "This build has no activation service yet. Press “Enter a key…” and paste one instead — that path works offline and is what the app checks in either case.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Version hat noch keinen Aktivierungsdienst. Wähle „Schlüssel eingeben …“ und füge einen Schlüssel ein; dies funktioniert offline."}},"es":{"stringUnit":{"state":"translated","value":"Esta compilación aún no tiene servicio de activación. Pulsa «Introducir una clave…» y pega una; funciona sin conexión y es el mismo método que comprueba la app."}},"it":{"stringUnit":{"state":"translated","value":"Questa build non dispone ancora del servizio di attivazione. Premi «Inserisci una chiave…» e incollane una: funziona offline ed è comunque il metodo verificato dall’app."}},"fr":{"stringUnit":{"state":"translated","value":"Cette version ne dispose pas encore du service d’activation. Appuyez sur « Saisir une clé… » et collez-en une : cette méthode fonctionne hors ligne et reste celle que l’app vérifie."}}}},
    "This build has no activation service. Paste a license key instead, or use a build from the product website.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Version hat keinen Aktivierungsdienst. Füge einen Lizenzschlüssel ein oder verwende eine Version von der Produktwebsite."}},"es":{"stringUnit":{"state":"translated","value":"Esta compilación no tiene servicio de activación. Pega una clave de licencia o instala una versión descargada del sitio web del producto."}},"it":{"stringUnit":{"state":"translated","value":"Questa build non dispone del servizio di attivazione. Incolla una chiave di licenza oppure installa una versione scaricata dal sito del prodotto."}},"fr":{"stringUnit":{"state":"translated","value":"Cette version ne dispose d’aucun service d’activation. Collez une clé de licence ou installez une version téléchargée depuis le site du produit."}}}},
    "This build sent an identifier the activation service does not recognize. Update Witness and try again.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Version hat eine unbekannte Kennung gesendet. Aktualisiere Witness und versuche es erneut."}},"es":{"stringUnit":{"state":"translated","value":"Esta versión ha enviado un identificador que el servicio de activación no reconoce. Actualiza Witness e inténtalo de nuevo."}},"it":{"stringUnit":{"state":"translated","value":"Questa versione ha inviato un identificatore che il servizio di attivazione non riconosce. Aggiorna Witness e riprova."}},"fr":{"stringUnit":{"state":"translated","value":"Cette version a envoyé un identifiant que le service d’activation ne reconnaît pas. Mettez Witness à jour et réessayez."}}}},
    "This key did not verify. It may have been edited in transit — paste it again straight from the email.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Schlüssel konnte nicht bestätigt werden. Füge ihn erneut direkt aus der E-Mail ein."}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido verificar la clave. Puede haberse modificado al copiarla: vuelve a pegarla directamente desde el correo."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile verificare la chiave. Potrebbe essere stata modificata durante la copia: incollala di nuovo direttamente dall’email."}},"fr":{"stringUnit":{"state":"translated","value":"La clé n’a pas pu être vérifiée. Elle a peut-être été modifiée lors de la copie : recollez-la directement depuis l’e-mail."}}}},
    "This key is version %@, which this build does not know how to read. Update Witness.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Schlüssel hat Version %@, die diese App-Version nicht lesen kann. Aktualisiere Witness."}},"es":{"stringUnit":{"state":"translated","value":"Esta clave utiliza la versión %@, que esta versión de Witness no sabe leer. Actualiza Witness."}},"it":{"stringUnit":{"state":"translated","value":"Questa chiave usa la versione %@, che questa versione di Witness non sa leggere. Aggiorna Witness."}},"fr":{"stringUnit":{"state":"translated","value":"Cette clé utilise la version %@, que cette version de Witness ne sait pas lire. Mettez Witness à jour."}}}},
    "This key was issued for a different Mac. Each Mac gets its own key, and a license covers two.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Schlüssel wurde für einen anderen Mac ausgestellt. Jeder Mac erhält einen eigenen Schlüssel; eine Lizenz gilt für zwei Macs."}},"es":{"stringUnit":{"state":"translated","value":"Esta clave se emitió para otro Mac. Cada Mac recibe su propia clave y una licencia cubre dos equipos."}},"it":{"stringUnit":{"state":"translated","value":"Questa chiave è stata emessa per un altro Mac. Ogni Mac riceve la propria chiave e una licenza copre due computer."}},"fr":{"stringUnit":{"state":"translated","value":"Cette clé a été émise pour un autre Mac. Chaque Mac reçoit sa propre clé et une licence couvre deux appareils."}}}},
    "This key's dates do not make sense, which means it was not issued by us.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Datumsangaben dieses Schlüssels sind ungültig. Er wurde nicht von uns ausgestellt."}},"es":{"stringUnit":{"state":"translated","value":"Las fechas de esta clave no son válidas, por lo que no ha sido emitida por Witness."}},"it":{"stringUnit":{"state":"translated","value":"Le date di questa chiave non sono valide, quindi la chiave non è stata emessa da Witness."}},"fr":{"stringUnit":{"state":"translated","value":"Les dates de cette clé ne sont pas valides. Elle n’a donc pas été émise par Witness."}}}},
    "Your lifetime license covers version %1$@ and every update to it. This is version %2$@. Version %1$@ keeps working forever.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine Dauerlizenz gilt für Version %1$@ und alle zugehörigen Updates. Dies ist Version %2$@. Version %1$@ funktioniert dauerhaft weiter."}},"es":{"stringUnit":{"state":"translated","value":"Tu licencia de por vida cubre la versión %1$@ y todas sus actualizaciones. Esta es la versión %2$@. La versión %1$@ seguirá funcionando para siempre."}},"it":{"stringUnit":{"state":"translated","value":"La licenza a vita copre la versione %1$@ e tutti i relativi aggiornamenti. Questa è la versione %2$@. La versione %1$@ continuerà a funzionare per sempre."}},"fr":{"stringUnit":{"state":"translated","value":"Votre licence à vie couvre la version %1$@ et toutes ses mises à jour. Il s’agit de la version %2$@. La version %1$@ continuera de fonctionner indéfiniment."}}}},
    "Your lifetime license covers version %1$lld and every update to it, forever. This is version %2$lld. Download version %1$lld again from the website and it works exactly as it did — or move to version %2$lld below.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine Dauerlizenz gilt dauerhaft für Version %1$lld und alle zugehörigen Updates. Dies ist Version %2$lld. Lade Version %1$lld erneut von der Website oder wechsle unten zu Version %2$lld."}},"es":{"stringUnit":{"state":"translated","value":"Tu licencia de por vida incluye la versión %1$lld y todas sus actualizaciones, para siempre. Esta es la versión %2$lld. Puedes volver a descargar la versión %1$lld desde el sitio web y seguir usándola como antes, o pasar a la versión %2$lld a continuación."}},"it":{"stringUnit":{"state":"translated","value":"La tua licenza a vita include la versione %1$lld e tutti i relativi aggiornamenti, per sempre. Questa è la versione %2$lld. Puoi scaricare di nuovo la versione %1$lld dal sito e continuare a usarla come prima, oppure passare alla versione %2$lld qui sotto."}},"fr":{"stringUnit":{"state":"translated","value":"Votre licence à vie couvre la version %1$lld et toutes ses mises à jour, sans limite de durée. Il s’agit ici de la version %2$lld. Vous pouvez télécharger de nouveau la version %1$lld depuis le site et continuer à l’utiliser comme avant, ou passer à la version %2$lld ci-dessous."}}}},
    "a shortcut needs at least one of ⌘ ⌥ ⌃ ⇧, or it would take that key away from every app": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"ein Tastenkürzel benötigt mindestens eine der Tasten ⌘ ⌥ ⌃ ⇧"}},"es":{"stringUnit":{"state":"translated","value":"el atajo debe incluir al menos una de estas teclas: ⌘ ⌥ ⌃ ⇧; de lo contrario, esa tecla dejaría de funcionar en las demás apps"}},"it":{"stringUnit":{"state":"translated","value":"la scorciatoia deve includere almeno uno dei tasti ⌘ ⌥ ⌃ ⇧, altrimenti quel tasto non sarebbe più disponibile nelle altre app"}},"fr":{"stringUnit":{"state":"translated","value":"le raccourci doit inclure au moins l’une des touches ⌘ ⌥ ⌃ ⇧ ; sinon, cette touche ne serait plus disponible dans les autres apps"}}}},
    "it answered with an error (%lld).": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"der Dienst antwortete mit einem Fehler (%lld)."}},"es":{"stringUnit":{"state":"translated","value":"ha respondido con un error (%lld)."}},"it":{"stringUnit":{"state":"translated","value":"ha risposto con un errore (%lld)."}},"fr":{"stringUnit":{"state":"translated","value":"a renvoyé une erreur (%lld)."}}}},
    "it is asking us to wait a moment. Try again shortly.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"der Dienst bittet um etwas Geduld. Versuche es gleich erneut."}},"es":{"stringUnit":{"state":"translated","value":"ha pedido que esperemos un momento. Vuelve a intentarlo dentro de poco."}},"it":{"stringUnit":{"state":"translated","value":"ha chiesto di attendere un momento. Riprova tra poco."}},"fr":{"stringUnit":{"state":"translated","value":"demande de patienter un instant. Réessayez dans quelques instants."}}}},
    "macOS cannot find this copy of the app to start it. Move Witness to your Applications folder and try again.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"macOS kann diese App-Version nicht zum Starten finden. Verschiebe Witness in den Programme-Ordner und versuche es erneut."}},"es":{"stringUnit":{"state":"translated","value":"macOS no encuentra esta copia de la app para abrirla. Mueve Witness a la carpeta Aplicaciones e inténtalo de nuevo."}},"it":{"stringUnit":{"state":"translated","value":"macOS non trova questa copia dell’app. Sposta Witness nella cartella Applicazioni e riprova."}},"fr":{"stringUnit":{"state":"translated","value":"macOS ne trouve pas cette copie de l’app. Déplacez Witness dans le dossier Applications, puis réessayez."}}}},
    "macOS gave an answer this app does not recognize.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"macOS hat eine unbekannte Antwort geliefert."}},"es":{"stringUnit":{"state":"translated","value":"macOS ha dado una respuesta que la app no reconoce."}},"it":{"stringUnit":{"state":"translated","value":"macOS ha fornito una risposta che l’app non riconosce."}},"fr":{"stringUnit":{"state":"translated","value":"macOS a fourni une réponse que l’app ne reconnaît pas."}}}},
    "macOS is holding this off. Open Login Items in System Settings and allow Witness there.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"macOS verhindert dies. Öffne die Anmeldeobjekte in den Systemeinstellungen und erlaube Witness dort."}},"es":{"stringUnit":{"state":"translated","value":"macOS mantiene esta opción desactivada. Abre Ítems de inicio en Ajustes del Sistema y permite Witness allí."}},"it":{"stringUnit":{"state":"translated","value":"macOS mantiene questa opzione disattivata. Apri Elementi login in Impostazioni di Sistema e autorizza Witness."}},"fr":{"stringUnit":{"state":"translated","value":"macOS maintient cette option désactivée. Ouvrez Éléments d’ouverture dans Réglages Système et autorisez Witness."}}}},
    "macOS refused: %@ A build running from Xcode cannot open at login — move Witness to your Applications folder and open it from there.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"macOS hat abgelehnt: %@ Eine aus Xcode gestartete Version kann nicht automatisch geöffnet werden. Verschiebe Witness in den Programme-Ordner und starte es dort."}},"es":{"stringUnit":{"state":"translated","value":"macOS lo ha rechazado: %@ Una compilación ejecutada desde Xcode no puede abrirse al iniciar sesión; mueve Witness a la carpeta Aplicaciones y ábrelo desde allí."}},"it":{"stringUnit":{"state":"translated","value":"macOS ha rifiutato: %@ Una build eseguita da Xcode non può aprirsi all’accesso; sposta Witness nella cartella Applicazioni e aprilo da lì."}},"fr":{"stringUnit":{"state":"translated","value":"macOS a refusé : %@ Une version exécutée depuis Xcode ne peut pas s’ouvrir à la connexion ; déplacez Witness dans le dossier Applications et ouvrez-le depuis cet emplacement."}}}},
    "registration failed (OSStatus %d)": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Registrierung fehlgeschlagen (OSStatus %d)"}},"es":{"stringUnit":{"state":"translated","value":"no se ha podido registrar (OSStatus %d)"}},"it":{"stringUnit":{"state":"translated","value":"registrazione non riuscita (OSStatus %d)"}},"fr":{"stringUnit":{"state":"translated","value":"échec de l’enregistrement (OSStatus %d)"}}}},
    "the event handler could not be installed (OSStatus %d)": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"der Ereignishandler konnte nicht installiert werden (OSStatus %d)"}},"es":{"stringUnit":{"state":"translated","value":"no se ha podido instalar el controlador de eventos (OSStatus %d)"}},"it":{"stringUnit":{"state":"translated","value":"impossibile installare il gestore degli eventi (OSStatus %d)"}},"fr":{"stringUnit":{"state":"translated","value":"impossible d’installer le gestionnaire d’événements (OSStatus %d)"}}}},
    "the reply was not an HTTP response": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"die Antwort war keine HTTP-Antwort"}},"es":{"stringUnit":{"state":"translated","value":"la respuesta recibida no era una respuesta HTTP"}},"it":{"stringUnit":{"state":"translated","value":"la risposta ricevuta non era una risposta HTTP"}},"fr":{"stringUnit":{"state":"translated","value":"la réponse reçue n’était pas une réponse HTTP"}}}},
    "Audio stays in memory on this Mac. Nothing is written to disk during normal capture, and nothing you dictate is ever sent anywhere. A recording is discarded as soon as the app decides no review is needed, and otherwise when the review ends.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audio bleibt im Arbeitsspeicher dieses Macs. Bei einer normalen Aufnahme wird nichts auf die Festplatte geschrieben und keine Diktatinhalte werden versendet. Die Aufnahme wird gelöscht, sobald keine Überprüfung nötig ist – andernfalls nach Abschluss der Überprüfung."}},"es":{"stringUnit":{"state":"translated","value":"El audio permanece en la memoria de este Mac. Durante una grabación normal no se escribe nada en el disco y nada de lo que dictas se envía a ningún sitio. La grabación se descarta en cuanto la app determina que no necesita revisión o, si la necesita, cuando termina la revisión."}},"it":{"stringUnit":{"state":"translated","value":"L’audio resta nella memoria di questo Mac. Durante la registrazione normale non viene scritto nulla su disco e nulla di ciò che detti viene mai inviato altrove. La registrazione viene eliminata non appena l’app stabilisce che non serve una verifica oppure, se serve, al termine della verifica."}},"fr":{"stringUnit":{"state":"translated","value":"L’audio reste dans la mémoire de ce Mac. Rien n’est écrit sur le disque pendant l’enregistrement normal et rien de ce que vous dictez n’est jamais envoyé. L’enregistrement est supprimé dès que l’app détermine qu’aucune vérification n’est nécessaire ou, dans le cas contraire, à la fin de la vérification."}}}},
    "On, the app says when it was installed, when the speech model starts arriving and whether it arrived, when a press finds it still arriving, when the microphone is refused, when a trial starts, when it asks for an email, and when it puts the offers on screen — with the app version, the macOS version, and a random number made at install that is not derived from this Mac. The six about setup are sent once for this installation and never again. That is the whole message, and nothing in it is about what you said. Off, it sends none of them and nothing else changes.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wenn aktiviert, meldet die App die Installation, den Beginn des Sprachmodell-Downloads und ob er geklappt hat, einen Tastendruck, der noch auf das Warten trifft, ein abgelehntes Mikrofon, den Start der Testphase, die Abfrage der E-Mail-Adresse und das Anzeigen der Angebote – zusammen mit App-Version, macOS-Version und einer zufälligen Installationskennung. Die sechs Ereignisse zur Einrichtung werden pro Installation genau einmal gesendet. Weitere Felder oder Diktatinhalte werden nicht gesendet. Wenn deaktiviert, werden auch diese Ereignisse nicht gesendet."}},"es":{"stringUnit":{"state":"translated","value":"Cuando esta opción está activada, Witness envía eventos al instalarse, al iniciar y terminar la descarga del modelo —o si falla—, al intentar dictar mientras todavía se descarga, si se deniega el micrófono, al comenzar la prueba, al solicitar el correo electrónico y al mostrar las ofertas. Solo incluyen la versión de la app, la versión de macOS y un identificador aleatorio creado al instalar que no procede de este Mac. Los seis eventos de configuración se envían una sola vez por instalación. No se envía nada sobre lo que has dicho. Si desactivas la opción, no se envía ninguno de estos eventos y nada más cambia."}},"it":{"stringUnit":{"state":"translated","value":"Quando questa opzione è attiva, Witness invia eventi al momento dell’installazione, all’avvio e al termine del download del modello —o in caso di errore—, quando provi a dettare mentre il download è ancora in corso, se l’accesso al microfono viene negato, all’inizio della prova, alla richiesta dell’indirizzo email e quando vengono mostrate le offerte. Gli eventi includono solo la versione dell’app, la versione di macOS e un identificatore casuale creato all’installazione che non deriva da questo Mac. I sei eventi di configurazione vengono inviati una sola volta per installazione. Non viene inviato nulla su ciò che hai detto. Se disattivi l’opzione, nessuno di questi eventi viene inviato e non cambia nient’altro."}},"fr":{"stringUnit":{"state":"translated","value":"Lorsque cette option est activée, Witness envoie des événements lors de l’installation, au début et à la fin du téléchargement du modèle —ou en cas d’échec—, lorsque vous tentez de dicter pendant le téléchargement, si l’accès au microphone est refusé, au début de l’essai, lors de la demande de l’adresse e-mail et à l’affichage des offres. Ces événements contiennent uniquement la version de l’app, la version de macOS et un identifiant aléatoire créé lors de l’installation qui ne provient pas de ce Mac. Les six événements de configuration ne sont envoyés qu’une seule fois par installation. Rien de ce que vous avez dit n’est envoyé. Si vous désactivez l’option, aucun de ces événements n’est envoyé et rien d’autre ne change."}}}},
    "On, a result with nothing worth checking goes straight into the application you were typing in. Off, it waits in this menu for an explicit insert. A result that does need review always waits for you either way.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wenn aktiviert, wird ein Ergebnis ohne Prüfhinweise direkt in die zuvor verwendete App eingefügt. Wenn deaktiviert, wartet es in diesem Menü auf dein Einfügen. Ergebnisse mit Prüfhinweisen warten immer auf dich."}},"es":{"stringUnit":{"state":"translated","value":"Si está activado, un resultado sin nada que revisar se inserta directamente en la aplicación donde estabas escribiendo. Si está desactivado, espera en este menú hasta que lo insertes. Un resultado que necesita revisión siempre espera tu decisión."}},"it":{"stringUnit":{"state":"translated","value":"Se attiva, un risultato senza elementi da verificare viene inserito direttamente nell’applicazione in cui stavi scrivendo. Se disattiva, resta in questo menu finché non lo inserisci. Un risultato che richiede una verifica attende sempre la tua decisione."}},"fr":{"stringUnit":{"state":"translated","value":"Lorsque cette option est activée, un résultat sans élément à vérifier est inséré directement dans l’application où vous écriviez. Lorsqu’elle est désactivée, il reste dans ce menu jusqu’à votre demande d’insertion. Un résultat à vérifier attend toujours votre décision."}}}},
    "Without Accessibility access the text is copied to the clipboard instead. A development build loses this permission on every rebuild, because macOS keys it to the code signature.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ohne Bedienungshilfen-Zugriff wird der Text stattdessen in die Zwischenablage kopiert. Eine Entwicklungs-Version verliert diese Berechtigung nach jeder neuen Signatur."}},"es":{"stringUnit":{"state":"translated","value":"Sin acceso a Accesibilidad, el texto se copia al portapapeles. Una compilación de desarrollo pierde este permiso con cada recompilación porque macOS lo vincula a la firma del código."}},"it":{"stringUnit":{"state":"translated","value":"Senza l’accesso ad Accessibilità, il testo viene copiato negli appunti. Una build di sviluppo perde questa autorizzazione a ogni ricompilazione perché macOS la lega alla firma del codice."}},"fr":{"stringUnit":{"state":"translated","value":"Sans accès à Accessibilité, le texte est copié dans le presse-papiers. Une version de développement perd cette autorisation à chaque recompilation, car macOS la lie à la signature du code."}}}},
    "The review step appears only when a fragment is worth checking — an amount, a date, a name, a dictionary near-miss, or a word the app removed. When nothing is marked, the text is simply ready and the recording is discarded immediately.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Überprüfung erscheint nur für Stellen, die du prüfen solltest – etwa Beträge, Daten, Namen, ähnliche Wörterbucheinträge oder entfernte Wörter. Wenn nichts markiert ist, ist der Text sofort fertig und die Aufnahme wird verworfen."}},"es":{"stringUnit":{"state":"translated","value":"La revisión solo aparece cuando conviene comprobar un fragmento: un importe, una fecha, un nombre, una coincidencia aproximada del diccionario o una palabra eliminada por la app. Si no se marca nada, el texto queda listo y la grabación se descarta inmediatamente."}},"it":{"stringUnit":{"state":"translated","value":"La verifica appare solo quando vale la pena controllare un frammento: un importo, una data, un nome, una corrispondenza simile nel dizionario o una parola rimossa dall’app. Se non viene segnalato nulla, il testo è semplicemente pronto e la registrazione viene eliminata immediatamente."}},"fr":{"stringUnit":{"state":"translated","value":"La vérification apparaît uniquement lorsqu’un fragment mérite d’être contrôlé : un montant, une date, un nom, une correspondance proche du dictionnaire ou un mot supprimé par l’app. Si rien n’est signalé, le texte est simplement prêt et l’enregistrement est immédiatement supprimé."}}}},
    "Phase 6 adds the trial, activation, and licensing. Dictation itself is unchanged: the words still go straight into the application you were typing in, and everything about them still stays on this Mac.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Phase 6 ergänzt Testphase, Aktivierung und Lizenzierung. Das Diktieren bleibt unverändert: Der Text gelangt direkt in die zuvor verwendete App und alle Inhalte bleiben auf diesem Mac."}},"es":{"stringUnit":{"state":"translated","value":"La prueba, la activación y la licencia no cambian el dictado: el texto sigue apareciendo directamente en la aplicación donde estabas escribiendo y todo su contenido permanece en este Mac."}},"it":{"stringUnit":{"state":"translated","value":"Il periodo di prova, l’attivazione e la licenza non cambiano la dettatura: il testo continua ad apparire direttamente nell’app in cui stavi scrivendo e tutto il suo contenuto resta su questo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"L’essai, l’activation et la licence ne changent rien à la dictée : le texte apparaît toujours directement dans l’app où vous écriviez et tout son contenu reste sur ce Mac."}}}},
    "Trailing silence is reported, never used to trim captured speech. Changes apply to the next recording. These thresholds are the one thing in Settings that is not written to disk — they are tuning, and they start from the defaults on every launch.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Stille am Ende wird nur gemeldet und niemals zum Kürzen der Sprache verwendet. Änderungen gelten ab der nächsten Aufnahme. Diese Schwellenwerte werden nicht gespeichert und bei jedem Start auf die Standardwerte gesetzt."}},"es":{"stringUnit":{"state":"translated","value":"El silencio final se muestra, pero nunca se usa para recortar el audio capturado. Los cambios se aplican a la siguiente grabación. Estos umbrales son el único ajuste que no se guarda en el disco: sirven para afinar el funcionamiento y vuelven a los valores predeterminados cada vez que se abre la app."}},"it":{"stringUnit":{"state":"translated","value":"Il silenzio finale viene segnalato, ma non viene mai usato per tagliare l’audio acquisito. Le modifiche si applicano alla registrazione successiva. Queste soglie sono l’unica impostazione che non viene salvata su disco: servono per la regolazione e tornano ai valori predefiniti a ogni avvio."}},"fr":{"stringUnit":{"state":"translated","value":"Le silence final est signalé, mais ne sert jamais à raccourcir l’audio capturé. Les modifications s’appliquent à l’enregistrement suivant. Ces seuils sont le seul réglage qui n’est pas enregistré sur le disque : ils servent à l’ajustement et reprennent leurs valeurs par défaut à chaque lancement."}}}},
    "The method and the application, which is what anyone asks first when an app misbehaves. The inserted text appears nowhere in here and in no log line.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gespeichert werden nur die Methode und die Ziel-App – die wichtigsten Angaben bei einer Fehlersuche. Der eingefügte Text erscheint weder hier noch in einem Protokoll."}},"es":{"stringUnit":{"state":"translated","value":"El método y la aplicación: lo primero que cualquiera quiere saber cuando una app falla. El texto insertado no aparece aquí ni en ninguna línea de registro."}},"it":{"stringUnit":{"state":"translated","value":"Il metodo e l’applicazione: le prime cose che chiunque vuole sapere quando un’app non funziona correttamente. Il testo inserito non compare qui né in alcuna riga di log."}},"fr":{"stringUnit":{"state":"translated","value":"La méthode et l’application : les premières informations demandées lorsqu’une app fonctionne mal. Le texte inséré n’apparaît ni ici ni dans aucune ligne de journal."}}}},
    "A recording is held only while a review can still use it. Zero here means the app is no longer holding the last utterance.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Eine Aufnahme bleibt nur so lange erhalten, wie sie für eine Überprüfung gebraucht wird. Null bedeutet, dass die letzte Äußerung nicht mehr im Speicher liegt."}},"es":{"stringUnit":{"state":"translated","value":"Una grabación solo se conserva mientras pueda usarse en una revisión. Un cero indica que la app ya no conserva la última grabación."}},"it":{"stringUnit":{"state":"translated","value":"Una registrazione viene conservata solo finché può ancora servire per una revisione. Uno zero indica che l’app non conserva più l’ultima registrazione."}},"fr":{"stringUnit":{"state":"translated","value":"Un enregistrement n’est conservé que tant qu’il peut encore servir à une vérification. Un zéro indique que l’app ne conserve plus le dernier enregistrement."}}}},
    "Debug builds only. Writes a file solely to the location you choose in the save panel; normal capture never touches the file system.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nur für Debug-Versionen. Eine Datei wird ausschließlich am im Speicherdialog gewählten Ort geschrieben; normale Aufnahmen greifen nicht auf das Dateisystem zu."}},"es":{"stringUnit":{"state":"translated","value":"Solo en compilaciones de depuración. Escribe un archivo únicamente en la ubicación que elijas en el panel de guardado; la captura normal nunca accede al sistema de archivos."}},"it":{"stringUnit":{"state":"translated","value":"Solo nelle build di debug. Scrive un file esclusivamente nella posizione scelta nel pannello di salvataggio; la normale acquisizione non accede mai al file system."}},"fr":{"stringUnit":{"state":"translated","value":"Uniquement dans les versions de débogage. Écrit un fichier seulement à l’emplacement choisi dans la fenêtre d’enregistrement ; la capture normale n’accède jamais au système de fichiers."}}}},
    "Selecting more languages costs nothing on a sentence the engine can hear clearly. It costs on the short ones: two words in Russian and two in Ukrainian look much alike, and the more languages are in play the more often one of those lands in the wrong one.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bei klar erkennbaren Sätzen schaden zusätzliche Sprachen nicht. Bei kurzen Äußerungen können sich beispielsweise russische und ukrainische Wörter ähneln; je mehr Sprachen ausgewählt sind, desto eher wird eine davon verwechselt."}},"es":{"stringUnit":{"state":"translated","value":"Seleccionar más idiomas no afecta a una frase que el motor oye con claridad. Sí afecta a las frases cortas: dos palabras en ruso y dos en ucraniano pueden parecerse mucho, y cuantos más idiomas estén activos, más probable será elegir el incorrecto."}},"it":{"stringUnit":{"state":"translated","value":"Selezionare più lingue non penalizza una frase che il motore sente chiaramente. Incide invece sulle frasi brevi: due parole in russo e due in ucraino possono somigliarsi molto, e più lingue sono attive, più spesso verrà scelta quella sbagliata."}},"fr":{"stringUnit":{"state":"translated","value":"Sélectionner davantage de langues n’affecte pas une phrase clairement entendue par le moteur. Cela compte pour les phrases courtes : deux mots en russe et deux en ukrainien peuvent se ressembler, et plus il y a de langues actives, plus le risque de choisir la mauvaise augmente."}}}},
    "A word that comes out close to one of your terms, but not equal to it, is marked for review. An exact match is not: it came out right.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ein erkanntes Wort, das einem deiner Begriffe ähnelt, aber nicht exakt entspricht, wird zur Überprüfung markiert. Ein exakter Treffer nicht – er wurde korrekt erkannt."}},"es":{"stringUnit":{"state":"translated","value":"Si una palabra se parece a uno de tus términos pero no coincide exactamente, Witness la marca para que la revises. Las coincidencias exactas no se marcan: ya están bien reconocidas."}},"it":{"stringUnit":{"state":"translated","value":"Se una parola è simile a uno dei tuoi termini ma non coincide esattamente, Witness la segnala per la verifica. Le corrispondenze esatte non vengono segnalate: sono già state riconosciute correttamente."}},"fr":{"stringUnit":{"state":"translated","value":"Lorsqu’un mot ressemble à l’un de vos termes sans correspondre exactement, Witness le signale pour vérification. Une correspondance exacte n’est pas signalée : elle a été correctement reconnue."}}}},
    "No terms yet. Add the names and words you dictate often and would notice being wrong.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Noch keine Begriffe. Füge Namen und Wörter hinzu, die du häufig diktierst und deren falsche Erkennung dir auffallen würde."}},"es":{"stringUnit":{"state":"translated","value":"Todavía no hay términos. Añade los nombres y palabras que dictas a menudo y cuyos errores notarías."}},"it":{"stringUnit":{"state":"translated","value":"Non ci sono ancora termini. Aggiungi i nomi e le parole che detti spesso e di cui noteresti un errore."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun terme pour le moment. Ajoutez les noms et les mots que vous dictez souvent et dont vous remarqueriez une erreur."}}}},
    "This file is the only thing the app persists. Transcripts and recordings stay in memory.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nur diese Datei wird dauerhaft gespeichert. Transkripte und Aufnahmen bleiben im Arbeitsspeicher."}},"es":{"stringUnit":{"state":"translated","value":"Este archivo es lo único que la app guarda de forma persistente. Las transcripciones y grabaciones permanecen en memoria."}},"it":{"stringUnit":{"state":"translated","value":"Questo file è l’unica cosa che l’app conserva in modo permanente. Trascrizioni e registrazioni restano in memoria."}},"fr":{"stringUnit":{"state":"translated","value":"Ce fichier est la seule chose conservée durablement par l’app. Les transcriptions et les enregistrements restent en mémoire."}}}},
    "The shortcut is not registered, so the hotkey does nothing. Pick another combination.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Tastenkürzel ist nicht registriert und hat daher keine Wirkung. Wähle eine andere Kombination."}},"es":{"stringUnit":{"state":"translated","value":"El atajo no está registrado y no responde. Elige otra combinación."}},"it":{"stringUnit":{"state":"translated","value":"La scorciatoia non è registrata e non funziona. Scegli un’altra combinazione."}},"fr":{"stringUnit":{"state":"translated","value":"Le raccourci n’est pas enregistré et ne fonctionne pas. Choisissez une autre combinaison."}}}},
    "At least one of ⌘ ⌥ ⌃ ⇧ is required. A bare key would be taken away from every application on this Mac.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mindestens eine der Tasten ⌘ ⌥ ⌃ ⇧ ist erforderlich. Eine einzelne Taste würde in allen Apps dieses Macs blockiert."}},"es":{"stringUnit":{"state":"translated","value":"Se necesita al menos una tecla entre ⌘ ⌥ ⌃ ⇧. Una tecla sola dejaría de estar disponible en todas las aplicaciones de este Mac."}},"it":{"stringUnit":{"state":"translated","value":"È necessario almeno un tasto tra ⌘ ⌥ ⌃ ⇧. Un tasto senza modificatori verrebbe sottratto a tutte le applicazioni di questo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Au moins une touche parmi ⌘ ⌥ ⌃ ⇧ est requise. Une touche seule ne serait plus disponible dans les autres applications de ce Mac."}}}},
    "An app with no Dock icon is one nobody remembers to open, and a hotkey belonging to an app that is not running reads as a broken hotkey.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Eine App ohne Dock-Symbol wird leicht vergessen. Deshalb sollte Witness beim Anmelden starten, damit das Tastenkürzel immer funktioniert."}},"es":{"stringUnit":{"state":"translated","value":"Una app sin icono en el Dock es fácil de olvidar; si no está abierta, su atajo parece estar roto."}},"it":{"stringUnit":{"state":"translated","value":"Un’app senza icona nel Dock è facile da dimenticare; se non è in esecuzione, la sua scorciatoia sembra non funzionare."}},"fr":{"stringUnit":{"state":"translated","value":"Une app sans icône dans le Dock est facile à oublier ; si elle n’est pas ouverte, son raccourci semble ne pas fonctionner."}}}},
    "Witness needs Accessibility access to put text into other applications. Without it, results go to the clipboard.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Witness benötigt Bedienungshilfen-Zugriff, um Text in andere Apps einzufügen. Ohne diesen Zugriff werden Ergebnisse in die Zwischenablage kopiert."}},"es":{"stringUnit":{"state":"translated","value":"Witness necesita acceso a Accesibilidad para insertar texto en otras aplicaciones. Sin este permiso, los resultados se copian al portapapeles."}},"it":{"stringUnit":{"state":"translated","value":"Witness ha bisogno dell’accesso ad Accessibilità per inserire il testo in altre applicazioni. Senza questa autorizzazione, i risultati vengono copiati negli appunti."}},"fr":{"stringUnit":{"state":"translated","value":"Witness a besoin de l’accès à Accessibilité pour insérer du texte dans d’autres applications. Sans cette autorisation, les résultats sont copiés dans le presse-papiers."}}}},
    "Checkout is not open yet. When it is, these buttons hand the purchase to Stripe in your browser — the app never sees a card number.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Checkout ist noch nicht geöffnet. Sobald er verfügbar ist, übergeben diese Tasten den Kauf im Browser an Stripe; die App sieht niemals eine Kartennummer."}},"es":{"stringUnit":{"state":"translated","value":"El pago aún no está disponible. Cuando lo esté, estos botones abrirán Stripe en tu navegador; la app nunca verá el número de tu tarjeta."}},"it":{"stringUnit":{"state":"translated","value":"Il pagamento non è ancora disponibile. Quando lo sarà, questi pulsanti apriranno Stripe nel browser; l’app non vedrà mai il numero della carta."}},"fr":{"stringUnit":{"state":"translated","value":"Le paiement n’est pas encore disponible. Lorsqu’il le sera, ces boutons ouvriront Stripe dans votre navigateur ; l’app ne verra jamais votre numéro de carte."}}}},
    "Checkout is not open yet. When it is, these buttons open the payment page in your browser — the app never sees a card number, and the key still comes back here, to this Mac.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Checkout ist noch nicht geöffnet. Sobald er verfügbar ist, öffnen diese Tasten die Zahlungsseite im Browser. Die App sieht niemals eine Kartennummer; der Schlüssel gelangt direkt zurück auf diesen Mac."}},"es":{"stringUnit":{"state":"translated","value":"El pago aún no está disponible. Cuando lo esté, estos botones abrirán la página de pago en tu navegador; la app nunca verá el número de tu tarjeta y la clave volverá directamente a este Mac."}},"it":{"stringUnit":{"state":"translated","value":"Il pagamento non è ancora disponibile. Quando lo sarà, questi pulsanti apriranno la pagina di pagamento nel browser; l’app non vedrà mai il numero della carta e la chiave tornerà direttamente su questo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Le paiement n’est pas encore disponible. Lorsqu’il le sera, ces boutons ouvriront la page de paiement dans votre navigateur ; l’app ne verra jamais votre numéro de carte et la clé reviendra directement sur ce Mac."}}}},
    "The identifier is a one-way hash of this Mac's hardware UUID. It is what makes a license cover two Macs rather than any number of them, and it cannot be turned back into a serial number or matched against anything outside this app.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Kennung ist ein nicht umkehrbarer Hash der Hardware-UUID dieses Macs. So kann eine Lizenz auf zwei Macs begrenzt werden. Die Kennung lässt sich weder in eine Seriennummer zurückverwandeln noch außerhalb dieser App abgleichen."}},"es":{"stringUnit":{"state":"translated","value":"El identificador es un hash unidireccional del UUID de hardware de este Mac. Permite limitar la licencia a dos Mac; no puede convertirse de nuevo en un número de serie ni vincularse con nada fuera de esta app."}},"it":{"stringUnit":{"state":"translated","value":"L’identificatore è un hash unidirezionale dell’UUID hardware di questo Mac. Consente di limitare la licenza a due Mac; non può essere riconvertito in un numero di serie né associato a elementi esterni all’app."}},"fr":{"stringUnit":{"state":"translated","value":"L’identifiant est un hachage à sens unique de l’UUID matériel de ce Mac. Il permet de limiter la licence à deux Mac ; il ne peut pas être reconverti en numéro de série ni associé à quoi que ce soit en dehors de l’app."}}}},
    "This is a development build: it carries no authority key, so no license can verify here. Only the ungated window applies.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dies ist eine Entwicklungs-Version ohne öffentlichen Lizenzschlüssel. Deshalb kann hier keine Lizenz geprüft werden; nur der lizenzfreie Zeitraum gilt."}},"es":{"stringUnit":{"state":"translated","value":"Esta es una compilación de desarrollo: no contiene una clave de autoridad, por lo que no puede verificar licencias. Solo se aplica el periodo sin licencia."}},"it":{"stringUnit":{"state":"translated","value":"Questa è una build di sviluppo: non contiene una chiave dell’autorità, quindi non può verificare alcuna licenza. Si applica solo il periodo senza licenza."}},"fr":{"stringUnit":{"state":"translated","value":"Il s’agit d’une version de développement : elle ne contient aucune clé d’autorité et ne peut donc vérifier aucune licence. Seule la période sans licence s’applique."}}}},
    "Send my license key as soon as I have paid. I understand that I give up my right of withdrawal once delivery begins.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sende meinen Lizenzschlüssel sofort nach der Zahlung. Mir ist bewusst, dass mein Widerrufsrecht mit Beginn der Lieferung erlischt."}}}},
    "OK": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"OK"}},"es":{"stringUnit":{"state":"translated","value":"Aceptar"}},"it":{"stringUnit":{"state":"translated","value":"OK"}},"fr":{"stringUnit":{"state":"translated","value":"OK"}}}},
    "Getting the speech model": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprachmodell wird geladen"}},"es":{"stringUnit":{"state":"translated","value":"Descargando el modelo de voz"}},"it":{"stringUnit":{"state":"translated","value":"Download del modello vocale"}},"fr":{"stringUnit":{"state":"translated","value":"Téléchargement du modèle vocal"}}}},
    "Removing…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wird entfernt …"}},"es":{"stringUnit":{"state":"translated","value":"Eliminando…"}},"it":{"stringUnit":{"state":"translated","value":"Rimozione…"}},"fr":{"stringUnit":{"state":"translated","value":"Suppression…"}}}},
    "Open Witness when I log in": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Witness beim Anmelden öffnen"}},"es":{"stringUnit":{"state":"translated","value":"Abrir Witness al iniciar sesión"}},"it":{"stringUnit":{"state":"translated","value":"Apri Witness all’accesso"}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrir Witness à l’ouverture de session"}}}},
    "The hotkey only works while Witness is running, and it has no Dock icon. Without this, a restart leaves the hotkey silent until you open the app again.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Hotkey funktioniert nur, solange Witness läuft, und die App hat kein Dock-Symbol. Ohne diese Option bleibt der Hotkey nach einem Neustart stumm, bis du die App erneut öffnest."}},"es":{"stringUnit":{"state":"translated","value":"El atajo solo funciona mientras Witness está abierto y la app no tiene icono en el Dock. Sin esta opción, después de reiniciar el atajo no responderá hasta que vuelvas a abrir la app."}},"it":{"stringUnit":{"state":"translated","value":"La scorciatoia funziona solo mentre Witness è in esecuzione e l’app non ha un’icona nel Dock. Senza questa opzione, dopo un riavvio la scorciatoia non risponde finché non riapri l’app."}},"fr":{"stringUnit":{"state":"translated","value":"Le raccourci fonctionne uniquement lorsque Witness est ouvert, et l’app n’a pas d’icône dans le Dock. Sans cette option, après un redémarrage, le raccourci reste inactif jusqu’à ce que vous rouvriez l’app."}}}},
    "Remove from this Mac": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Von diesem Mac entfernen"}},"es":{"stringUnit":{"state":"translated","value":"Eliminar de este Mac"}},"it":{"stringUnit":{"state":"translated","value":"Rimuovi da questo Mac"}},"fr":{"stringUnit":{"state":"translated","value":"Supprimer de ce Mac"}}}},
    "Continue with your email": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mit deiner E-Mail fortfahren"}},"es":{"stringUnit":{"state":"translated","value":"Continuar con tu correo electrónico"}},"it":{"stringUnit":{"state":"translated","value":"Continua con il tuo indirizzo email"}},"fr":{"stringUnit":{"state":"translated","value":"Continuer avec votre adresse e-mail"}}}},
    "The key comes straight back here and unlocks the app — there is nothing to fetch from your mail and nothing to paste. The address and an identifier for this Mac are the only things sent: when you press the button, and, for a subscription, about once a month to renew its key. No audio, no text, and nothing from your dictionary ever leaves this Mac.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Schlüssel kommt direkt hierher zurück und schaltet die App frei – du musst nichts aus deinem Postfach holen und nichts einfügen. Gesendet werden nur die Adresse und eine Kennung dieses Macs: wenn du die Taste drückst und bei einem Abonnement etwa einmal im Monat, um den Schlüssel zu erneuern. Kein Audio, kein Text und nichts aus deinem Wörterbuch verlässt jemals diesen Mac."}},"es":{"stringUnit":{"state":"translated","value":"La clave vuelve directamente aquí y desbloquea la app: no tienes que buscar nada en tu correo ni pegar nada. Solo se envían la dirección y un identificador de este Mac al pulsar el botón y, si hay una suscripción, aproximadamente una vez al mes para renovar la clave. Ningún audio, texto ni contenido de tu diccionario sale de este Mac."}},"it":{"stringUnit":{"state":"translated","value":"La chiave torna direttamente qui e sblocca l’app: non devi recuperare nulla dall’email né incollare nulla. Vengono inviati solo l’indirizzo e un identificatore di questo Mac quando premi il pulsante e, per un abbonamento, circa una volta al mese per rinnovare la chiave. Audio, testo e dizionario non lasciano mai questo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"La clé revient directement ici et déverrouille l’app : vous n’avez rien à récupérer dans vos e-mails ni à coller. Seuls l’adresse et un identifiant de ce Mac sont envoyés lorsque vous appuyez sur le bouton et, pour un abonnement, environ une fois par mois afin de renouveler la clé. Aucun audio, aucun texte ni aucun élément de votre dictionnaire ne quitte ce Mac."}}}},
    "The address you bought with fetches a key for this Mac. It and an identifier for this Mac are the only things sent: when you press the button, and, for a subscription, about once a month to renew its key. No audio, no text, and nothing from your dictionary.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mit der Adresse, mit der du gekauft hast, holst du einen Schlüssel für diesen Mac. Gesendet werden nur sie und eine Kennung dieses Macs: wenn du die Taste drückst und bei einem Abonnement etwa einmal im Monat, um den Schlüssel zu erneuern. Kein Audio, kein Text und nichts aus deinem Wörterbuch."}},"es":{"stringUnit":{"state":"translated","value":"La dirección con la que compraste obtiene una clave para este Mac. Solo se envían esa dirección y un identificador de este Mac al pulsar el botón y, si hay una suscripción, aproximadamente una vez al mes para renovar la clave. No se envían audio, texto ni datos de tu diccionario."}},"it":{"stringUnit":{"state":"translated","value":"L’indirizzo usato per l’acquisto recupera una chiave per questo Mac. Vengono inviati solo quell’indirizzo e un identificatore di questo Mac quando premi il pulsante e, per un abbonamento, circa una volta al mese per rinnovare la chiave. Non vengono inviati audio, testo o dati del dizionario."}},"fr":{"stringUnit":{"state":"translated","value":"L’adresse utilisée pour l’achat récupère une clé pour ce Mac. Seuls cette adresse et un identifiant de ce Mac sont envoyés lorsque vous appuyez sur le bouton et, pour un abonnement, environ une fois par mois afin de renouveler la clé. Aucun audio, aucun texte ni aucun élément du dictionnaire n’est envoyé."}}}},
    "Ready to use": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bereit zum Diktieren"}},"es":{"stringUnit":{"state":"translated","value":"Listo para usar"}},"it":{"stringUnit":{"state":"translated","value":"Pronto all’uso"}},"fr":{"stringUnit":{"state":"translated","value":"Prêt à l’emploi"}}}},
    "Witness asks for nothing until %@. After that it asks for your email address, to carry on.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bis zum %@ fragt Witness nach nichts. Danach bittet es um deine E-Mail-Adresse, damit du weiterdiktieren kannst."}},"es":{"stringUnit":{"state":"translated","value":"Witness no te pedirá nada hasta el %@. Después te pedirá tu correo electrónico para continuar."}},"it":{"stringUnit":{"state":"translated","value":"Witness non ti chiederà nulla fino al %@. In seguito ti chiederà l’indirizzo email per continuare."}},"fr":{"stringUnit":{"state":"translated","value":"Witness ne vous demandera rien avant le %@. Il vous demandera ensuite votre adresse e-mail pour continuer."}}}},
    "The first three days need no email and no key. After that, Witness asks for your email address, to carry on.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die ersten drei Tage brauchen weder E-Mail noch Schlüssel. Danach bittet Witness um deine E-Mail-Adresse, damit du weiterdiktieren kannst."}},"es":{"stringUnit":{"state":"translated","value":"Durante los tres primeros días no necesitas correo electrónico ni clave. Después, Witness te pedirá tu correo para continuar."}},"it":{"stringUnit":{"state":"translated","value":"Per i primi tre giorni non servono né un indirizzo email né una chiave. In seguito Witness ti chiederà l’indirizzo email per continuare."}},"fr":{"stringUnit":{"state":"translated","value":"Pendant les trois premiers jours, vous n’avez besoin ni d’adresse e-mail ni de clé. Witness vous demandera ensuite votre adresse e-mail pour continuer."}}}},
    "Annual subscription": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Jahresabonnement"}},"es":{"stringUnit":{"state":"translated","value":"Suscripción anual"}},"it":{"stringUnit":{"state":"translated","value":"Abbonamento annuale"}},"fr":{"stringUnit":{"state":"translated","value":"Abonnement annuel"}}}},
    "Licensed to %@. It renews by itself while the subscription runs, and Witness picks up its new key in the background. You can manage or cancel it any time.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Lizenziert für %@. Es verlängert sich von selbst, solange das Abonnement läuft, und Witness holt den neuen Schlüssel im Hintergrund. Du kannst es jederzeit verwalten oder kündigen."}},"es":{"stringUnit":{"state":"translated","value":"Licencia de %@. Se renueva automáticamente mientras la suscripción esté activa y Witness obtiene la nueva clave en segundo plano. Puedes gestionarla o cancelarla en cualquier momento."}},"it":{"stringUnit":{"state":"translated","value":"Licenza di %@. Si rinnova automaticamente finché l’abbonamento è attivo e Witness recupera la nuova chiave in background. Puoi gestirlo o annullarlo in qualsiasi momento."}},"fr":{"stringUnit":{"state":"translated","value":"Licence de %@. Elle se renouvelle automatiquement tant que l’abonnement est actif et Witness récupère la nouvelle clé en arrière-plan. Vous pouvez la gérer ou la résilier à tout moment."}}}},
    "The first three days are over. Enter your email address to carry on. No payment is needed at this step, and nothing you have dictated has left this Mac.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die ersten drei Tage sind vorbei. Gib deine E-Mail-Adresse ein, um weiterzumachen. Dafür ist keine Zahlung nötig, und nichts von dem, was du diktiert hast, hat diesen Mac verlassen."}},"es":{"stringUnit":{"state":"translated","value":"Los tres primeros días han terminado. Introduce tu correo electrónico para continuar. No tienes que pagar en este paso y nada de lo que has dictado ha salido de este Mac."}},"it":{"stringUnit":{"state":"translated","value":"I primi tre giorni sono terminati. Inserisci il tuo indirizzo email per continuare. In questo passaggio non devi pagare e nulla di ciò che hai dettato ha lasciato questo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Les trois premiers jours sont terminés. Saisissez votre adresse e-mail pour continuer. Aucun paiement n’est nécessaire à cette étape et rien de ce que vous avez dicté n’a quitté ce Mac."}}}},
    "Subscription not renewed": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Abonnement nicht verlängert"}},"es":{"stringUnit":{"state":"translated","value":"Suscripción no renovada"}},"it":{"stringUnit":{"state":"translated","value":"Abbonamento non rinnovato"}},"fr":{"stringUnit":{"state":"translated","value":"Abonnement non renouvelé"}}}},
    "Witness could not renew its key, and the last one ran out on %@. If a payment did not go through, fix it under Manage subscription, then press the button below. Nothing local was removed.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Witness konnte den Schlüssel nicht erneuern, und der letzte ist am %@ abgelaufen. Falls eine Zahlung nicht durchging, korrigiere sie unter „Abonnement verwalten“ und drücke dann die Taste unten. Lokal wurde nichts entfernt."}},"es":{"stringUnit":{"state":"translated","value":"Witness no ha podido renovar la clave y la anterior caducó el %@. Si un pago ha fallado, corrígelo en Gestionar suscripción y pulsa el botón de abajo. No se ha eliminado nada de este Mac."}},"it":{"stringUnit":{"state":"translated","value":"Witness non è riuscito a rinnovare la chiave e la precedente è scaduta il %@. Se un pagamento non è riuscito, correggilo in Gestisci abbonamento e premi il pulsante qui sotto. Nessun dato locale è stato rimosso."}},"fr":{"stringUnit":{"state":"translated","value":"Witness n’a pas pu renouveler la clé et la précédente a expiré le %@. Si un paiement a échoué, corrigez-le dans Gérer l’abonnement, puis appuyez sur le bouton ci-dessous. Aucune donnée locale n’a été supprimée."}}}},
    "Your annual subscription is on this Mac now. There is nothing else to enter.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Jahresabonnement ist jetzt auf diesem Mac. Du musst nichts weiter eingeben."}},"es":{"stringUnit":{"state":"translated","value":"Tu suscripción anual ya está activa en este Mac. No tienes que introducir nada más."}},"it":{"stringUnit":{"state":"translated","value":"Il tuo abbonamento annuale è ora attivo su questo Mac. Non devi inserire altro."}},"fr":{"stringUnit":{"state":"translated","value":"Votre abonnement annuel est maintenant actif sur ce Mac. Vous n’avez rien d’autre à saisir."}}}},
    "Dictation keeps working until %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Diktieren funktioniert bis zum %@ weiter."}},"es":{"stringUnit":{"state":"translated","value":"El dictado seguirá funcionando hasta el %@."}},"it":{"stringUnit":{"state":"translated","value":"La dettatura continuerà a funzionare fino al %@."}},"fr":{"stringUnit":{"state":"translated","value":"La dictée continuera de fonctionner jusqu’au %@."}}}},
    "Your key ends today": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Schlüssel läuft heute ab"}},"es":{"stringUnit":{"state":"translated","value":"Tu clave caduca hoy"}},"it":{"stringUnit":{"state":"translated","value":"La tua chiave scade oggi"}},"fr":{"stringUnit":{"state":"translated","value":"Votre clé expire aujourd’hui"}}}},
    "Your key ends in %lld days": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Schlüssel läuft in %lld Tagen ab"}},"es":{"stringUnit":{"state":"translated","value":"Tu clave caduca en %lld días"}},"it":{"stringUnit":{"state":"translated","value":"La tua chiave scade tra %lld giorni"}},"fr":{"stringUnit":{"state":"translated","value":"Votre clé expire dans %lld jours"}}}},
    "The key on this Mac runs out on %@, and Witness has not been able to fetch a new one. Open Witness with an internet connection; if a payment did not go through, fix it under Manage subscription.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Schlüssel auf diesem Mac läuft am %@ ab, und Witness konnte keinen neuen holen. Öffne Witness mit Internetverbindung; falls eine Zahlung nicht durchging, korrigiere sie unter „Abonnement verwalten“."}},"es":{"stringUnit":{"state":"translated","value":"La clave de este Mac caduca el %@ y Witness no ha podido obtener una nueva. Abre Witness con conexión a internet; si un pago ha fallado, corrígelo en Gestionar suscripción."}},"it":{"stringUnit":{"state":"translated","value":"La chiave su questo Mac scade il %@ e Witness non è riuscito a ottenerne una nuova. Apri Witness con una connessione internet; se un pagamento non è riuscito, correggilo in Gestisci abbonamento."}},"fr":{"stringUnit":{"state":"translated","value":"La clé de ce Mac expire le %@ et Witness n’a pas pu en récupérer une nouvelle. Ouvrez Witness avec une connexion Internet ; si un paiement a échoué, corrigez-le dans Gérer l’abonnement."}}}},
    "The first three days ask for nothing; they end %@. After that Witness asks for your email address, to carry on.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die ersten drei Tage fragen nach nichts; sie enden am %@. Danach bittet Witness um deine E-Mail-Adresse, damit du weiterdiktieren kannst."}},"es":{"stringUnit":{"state":"translated","value":"Durante los tres primeros días, Witness no te pide nada. Este periodo termina el %@; después te pedirá tu correo electrónico para continuar."}},"it":{"stringUnit":{"state":"translated","value":"Per i primi tre giorni Witness non ti chiede nulla. Il periodo termina il %@; in seguito ti chiederà l’indirizzo email per continuare."}},"fr":{"stringUnit":{"state":"translated","value":"Pendant les trois premiers jours, Witness ne vous demande rien. Cette période se termine le %@ ; il vous demandera ensuite votre adresse e-mail pour continuer."}}}},
    "The first three days are over. Enter your email address under Settings → License to carry on. No payment is needed at this step.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die ersten drei Tage sind vorbei. Gib deine E-Mail-Adresse unter Einstellungen → Lizenz ein, um weiterzumachen. Dafür ist keine Zahlung nötig."}},"es":{"stringUnit":{"state":"translated","value":"Los tres primeros días han terminado. Introduce tu correo electrónico en Ajustes → Licencia para continuar. No tienes que pagar en este paso."}},"it":{"stringUnit":{"state":"translated","value":"I primi tre giorni sono terminati. Inserisci il tuo indirizzo email in Impostazioni → Licenza per continuare. In questo passaggio non devi pagare."}},"fr":{"stringUnit":{"state":"translated","value":"Les trois premiers jours sont terminés. Saisissez votre adresse e-mail dans Réglages → Licence pour continuer. Aucun paiement n’est nécessaire à cette étape."}}}},
    "Witness could not renew its key, and the last one ran out %@. Open Settings → License to put it right.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Witness konnte den Schlüssel nicht erneuern, und der letzte ist am %@ abgelaufen. Öffne Einstellungen → Lizenz, um das zu beheben."}},"es":{"stringUnit":{"state":"translated","value":"Witness no ha podido renovar la clave y la anterior caducó el %@. Abre Ajustes → Licencia para solucionarlo."}},"it":{"stringUnit":{"state":"translated","value":"Witness non è riuscito a rinnovare la chiave e la precedente è scaduta il %@. Apri Impostazioni → Licenza per risolvere il problema."}},"fr":{"stringUnit":{"state":"translated","value":"Witness n’a pas pu renouveler la clé et la précédente a expiré le %@. Ouvrez Réglages → Licence pour résoudre le problème."}}}},
    "The activation service could not be reached: %@. Check your connection and try again.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Aktivierungsdienst war nicht erreichbar: %@. Prüfe deine Verbindung und versuche es erneut."}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido conectar con el servicio de activación: %@. Comprueba la conexión e inténtalo de nuevo."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile contattare il servizio di attivazione: %@. Controlla la connessione e riprova."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de joindre le service d’activation : %@. Vérifiez votre connexion, puis réessayez."}}}},
    "This address has no active subscription. If you subscribed, check the payment under Manage subscription. A subscription that ended or was refunded no longer unlocks Witness.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zu dieser Adresse gibt es kein aktives Abonnement. Falls du abonniert hast, prüfe die Zahlung unter „Abonnement verwalten“. Ein beendetes oder erstattetes Abonnement schaltet Witness nicht mehr frei."}},"es":{"stringUnit":{"state":"translated","value":"No hay ninguna suscripción activa para esta dirección. Si te has suscrito, comprueba el pago en Gestionar suscripción. Una suscripción finalizada o reembolsada ya no desbloquea Witness."}},"it":{"stringUnit":{"state":"translated","value":"Non risulta alcun abbonamento attivo per questo indirizzo. Se ti sei abbonato, controlla il pagamento in Gestisci abbonamento. Un abbonamento terminato o rimborsato non sblocca più Witness."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun abonnement actif n’est associé à cette adresse. Si vous vous êtes abonné, vérifiez le paiement dans Gérer l’abonnement. Un abonnement arrivé à échéance ou remboursé ne déverrouille plus Witness."}}}},
    "Subscription": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Abonnement"}},"es":{"stringUnit":{"state":"translated","value":"Suscripción"}},"it":{"stringUnit":{"state":"translated","value":"Abbonamento"}},"fr":{"stringUnit":{"state":"translated","value":"Abonnement"}}}},
    "Manage subscription": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Abonnement verwalten"}},"es":{"stringUnit":{"state":"translated","value":"Gestionar suscripción"}},"it":{"stringUnit":{"state":"translated","value":"Gestisci abbonamento"}},"fr":{"stringUnit":{"state":"translated","value":"Gérer l’abonnement"}}}},
    "Opens a page in your browser where you can cancel, change the card, or download invoices. You sign in there with the email address you paid with.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Öffnet eine Seite im Browser, auf der du kündigen, die Karte ändern oder Rechnungen laden kannst. Dort meldest du dich mit der E-Mail-Adresse an, mit der du bezahlt hast."}},"es":{"stringUnit":{"state":"translated","value":"Abre una página en el navegador donde puedes cancelar la suscripción, cambiar la tarjeta o descargar facturas. Inicia sesión con el correo electrónico que utilizaste para pagar."}},"it":{"stringUnit":{"state":"translated","value":"Apre una pagina nel browser in cui puoi disdire l’abbonamento, cambiare carta o scaricare le fatture. Accedi con l’indirizzo email usato per il pagamento."}},"fr":{"stringUnit":{"state":"translated","value":"Ouvre une page dans votre navigateur où vous pouvez résilier l’abonnement, changer de carte ou télécharger les factures. Connectez-vous avec l’adresse e-mail utilisée pour le paiement."}}}},
    "Check for updates automatically": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Automatisch nach Updates suchen"}},"es":{"stringUnit":{"state":"translated","value":"Buscar actualizaciones automáticamente"}},"it":{"stringUnit":{"state":"translated","value":"Controlla automaticamente gli aggiornamenti"}},"fr":{"stringUnit":{"state":"translated","value":"Rechercher automatiquement les mises à jour"}}}},
    "Once a day Witness asks GitHub whether a newer signed version exists, and offers it if so. Nothing is installed until you confirm. You can also check yourself with the button above.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einmal am Tag fragt Witness bei GitHub nach, ob es eine neuere signierte Version gibt, und bietet sie dir an. Installiert wird erst nach deiner Bestätigung. Du kannst auch selbst mit der Taste oben suchen."}},"es":{"stringUnit":{"state":"translated","value":"Una vez al día, Witness pregunta a GitHub si hay una versión firmada más reciente y te la ofrece si existe. No se instala nada hasta que lo confirmes. También puedes comprobarlo con el botón de arriba."}},"it":{"stringUnit":{"state":"translated","value":"Una volta al giorno Witness verifica su GitHub se esiste una versione firmata più recente e, in tal caso, la propone. Non viene installato nulla finché non confermi. Puoi anche controllare manualmente con il pulsante qui sopra."}},"fr":{"stringUnit":{"state":"translated","value":"Une fois par jour, Witness vérifie sur GitHub s’il existe une version signée plus récente et vous la propose le cas échéant. Rien n’est installé sans votre confirmation. Vous pouvez aussi vérifier avec le bouton ci-dessus."}}}},
    "Current": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktuell"}},"es":{"stringUnit":{"state":"translated","value":"Actual"}},"it":{"stringUnit":{"state":"translated","value":"Attuale"}},"fr":{"stringUnit":{"state":"translated","value":"Actuel"}}}},
    "Buffer capacity": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Pufferkapazität"}},"es":{"stringUnit":{"state":"translated","value":"Capacidad del búfer"}},"it":{"stringUnit":{"state":"translated","value":"Capacità del buffer"}},"fr":{"stringUnit":{"state":"translated","value":"Capacité du tampon"}}}},
    "Export last utterance": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Letzte Aufnahme exportieren"}},"es":{"stringUnit":{"state":"translated","value":"Exportar la última grabación"}},"it":{"stringUnit":{"state":"translated","value":"Esporta l’ultima registrazione"}},"fr":{"stringUnit":{"state":"translated","value":"Exporter le dernier enregistrement"}}}},
    "%1$lld Hz · mono · Float32": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%1$lld Hz · Mono · Float32"}},"es":{"stringUnit":{"state":"translated","value":"%1$lld Hz · mono · Float32"}},"it":{"stringUnit":{"state":"translated","value":"%1$lld Hz · mono · Float32"}},"fr":{"stringUnit":{"state":"translated","value":"%1$lld Hz · mono · Float32"}}}},
    "%1$lld Hz · %2$lld ch · Float32": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%1$lld Hz · %2$lld Kanäle · Float32"}},"es":{"stringUnit":{"state":"translated","value":"%1$lld Hz · %2$lld canales · Float32"}},"it":{"stringUnit":{"state":"translated","value":"%1$lld Hz · %2$lld canali · Float32"}},"fr":{"stringUnit":{"state":"translated","value":"%1$lld Hz · %2$lld canaux · Float32"}}}},
    "%.3f": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%.3f"}},"es":{"stringUnit":{"state":"translated","value":"%.3f"}},"it":{"stringUnit":{"state":"translated","value":"%.3f"}},"fr":{"stringUnit":{"state":"translated","value":"%.3f"}}}},
    "%.0f s": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%.0f s"}},"es":{"stringUnit":{"state":"translated","value":"%.0f s"}},"it":{"stringUnit":{"state":"translated","value":"%.0f s"}},"fr":{"stringUnit":{"state":"translated","value":"%.0f s"}}}},
    "%lld frames": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%lld Frames"}},"es":{"stringUnit":{"state":"translated","value":"%lld tramas"}},"it":{"stringUnit":{"state":"translated","value":"%lld frame"}},"fr":{"stringUnit":{"state":"translated","value":"%lld trames"}}}},
    "%.2f s": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%.2f s"}},"es":{"stringUnit":{"state":"translated","value":"%.2f s"}},"it":{"stringUnit":{"state":"translated","value":"%.2f s"}},"fr":{"stringUnit":{"state":"translated","value":"%.2f s"}}}},
    "%1$lld / %2$lld": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%1$lld / %2$lld"}},"es":{"stringUnit":{"state":"translated","value":"%1$lld / %2$lld"}},"it":{"stringUnit":{"state":"translated","value":"%1$lld / %2$lld"}},"fr":{"stringUnit":{"state":"translated","value":"%1$lld / %2$lld"}}}},
    "%.1f %%": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%.1f %%"}},"es":{"stringUnit":{"state":"translated","value":"%.1f %%"}},"it":{"stringUnit":{"state":"translated","value":"%.1f %%"}},"fr":{"stringUnit":{"state":"translated","value":"%.1f %%"}}}},
    "%.2f": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%.2f"}},"es":{"stringUnit":{"state":"translated","value":"%.2f"}},"it":{"stringUnit":{"state":"translated","value":"%.2f"}},"fr":{"stringUnit":{"state":"translated","value":"%.2f"}}}},
    "%lld Hz": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%lld Hz"}},"es":{"stringUnit":{"state":"translated","value":"%lld Hz"}},"it":{"stringUnit":{"state":"translated","value":"%lld Hz"}},"fr":{"stringUnit":{"state":"translated","value":"%lld Hz"}}}},
    "%lld": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%lld"}},"es":{"stringUnit":{"state":"translated","value":"%lld"}},"it":{"stringUnit":{"state":"translated","value":"%lld"}},"fr":{"stringUnit":{"state":"translated","value":"%lld"}}}},
    "Hotkey released": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Tastenkürzel losgelassen"}},"es":{"stringUnit":{"state":"translated","value":"Atajo soltado"}},"it":{"stringUnit":{"state":"translated","value":"Scorciatoia rilasciata"}},"fr":{"stringUnit":{"state":"translated","value":"Raccourci relâché"}}}},
    "Maximum duration reached": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Maximale Dauer erreicht"}},"es":{"stringUnit":{"state":"translated","value":"Duración máxima alcanzada"}},"it":{"stringUnit":{"state":"translated","value":"Durata massima raggiunta"}},"fr":{"stringUnit":{"state":"translated","value":"Durée maximale atteinte"}}}},
    "Interrupted": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Unterbrochen"}},"es":{"stringUnit":{"state":"translated","value":"Interrumpida"}},"it":{"stringUnit":{"state":"translated","value":"Interrotta"}},"fr":{"stringUnit":{"state":"translated","value":"Interrompue"}}}},
    "Surface normalization": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Oberflächennormalisierung"}},"es":{"stringUnit":{"state":"translated","value":"Formato tipográfico ajustado"}},"it":{"stringUnit":{"state":"translated","value":"Grafia uniformata"}},"fr":{"stringUnit":{"state":"translated","value":"Typographie harmonisée"}}}},
    "Boundary duplicate removed": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Duplikat an der Grenze entfernt"}},"es":{"stringUnit":{"state":"translated","value":"Repetición eliminada"}},"it":{"stringUnit":{"state":"translated","value":"Ripetizione rimossa"}},"fr":{"stringUnit":{"state":"translated","value":"Répétition supprimée"}}}},
    "Inferred punctuation": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Abgeleitete Zeichensetzung"}},"es":{"stringUnit":{"state":"translated","value":"Puntuación añadida"}},"it":{"stringUnit":{"state":"translated","value":"Punteggiatura aggiunta"}},"fr":{"stringUnit":{"state":"translated","value":"Ponctuation ajoutée"}}}},
    "Inferred paragraph break": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Abgeleiteter Absatzumbruch"}},"es":{"stringUnit":{"state":"translated","value":"Salto de párrafo añadido"}},"it":{"stringUnit":{"state":"translated","value":"Interruzione di paragrafo aggiunta"}},"fr":{"stringUnit":{"state":"translated","value":"Saut de paragraphe ajouté"}}}}
  },
  "version": "1.0"
}
