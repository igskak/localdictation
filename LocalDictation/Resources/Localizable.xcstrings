    "Trial, activated": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Testphase aktiviert"
          }
        }
      }
    },
    "Activate to keep dictating": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren, um weiter zu diktieren"
          }
