    "The trial ended": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Testphase ist abgelaufen"
          }
        }
      }
    },
    "This version is newer than your license": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version ist neuer als deine Lizenz"
          }
        }
      }
    },
    "Your annual license is on this Mac now. There is nothing else to enter.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Jahreslizenz ist jetzt auf diesem Mac. Weitere Eingaben sind nicht nötig."
          }
        }
      }
    },
    "Your lifetime license is on this Mac now. There is nothing else to enter — no renewal, and no connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dauerlizenz ist jetzt auf diesem Mac. Weitere Eingaben, Verlängerungen oder eine Verbindung sind nicht nötig."
          }
        }
      }
    },
    "The key for this Mac was accepted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel für diesen Mac wurde akzeptiert."
          }
        }
      }
    },
    "%lld day": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Tag"
          }
        }
      }
    },
    "%lld days": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Tage"
          }
        }
      }
    },
    "Paid once. Covers two Macs and every update to this major version.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmalzahlung. Gilt für zwei Macs und alle Updates dieser Hauptversion."
          }
        }
      }
    },
    "Renewed each year. Covers two Macs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jährliche Verlängerung. Gilt für zwei Macs."
          }
        }
      }
    },
    "Renews automatically each year, and can be cancelled any time — it then runs to its date. Covers two Macs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich jährlich automatisch und kann jederzeit gekündigt werden; sie läuft dann bis zum Enddatum weiter. Gilt für zwei Macs."
          }
        }
      }
    },
    "Your last day before activation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzter Tag vor der Aktivierung"
          }
        }
      }
    },
    "The trial ends today": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Testphase endet heute"
          }
        }
      }
    },
    "The trial ends in %lld days": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Testphase endet in %lld Tagen"
          }
        }
      }
    },
    "Your license ends today": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Lizenz endet heute"
