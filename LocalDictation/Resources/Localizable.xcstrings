      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird gesendet …"
          }
        }
      }
    },
    "Trial, not yet activated": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Testphase, noch nicht aktiviert"
          }
        }
      }
    },
    "Ready to use, nothing asked for yet": {
