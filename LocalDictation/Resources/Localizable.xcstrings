    "Microphone": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofon"}},"es":{"stringUnit":{"state":"translated","value":"Micrófono"}},"it":{"stringUnit":{"state":"translated","value":"Microfono"}},"fr":{"stringUnit":{"state":"translated","value":"Microphone"}}}},
    "Input source": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Eingangsquelle"}},"es":{"stringUnit":{"state":"translated","value":"Fuente de entrada"}},"it":{"stringUnit":{"state":"translated","value":"Sorgente di ingresso"}},"fr":{"stringUnit":{"state":"translated","value":"Source d’entrée"}}}},
    "Mac built-in microphone": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Integriertes Mac-Mikrofon"}},"es":{"stringUnit":{"state":"translated","value":"Micrófono integrado del Mac"}},"it":{"stringUnit":{"state":"translated","value":"Microfono integrato del Mac"}},"fr":{"stringUnit":{"state":"translated","value":"Microphone intégré du Mac"}}}},
    "macOS default input": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"macOS-Standardeingang"}},"es":{"stringUnit":{"state":"translated","value":"Entrada predeterminada de macOS"}},"it":{"stringUnit":{"state":"translated","value":"Ingresso predefinito di macOS"}},"fr":{"stringUnit":{"state":"translated","value":"Entrée par défaut de macOS"}}}},
    "Refresh microphones": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofone aktualisieren"}},"es":{"stringUnit":{"state":"translated","value":"Actualizar micrófonos"}},"it":{"stringUnit":{"state":"translated","value":"Aggiorna microfoni"}},"fr":{"stringUnit":{"state":"translated","value":"Actualiser les microphones"}}}},
    "Previously selected microphone (unavailable)": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zuvor ausgewähltes Mikrofon (nicht verfügbar)"}},"es":{"stringUnit":{"state":"translated","value":"Micrófono seleccionado anteriormente (no disponible)"}},"it":{"stringUnit":{"state":"translated","value":"Microfono selezionato in precedenza (non disponibile)"}},"fr":{"stringUnit":{"state":"translated","value":"Microphone précédemment sélectionné (indisponible)"}}}},
    "The selected microphone is unavailable. Witness will use another available microphone until it returns.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das ausgewählte Mikrofon ist nicht verfügbar. Witness verwendet ein anderes verfügbares Mikrofon, bis es wieder verbunden ist."}},"es":{"stringUnit":{"state":"translated","value":"El micrófono seleccionado no está disponible. Witness utilizará otro hasta que vuelva a estar disponible."}},"it":{"stringUnit":{"state":"translated","value":"Il microfono selezionato non è disponibile. Witness ne userà un altro finché non tornerà disponibile."}},"fr":{"stringUnit":{"state":"translated","value":"Le microphone sélectionné est indisponible. Witness en utilisera un autre jusqu’à son retour."}}}},
    "The Mac microphone is unavailable. Witness will use another available microphone.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Mac-Mikrofon ist nicht verfügbar. Witness verwendet ein anderes verfügbares Mikrofon."}},"es":{"stringUnit":{"state":"translated","value":"El micrófono del Mac no está disponible. Witness utilizará otro micrófono disponible."}},"it":{"stringUnit":{"state":"translated","value":"Il microfono del Mac non è disponibile. Witness userà un altro microfono disponibile."}},"fr":{"stringUnit":{"state":"translated","value":"Le microphone du Mac est indisponible. Witness utilisera un autre microphone disponible."}}}},
    "The Mac microphone keeps dictation independent of AirPods connected to your iPhone. Changes apply to the next recording; Witness does not change the macOS sound input.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mit dem Mac-Mikrofon bleibt das Diktieren unabhängig von AirPods, die mit deinem iPhone verbunden sind. Änderungen gelten ab der nächsten Aufnahme; Witness ändert den macOS-Toneingang nicht."}},"es":{"stringUnit":{"state":"translated","value":"El micrófono del Mac mantiene el dictado independiente de los AirPods conectados al iPhone. Los cambios se aplican a la siguiente grabación; Witness no modifica la entrada de sonido de macOS."}},"it":{"stringUnit":{"state":"translated","value":"Il microfono del Mac mantiene la dettatura indipendente dagli AirPods collegati all’iPhone. Le modifiche si applicano alla registrazione successiva; Witness non cambia l’ingresso audio di macOS."}},"fr":{"stringUnit":{"state":"translated","value":"Le microphone du Mac permet à la dictée de rester indépendante des AirPods connectés à votre iPhone. Les modifications s’appliquent au prochain enregistrement ; Witness ne modifie pas l’entrée audio de macOS."}}}},
    "Could not open the selected microphone (%@)": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das ausgewählte Mikrofon konnte nicht geöffnet werden (%@)"}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido usar el micrófono seleccionado (%@)"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile usare il microfono selezionato (%@)"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible d’utiliser le microphone sélectionné (%@)"}}}},
