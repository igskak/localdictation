    "None": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Keine"}},"es":{"stringUnit":{"state":"translated","value":"No necesaria"}},"it":{"stringUnit":{"state":"translated","value":"Non necessaria"}},"fr":{"stringUnit":{"state":"translated","value":"Non requise"}}}},
    "Press a combination…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Tastenkombination drücken …"}},"es":{"stringUnit":{"state":"translated","value":"Pulsa una combinación…"}},"it":{"stringUnit":{"state":"translated","value":"Premi una combinazione…"}},"fr":{"stringUnit":{"state":"translated","value":"Appuyez sur une combinaison…"}}}},
    "%1$@ cannot be used: %2$@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%1$@ kann nicht verwendet werden: %2$@."}},"es":{"stringUnit":{"state":"translated","value":"No se puede usar %1$@: %2$@."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile usare %1$@: %2$@."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible d’utiliser %1$@ : %2$@."}}}},
    "Send me a key": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Schlüssel anfordern"}},"es":{"stringUnit":{"state":"translated","value":"Enviarme una clave"}},"it":{"stringUnit":{"state":"translated","value":"Inviami una chiave"}},"fr":{"stringUnit":{"state":"translated","value":"Envoyer une clé"}}}},
    "Already bought a license?": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bereits eine Lizenz gekauft?"}},"es":{"stringUnit":{"state":"translated","value":"¿Ya has comprado una licencia?"}},"it":{"stringUnit":{"state":"translated","value":"Hai già acquistato una licenza?"}},"fr":{"stringUnit":{"state":"translated","value":"Vous avez déjà acheté une licence ?"}}}},
    "Send my key": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Meinen Schlüssel senden"}},"es":{"stringUnit":{"state":"translated","value":"Enviar mi clave"}},"it":{"stringUnit":{"state":"translated","value":"Invia la mia chiave"}},"fr":{"stringUnit":{"state":"translated","value":"Envoyer ma clé"}}}},
    "Sending…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wird gesendet …"}},"es":{"stringUnit":{"state":"translated","value":"Enviando…"}},"it":{"stringUnit":{"state":"translated","value":"Invio…"}},"fr":{"stringUnit":{"state":"translated","value":"Envoi…"}}}},
    "Ready to use, nothing asked for yet": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einsatzbereit, noch keine Angaben nötig"}},"es":{"stringUnit":{"state":"translated","value":"Listo para usar, sin pedirte nada todavía"}},"it":{"stringUnit":{"state":"translated","value":"Pronto all’uso, per ora non serve nulla"}},"fr":{"stringUnit":{"state":"translated","value":"Prêt à l’emploi, rien à fournir pour l’instant"}}}},
    "Trial, activated": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Testphase aktiviert"}},"es":{"stringUnit":{"state":"translated","value":"Periodo de prueba activado"}},"it":{"stringUnit":{"state":"translated","value":"Prova attivata"}},"fr":{"stringUnit":{"state":"translated","value":"Essai activé"}}}},
    "Activate to keep dictating": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktivieren, um weiter zu diktieren"}},"es":{"stringUnit":{"state":"translated","value":"Activa Witness para seguir dictando"}},"it":{"stringUnit":{"state":"translated","value":"Attiva Witness per continuare a dettare"}},"fr":{"stringUnit":{"state":"translated","value":"Activez Witness pour continuer à dicter"}}}},
    "The trial ended": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Testphase ist abgelaufen"}},"es":{"stringUnit":{"state":"translated","value":"El periodo de prueba ha terminado"}},"it":{"stringUnit":{"state":"translated","value":"Il periodo di prova è terminato"}},"fr":{"stringUnit":{"state":"translated","value":"La période d’essai est terminée"}}}},
    "This version is newer than your license": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Version ist neuer als deine Lizenz"}},"es":{"stringUnit":{"state":"translated","value":"Esta versión es más reciente que tu licencia"}},"it":{"stringUnit":{"state":"translated","value":"Questa versione è più recente della tua licenza"}},"fr":{"stringUnit":{"state":"translated","value":"Cette version est plus récente que votre licence"}}}},
    "Your lifetime license is on this Mac now. There is nothing else to enter — no renewal, and no connection.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine Dauerlizenz ist jetzt auf diesem Mac. Weitere Eingaben, Verlängerungen oder eine Verbindung sind nicht nötig."}},"es":{"stringUnit":{"state":"translated","value":"Tu licencia de por vida ya está activa en este Mac. No tienes que introducir nada más, ni renovar ni conectarte."}},"it":{"stringUnit":{"state":"translated","value":"La tua licenza a vita è ora attiva su questo Mac. Non devi inserire altro: nessun rinnovo e nessuna connessione."}},"fr":{"stringUnit":{"state":"translated","value":"Votre licence à vie est maintenant active sur ce Mac. Vous n’avez rien d’autre à saisir : aucun renouvellement ni aucune connexion."}}}},
    "The key for this Mac was accepted.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Schlüssel für diesen Mac wurde akzeptiert."}},"es":{"stringUnit":{"state":"translated","value":"Se ha aceptado la clave para este Mac."}},"it":{"stringUnit":{"state":"translated","value":"La chiave per questo Mac è stata accettata."}},"fr":{"stringUnit":{"state":"translated","value":"La clé de ce Mac a été acceptée."}}}},
    "%lld day": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%lld Tag"}},"es":{"stringUnit":{"state":"translated","value":"%lld día"}},"it":{"stringUnit":{"state":"translated","value":"%lld giorno"}},"fr":{"stringUnit":{"state":"translated","value":"%lld jour"}}}},
    "%lld days": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%lld Tage"}},"es":{"stringUnit":{"state":"translated","value":"%lld días"}},"it":{"stringUnit":{"state":"translated","value":"%lld giorni"}},"fr":{"stringUnit":{"state":"translated","value":"%lld jours"}}}},
    "Paid once. Covers two Macs and every update to this major version.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einmalzahlung. Gilt für zwei Macs und alle Updates dieser Hauptversion."}},"es":{"stringUnit":{"state":"translated","value":"Un solo pago. Cubre dos Mac y todas las actualizaciones de esta versión principal."}},"it":{"stringUnit":{"state":"translated","value":"Un solo pagamento. Copre due Mac e tutti gli aggiornamenti di questa versione principale."}},"fr":{"stringUnit":{"state":"translated","value":"Un seul paiement. Couvre deux Mac et toutes les mises à jour de cette version majeure."}}}},
    "Renewed each year. Covers two Macs.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Jährliche Verlängerung. Gilt für zwei Macs."}},"es":{"stringUnit":{"state":"translated","value":"Se renueva cada año. Cubre dos Mac."}},"it":{"stringUnit":{"state":"translated","value":"Si rinnova ogni anno. Copre due Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Renouvelé chaque année. Couvre deux Mac."}}}},
    "Renews automatically each year, and can be cancelled any time — it then runs to its date. Covers two Macs.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlängert sich jährlich automatisch und kann jederzeit gekündigt werden; sie läuft dann bis zum Enddatum weiter. Gilt für zwei Macs."}},"es":{"stringUnit":{"state":"translated","value":"Se renueva automáticamente cada año y puedes cancelarla en cualquier momento; seguirá activa hasta la fecha pagada. Cubre dos Mac."}},"it":{"stringUnit":{"state":"translated","value":"Si rinnova automaticamente ogni anno e puoi annullarlo in qualsiasi momento; resterà attivo fino alla data pagata. Copre due Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Se renouvelle automatiquement chaque année et peut être résilié à tout moment ; il reste alors actif jusqu’à la date payée. Couvre deux Mac."}}}},
    "Your last day before activation": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Letzter Tag vor der Aktivierung"}},"es":{"stringUnit":{"state":"translated","value":"Tu último día antes de la activación"}},"it":{"stringUnit":{"state":"translated","value":"Il tuo ultimo giorno prima dell’attivazione"}},"fr":{"stringUnit":{"state":"translated","value":"Votre dernier jour avant l’activation"}}}},
    "The trial ends today": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Testphase endet heute"}},"es":{"stringUnit":{"state":"translated","value":"El periodo de prueba termina hoy"}},"it":{"stringUnit":{"state":"translated","value":"Il periodo di prova termina oggi"}},"fr":{"stringUnit":{"state":"translated","value":"La période d’essai se termine aujourd’hui"}}}},
    "The trial ends in %lld days": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Testphase endet in %lld Tagen"}},"es":{"stringUnit":{"state":"translated","value":"El periodo de prueba termina en %lld días"}},"it":{"stringUnit":{"state":"translated","value":"Il periodo di prova termina tra %lld giorni"}},"fr":{"stringUnit":{"state":"translated","value":"La période d’essai se termine dans %lld jours"}}}},
    "Activate to keep going": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktivieren, um fortzufahren"}},"es":{"stringUnit":{"state":"translated","value":"Activar para continuar"}},"it":{"stringUnit":{"state":"translated","value":"Attiva per continuare"}},"fr":{"stringUnit":{"state":"translated","value":"Activer pour continuer"}}}},
    "Trial finished": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Testphase beendet"}},"es":{"stringUnit":{"state":"translated","value":"Periodo de prueba finalizado"}},"it":{"stringUnit":{"state":"translated","value":"Periodo di prova terminato"}},"fr":{"stringUnit":{"state":"translated","value":"Période d’essai terminée"}}}},
    "%@ license expired": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ abgelaufen"}},"es":{"stringUnit":{"state":"translated","value":"Licencia %@ caducada"}},"it":{"stringUnit":{"state":"translated","value":"Licenza %@ scaduta"}},"fr":{"stringUnit":{"state":"translated","value":"Licence %@ expirée"}}}},
