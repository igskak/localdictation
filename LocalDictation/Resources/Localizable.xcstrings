{
  "sourceLanguage": "en",
  "strings": {
    "The update is ready. Witness will restart after dictation or the meeting note finishes.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Update ist bereit. Witness startet neu, sobald Diktat oder Besprechungsnotiz abgeschlossen sind."}},"es":{"stringUnit":{"state":"translated","value":"La actualización está lista. Witness se reiniciará cuando termine el dictado o la nota de reunión."}},"it":{"stringUnit":{"state":"translated","value":"L’aggiornamento è pronto. Witness si riavvierà al termine della dettatura o della nota riunione."}},"fr":{"stringUnit":{"state":"translated","value":"La mise à jour est prête. Witness redémarrera à la fin de la dictée ou de la note de réunion."}}}},
    "Demo": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Demo"}},"es":{"stringUnit":{"state":"translated","value":"Demo"}},"it":{"stringUnit":{"state":"translated","value":"Demo"}},"fr":{"stringUnit":{"state":"translated","value":"Démo"}}}},
    "Notetaker is in demo": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Notetaker ist im Demomodus"}},"es":{"stringUnit":{"state":"translated","value":"Notetaker está en modo demo"}},"it":{"stringUnit":{"state":"translated","value":"Notetaker è in modalità demo"}},"fr":{"stringUnit":{"state":"translated","value":"Notetaker est en mode démo"}}}},
    "Speaker separation is still being improved. Speaker labels may be inaccurate; check them against the conversation.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Sprechertrennung wird noch verbessert. Sprecherzuordnungen können ungenau sein; prüfe sie anhand des Gesprächs."}},"es":{"stringUnit":{"state":"translated","value":"La separación por hablantes sigue mejorando. Las etiquetas pueden ser imprecisas; compruébalas con la conversación."}},"it":{"stringUnit":{"state":"translated","value":"La separazione dei parlanti è ancora in miglioramento. Le etichette possono essere imprecise: verificale rispetto alla conversazione."}},"fr":{"stringUnit":{"state":"translated","value":"La séparation des intervenants est encore en cours d’amélioration. Les étiquettes peuvent être inexactes ; vérifiez-les avec la conversation."}}}},
    "More actions": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Weitere Aktionen"}},"es":{"stringUnit":{"state":"translated","value":"Más acciones"}},"it":{"stringUnit":{"state":"translated","value":"Altre azioni"}},"fr":{"stringUnit":{"state":"translated","value":"Autres actions"}}}},
    "Private by design": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Privat von Grund auf"}},"es":{"stringUnit":{"state":"translated","value":"Privado desde el diseño"}},"it":{"stringUnit":{"state":"translated","value":"Privato per principio"}},"fr":{"stringUnit":{"state":"translated","value":"Conçu pour la confidentialité"}}}},
    "Last dictation": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Letztes Diktat"}},"es":{"stringUnit":{"state":"translated","value":"Último dictado"}},"it":{"stringUnit":{"state":"translated","value":"Ultima dettatura"}},"fr":{"stringUnit":{"state":"translated","value":"Dernière dictée"}}}},
    "Shortcut: %@": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Tastenkürzel: %@"}},"es":{"stringUnit":{"state":"translated","value":"Atajo: %@"}},"it":{"stringUnit":{"state":"translated","value":"Scorciatoia: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Raccourci : %@"}}}},
    "A note for every meeting": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Eine Notiz für jede Besprechung"}},"es":{"stringUnit":{"state":"translated","value":"Una nota para cada reunión"}},"it":{"stringUnit":{"state":"translated","value":"Una nota per ogni riunione"}},"fr":{"stringUnit":{"state":"translated","value":"Une note pour chaque réunion"}}}},
    "Capture a local transcript from your microphone and the meeting app.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Erstelle ein lokales Transkript mit Mikrofon und Besprechungs-App."}},"es":{"stringUnit":{"state":"translated","value":"Crea una transcripción local con el micrófono y la app de reuniones."}},"it":{"stringUnit":{"state":"translated","value":"Crea una trascrizione locale dal microfono e dall’app della riunione."}},"fr":{"stringUnit":{"state":"translated","value":"Créez une transcription locale à partir du microphone et de l’app de réunion."}}}},
    "Find your favorite model": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Finde dein bevorzugtes Modell"}},"es":{"stringUnit":{"state":"translated","value":"Encuentra tu modelo favorito"}},"it":{"stringUnit":{"state":"translated","value":"Trova il tuo modello preferito"}},"fr":{"stringUnit":{"state":"translated","value":"Trouvez votre modèle préféré"}}}},
    "Finish setup": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Einrichtung abschließen"}},"es":{"stringUnit":{"state":"translated","value":"Finalizar configuración"}},"it":{"stringUnit":{"state":"translated","value":"Completa configurazione"}},"fr":{"stringUnit":{"state":"translated","value":"Terminer la configuration"}}}},
    "Keep the model you’ve just tried, or explore another. You can always change this in Settings.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Behalte das gerade getestete Modell oder probiere ein anderes. Du kannst dies jederzeit in den Einstellungen ändern."}},"es":{"stringUnit":{"state":"translated","value":"Conserva el modelo que acabas de probar o prueba otro. Puedes cambiarlo en Ajustes."}},"it":{"stringUnit":{"state":"translated","value":"Mantieni il modello appena provato o esplorane un altro. Puoi cambiarlo in Impostazioni."}},"fr":{"stringUnit":{"state":"translated","value":"Conservez le modèle que vous venez d’essayer ou explorez-en un autre. Vous pouvez changer ce choix dans les réglages."}}}},
    "Keep %@": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ behalten"}},"es":{"stringUnit":{"state":"translated","value":"Conservar %@"}},"it":{"stringUnit":{"state":"translated","value":"Mantieni %@"}},"fr":{"stringUnit":{"state":"translated","value":"Conserver %@"}}}},
    "Your current model keeps working.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein aktuelles Modell bleibt verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"Tu modelo actual sigue funcionando."}},"it":{"stringUnit":{"state":"translated","value":"Il modello attuale continua a funzionare."}},"fr":{"stringUnit":{"state":"translated","value":"Votre modèle actuel continue de fonctionner."}}}},
    "Try another model": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Anderes Modell ausprobieren"}},"es":{"stringUnit":{"state":"translated","value":"Probar otro modelo"}},"it":{"stringUnit":{"state":"translated","value":"Prova un altro modello"}},"fr":{"stringUnit":{"state":"translated","value":"Essayer un autre modèle"}}}},
    "Compare speed, languages and recognition.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Vergleiche Tempo, Sprachen und Erkennung."}},"es":{"stringUnit":{"state":"translated","value":"Compara velocidad, idiomas y reconocimiento."}},"it":{"stringUnit":{"state":"translated","value":"Confronta velocità, lingue e riconoscimento."}},"fr":{"stringUnit":{"state":"translated","value":"Comparez la vitesse, les langues et la reconnaissance."}}}},
    "Your voice stays on your Mac.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine Stimme bleibt auf deinem Mac."}},"es":{"stringUnit":{"state":"translated","value":"Tu voz se queda en tu Mac."}},"it":{"stringUnit":{"state":"translated","value":"La tua voce resta sul tuo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Votre voix reste sur votre Mac."}}}},
    "Meeting note": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Besprechungsnotiz"}},"es":{"stringUnit":{"state":"translated","value":"Nota de reunión"}},"it":{"stringUnit":{"state":"translated","value":"Nota riunione"}},"fr":{"stringUnit":{"state":"translated","value":"Note de réunion"}}}},
    "Starting meeting note": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Besprechungsnotiz wird gestartet"}},"es":{"stringUnit":{"state":"translated","value":"Iniciando nota de reunión"}},"it":{"stringUnit":{"state":"translated","value":"Avvio della nota riunione"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrage de la note de réunion"}}}},
    "Recording meeting": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Besprechung wird aufgenommen"}},"es":{"stringUnit":{"state":"translated","value":"Grabando reunión"}},"it":{"stringUnit":{"state":"translated","value":"Registrazione della riunione"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrement de la réunion"}}}},
    "Meeting paused": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Besprechung pausiert"}},"es":{"stringUnit":{"state":"translated","value":"Reunión en pausa"}},"it":{"stringUnit":{"state":"translated","value":"Riunione in pausa"}},"fr":{"stringUnit":{"state":"translated","value":"Réunion en pause"}}}},
    "Finishing meeting note": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Besprechungsnotiz wird abgeschlossen"}},"es":{"stringUnit":{"state":"translated","value":"Finalizando nota de reunión"}},"it":{"stringUnit":{"state":"translated","value":"Completamento della nota riunione"}},"fr":{"stringUnit":{"state":"translated","value":"Finalisation de la note de réunion"}}}},
    "Meeting note needs attention": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Besprechungsnotiz prüfen"}},"es":{"stringUnit":{"state":"translated","value":"La nota requiere atención"}},"it":{"stringUnit":{"state":"translated","value":"La nota richiede attenzione"}},"fr":{"stringUnit":{"state":"translated","value":"La note nécessite votre attention"}}}},
    "Keep current shortcut": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktuelles Tastenkürzel behalten"}},"es":{"stringUnit":{"state":"translated","value":"Mantener el atajo actual"}},"it":{"stringUnit":{"state":"translated","value":"Mantieni la scorciatoia attuale"}},"fr":{"stringUnit":{"state":"translated","value":"Conserver le raccourci actuel"}}}},
    "Continue with copy and paste": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mit Kopieren und Einfügen fortfahren"}},"es":{"stringUnit":{"state":"translated","value":"Continuar copiando y pegando"}},"it":{"stringUnit":{"state":"translated","value":"Continua con copia e incolla"}},"fr":{"stringUnit":{"state":"translated","value":"Continuer avec le copier-coller"}}}},
    "Copy and paste selected": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kopieren und Einfügen ausgewählt"}},"es":{"stringUnit":{"state":"translated","value":"Copiar y pegar seleccionado"}},"it":{"stringUnit":{"state":"translated","value":"Copia e incolla selezionato"}},"fr":{"stringUnit":{"state":"translated","value":"Copier-coller sélectionné"}}}},
    "Automatic insertion is enabled": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Automatisches Einfügen ist aktiviert"}},"es":{"stringUnit":{"state":"translated","value":"Inserción automática activada"}},"it":{"stringUnit":{"state":"translated","value":"Inserimento automatico attivo"}},"fr":{"stringUnit":{"state":"translated","value":"Insertion automatique activée"}}}},
    "Automatic insertion is not enabled": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Automatisches Einfügen ist nicht aktiviert"}},"es":{"stringUnit":{"state":"translated","value":"La inserción automática no está activada"}},"it":{"stringUnit":{"state":"translated","value":"L’inserimento automatico non è attivo"}},"fr":{"stringUnit":{"state":"translated","value":"L’insertion automatique n’est pas activée"}}}},
    "Your voice test worked here. You can now try inserting text in another app.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Probediktat hat hier funktioniert. Jetzt kannst du das Einfügen von Text in einer anderen App ausprobieren."}},"es":{"stringUnit":{"state":"translated","value":"La prueba de voz ha funcionado aquí. Ahora puedes probar a insertar texto en otra app."}},"it":{"stringUnit":{"state":"translated","value":"La prova vocale ha funzionato qui. Ora puoi provare a inserire testo in un’altra app."}},"fr":{"stringUnit":{"state":"translated","value":"Votre essai vocal a fonctionné ici. Vous pouvez maintenant essayer d’insérer du texte dans une autre app."}}}},
    "Your voice test worked here. You can copy your dictation from Witness and paste it into another app.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Probediktat hat hier funktioniert. Du kannst dein Diktat aus Witness kopieren und in einer anderen App einfügen."}},"es":{"stringUnit":{"state":"translated","value":"La prueba de voz ha funcionado aquí. Puedes copiar el dictado desde Witness y pegarlo en otra app."}},"it":{"stringUnit":{"state":"translated","value":"La prova vocale ha funzionato qui. Puoi copiare la dettatura da Witness e incollarla in un’altra app."}},"fr":{"stringUnit":{"state":"translated","value":"Votre essai vocal a fonctionné ici. Vous pouvez copier votre dictée depuis Witness et la coller dans une autre app."}}}},
    "Set up automatic insertion": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Automatisches Einfügen einrichten"}},"es":{"stringUnit":{"state":"translated","value":"Configurar inserción automática"}},"it":{"stringUnit":{"state":"translated","value":"Configura inserimento automatico"}},"fr":{"stringUnit":{"state":"translated","value":"Configurer l’insertion automatique"}}}},
    "You can enable automatic insertion in Settings.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Du kannst das automatische Einfügen in den Einstellungen aktivieren."}},"es":{"stringUnit":{"state":"translated","value":"Puedes activar la inserción automática en Ajustes."}},"it":{"stringUnit":{"state":"translated","value":"Puoi attivare l’inserimento automatico nelle Impostazioni."}},"fr":{"stringUnit":{"state":"translated","value":"Vous pouvez activer l’insertion automatique dans les Réglages."}}}},
    "Hold %@ while you speak, then release it to finish.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Halte %@ beim Sprechen gedrückt und lass die Taste zum Beenden los."}},"es":{"stringUnit":{"state":"translated","value":"Mantén %@ mientras hablas y suéltala para terminar."}},"it":{"stringUnit":{"state":"translated","value":"Tieni premuto %@ mentre parli e rilascialo per finire."}},"fr":{"stringUnit":{"state":"translated","value":"Maintenez %@ pendant que vous parlez, puis relâchez pour terminer."}}}},
    "Press %@ to start, then press it again to finish.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Drücke %@ zum Starten und erneut zum Beenden."}},"es":{"stringUnit":{"state":"translated","value":"Pulsa %@ para empezar y vuelve a pulsarla para terminar."}},"it":{"stringUnit":{"state":"translated","value":"Premi %@ per iniziare e premilo di nuovo per finire."}},"fr":{"stringUnit":{"state":"translated","value":"Appuyez sur %@ pour commencer, puis à nouveau pour terminer."}}}},
    "Witness is downloading the speech model%@. Nothing has been recorded. When it is ready: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Witness lädt das Sprachmodell herunter%@. Es wurde nichts aufgenommen. Sobald es bereit ist: %@"}},"es":{"stringUnit":{"state":"translated","value":"Witness está descargando el modelo de voz%@. No se ha grabado nada. Cuando esté listo: %@"}},"it":{"stringUnit":{"state":"translated","value":"Witness sta scaricando il modello vocale%@. Non è stato registrato nulla. Quando sarà pronto: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Witness télécharge le modèle vocal%@. Rien n’a été enregistré. Lorsqu’il sera prêt : %@"}}}},
    "The speech model is loading. Nothing has been recorded. Once it is ready: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprachmodell wird geladen. Es wurde nichts aufgenommen. Sobald es bereit ist: %@"}},"es":{"stringUnit":{"state":"translated","value":"El modelo de voz se está cargando. No se ha grabado nada. Cuando esté listo: %@"}},"it":{"stringUnit":{"state":"translated","value":"Il modello vocale si sta caricando. Non è stato registrato nulla. Quando sarà pronto: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle vocal est en cours de chargement. Rien n’a été enregistré. Une fois prêt : %@"}}}},
    "macOS is preparing the speech model for this Mac. This may take a few minutes. Nothing has been recorded. When it is ready: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"macOS bereitet das Sprachmodell für diesen Mac vor. Das kann einige Minuten dauern. Es wurde nichts aufgenommen. Sobald es bereit ist: %@"}},"es":{"stringUnit":{"state":"translated","value":"macOS está preparando el modelo de voz para este Mac. Puede tardar unos minutos. No se ha grabado nada. Cuando esté listo: %@"}},"it":{"stringUnit":{"state":"translated","value":"macOS sta preparando il modello vocale per questo Mac. Potrebbe richiedere qualche minuto. Non è stato registrato nulla. Quando sarà pronto: %@"}},"fr":{"stringUnit":{"state":"translated","value":"macOS prépare le modèle vocal pour ce Mac. Cela peut prendre quelques minutes. Rien n’a été enregistré. Lorsqu’il sera prêt : %@"}}}},
    "The speech model download has started: about %@. Nothing has been recorded. We will let you know when it is ready. Then: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Download des Sprachmodells hat begonnen: etwa %@. Es wurde nichts aufgenommen. Wir geben dir Bescheid, sobald es bereit ist. Dann: %@"}},"es":{"stringUnit":{"state":"translated","value":"La descarga del modelo de voz ha empezado: unos %@. No se ha grabado nada. Te avisaremos cuando esté listo. Entonces: %@"}},"it":{"stringUnit":{"state":"translated","value":"Il download del modello vocale è iniziato: circa %@. Non è stato registrato nulla. Ti avviseremo quando sarà pronto. Poi: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Le téléchargement du modèle vocal a commencé : environ %@. Rien n’a été enregistré. Nous vous préviendrons lorsqu’il sera prêt. Ensuite : %@"}}}},
    "Text will appear at your cursor.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Text erscheint an deiner Cursorposition."}},"es":{"stringUnit":{"state":"translated","value":"El texto aparecerá donde esté el cursor."}},"it":{"stringUnit":{"state":"translated","value":"Il testo apparirà nella posizione del cursore."}},"fr":{"stringUnit":{"state":"translated","value":"Le texte apparaîtra à l’emplacement du curseur."}}}},
    "You can copy your dictation from Witness.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Du kannst dein Diktat aus Witness kopieren."}},"es":{"stringUnit":{"state":"translated","value":"Puedes copiar tu dictado desde Witness."}},"it":{"stringUnit":{"state":"translated","value":"Puoi copiare la dettatura da Witness."}},"fr":{"stringUnit":{"state":"translated","value":"Vous pouvez copier votre dictée depuis Witness."}}}},
    "The speech model is ready. %@ %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprachmodell ist bereit. %@ %@"}},"es":{"stringUnit":{"state":"translated","value":"El modelo de voz está listo. %@ %@"}},"it":{"stringUnit":{"state":"translated","value":"Il modello vocale è pronto. %@ %@"}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle vocal est prêt. %@ %@"}}}},
    "Activation key": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktivierungstaste"}},"es":{"stringUnit":{"state":"translated","value":"Tecla de activación"}},"it":{"stringUnit":{"state":"translated","value":"Tasto di attivazione"}},"fr":{"stringUnit":{"state":"translated","value":"Touche d’activation"}}}},
    "Press a key or combination…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Taste oder Tastenkürzel drücken…"}},"es":{"stringUnit":{"state":"translated","value":"Pulsa una tecla o combinación…"}},"it":{"stringUnit":{"state":"translated","value":"Premi un tasto o una combinazione…"}},"fr":{"stringUnit":{"state":"translated","value":"Appuyez sur une touche ou combinaison…"}}}},
    "Press and release a key such as ⌥, or press a combination. It saves automatically. Escape cancels.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Drücke eine Taste wie ⌥ und lass sie los oder drücke ein Tastenkürzel. Wird automatisch gespeichert. Escape bricht ab."}},"es":{"stringUnit":{"state":"translated","value":"Pulsa y suelta una tecla como ⌥ o pulsa una combinación. Se guarda automáticamente. Escape cancela."}},"it":{"stringUnit":{"state":"translated","value":"Premi e rilascia un tasto come ⌥ o premi una combinazione. Si salva automaticamente. Escape annulla."}},"fr":{"stringUnit":{"state":"translated","value":"Appuyez puis relâchez une touche comme ⌥, ou appuyez sur une combinaison. Enregistrement automatique. Échap annule."}}}},
    "Use ⌘, ⌥, ⌃, ⇧ or Fn on its own, or a key combination. Letters, numbers and Space need a modifier.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nutze ⌘, ⌥, ⌃, ⇧ oder Fn allein oder ein Tastenkürzel. Buchstaben, Ziffern und die Leertaste brauchen eine zusätzliche Sondertaste."}},"es":{"stringUnit":{"state":"translated","value":"Usa ⌘, ⌥, ⌃, ⇧ o Fn sola, o una combinación. Las letras, los números y Espacio necesitan un modificador."}},"it":{"stringUnit":{"state":"translated","value":"Usa ⌘, ⌥, ⌃, ⇧ o Fn da solo, oppure una combinazione. Lettere, numeri e Spazio richiedono un modificatore."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez ⌘, ⌥, ⌃, ⇧ ou Fn seule, ou une combinaison. Les lettres, chiffres et Espace nécessitent un modificateur."}}}},
    "To use this key on its own, allow keyboard access in macOS. You can also choose a combination instead.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Um diese Taste allein zu verwenden, erlaube den Tastaturzugriff in macOS. Du kannst auch ein Tastenkürzel wählen."}},"es":{"stringUnit":{"state":"translated","value":"Para usar esta tecla sola, permite el acceso al teclado en macOS. También puedes elegir una combinación."}},"it":{"stringUnit":{"state":"translated","value":"Per usare questo tasto da solo, consenti l’accesso alla tastiera in macOS. Puoi anche scegliere una combinazione."}},"fr":{"stringUnit":{"state":"translated","value":"Pour utiliser cette touche seule, autorisez l’accès au clavier dans macOS. Vous pouvez aussi choisir une combinaison."}}}},
    "Check again": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erneut prüfen"}},"es":{"stringUnit":{"state":"translated","value":"Comprobar de nuevo"}},"it":{"stringUnit":{"state":"translated","value":"Controlla di nuovo"}},"fr":{"stringUnit":{"state":"translated","value":"Vérifier à nouveau"}}}},
    "Your dictation stays on this Mac. Witness also sends limited setup and trial events. You can turn these off in Settings → Privacy.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Diktat bleibt auf diesem Mac. Witness sendet außerdem begrenzte Einrichtungs- und Testereignisse. Du kannst dies unter Einstellungen → Datenschutz ausschalten."}},"es":{"stringUnit":{"state":"translated","value":"Tus dictados se quedan en este Mac. Witness también envía eventos limitados de configuración y prueba. Puedes desactivarlos en Ajustes → Privacidad."}},"it":{"stringUnit":{"state":"translated","value":"La dettatura resta su questo Mac. Witness invia anche un numero limitato di eventi di configurazione e prova. Puoi disattivarli in Impostazioni → Privacy."}},"fr":{"stringUnit":{"state":"translated","value":"Vos dictées restent sur ce Mac. Witness envoie aussi un nombre limité d’événements de configuration et d’essai. Vous pouvez les désactiver dans Réglages → Confidentialité."}}}},
    "About setup and privacy": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Über Einrichtung und Datenschutz"}},"es":{"stringUnit":{"state":"translated","value":"Sobre la configuración y la privacidad"}},"it":{"stringUnit":{"state":"translated","value":"Configurazione e privacy"}},"fr":{"stringUnit":{"state":"translated","value":"À propos de la configuration et de la confidentialité"}}}},
    "Welcome to Witness": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Willkommen bei Witness"}},"es":{"stringUnit":{"state":"translated","value":"Te damos la bienvenida a Witness"}},"it":{"stringUnit":{"state":"translated","value":"Ti diamo il benvenuto in Witness"}},"fr":{"stringUnit":{"state":"translated","value":"Bienvenue dans Witness"}}}},
    "Microphone access": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofonzugriff"}},"es":{"stringUnit":{"state":"translated","value":"Acceso al micrófono"}},"it":{"stringUnit":{"state":"translated","value":"Accesso al microfono"}},"fr":{"stringUnit":{"state":"translated","value":"Accès au microphone"}}}},
    "You can set this up later. Without this permission, you can paste your dictation from the clipboard into other apps.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Du kannst das auch später einrichten. Ohne diesen Zugriff kannst du dein Diktat über die Zwischenablage in andere Apps einfügen."}},"es":{"stringUnit":{"state":"translated","value":"Puedes configurarlo más tarde. Sin este permiso, puedes pegar el dictado desde el portapapeles en otras apps."}},"it":{"stringUnit":{"state":"translated","value":"Puoi configurarlo più tardi. Senza questa autorizzazione puoi incollare la dettatura dagli appunti nelle altre app."}},"fr":{"stringUnit":{"state":"translated","value":"Vous pouvez le configurer plus tard. Sans cette autorisation, vous pourrez coller votre dictée depuis le presse-papiers dans les autres apps."}}}},
    "A few setup steps are still needed before you can try dictation. Let’s check the microphone, your key and the speech model.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Vor dem Probediktat fehlen noch ein paar Schritte. Schauen wir nach dem Mikrofon, deiner Taste und dem Sprachmodell."}},"es":{"stringUnit":{"state":"translated","value":"Faltan algunos pasos antes de probar el dictado. Vamos a revisar el micrófono, tu tecla y el modelo de voz."}},"it":{"stringUnit":{"state":"translated","value":"Mancano ancora alcuni passaggi prima della prova. Controlliamo il microfono, il tasto e il modello vocale."}},"fr":{"stringUnit":{"state":"translated","value":"Il reste quelques étapes avant l’essai. Vérifions le microphone, votre touche et le modèle vocal."}}}},
    "A few words may need a second look. The original recognized text is below to help you check.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ein paar Wörter solltest du vielleicht prüfen. Zum Vergleichen findest du unten den ursprünglich erkannten Text."}},"es":{"stringUnit":{"state":"translated","value":"Puede que convenga revisar algunas palabras. El texto reconocido original aparece abajo para ayudarte a comprobarlo."}},"it":{"stringUnit":{"state":"translated","value":"Alcune parole potrebbero richiedere un controllo. Il testo riconosciuto originale è qui sotto per aiutarti."}},"fr":{"stringUnit":{"state":"translated","value":"Quelques mots méritent peut-être une vérification. Le texte reconnu d’origine se trouve ci-dessous pour vous aider."}}}},
    "This key isn’t ready to use yet. Check keyboard access or choose another shortcut.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Taste ist noch nicht einsatzbereit. Prüfe den Tastaturzugriff oder wähle ein anderes Kürzel."}},"es":{"stringUnit":{"state":"translated","value":"Esta tecla aún no está lista. Comprueba el acceso al teclado o elige otro atajo."}},"it":{"stringUnit":{"state":"translated","value":"Questo tasto non è ancora pronto. Controlla l’accesso alla tastiera o scegli un’altra scorciatoia."}},"fr":{"stringUnit":{"state":"translated","value":"Cette touche n’est pas encore prête. Vérifiez l’accès au clavier ou choisissez un autre raccourci."}}}},
    "Choose a modifier above, or a combination with ⌘, ⌥, ⌃ or ⇧. Letters, numbers and Space need a modifier so you can keep typing as usual. If a shortcut is taken, we’ll help you choose another.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wähle oben eine Sondertaste oder ein Kürzel mit ⌘, ⌥, ⌃ oder ⇧. Buchstaben, Ziffern und die Leertaste brauchen eine Sondertaste, damit du weiter normal tippen kannst. Ist ein Kürzel belegt, helfen wir dir bei der Auswahl."}},"es":{"stringUnit":{"state":"translated","value":"Elige un modificador arriba o una combinación con ⌘, ⌥, ⌃ o ⇧. Las letras, números y Espacio necesitan un modificador para que puedas seguir escribiendo normalmente. Si un atajo está ocupado, te ayudaremos a elegir otro."}},"it":{"stringUnit":{"state":"translated","value":"Scegli un modificatore sopra o una combinazione con ⌘, ⌥, ⌃ o ⇧. Lettere, numeri e Spazio richiedono un modificatore per continuare a scrivere normalmente. Se una scorciatoia è occupata, ti aiuteremo a sceglierne un’altra."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez un modificateur ci-dessus ou une combinaison avec ⌘, ⌥, ⌃ ou ⇧. Les lettres, chiffres et Espace nécessitent un modificateur pour vous permettre de continuer à taper normalement. Si un raccourci est occupé, nous vous aiderons à en choisir un autre."}}}},
    "Notifications are off. You can still follow progress here or return from the menu bar. You can enable notifications later in System Settings → Notifications.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mitteilungen sind ausgeschaltet. Du kannst den Fortschritt hier verfolgen oder über die Menüleiste zurückkommen. Wenn du möchtest, kannst du sie später unter Systemeinstellungen → Mitteilungen aktivieren."}},"es":{"stringUnit":{"state":"translated","value":"Las notificaciones están desactivadas. Puedes seguir el progreso aquí o volver desde la barra de menús. Si quieres, puedes activarlas más tarde en Ajustes del Sistema → Notificaciones."}},"it":{"stringUnit":{"state":"translated","value":"Le notifiche sono disattivate. Puoi seguire l’avanzamento qui o tornare dalla barra dei menu. Se vuoi, puoi attivarle più tardi in Impostazioni di Sistema → Notifiche."}},"fr":{"stringUnit":{"state":"translated","value":"Les notifications sont désactivées. Vous pouvez suivre la progression ici ou revenir par la barre des menus. Vous pourrez les activer plus tard dans Réglages Système → Notifications."}}}},
    "We’ll let you know when the model is ready. You can use other apps while Witness stays open.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wir geben dir Bescheid, sobald das Modell bereit ist. Du kannst andere Apps verwenden, während Witness geöffnet bleibt."}},"es":{"stringUnit":{"state":"translated","value":"Te avisaremos cuando el modelo esté listo. Puedes usar otras apps mientras Witness siga abierto."}},"it":{"stringUnit":{"state":"translated","value":"Ti avviseremo quando il modello sarà pronto. Puoi usare altre app lasciando Witness aperto."}},"fr":{"stringUnit":{"state":"translated","value":"Nous vous préviendrons dès que le modèle sera prêt. Vous pouvez utiliser d’autres apps pendant que Witness reste ouvert."}}}},
    "Your speech model is ready. Open Witness whenever you’d like to try dictation. Your key: %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Sprachmodell ist bereit. Öffne Witness, wenn du das Diktieren ausprobieren möchtest. Deine Taste: %@."}},"es":{"stringUnit":{"state":"translated","value":"Tu modelo de voz está listo. Abre Witness cuando quieras probar el dictado. Tu tecla: %@."}},"it":{"stringUnit":{"state":"translated","value":"Il modello vocale è pronto. Apri Witness quando vuoi provare la dettatura. Il tuo tasto: %@."}},"fr":{"stringUnit":{"state":"translated","value":"Votre modèle vocal est prêt. Ouvrez Witness quand vous souhaitez essayer la dictée. Votre touche : %@."}}}},
    "One key": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Eine Taste"}},"es":{"stringUnit":{"state":"translated","value":"Una tecla"}},"it":{"stringUnit":{"state":"translated","value":"Un tasto"}},"fr":{"stringUnit":{"state":"translated","value":"Une touche"}}}},
    "Key": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Taste"}},"es":{"stringUnit":{"state":"translated","value":"Tecla"}},"it":{"stringUnit":{"state":"translated","value":"Tasto"}},"fr":{"stringUnit":{"state":"translated","value":"Touche"}}}},
    "Allow keyboard access…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Tastaturzugriff erlauben…"}},"es":{"stringUnit":{"state":"translated","value":"Permitir acceso al teclado…"}},"it":{"stringUnit":{"state":"translated","value":"Consenti accesso alla tastiera…"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser l’accès au clavier…"}}}},
    "Saved. Your shortcut is ready to use.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gespeichert. Dein Tastenkürzel ist einsatzbereit."}},"es":{"stringUnit":{"state":"translated","value":"Guardado. Tu atajo ya está listo."}},"it":{"stringUnit":{"state":"translated","value":"Salvato. La scorciatoia è pronta."}},"fr":{"stringUnit":{"state":"translated","value":"Enregistré. Votre raccourci est prêt."}}}},
    "Choose a left or right modifier, or Fn. Hold briefly until the recording indicator appears. Regular shortcuts keep working.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wähle eine linke oder rechte Sondertaste oder Fn. Halte sie, bis die Aufnahmeanzeige erscheint. Normale Tastenkürzel funktionieren weiterhin."}},"es":{"stringUnit":{"state":"translated","value":"Elige un modificador izquierdo o derecho, o Fn. Mantenlo pulsado hasta ver el indicador de grabación. Los atajos habituales siguen funcionando."}},"it":{"stringUnit":{"state":"translated","value":"Scegli un modificatore sinistro o destro, o Fn. Tienilo premuto fino all’indicatore di registrazione. Le altre scorciatoie continuano a funzionare."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez un modificateur gauche ou droit, ou Fn. Maintenez-le jusqu’à l’indicateur d’enregistrement. Les raccourcis habituels restent disponibles."}}}},
    "Press a key with ⌘, ⌥, ⌃ or ⇧. It saves automatically. Press Escape to cancel.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Drücke eine Taste mit ⌘, ⌥, ⌃ oder ⇧. Wird automatisch gespeichert. Escape bricht ab."}},"es":{"stringUnit":{"state":"translated","value":"Pulsa una tecla con ⌘, ⌥, ⌃ o ⇧. Se guarda automáticamente. Escape cancela."}},"it":{"stringUnit":{"state":"translated","value":"Premi un tasto con ⌘, ⌥, ⌃ o ⇧. Si salva automaticamente. Escape annulla."}},"fr":{"stringUnit":{"state":"translated","value":"Appuyez sur une touche avec ⌘, ⌥, ⌃ ou ⇧. Enregistrement automatique. Échap annule."}}}},
    "Choose one modifier above, or record a combination with ⌘, ⌥, ⌃ or ⇧. Bare letters, numbers and Space are unavailable. Taken shortcuts are refused.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wähle oben eine Sondertaste oder ein Kürzel mit ⌘, ⌥, ⌃ oder ⇧. Einzelne Buchstaben, Ziffern und die Leertaste sind nicht verfügbar. Belegte Kürzel werden abgelehnt."}},"es":{"stringUnit":{"state":"translated","value":"Elige un modificador arriba o una combinación con ⌘, ⌥, ⌃ o ⇧. No se permiten letras, números ni Espacio solos. Se rechazan los atajos ocupados."}},"it":{"stringUnit":{"state":"translated","value":"Scegli un modificatore sopra o una combinazione con ⌘, ⌥, ⌃ o ⇧. Lettere, numeri e Spazio da soli non sono disponibili. Le scorciatoie occupate vengono rifiutate."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez un modificateur ci-dessus ou une combinaison avec ⌘, ⌥, ⌃ ou ⇧. Lettres, chiffres et Espace seuls sont indisponibles. Les raccourcis occupés sont refusés."}}}},
    "Either Option": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Option auf beiden Seiten"}},"es":{"stringUnit":{"state":"translated","value":"Cualquier Option"}},"it":{"stringUnit":{"state":"translated","value":"Qualsiasi Option"}},"fr":{"stringUnit":{"state":"translated","value":"Option des deux côtés"}}}},
    "Either Control": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Control auf beiden Seiten"}},"es":{"stringUnit":{"state":"translated","value":"Cualquier Control"}},"it":{"stringUnit":{"state":"translated","value":"Qualsiasi Control"}},"fr":{"stringUnit":{"state":"translated","value":"Control des deux côtés"}}}},
    "Either Command": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Command auf beiden Seiten"}},"es":{"stringUnit":{"state":"translated","value":"Cualquier Command"}},"it":{"stringUnit":{"state":"translated","value":"Qualsiasi Command"}},"fr":{"stringUnit":{"state":"translated","value":"Command des deux côtés"}}}},
    "Either Shift": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Umschalt auf beiden Seiten"}},"es":{"stringUnit":{"state":"translated","value":"Cualquier Mayúsculas"}},"it":{"stringUnit":{"state":"translated","value":"Qualsiasi Maiuscole"}},"fr":{"stringUnit":{"state":"translated","value":"Maj des deux côtés"}}}},
    "Right Option": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Rechte Option-Taste"}},"es":{"stringUnit":{"state":"translated","value":"Option derecha"}},"it":{"stringUnit":{"state":"translated","value":"Option destro"}},"fr":{"stringUnit":{"state":"translated","value":"Option droite"}}}},
    "Left Option": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Linke Option-Taste"}},"es":{"stringUnit":{"state":"translated","value":"Option izquierda"}},"it":{"stringUnit":{"state":"translated","value":"Option sinistro"}},"fr":{"stringUnit":{"state":"translated","value":"Option gauche"}}}},
    "Right Control": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Rechte Control-Taste"}},"es":{"stringUnit":{"state":"translated","value":"Control derecha"}},"it":{"stringUnit":{"state":"translated","value":"Control destro"}},"fr":{"stringUnit":{"state":"translated","value":"Control droite"}}}},
    "Left Control": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Linke Control-Taste"}},"es":{"stringUnit":{"state":"translated","value":"Control izquierda"}},"it":{"stringUnit":{"state":"translated","value":"Control sinistro"}},"fr":{"stringUnit":{"state":"translated","value":"Control gauche"}}}},
    "Right Command": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Rechte Command-Taste"}},"es":{"stringUnit":{"state":"translated","value":"Command derecha"}},"it":{"stringUnit":{"state":"translated","value":"Command destro"}},"fr":{"stringUnit":{"state":"translated","value":"Command droite"}}}},
    "Left Command": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Linke Command-Taste"}},"es":{"stringUnit":{"state":"translated","value":"Command izquierda"}},"it":{"stringUnit":{"state":"translated","value":"Command sinistro"}},"fr":{"stringUnit":{"state":"translated","value":"Command gauche"}}}},
    "Right Shift": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Rechte Umschalttaste"}},"es":{"stringUnit":{"state":"translated","value":"Mayúsculas derecha"}},"it":{"stringUnit":{"state":"translated","value":"Maiuscole destro"}},"fr":{"stringUnit":{"state":"translated","value":"Maj droite"}}}},
    "Left Shift": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Linke Umschalttaste"}},"es":{"stringUnit":{"state":"translated","value":"Mayúsculas izquierda"}},"it":{"stringUnit":{"state":"translated","value":"Maiuscole sinistro"}},"fr":{"stringUnit":{"state":"translated","value":"Maj gauche"}}}},
    "Fn / Globe": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Fn / Globus"}},"es":{"stringUnit":{"state":"translated","value":"Fn / Globo"}},"it":{"stringUnit":{"state":"translated","value":"Fn / Globo"}},"fr":{"stringUnit":{"state":"translated","value":"Fn / Globe"}}}},
    "Speak. Witness types.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprich. Witness schreibt."}},"es":{"stringUnit":{"state":"translated","value":"Habla. Witness escribe."}},"it":{"stringUnit":{"state":"translated","value":"Parla. Witness scrive."}},"fr":{"stringUnit":{"state":"translated","value":"Parlez. Witness écrit."}}}},
    "The first setup downloads a speech model. This usually takes 5–15 minutes. We will guide you to a test when it is ready.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Beim ersten Einrichten wird ein Sprachmodell geladen. Das dauert meist 5–15 Minuten. Danach führen wir dich zum Probediktat."}},"es":{"stringUnit":{"state":"translated","value":"La primera configuración descarga un modelo de voz. Suele tardar entre 5 y 15 minutos. Te guiaremos a una prueba cuando esté listo."}},"it":{"stringUnit":{"state":"translated","value":"La prima configurazione scarica un modello vocale. Di solito servono 5–15 minuti. Ti guideremo alla prova quando sarà pronto."}},"fr":{"stringUnit":{"state":"translated","value":"La première configuration télécharge un modèle vocal. Cela prend généralement 5 à 15 minutes. Nous vous guiderons vers un essai dès qu’il sera prêt."}}}},
    "Set up Witness": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Witness einrichten"}},"es":{"stringUnit":{"state":"translated","value":"Configurar Witness"}},"it":{"stringUnit":{"state":"translated","value":"Configura Witness"}},"fr":{"stringUnit":{"state":"translated","value":"Configurer Witness"}}}},
    "Skip": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Überspringen"}},"es":{"stringUnit":{"state":"translated","value":"Omitir"}},"it":{"stringUnit":{"state":"translated","value":"Salta"}},"fr":{"stringUnit":{"state":"translated","value":"Passer"}}}},
    "Next": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Weiter"}},"es":{"stringUnit":{"state":"translated","value":"Siguiente"}},"it":{"stringUnit":{"state":"translated","value":"Avanti"}},"fr":{"stringUnit":{"state":"translated","value":"Suivant"}}}},
    "Done": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Fertig"}},"es":{"stringUnit":{"state":"translated","value":"Listo"}},"it":{"stringUnit":{"state":"translated","value":"Fine"}},"fr":{"stringUnit":{"state":"translated","value":"Terminé"}}}},
    "Allow the microphone": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofon erlauben"}},"es":{"stringUnit":{"state":"translated","value":"Permitir el micrófono"}},"it":{"stringUnit":{"state":"translated","value":"Consenti il microfono"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser le microphone"}}}},
    "Type into other apps": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"In anderen Apps schreiben"}},"es":{"stringUnit":{"state":"translated","value":"Escribir en otras apps"}},"it":{"stringUnit":{"state":"translated","value":"Scrivi in altre app"}},"fr":{"stringUnit":{"state":"translated","value":"Écrire dans d’autres apps"}}}},
    "Preparing your speech model": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Sprachmodell wird vorbereitet"}},"es":{"stringUnit":{"state":"translated","value":"Preparando tu modelo de voz"}},"it":{"stringUnit":{"state":"translated","value":"Preparazione del modello vocale"}},"fr":{"stringUnit":{"state":"translated","value":"Préparation du modèle vocal"}}}},
    "Try your first dictation": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Probiere dein erstes Diktat"}},"es":{"stringUnit":{"state":"translated","value":"Prueba tu primer dictado"}},"it":{"stringUnit":{"state":"translated","value":"Prova la prima dettatura"}},"fr":{"stringUnit":{"state":"translated","value":"Essayez votre première dictée"}}}},
    "You are ready": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Alles bereit"}},"es":{"stringUnit":{"state":"translated","value":"Todo listo"}},"it":{"stringUnit":{"state":"translated","value":"Tutto pronto"}},"fr":{"stringUnit":{"state":"translated","value":"Tout est prêt"}}}},
    "Microphone allowed": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofon erlaubt"}},"es":{"stringUnit":{"state":"translated","value":"Micrófono permitido"}},"it":{"stringUnit":{"state":"translated","value":"Microfono consentito"}},"fr":{"stringUnit":{"state":"translated","value":"Microphone autorisé"}}}},
    "The microphone is blocked. Enable Witness in Privacy & Security → Microphone. A managed Mac may require an administrator.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Mikrofon ist gesperrt. Aktiviere Witness unter Datenschutz & Sicherheit → Mikrofon. Auf verwalteten Macs kann ein Administrator nötig sein."}},"es":{"stringUnit":{"state":"translated","value":"El micrófono está bloqueado. Activa Witness en Privacidad y seguridad → Micrófono. Un Mac administrado puede necesitar un administrador."}},"it":{"stringUnit":{"state":"translated","value":"Il microfono è bloccato. Attiva Witness in Privacy e sicurezza → Microfono. Su un Mac gestito potrebbe servire un amministratore."}},"fr":{"stringUnit":{"state":"translated","value":"Le microphone est bloqué. Activez Witness dans Confidentialité et sécurité → Microphone. Un Mac géré peut nécessiter un administrateur."}}}},
    "Enable Witness in Privacy & Security → Accessibility, then return here. This lets Witness type where your cursor is.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktiviere Witness unter Datenschutz & Sicherheit → Bedienungshilfen und kehre zurück. So kann Witness an der Cursorposition schreiben."}},"es":{"stringUnit":{"state":"translated","value":"Activa Witness en Privacidad y seguridad → Accesibilidad y vuelve aquí. Así podrá escribir donde esté el cursor."}},"it":{"stringUnit":{"state":"translated","value":"Attiva Witness in Privacy e sicurezza → Accessibilità, poi torna qui. Potrà scrivere nella posizione del cursore."}},"fr":{"stringUnit":{"state":"translated","value":"Activez Witness dans Confidentialité et sécurité → Accessibilité, puis revenez ici. Witness pourra écrire à l’emplacement du curseur."}}}},
    "Open Accessibility Settings": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bedienungshilfen öffnen"}},"es":{"stringUnit":{"state":"translated","value":"Abrir ajustes de Accesibilidad"}},"it":{"stringUnit":{"state":"translated","value":"Apri impostazioni di Accessibilità"}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrir les réglages d’accessibilité"}}}},
    "You can continue without this. In other apps, text will use the clipboard fallback instead of automatic insertion.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Du kannst ohne diesen Zugriff fortfahren. Text wird dann für andere Apps über die Zwischenablage bereitgestellt."}},"es":{"stringUnit":{"state":"translated","value":"Puedes continuar sin este permiso. En otras apps se usará el portapapeles en lugar de insertar automáticamente."}},"it":{"stringUnit":{"state":"translated","value":"Puoi continuare senza. Nelle altre app verranno usati gli appunti anziché l’inserimento automatico."}},"fr":{"stringUnit":{"state":"translated","value":"Vous pouvez continuer sans ce droit. Pour les autres apps, le texte passera par le presse-papiers au lieu de l’insertion automatique."}}}},
    "Please keep this window open. You can follow the preparation progress below. When the model is ready, we will invite you to try dictation. Your audio is never sent to a server.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bitte lass dieses Fenster offen. Unten siehst du den Fortschritt der Vorbereitung. Sobald das Modell bereit ist, laden wir dich zum Probediktat ein. Dein Audio wird niemals an einen Server gesendet."}},"es":{"stringUnit":{"state":"translated","value":"Deja esta ventana abierta. Puedes seguir el progreso de la preparación abajo. Cuando el modelo esté listo, te invitaremos a probar el dictado. Tu audio nunca se envía a un servidor."}},"it":{"stringUnit":{"state":"translated","value":"Lascia aperta questa finestra. Puoi seguire l’avanzamento della preparazione qui sotto. Quando il modello sarà pronto, ti inviteremo a provare la dettatura. L’audio non viene mai inviato a un server."}},"fr":{"stringUnit":{"state":"translated","value":"Gardez cette fenêtre ouverte. Vous pouvez suivre la progression de la préparation ci-dessous. Dès que le modèle sera prêt, nous vous inviterons à essayer la dictée. Votre audio n’est jamais envoyé à un serveur."}}}},
    "You can minimize this window. If you close it, preparation continues while Witness is running. Return through the menu bar → Set up / Try dictation.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Du kannst das Fenster minimieren. Nach dem Schließen läuft die Vorbereitung weiter, solange Witness läuft. Zurück über die Menüleiste → Einrichten / Diktat testen."}},"es":{"stringUnit":{"state":"translated","value":"Puedes minimizar esta ventana. Si la cierras, la preparación continúa mientras Witness siga abierto. Vuelve desde la barra de menús → Configurar / Probar dictado."}},"it":{"stringUnit":{"state":"translated","value":"Puoi ridurre la finestra. Se la chiudi, la preparazione continua finché Witness è in esecuzione. Torna dalla barra dei menu → Configura / Prova dettatura."}},"fr":{"stringUnit":{"state":"translated","value":"Vous pouvez réduire cette fenêtre. Si vous la fermez, la préparation continue tant que Witness fonctionne. Revenez par la barre des menus → Configurer / Essayer la dictée."}}}},
    "Complete microphone access, your key and model preparation before the test.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erlaube das Mikrofon, wähle deine Taste und bereite das Modell vor dem Test vor."}},"es":{"stringUnit":{"state":"translated","value":"Completa el acceso al micrófono, la tecla y la preparación del modelo antes de la prueba."}},"it":{"stringUnit":{"state":"translated","value":"Completa l’accesso al microfono, il tasto e la preparazione del modello prima della prova."}},"fr":{"stringUnit":{"state":"translated","value":"Terminez l’accès au microphone, le choix de touche et la préparation du modèle avant l’essai."}}}},
    "Check setup": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einrichtung prüfen"}},"es":{"stringUnit":{"state":"translated","value":"Revisar configuración"}},"it":{"stringUnit":{"state":"translated","value":"Controlla configurazione"}},"fr":{"stringUnit":{"state":"translated","value":"Vérifier la configuration"}}}},
    "Your test result appears here. Nothing is inserted into another app.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Testergebnis erscheint hier. Es wird nichts in eine andere App eingefügt."}},"es":{"stringUnit":{"state":"translated","value":"El resultado de la prueba aparece aquí. No se inserta nada en otra app."}},"it":{"stringUnit":{"state":"translated","value":"Il risultato della prova appare qui. Non viene inserito nulla in altre app."}},"fr":{"stringUnit":{"state":"translated","value":"Le résultat de votre essai apparaît ici. Rien n’est inséré dans une autre app."}}}},
    "Stop recording": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aufnahme beenden"}},"es":{"stringUnit":{"state":"translated","value":"Detener grabación"}},"it":{"stringUnit":{"state":"translated","value":"Interrompi registrazione"}},"fr":{"stringUnit":{"state":"translated","value":"Arrêter l’enregistrement"}}}},
    "Some fragments need a second look. You can compare the raw recognized text below.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einige Stellen solltest du prüfen. Unten kannst du den erkannten Originaltext vergleichen."}},"es":{"stringUnit":{"state":"translated","value":"Algunos fragmentos necesitan revisión. Puedes comparar el texto reconocido sin procesar abajo."}},"it":{"stringUnit":{"state":"translated","value":"Alcuni frammenti vanno controllati. Puoi confrontare il testo riconosciuto originale qui sotto."}},"fr":{"stringUnit":{"state":"translated","value":"Certains passages méritent une vérification. Vous pouvez comparer le texte brut reconnu ci-dessous."}}}},
    "Your first dictation worked": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein erstes Diktat hat funktioniert"}},"es":{"stringUnit":{"state":"translated","value":"Tu primer dictado ha funcionado"}},"it":{"stringUnit":{"state":"translated","value":"La prima dettatura ha funzionato"}},"fr":{"stringUnit":{"state":"translated","value":"Votre première dictée a réussi"}}}},
    "Witness lives in the menu bar. Place your cursor in another app and use your key. Set up / Try dictation is always available in the menu.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Witness ist in der Menüleiste. Setze den Cursor in eine andere App und nutze deine Taste. Einrichten / Diktat testen findest du jederzeit im Menü."}},"es":{"stringUnit":{"state":"translated","value":"Witness está en la barra de menús. Coloca el cursor en otra app y usa tu tecla. Configurar / Probar dictado siempre está disponible en el menú."}},"it":{"stringUnit":{"state":"translated","value":"Witness si trova nella barra dei menu. Posiziona il cursore in un’altra app e usa il tasto. Configura / Prova dettatura è sempre disponibile nel menu."}},"fr":{"stringUnit":{"state":"translated","value":"Witness se trouve dans la barre des menus. Placez le curseur dans une autre app et utilisez votre touche. Configurer / Essayer la dictée reste accessible dans le menu."}}}},
    "The first three days start at your first successful dictation. Afterwards, an email address activates ten more free days. Your dictation stays on this Mac.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die ersten drei Tage beginnen mit deinem ersten erfolgreichen Diktat. Danach schaltet eine E-Mail-Adresse zehn weitere kostenlose Tage frei. Dein Diktat bleibt auf diesem Mac."}},"es":{"stringUnit":{"state":"translated","value":"Los primeros tres días empiezan con tu primer dictado correcto. Después, una dirección de correo activa diez días gratis más. Tus dictados se quedan en este Mac."}},"it":{"stringUnit":{"state":"translated","value":"I primi tre giorni iniziano con la prima dettatura riuscita. Poi un indirizzo email attiva altri dieci giorni gratuiti. La dettatura resta su questo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Les trois premiers jours commencent à votre première dictée réussie. Ensuite, une adresse e-mail active dix jours gratuits de plus. Vos dictées restent sur ce Mac."}}}},
    "allow Input Monitoring in System Settings, then try again": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"erlaube die Eingabeüberwachung in den Systemeinstellungen und versuche es erneut"}},"es":{"stringUnit":{"state":"translated","value":"permite Monitorización de entrada en Ajustes del Sistema y vuelve a intentarlo"}},"it":{"stringUnit":{"state":"translated","value":"consenti Monitoraggio input nelle Impostazioni di Sistema e riprova"}},"fr":{"stringUnit":{"state":"translated","value":"autorisez la surveillance de l’entrée dans les Réglages Système, puis réessayez"}}}},
    "Let’s get Witness ready": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Richten wir Witness ein"}},"es":{"stringUnit":{"state":"translated","value":"Vamos a preparar Witness"}},"it":{"stringUnit":{"state":"translated","value":"Prepariamo Witness"}},"fr":{"stringUnit":{"state":"translated","value":"Préparons Witness"}}}},
    "Allow access below, then we’ll prepare your private speech model.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erlaube den Zugriff. Danach bereiten wir dein lokales Sprachmodell vor."}},"es":{"stringUnit":{"state":"translated","value":"Concede los permisos siguientes y prepararemos tu modelo de voz privado."}},"it":{"stringUnit":{"state":"translated","value":"Concedi le autorizzazioni qui sotto, poi prepareremo il tuo modello vocale privato."}},"fr":{"stringUnit":{"state":"translated","value":"Accordez les autorisations ci-dessous, puis nous préparerons votre modèle vocal privé."}}}},
    "Allow microphone access": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofonzugriff erlauben"}},"es":{"stringUnit":{"state":"translated","value":"Permitir acceso al micrófono"}},"it":{"stringUnit":{"state":"translated","value":"Consenti l’accesso al microfono"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser l’accès au microphone"}}}},
    "Witness needs the microphone to hear you. Audio stays in memory and is never saved to disk.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Witness benötigt das Mikrofon, um dich zu hören. Audio bleibt im Arbeitsspeicher und wird nicht gespeichert."}},"es":{"stringUnit":{"state":"translated","value":"Witness necesita el micrófono para oírte. El audio permanece en memoria y nunca se guarda en el disco."}},"it":{"stringUnit":{"state":"translated","value":"Witness ha bisogno del microfono per ascoltarti. L’audio resta in memoria e non viene mai salvato su disco."}},"fr":{"stringUnit":{"state":"translated","value":"Witness a besoin du microphone pour vous entendre. L’audio reste en mémoire et n’est jamais enregistré sur le disque."}}}},
    "Allow typing into other apps": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Eingabe in anderen Apps erlauben"}},"es":{"stringUnit":{"state":"translated","value":"Permitir escribir en otras apps"}},"it":{"stringUnit":{"state":"translated","value":"Consenti la scrittura in altre app"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser la saisie dans d’autres apps"}}}},
    "Enable Witness in Privacy & Security → Accessibility to insert text where your cursor is. Without it, text goes to the clipboard.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktiviere Witness unter Datenschutz & Sicherheit → Bedienungshilfen, um Text an der Cursorposition einzufügen. Andernfalls wird er in die Zwischenablage kopiert."}},"es":{"stringUnit":{"state":"translated","value":"Activa Witness en Privacidad y seguridad → Accesibilidad para insertar texto donde esté el cursor. Sin este permiso, el texto se copia al portapapeles."}},"it":{"stringUnit":{"state":"translated","value":"Attiva Witness in Privacy e sicurezza → Accessibilità per inserire il testo nella posizione del cursore. Senza questa autorizzazione, il testo viene copiato negli appunti."}},"fr":{"stringUnit":{"state":"translated","value":"Activez Witness dans Confidentialité et sécurité → Accessibilité pour insérer le texte à l’emplacement du curseur. Sans cette autorisation, le texte est copié dans le presse-papiers."}}}},
    "Allow access…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zugriff erlauben…"}},"es":{"stringUnit":{"state":"translated","value":"Permitir acceso…"}},"it":{"stringUnit":{"state":"translated","value":"Consenti accesso…"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser l’accès…"}}}},
    "Get notified when the speech model is ready?": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Benachrichtigung, sobald das Sprachmodell bereit ist?"}},"es":{"stringUnit":{"state":"translated","value":"¿Quieres recibir un aviso cuando el modelo de voz esté listo?"}},"it":{"stringUnit":{"state":"translated","value":"Vuoi ricevere una notifica quando il modello vocale è pronto?"}},"fr":{"stringUnit":{"state":"translated","value":"Souhaitez-vous être averti lorsque le modèle vocal est prêt ?"}}}},
    "Allow notifications for Witness to get a notification when the download finishes.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erlaube Mitteilungen für Witness, damit du benachrichtigt wirst, sobald der Download abgeschlossen ist."}},"es":{"stringUnit":{"state":"translated","value":"Permite las notificaciones de Witness para recibir un aviso cuando termine la descarga."}},"it":{"stringUnit":{"state":"translated","value":"Consenti le notifiche per Witness per sapere quando termina il download."}},"fr":{"stringUnit":{"state":"translated","value":"Autorisez les notifications de Witness pour être averti à la fin du téléchargement."}}}},
    "Allow Notifications": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mitteilungen erlauben"}},"es":{"stringUnit":{"state":"translated","value":"Permitir notificaciones"}},"it":{"stringUnit":{"state":"translated","value":"Consenti notifiche"}},"fr":{"stringUnit":{"state":"translated","value":"Autoriser les notifications"}}}},
    "Don’t Allow": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nicht erlauben"}},"es":{"stringUnit":{"state":"translated","value":"No permitir"}},"it":{"stringUnit":{"state":"translated","value":"Non consentire"}},"fr":{"stringUnit":{"state":"translated","value":"Ne pas autoriser"}}}},
    "Notify me when ready": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bei Bereitschaft benachrichtigen"}},"es":{"stringUnit":{"state":"translated","value":"Avisarme cuando esté listo"}},"it":{"stringUnit":{"state":"translated","value":"Avvisami quando è pronto"}},"fr":{"stringUnit":{"state":"translated","value":"Me prévenir lorsque ce sera prêt"}}}},
    "Get a macOS notification when the model is ready.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erhalte eine macOS-Mitteilung, sobald das Modell bereit ist."}},"es":{"stringUnit":{"state":"translated","value":"Recibe una notificación de macOS cuando el modelo esté listo."}},"it":{"stringUnit":{"state":"translated","value":"Ricevi una notifica di macOS quando il modello è pronto."}},"fr":{"stringUnit":{"state":"translated","value":"Recevez une notification macOS lorsque le modèle est prêt."}}}},
    "We’ll notify you when the model is ready. Keep Witness running.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wir benachrichtigen dich, sobald das Modell bereit ist. Lass Witness geöffnet."}},"es":{"stringUnit":{"state":"translated","value":"Te avisaremos cuando el modelo esté listo. Mantén Witness abierto."}},"it":{"stringUnit":{"state":"translated","value":"Ti avviseremo quando il modello sarà pronto. Mantieni Witness in esecuzione."}},"fr":{"stringUnit":{"state":"translated","value":"Nous vous préviendrons lorsque le modèle sera prêt. Laissez Witness ouvert."}}}},
    "Witness is ready": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Witness ist bereit"}},"es":{"stringUnit":{"state":"translated","value":"Witness está listo"}},"it":{"stringUnit":{"state":"translated","value":"Witness è pronto"}},"fr":{"stringUnit":{"state":"translated","value":"Witness est prêt"}}}},
    "The local speech model is ready. Hold %@ and speak.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das lokale Sprachmodell ist bereit. Halte %@ gedrückt und sprich."}},"es":{"stringUnit":{"state":"translated","value":"El modelo de voz local está listo. Mantén pulsado %@ y habla."}},"it":{"stringUnit":{"state":"translated","value":"Il modello vocale locale è pronto. Tieni premuto %@ e parla."}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle vocal local est prêt. Maintenez %@ enfoncé et parlez."}}}},
    "The model is ready.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Modell ist bereit."}},"es":{"stringUnit":{"state":"translated","value":"El modelo está listo."}},"it":{"stringUnit":{"state":"translated","value":"Il modello è pronto."}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle est prêt."}}}},
    "The model is ready, but the notification could not be delivered.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Modell ist bereit, aber die Mitteilung konnte nicht zugestellt werden."}},"es":{"stringUnit":{"state":"translated","value":"El modelo está listo, pero no se ha podido enviar la notificación."}},"it":{"stringUnit":{"state":"translated","value":"Il modello è pronto, ma non è stato possibile inviare la notifica."}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle est prêt, mais la notification n’a pas pu être envoyée."}}}},
    "Hold %@ and say a few words to try dictation.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Halte %@ gedrückt und sage ein paar Worte, um das Diktieren auszuprobieren."}},"es":{"stringUnit":{"state":"translated","value":"Mantén pulsado %@ y di unas palabras para probar el dictado."}},"it":{"stringUnit":{"state":"translated","value":"Tieni premuto %@ e pronuncia qualche parola per provare la dettatura."}},"fr":{"stringUnit":{"state":"translated","value":"Maintenez %@ enfoncé et dites quelques mots pour essayer la dictée."}}}},
    "Continue in background": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Im Hintergrund fortfahren"}},"es":{"stringUnit":{"state":"translated","value":"Continuar en segundo plano"}},"it":{"stringUnit":{"state":"translated","value":"Continua in background"}},"fr":{"stringUnit":{"state":"translated","value":"Continuer en arrière-plan"}}}},
    "The speech model is preparing": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprachmodell wird vorbereitet"}},"es":{"stringUnit":{"state":"translated","value":"El modelo de voz se está preparando"}},"it":{"stringUnit":{"state":"translated","value":"Preparazione del modello vocale"}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle vocal est en cours de préparation"}}}},
    "The model is being prepared on this Mac. Keep Witness running until it is ready.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Modell wird auf diesem Mac vorbereitet. Lass Witness geöffnet, bis es bereit ist."}},"es":{"stringUnit":{"state":"translated","value":"El modelo se está preparando en este Mac. Mantén Witness abierto hasta que esté listo."}},"it":{"stringUnit":{"state":"translated","value":"Il modello viene preparato su questo Mac. Mantieni Witness in esecuzione finché non è pronto."}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle est en cours de préparation sur ce Mac. Laissez Witness ouvert jusqu’à ce qu’il soit prêt."}}}},
    "About %@, downloaded once. This can take 5–15 minutes depending on your connection and Mac. Keep Witness running; recognition then happens locally.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Etwa %@, einmaliger Download. Je nach Verbindung und Mac kann dies 5–15 Minuten dauern. Lass Witness geöffnet; danach erfolgt die Erkennung lokal."}},"es":{"stringUnit":{"state":"translated","value":"Aproximadamente %@, se descarga una sola vez. Puede tardar entre 5 y 15 minutos según la conexión y el Mac. Mantén Witness abierto; después el reconocimiento será local."}},"it":{"stringUnit":{"state":"translated","value":"Circa %@, scaricati una sola volta. Può richiedere 5–15 minuti in base alla connessione e al Mac. Mantieni Witness in esecuzione; in seguito il riconoscimento avviene in locale."}},"fr":{"stringUnit":{"state":"translated","value":"Environ %@, téléchargés une seule fois. Cela peut prendre 5 à 15 minutes selon votre connexion et votre Mac. Laissez Witness ouvert ; la reconnaissance s’effectuera ensuite localement."}}}},
    "Cleanup": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bereinigung"}},"es":{"stringUnit":{"state":"translated","value":"Edición"}},"it":{"stringUnit":{"state":"translated","value":"Rifinitura"}},"fr":{"stringUnit":{"state":"translated","value":"Retouche"}}}},
    "Level": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Stufe"}},"es":{"stringUnit":{"state":"translated","value":"Nivel"}},"it":{"stringUnit":{"state":"translated","value":"Livello"}},"fr":{"stringUnit":{"state":"translated","value":"Niveau"}}}},
    "Cleanup level": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bereinigungsstufe"}},"es":{"stringUnit":{"state":"translated","value":"Nivel de edición"}},"it":{"stringUnit":{"state":"translated","value":"Livello di rifinitura"}},"fr":{"stringUnit":{"state":"translated","value":"Niveau de retouche"}}}},
    "Example": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Beispiel"}},"es":{"stringUnit":{"state":"translated","value":"Ejemplo"}},"it":{"stringUnit":{"state":"translated","value":"Esempio"}},"fr":{"stringUnit":{"state":"translated","value":"Exemple"}}}},
    "Verbatim": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wörtlich"}},"es":{"stringUnit":{"state":"translated","value":"Literal"}},"it":{"stringUnit":{"state":"translated","value":"Letterale"}},"fr":{"stringUnit":{"state":"translated","value":"Verbatim"}}}},
    "Exactly what the speech engine recognized, with no cleanup.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Genau das, was die Spracherkennung erkannt hat, ohne Bereinigung."}},"es":{"stringUnit":{"state":"translated","value":"El texto tal como lo reconoció el sistema, sin ningún retoque."}},"it":{"stringUnit":{"state":"translated","value":"Il testo così come è stato riconosciuto, senza alcuna modifica."}},"fr":{"stringUnit":{"state":"translated","value":"Le texte tel qu’il a été reconnu, sans aucune retouche."}}}},
    "All cleanup runs on this Mac. Raw recognized text remains available in review.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die gesamte Bereinigung läuft auf diesem Mac. Der rohe erkannte Text bleibt in der Überprüfung verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"Toda la edición se realiza en este Mac. El texto original reconocido sigue disponible durante la revisión."}},"it":{"stringUnit":{"state":"translated","value":"Tutte le modifiche vengono eseguite su questo Mac. Il testo originale riconosciuto resta disponibile durante la verifica."}},"fr":{"stringUnit":{"state":"translated","value":"Toutes les retouches sont effectuées sur ce Mac. Le texte brut reconnu reste disponible pendant la vérification."}}}},
    "Add a term or correction": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Begriff oder Korrektur hinzufügen"}},"es":{"stringUnit":{"state":"translated","value":"Añadir un término o corrección"}},"it":{"stringUnit":{"state":"translated","value":"Aggiungi un termine o una correzione"}},"fr":{"stringUnit":{"state":"translated","value":"Ajouter un terme ou une correction"}}}},
    "Preferred spelling or phrase": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bevorzugte Schreibweise oder Wendung"}},"es":{"stringUnit":{"state":"translated","value":"Ortografía o frase preferida"}},"it":{"stringUnit":{"state":"translated","value":"Grafia o frase preferita"}},"fr":{"stringUnit":{"state":"translated","value":"Orthographe ou expression préférée"}}}},
    "Optional: when Witness writes…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Optional: wenn Witness Folgendes schreibt …"}},"es":{"stringUnit":{"state":"translated","value":"Opcional: cuando Witness escriba…"}},"it":{"stringUnit":{"state":"translated","value":"Facoltativo: quando Witness scrive…"}},"fr":{"stringUnit":{"state":"translated","value":"Facultatif : lorsque Witness écrit…"}}}},
    "Replace the second phrase with the preferred spelling": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die zweite Wendung durch die bevorzugte Schreibweise ersetzen"}},"es":{"stringUnit":{"state":"translated","value":"Sustituir la segunda frase por la forma preferida"}},"it":{"stringUnit":{"state":"translated","value":"Sostituisci la seconda frase con la grafia preferita"}},"fr":{"stringUnit":{"state":"translated","value":"Remplacer la deuxième expression par la forme préférée"}}}},
    "Spoken punctuation": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gesprochene Zeichensetzung"}},"es":{"stringUnit":{"state":"translated","value":"Puntuación hablada"}},"it":{"stringUnit":{"state":"translated","value":"Punteggiatura pronunciata"}},"fr":{"stringUnit":{"state":"translated","value":"Ponctuation dictée"}}}},
    "Line break": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zeilenumbruch"}},"es":{"stringUnit":{"state":"translated","value":"Salto de línea"}},"it":{"stringUnit":{"state":"translated","value":"Interruzione di riga"}},"fr":{"stringUnit":{"state":"translated","value":"Saut de ligne"}}}},
    "Paragraph break": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Absatzumbruch"}},"es":{"stringUnit":{"state":"translated","value":"Salto de párrafo"}},"it":{"stringUnit":{"state":"translated","value":"Interruzione di paragrafo"}},"fr":{"stringUnit":{"state":"translated","value":"Saut de paragraphe"}}}},
    "Explicit correction": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Explizite Korrektur"}},"es":{"stringUnit":{"state":"translated","value":"Corrección explícita"}},"it":{"stringUnit":{"state":"translated","value":"Correzione esplicita"}},"fr":{"stringUnit":{"state":"translated","value":"Correction explicite"}}}},
    "Repeated words removed": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wiederholte Wörter entfernt"}},"es":{"stringUnit":{"state":"translated","value":"Palabras repetidas eliminadas"}},"it":{"stringUnit":{"state":"translated","value":"Parole ripetute rimosse"}},"fr":{"stringUnit":{"state":"translated","value":"Mots répétés supprimés"}}}},
    "List formatting": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Listenformatierung"}},"es":{"stringUnit":{"state":"translated","value":"Formato de lista"}},"it":{"stringUnit":{"state":"translated","value":"Formattazione dell’elenco"}},"fr":{"stringUnit":{"state":"translated","value":"Mise en forme de liste"}}}},
    "Number formatting": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zahlenformatierung"}},"es":{"stringUnit":{"state":"translated","value":"Formato de números"}},"it":{"stringUnit":{"state":"translated","value":"Formattazione dei numeri"}},"fr":{"stringUnit":{"state":"translated","value":"Mise en forme des nombres"}}}},
    "Date formatting": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Datumsformatierung"}},"es":{"stringUnit":{"state":"translated","value":"Formato de fechas"}},"it":{"stringUnit":{"state":"translated","value":"Formattazione delle date"}},"fr":{"stringUnit":{"state":"translated","value":"Mise en forme des dates"}}}},
    "Time formatting": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zeitformatierung"}},"es":{"stringUnit":{"state":"translated","value":"Formato de horas"}},"it":{"stringUnit":{"state":"translated","value":"Formattazione degli orari"}},"fr":{"stringUnit":{"state":"translated","value":"Mise en forme des heures"}}}},
    "Currency formatting": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Währungsformatierung"}},"es":{"stringUnit":{"state":"translated","value":"Formato de moneda"}},"it":{"stringUnit":{"state":"translated","value":"Formattazione della valuta"}},"fr":{"stringUnit":{"state":"translated","value":"Mise en forme des devises"}}}},
    "Percentage formatting": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Prozentformatierung"}},"es":{"stringUnit":{"state":"translated","value":"Formato de porcentajes"}},"it":{"stringUnit":{"state":"translated","value":"Formattazione delle percentuali"}},"fr":{"stringUnit":{"state":"translated","value":"Mise en forme des pourcentages"}}}},
    "Unit formatting": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einheitenformatierung"}},"es":{"stringUnit":{"state":"translated","value":"Formato de unidades"}},"it":{"stringUnit":{"state":"translated","value":"Formattazione delle unità"}},"fr":{"stringUnit":{"state":"translated","value":"Mise en forme des unités"}}}},
    "Context spacing": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kontextabhängiger Abstand"}},"es":{"stringUnit":{"state":"translated","value":"Espaciado adaptado al contexto"}},"it":{"stringUnit":{"state":"translated","value":"Spaziatura adattata al contesto"}},"fr":{"stringUnit":{"state":"translated","value":"Espacement adapté au contexte"}}}},
    "Context capitalization": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kontextabhängige Großschreibung"}},"es":{"stringUnit":{"state":"translated","value":"Mayúsculas adaptadas al contexto"}},"it":{"stringUnit":{"state":"translated","value":"Maiuscole adattate al contesto"}},"fr":{"stringUnit":{"state":"translated","value":"Majuscules adaptées au contexte"}}}},
    "Context punctuation": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kontextabhängige Zeichensetzung"}},"es":{"stringUnit":{"state":"translated","value":"Puntuación adaptada al contexto"}},"it":{"stringUnit":{"state":"translated","value":"Punteggiatura adattata al contesto"}},"fr":{"stringUnit":{"state":"translated","value":"Ponctuation adaptée au contexte"}}}},
    "Dictionary correction": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wörterbuchkorrektur"}},"es":{"stringUnit":{"state":"translated","value":"Corrección del diccionario"}},"it":{"stringUnit":{"state":"translated","value":"Correzione del dizionario"}},"fr":{"stringUnit":{"state":"translated","value":"Correction du dictionnaire"}}}},
    "The speech model has not been downloaded yet (about %@)": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprachmodell wurde noch nicht geladen (etwa %@)"}},"es":{"stringUnit":{"state":"translated","value":"El modelo de voz aún no se ha descargado (aprox. %@)"}},"it":{"stringUnit":{"state":"translated","value":"Il modello vocale non è ancora stato scaricato (circa %@)"}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle vocal n’a pas encore été téléchargé (environ %@)"}}}},
    "less than a minute": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"weniger als eine Minute"}},"es":{"stringUnit":{"state":"translated","value":"menos de un minuto"}},"it":{"stringUnit":{"state":"translated","value":"meno di un minuto"}},"fr":{"stringUnit":{"state":"translated","value":"moins d’une minute"}}}},
    "about %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"etwa %@"}},"es":{"stringUnit":{"state":"translated","value":"aprox. %@"}},"it":{"stringUnit":{"state":"translated","value":"circa %@"}},"fr":{"stringUnit":{"state":"translated","value":"environ %@"}}}},
    " — %lld%%, %@ left": {"localizations":{"de":{"stringUnit":{"state":"translated","value":" – %lld %%, noch %@"}},"es":{"stringUnit":{"state":"translated","value":" — %lld%%, quedan %@"}},"it":{"stringUnit":{"state":"translated","value":" — %lld%%, restano %@"}},"fr":{"stringUnit":{"state":"translated","value":" — %lld%%, %@ restants"}}}},
    " — %lld%%, %@ left, %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":" – %lld %%, noch %@, %@"}},"es":{"stringUnit":{"state":"translated","value":" — %lld%%, quedan %@, %@"}},"it":{"stringUnit":{"state":"translated","value":" — %lld%%, restano %@, %@"}},"fr":{"stringUnit":{"state":"translated","value":" — %lld%%, %@ restants, %@"}}}},
    "Downloading the speech model… %lld%%. %@ left.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprachmodell wird geladen … %lld %%. Noch %@."}},"es":{"stringUnit":{"state":"translated","value":"Descargando el modelo de voz… %lld%%. Quedan %@."}},"it":{"stringUnit":{"state":"translated","value":"Download del modello vocale… %lld%%. Restano %@."}},"fr":{"stringUnit":{"state":"translated","value":"Téléchargement du modèle vocal… %lld%%. %@ restants."}}}},
    "Downloading the speech model… %lld%%. %@ left, %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprachmodell wird geladen … %lld %%. Noch %@, %@."}},"es":{"stringUnit":{"state":"translated","value":"Descargando el modelo de voz… %lld%%. Quedan %@, %@."}},"it":{"stringUnit":{"state":"translated","value":"Download del modello vocale… %lld%%. Restano %@, %@."}},"fr":{"stringUnit":{"state":"translated","value":"Téléchargement du modèle vocal… %lld%%. %@ restants, %@."}}}},
    "Updates": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Updates"}},"es":{"stringUnit":{"state":"translated","value":"Actualizaciones"}},"it":{"stringUnit":{"state":"translated","value":"Aggiornamenti"}},"fr":{"stringUnit":{"state":"translated","value":"Mises à jour"}}}},
    "Installed version": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Installierte Version"}},"es":{"stringUnit":{"state":"translated","value":"Versión instalada"}},"it":{"stringUnit":{"state":"translated","value":"Versione installata"}},"fr":{"stringUnit":{"state":"translated","value":"Version installée"}}}},
    "Check for updates…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Auf Updates prüfen …"}},"es":{"stringUnit":{"state":"translated","value":"Buscar actualizaciones…"}},"it":{"stringUnit":{"state":"translated","value":"Controlla aggiornamenti…"}},"fr":{"stringUnit":{"state":"translated","value":"Rechercher des mises à jour…"}}}},
