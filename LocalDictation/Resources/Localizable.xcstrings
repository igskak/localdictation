    "Paid once. Covers two Macs and every update to this major version.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einmalzahlung. Gilt für zwei Macs und alle Updates dieser Hauptversion."}},"es":{"stringUnit":{"state":"translated","value":"Un solo pago. Cubre dos Mac y todas las actualizaciones de esta versión principal."}},"it":{"stringUnit":{"state":"translated","value":"Un solo pagamento. Copre due Mac e tutti gli aggiornamenti di questa versione principale."}},"fr":{"stringUnit":{"state":"translated","value":"Un seul paiement. Couvre deux Mac et toutes les mises à jour de cette version majeure."}}}},
    "Renewed each year. Covers two Macs.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Jährliche Verlängerung. Gilt für zwei Macs."}},"es":{"stringUnit":{"state":"translated","value":"Se renueva cada año. Cubre dos Mac."}},"it":{"stringUnit":{"state":"translated","value":"Si rinnova ogni anno. Copre due Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Renouvelé chaque année. Couvre deux Mac."}}}},
    "Your last day before activation": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Letzter Tag vor der Aktivierung"}},"es":{"stringUnit":{"state":"translated","value":"Tu último día antes de la activación"}},"it":{"stringUnit":{"state":"translated","value":"Il tuo ultimo giorno prima dell’attivazione"}},"fr":{"stringUnit":{"state":"translated","value":"Votre dernier jour avant l’activation"}}}},
    "The trial ends today": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Testphase endet heute"}},"es":{"stringUnit":{"state":"translated","value":"El periodo de prueba termina hoy"}},"it":{"stringUnit":{"state":"translated","value":"Il periodo di prova termina oggi"}},"fr":{"stringUnit":{"state":"translated","value":"La période d’essai se termine aujourd’hui"}}}},
    "The trial ends in %lld days": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Testphase endet in %lld Tagen"}},"es":{"stringUnit":{"state":"translated","value":"El periodo de prueba termina en %lld días"}},"it":{"stringUnit":{"state":"translated","value":"Il periodo di prova termina tra %lld giorni"}},"fr":{"stringUnit":{"state":"translated","value":"La période d’essai se termine dans %lld jours"}}}},
    "Activate to keep going": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktivieren, um fortzufahren"}},"es":{"stringUnit":{"state":"translated","value":"Activar para continuar"}},"it":{"stringUnit":{"state":"translated","value":"Attiva per continuare"}},"fr":{"stringUnit":{"state":"translated","value":"Activer pour continuer"}}}},
    "Trial finished": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Testphase beendet"}},"es":{"stringUnit":{"state":"translated","value":"Periodo de prueba finalizado"}},"it":{"stringUnit":{"state":"translated","value":"Periodo di prova terminato"}},"fr":{"stringUnit":{"state":"translated","value":"Période d’essai terminée"}}}},
    "%@ license expired": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ abgelaufen"}},"es":{"stringUnit":{"state":"translated","value":"Licencia %@ caducada"}},"it":{"stringUnit":{"state":"translated","value":"Licenza %@ scaduta"}},"fr":{"stringUnit":{"state":"translated","value":"Licence %@ expirée"}}}},
    "Needs attention": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktion erforderlich"}},"es":{"stringUnit":{"state":"translated","value":"Requiere atención"}},"it":{"stringUnit":{"state":"translated","value":"Richiede attenzione"}},"fr":{"stringUnit":{"state":"translated","value":"Nécessite votre attention"}}}},
    "Worth a look": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Prüfung empfohlen"}},"es":{"stringUnit":{"state":"translated","value":"Conviene revisarlo"}},"it":{"stringUnit":{"state":"translated","value":"Da controllare"}},"fr":{"stringUnit":{"state":"translated","value":"À vérifier"}}}},
    "Recording ended early": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aufnahme vorzeitig beendet"}},"es":{"stringUnit":{"state":"translated","value":"La grabación terminó antes de tiempo"}},"it":{"stringUnit":{"state":"translated","value":"La registrazione è terminata in anticipo"}},"fr":{"stringUnit":{"state":"translated","value":"L’enregistrement s’est terminé prématurément"}}}},
    "Starting up": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wird gestartet"}},"es":{"stringUnit":{"state":"translated","value":"Iniciando"}},"it":{"stringUnit":{"state":"translated","value":"Avvio"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrage"}}}},
    "Checking microphone access.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofonzugriff wird geprüft."}},"es":{"stringUnit":{"state":"translated","value":"Comprobando el acceso al micrófono."}},"it":{"stringUnit":{"state":"translated","value":"Verifica dell’accesso al microfono."}},"fr":{"stringUnit":{"state":"translated","value":"Vérification de l’accès au microphone."}}}},
    "Microphone access required": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofonzugriff erforderlich"}},"es":{"stringUnit":{"state":"translated","value":"Se necesita acceso al micrófono"}},"it":{"stringUnit":{"state":"translated","value":"Accesso al microfono richiesto"}},"fr":{"stringUnit":{"state":"translated","value":"Accès au microphone requis"}}}},
    "Grant access to enable push-to-talk dictation.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erlaube den Zugriff, um per Tastendruck zu diktieren."}},"es":{"stringUnit":{"state":"translated","value":"Concede acceso para activar el dictado mediante pulsación."}},"it":{"stringUnit":{"state":"translated","value":"Concedi l’accesso per attivare la dettatura push-to-talk."}},"fr":{"stringUnit":{"state":"translated","value":"Accordez l’accès pour activer la dictée par maintien de la touche."}}}},
    "Waiting for your answer": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Warte auf deine Antwort"}},"es":{"stringUnit":{"state":"translated","value":"Esperando tu respuesta"}},"it":{"stringUnit":{"state":"translated","value":"In attesa della tua risposta"}},"fr":{"stringUnit":{"state":"translated","value":"En attente de votre réponse"}}}},
    "Approve the macOS microphone prompt.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Bestätige die Mikrofonabfrage von macOS."}},"es":{"stringUnit":{"state":"translated","value":"Acepta la solicitud de acceso al micrófono de macOS."}},"it":{"stringUnit":{"state":"translated","value":"Approva la richiesta di accesso al microfono di macOS."}},"fr":{"stringUnit":{"state":"translated","value":"Acceptez la demande d’accès au microphone de macOS."}}}},
    "Microphone access restricted": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofonzugriff eingeschränkt"}},"es":{"stringUnit":{"state":"translated","value":"El acceso al micrófono está restringido"}},"it":{"stringUnit":{"state":"translated","value":"L’accesso al microfono è limitato"}},"fr":{"stringUnit":{"state":"translated","value":"L’accès au microphone est restreint"}}}},
    "Microphone access denied": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofonzugriff verweigert"}},"es":{"stringUnit":{"state":"translated","value":"Acceso al micrófono denegado"}},"it":{"stringUnit":{"state":"translated","value":"Accesso al microfono negato"}},"fr":{"stringUnit":{"state":"translated","value":"Accès au microphone refusé"}}}},
    "A device policy blocks microphone access. Contact whoever manages this Mac.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Eine Geräterichtlinie blockiert den Mikrofonzugriff. Wende dich an die Verwaltung dieses Macs."}},"es":{"stringUnit":{"state":"translated","value":"Una política del dispositivo bloquea el acceso al micrófono. Contacta con quien administre este Mac."}},"it":{"stringUnit":{"state":"translated","value":"Un criterio del dispositivo blocca l’accesso al microfono. Contatta chi gestisce questo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Une règle de l’appareil bloque l’accès au microphone. Contactez la personne qui gère ce Mac."}}}},
    "Enable Witness under Privacy & Security → Microphone, then return here.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktiviere Witness unter Datenschutz & Sicherheit → Mikrofon und kehre dann hierher zurück."}},"es":{"stringUnit":{"state":"translated","value":"Activa Witness en Privacidad y seguridad → Micrófono y vuelve aquí."}},"it":{"stringUnit":{"state":"translated","value":"Attiva Witness in Privacy e sicurezza → Microfono, poi torna qui."}},"fr":{"stringUnit":{"state":"translated","value":"Activez Witness dans Confidentialité et sécurité → Microphone, puis revenez ici."}}}},
    "Opening the microphone.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mikrofon wird geöffnet."}},"es":{"stringUnit":{"state":"translated","value":"Abriendo el micrófono."}},"it":{"stringUnit":{"state":"translated","value":"Apertura del microfono."}},"fr":{"stringUnit":{"state":"translated","value":"Ouverture du microphone."}}}},
    "Recording": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aufnahme"}},"es":{"stringUnit":{"state":"translated","value":"Grabando"}},"it":{"stringUnit":{"state":"translated","value":"Registrazione"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrement"}}}},
    "Waiting for the speech model": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Warte auf das Sprachmodell"}},"es":{"stringUnit":{"state":"translated","value":"Esperando al modelo de voz"}},"it":{"stringUnit":{"state":"translated","value":"In attesa del modello vocale"}},"fr":{"stringUnit":{"state":"translated","value":"En attente du modèle vocal"}}}},
    "Transcribing": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wird transkribiert"}},"es":{"stringUnit":{"state":"translated","value":"Transcribiendo"}},"it":{"stringUnit":{"state":"translated","value":"Trascrizione in corso"}},"fr":{"stringUnit":{"state":"translated","value":"Transcription en cours"}}}},
    "Your recording is held in memory. Transcription starts the moment the model finishes loading.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine Aufnahme bleibt im Arbeitsspeicher. Die Transkription beginnt, sobald das Modell geladen ist."}},"es":{"stringUnit":{"state":"translated","value":"La grabación se mantiene en memoria. La transcripción empezará en cuanto termine de cargarse el modelo."}},"it":{"stringUnit":{"state":"translated","value":"La registrazione resta in memoria. La trascrizione inizierà non appena il modello avrà terminato il caricamento."}},"fr":{"stringUnit":{"state":"translated","value":"Votre enregistrement est conservé en mémoire. La transcription commencera dès que le modèle sera chargé."}}}},
    "Recognizing speech on this Mac. %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Spracherkennung auf diesem Mac. %@"}},"es":{"stringUnit":{"state":"translated","value":"Reconociendo voz en este Mac. %@"}},"it":{"stringUnit":{"state":"translated","value":"Riconoscimento vocale su questo Mac. %@"}},"fr":{"stringUnit":{"state":"translated","value":"Reconnaissance vocale sur ce Mac. %@"}}}},
    "Inserting": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wird eingefügt"}},"es":{"stringUnit":{"state":"translated","value":"Insertando"}},"it":{"stringUnit":{"state":"translated","value":"Inserimento"}},"fr":{"stringUnit":{"state":"translated","value":"Insertion"}}}},
    "Putting the text where you were typing.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Text wird an der bisherigen Eingabestelle eingefügt."}},"es":{"stringUnit":{"state":"translated","value":"Insertando el texto donde estabas escribiendo."}},"it":{"stringUnit":{"state":"translated","value":"Inserimento del testo nel punto in cui stavi scrivendo."}},"fr":{"stringUnit":{"state":"translated","value":"Insertion du texte là où vous écriviez."}}}},
    "Hold %@ to record.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Halte %@ zum Aufnehmen gedrückt."}},"es":{"stringUnit":{"state":"translated","value":"Mantén pulsado %@ para grabar."}},"it":{"stringUnit":{"state":"translated","value":"Tieni premuto %@ per registrare."}},"fr":{"stringUnit":{"state":"translated","value":"Maintenez %@ enfoncé pour enregistrer."}}}},
    "Press %@ to start recording.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Drücke %@, um die Aufnahme zu starten."}},"es":{"stringUnit":{"state":"translated","value":"Pulsa %@ para empezar a grabar."}},"it":{"stringUnit":{"state":"translated","value":"Premi %@ per iniziare a registrare."}},"fr":{"stringUnit":{"state":"translated","value":"Appuyez sur %@ pour commencer l’enregistrement."}}}},
    "Release %@ to finish.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Lass %@ los, um die Aufnahme zu beenden."}},"es":{"stringUnit":{"state":"translated","value":"Suelta %@ para terminar."}},"it":{"stringUnit":{"state":"translated","value":"Rilascia %@ per terminare."}},"fr":{"stringUnit":{"state":"translated","value":"Relâchez %@ pour terminer."}}}},
    "Press %@ again to finish.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Drücke %@ erneut, um die Aufnahme zu beenden."}},"es":{"stringUnit":{"state":"translated","value":"Pulsa %@ de nuevo para terminar."}},"it":{"stringUnit":{"state":"translated","value":"Premi di nuovo %@ per terminare."}},"fr":{"stringUnit":{"state":"translated","value":"Appuyez de nouveau sur %@ pour terminer."}}}},
    "%1$@ left, until %2$@. %3$@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Noch %1$@, bis %2$@. %3$@"}},"es":{"stringUnit":{"state":"translated","value":"Quedan %1$@, hasta el %2$@. %3$@"}},"it":{"stringUnit":{"state":"translated","value":"Restano %1$@, fino al %2$@. %3$@"}},"fr":{"stringUnit":{"state":"translated","value":"Il reste %1$@, jusqu’au %2$@. %3$@"}}}},
    "%1$@ · %2$lld Hz · %3$lld ch": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%1$@ · %2$lld Hz · %3$lld Kan."}},"es":{"stringUnit":{"state":"translated","value":"%1$@ · %2$lld Hz · %3$lld canales"}},"it":{"stringUnit":{"state":"translated","value":"%1$@ · %2$lld Hz · %3$lld canali"}},"fr":{"stringUnit":{"state":"translated","value":"%1$@ · %2$lld Hz · %3$lld canaux"}}}},
    "Some fragments in the last result are worth checking. The text is already in place.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einige Stellen im letzten Ergebnis solltest du prüfen. Der Text wurde bereits eingefügt."}},"es":{"stringUnit":{"state":"translated","value":"Conviene revisar algunos fragmentos del último resultado. El texto ya está insertado."}},"it":{"stringUnit":{"state":"translated","value":"Vale la pena controllare alcuni frammenti dell’ultimo risultato. Il testo è già stato inserito."}},"fr":{"stringUnit":{"state":"translated","value":"Certains fragments du dernier résultat méritent une vérification. Le texte est déjà inséré."}}}},
    "The trial ended %@. A license brings it back, on this Mac and one more.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Testphase endete am %@. Eine Lizenz aktiviert Witness auf diesem und einem weiteren Mac."}},"es":{"stringUnit":{"state":"translated","value":"El periodo de prueba terminó el %@. Una licencia reactiva Witness en este Mac y en otro más."}},"it":{"stringUnit":{"state":"translated","value":"Il periodo di prova è terminato il %@. Una licenza riattiva Witness su questo Mac e su un altro."}},"fr":{"stringUnit":{"state":"translated","value":"La période d’essai s’est terminée le %@. Une licence réactive Witness sur ce Mac et sur un autre."}}}},
    "The speech model is not ready": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprachmodell ist nicht bereit"}},"es":{"stringUnit":{"state":"translated","value":"El modelo de voz no está listo"}},"it":{"stringUnit":{"state":"translated","value":"Il modello vocale non è pronto"}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle vocal n’est pas prêt"}}}},
    "The speech model is ready. Hold %@ and speak — the text lands where your cursor is.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprachmodell ist bereit. Halte %@ gedrückt und sprich – der Text erscheint an der Cursorposition."}},"es":{"stringUnit":{"state":"translated","value":"El modelo de voz está listo. Mantén pulsado %@ y habla; el texto aparecerá donde esté el cursor."}},"it":{"stringUnit":{"state":"translated","value":"Il modello vocale è pronto. Tieni premuto %@ e parla: il testo apparirà nella posizione del cursore."}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle vocal est prêt. Maintenez %@ enfoncé et parlez : le texte apparaîtra à l’emplacement du curseur."}}}},
    "Nothing was inserted: the focus is in a password field. The text is here and was not copied.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nichts wurde eingefügt: Der Fokus befindet sich in einem Passwortfeld. Der Text ist weiterhin hier und wurde nicht kopiert."}},"es":{"stringUnit":{"state":"translated","value":"No se ha insertado nada porque el cursor está en un campo de contraseña. El texto está aquí y no se ha copiado."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato inserito nulla perché il cursore si trova in un campo password. Il testo è qui e non è stato copiato."}},"fr":{"stringUnit":{"state":"translated","value":"Rien n’a été inséré, car le curseur se trouve dans un champ de mot de passe. Le texte est ici et n’a pas été copié."}}}},
    "Copied to the clipboard. Grant Accessibility access to have it typed for you.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"In die Zwischenablage kopiert. Erlaube den Bedienungshilfen-Zugriff, damit Witness den Text für dich eingibt."}},"es":{"stringUnit":{"state":"translated","value":"Copiado al portapapeles. Concede acceso a Accesibilidad para que Witness lo escriba por ti."}},"it":{"stringUnit":{"state":"translated","value":"Copiato negli appunti. Concedi l’accesso ad Accessibilità affinché Witness lo inserisca per te."}},"fr":{"stringUnit":{"state":"translated","value":"Copié dans le presse-papiers. Accordez l’accès à Accessibilité pour que Witness saisisse le texte à votre place."}}}},
    "Copied to the clipboard — there was no other application to put it in.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"In die Zwischenablage kopiert – es gab keine andere App zum Einfügen."}},"es":{"stringUnit":{"state":"translated","value":"Copiado al portapapeles: no había otra aplicación donde insertarlo."}},"it":{"stringUnit":{"state":"translated","value":"Copiato negli appunti: non c’era un’altra applicazione in cui inserirlo."}},"fr":{"stringUnit":{"state":"translated","value":"Copié dans le presse-papiers : aucune autre application ne pouvait le recevoir."}}}},
    "Settings could not be read: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einstellungen konnten nicht gelesen werden: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se han podido leer los ajustes: %@"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile leggere le impostazioni: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de lire les réglages : %@"}}}},
    "Settings could not be saved: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einstellungen konnten nicht gespeichert werden: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se han podido guardar los ajustes: %@"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile salvare le impostazioni: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible d’enregistrer les réglages : %@"}}}},
    "The dictionary could not be read: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Wörterbuch konnte nicht gelesen werden: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido leer el diccionario: %@"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile leggere il dizionario: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de lire le dictionnaire : %@"}}}},
    "The dictionary could not be saved: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Wörterbuch konnte nicht gespeichert werden: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido guardar el diccionario: %@"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile salvare il dizionario: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible d’enregistrer le dictionnaire : %@"}}}},
    "The license record could not be read: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Lizenzdatensatz konnte nicht gelesen werden: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido leer la información de la licencia: %@"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile leggere i dati della licenza: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de lire les informations de licence : %@"}}}},
    "The license record could not be saved: %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Lizenzdatensatz konnte nicht gespeichert werden: %@"}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido guardar la información de la licencia: %@"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile salvare i dati della licenza: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible d’enregistrer les informations de licence : %@"}}}},
    "That address does not look complete. The key is sent to it, so a typo means it goes nowhere.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Adresse scheint unvollständig zu sein. Prüfe sie auf Tippfehler."}},"es":{"stringUnit":{"state":"translated","value":"Esa dirección parece incompleta. La clave se enviará allí, así que comprueba que no haya ningún error."}},"it":{"stringUnit":{"state":"translated","value":"L’indirizzo sembra incompleto. La chiave verrà inviata lì, quindi controlla che non ci siano errori."}},"fr":{"stringUnit":{"state":"translated","value":"Cette adresse semble incomplète. La clé y sera envoyée : vérifiez qu’elle ne contient aucune erreur."}}}},
    "This license already covers two Macs. Release one of them before activating a third.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Lizenz wird bereits auf zwei Macs verwendet. Entferne einen davon, bevor du einen dritten aktivierst."}},"es":{"stringUnit":{"state":"translated","value":"Esta licencia ya se utiliza en dos Mac. Libera uno de ellos antes de activar un tercero."}},"it":{"stringUnit":{"state":"translated","value":"Questa licenza è già usata su due Mac. Liberane uno prima di attivarne un terzo."}},"fr":{"stringUnit":{"state":"translated","value":"Cette licence est déjà utilisée sur deux Mac. Libérez l’un d’eux avant d’en activer un troisième."}}}},
    "The activation service replied with something unreadable.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Antwort des Aktivierungsdienstes konnte nicht gelesen werden."}},"es":{"stringUnit":{"state":"translated","value":"El servicio de activación ha enviado una respuesta que Witness no puede interpretar."}},"it":{"stringUnit":{"state":"translated","value":"Il servizio di attivazione ha inviato una risposta che Witness non riesce a interpretare."}},"fr":{"stringUnit":{"state":"translated","value":"Le service d’activation a envoyé une réponse que Witness ne peut pas interpréter."}}}},
    "This address or this Mac has already had the free trial. A license keeps it dictating: €99 once, or €49 a year, both covering two Macs.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Für diese Adresse oder diesen Mac wurde die Testphase bereits genutzt. Eine Lizenz kostet einmalig 99 € oder 49 € pro Jahr und gilt für zwei Macs."}},"es":{"stringUnit":{"state":"translated","value":"Esta dirección o este Mac ya ha utilizado la prueba gratuita. Para seguir dictando, elige una licencia: 99 € en un único pago o 49 € al año, ambas para dos Mac."}},"it":{"stringUnit":{"state":"translated","value":"Questo indirizzo o questo Mac ha già utilizzato la prova gratuita. Per continuare a dettare, scegli una licenza: 99 € una tantum oppure 49 € all’anno, entrambe valide per due Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Cette adresse ou ce Mac a déjà bénéficié de l’essai gratuit. Pour continuer à dicter, choisissez une licence : 99 € en une fois ou 49 € par an, toutes deux valables pour deux Mac."}}}},
    "the shortcut is already used by macOS or another app": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"das Tastenkürzel wird bereits von macOS oder einer anderen App verwendet"}},"es":{"stringUnit":{"state":"translated","value":"macOS u otra app ya utiliza este atajo"}},"it":{"stringUnit":{"state":"translated","value":"la scorciatoia è già usata da macOS o da un’altra app"}},"fr":{"stringUnit":{"state":"translated","value":"ce raccourci est déjà utilisé par macOS ou une autre app"}}}},
    "the previous application": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"die vorherige App"}},"es":{"stringUnit":{"state":"translated","value":"la aplicación anterior"}},"it":{"stringUnit":{"state":"translated","value":"l’app precedente"}},"fr":{"stringUnit":{"state":"translated","value":"l’app précédente"}}}},
    " — %lld%% of about %@": {"localizations":{"de":{"stringUnit":{"state":"translated","value":" – %lld %% von etwa %@"}},"es":{"stringUnit":{"state":"translated","value":" — %lld%% de unos %@"}},"it":{"stringUnit":{"state":"translated","value":" — %lld%% di circa %@"}},"fr":{"stringUnit":{"state":"translated","value":" — %lld%% sur environ %@"}}}},
    "Copied to the clipboard: that application would not accept the text directly.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"In die Zwischenablage kopiert: Diese App hat den Text nicht direkt angenommen."}},"es":{"stringUnit":{"state":"translated","value":"Copiado al portapapeles: esa aplicación no ha aceptado el texto directamente."}},"it":{"stringUnit":{"state":"translated","value":"Copiato negli appunti: l’applicazione non ha accettato direttamente il testo."}},"fr":{"stringUnit":{"state":"translated","value":"Copié dans le presse-papiers : cette application n’a pas accepté le texte directement."}}}},
    "Copied to the clipboard: you moved to a different application while this was being prepared.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"In die Zwischenablage kopiert: Du hast während der Verarbeitung zu einer anderen App gewechselt."}},"es":{"stringUnit":{"state":"translated","value":"Copiado al portapapeles: cambiaste de aplicación mientras se preparaba el texto."}},"it":{"stringUnit":{"state":"translated","value":"Copiato negli appunti: sei passato a un’altra applicazione mentre il testo veniva preparato."}},"fr":{"stringUnit":{"state":"translated","value":"Copié dans le presse-papiers : vous avez changé d’application pendant la préparation du texte."}}}},
    "It ran out %@. Renewing unlocks dictation again; nothing on this Mac was touched.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sie ist am %@ abgelaufen. Eine Verlängerung schaltet das Diktieren wieder frei; lokale Daten wurden nicht verändert."}},"es":{"stringUnit":{"state":"translated","value":"Caducó el %@. La renovación vuelve a activar el dictado; no se ha modificado nada en este Mac."}},"it":{"stringUnit":{"state":"translated","value":"È scaduta il %@. Il rinnovo riattiva la dettatura; nulla su questo Mac è stato modificato."}},"fr":{"stringUnit":{"state":"translated","value":"Elle a expiré le %@. Le renouvellement réactive la dictée ; rien n’a été modifié sur ce Mac."}}}},
    "Licensed to %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Lizenziert für %@."}},"es":{"stringUnit":{"state":"translated","value":"Licencia de %@."}},"it":{"stringUnit":{"state":"translated","value":"Licenza di %@."}},"fr":{"stringUnit":{"state":"translated","value":"Licence de %@."}}}},
    "Nothing was recorded yet — Witness is downloading the speech model%@. It happens once, and afterwards recognition runs entirely on this Mac. Hold %@ again when it is here; Witness will say so.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Noch nichts aufgenommen – Witness lädt das Sprachmodell%@. Dies geschieht einmalig, danach läuft die Erkennung vollständig auf diesem Mac. Halte %@ erneut gedrückt, sobald es bereit ist."}},"es":{"stringUnit":{"state":"translated","value":"Todavía no se ha grabado nada: Witness está descargando el modelo de voz%@. Solo ocurre una vez; después, el reconocimiento se ejecuta por completo en este Mac. Vuelve a mantener pulsado %@ cuando termine; Witness te avisará."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato ancora registrato nulla: Witness sta scaricando il modello vocale%@. Succede una sola volta; in seguito il riconoscimento avviene interamente su questo Mac. Tieni di nuovo premuto %@ quando sarà pronto; Witness ti avviserà."}},"fr":{"stringUnit":{"state":"translated","value":"Rien n’a encore été enregistré : Witness télécharge le modèle vocal%@. Cette opération n’a lieu qu’une fois ; la reconnaissance s’effectuera ensuite entièrement sur ce Mac. Maintenez de nouveau %@ enfoncé lorsqu’il sera prêt ; Witness vous préviendra."}}}},
    "Nothing was recorded yet — macOS is preparing the speech model for this Mac. It happens once per macOS version and takes a few minutes. Hold %@ again when it is here; Witness will say so.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Noch nichts aufgenommen – macOS bereitet das Sprachmodell für diesen Mac vor. Dies geschieht einmal pro macOS-Version und dauert einige Minuten. Halte %@ danach erneut gedrückt."}},"es":{"stringUnit":{"state":"translated","value":"Todavía no se ha grabado nada: macOS está preparando el modelo de voz para este Mac. Ocurre una vez por versión de macOS y tarda unos minutos. Vuelve a mantener pulsado %@ cuando termine; Witness te avisará."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato ancora registrato nulla: macOS sta preparando il modello vocale per questo Mac. Succede una volta per ogni versione di macOS e richiede alcuni minuti. Tieni di nuovo premuto %@ quando sarà pronto; Witness ti avviserà."}},"fr":{"stringUnit":{"state":"translated","value":"Rien n’a encore été enregistré : macOS prépare le modèle vocal pour ce Mac. Cette opération a lieu une fois par version de macOS et prend quelques minutes. Maintenez de nouveau %@ enfoncé lorsqu’il sera prêt ; Witness vous préviendra."}}}},
    "Nothing was recorded yet — the speech model is loading. That takes seconds. Hold %@ again in a moment.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Noch nichts aufgenommen – das Sprachmodell wird geladen. Das dauert nur Sekunden. Halte %@ gleich erneut gedrückt."}},"es":{"stringUnit":{"state":"translated","value":"Todavía no se ha grabado nada: el modelo de voz se está cargando. Tardará unos segundos. Vuelve a mantener pulsado %@ dentro de un momento."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato ancora registrato nulla: il modello vocale si sta caricando. Richiede pochi secondi. Tra un momento tieni di nuovo premuto %@."}},"fr":{"stringUnit":{"state":"translated","value":"Rien n’a encore été enregistré : le modèle vocal est en cours de chargement. Cela prend quelques secondes. Maintenez de nouveau %@ enfoncé dans un instant."}}}},
    "Nothing was recorded yet — the speech model is not on this Mac. The download has just started: about %@, once. The menu bar shows how far it has got and how long is left. Hold %@ again when it is here; Witness will say so.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Noch nichts aufgenommen – das Sprachmodell fehlt auf diesem Mac. Der einmalige Download von etwa %@ wurde gestartet. Die Menüleiste zeigt, wie weit er ist und wie lange es noch dauert. Halte %@ danach erneut gedrückt."}},"es":{"stringUnit":{"state":"translated","value":"Todavía no se ha grabado nada: el modelo de voz no está en este Mac. La descarga acaba de empezar: unos %@, una sola vez. La barra de menús muestra el progreso y el tiempo restante. Vuelve a mantener pulsado %@ cuando termine; Witness te avisará."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato ancora registrato nulla: il modello vocale non è presente su questo Mac. Il download è appena iniziato: circa %@, una sola volta. La barra dei menu mostra l’avanzamento e il tempo restante. Tieni di nuovo premuto %@ quando sarà pronto; Witness ti avviserà."}},"fr":{"stringUnit":{"state":"translated","value":"Rien n’a encore été enregistré : le modèle vocal n’est pas présent sur ce Mac. Le téléchargement vient de commencer : environ %@, une seule fois. La barre des menus indique la progression et le temps restant. Maintenez de nouveau %@ enfoncé lorsqu’il sera prêt ; Witness vous préviendra."}}}},
    "That key did not verify, so nothing was changed.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Schlüssel konnte nicht bestätigt werden. Es wurde nichts geändert."}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido verificar la clave, por lo que no se ha cambiado nada."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile verificare la chiave, quindi non è cambiato nulla."}},"fr":{"stringUnit":{"state":"translated","value":"La clé n’a pas pu être vérifiée. Rien n’a donc été modifié."}}}},
    "That key was issued for a different Mac, so nothing was changed.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Schlüssel wurde für einen anderen Mac ausgestellt. Es wurde nichts geändert."}},"es":{"stringUnit":{"state":"translated","value":"La clave se emitió para otro Mac, por lo que no se ha cambiado nada."}},"it":{"stringUnit":{"state":"translated","value":"La chiave è stata emessa per un altro Mac, quindi non è cambiato nulla."}},"fr":{"stringUnit":{"state":"translated","value":"La clé a été émise pour un autre Mac. Rien n’a donc été modifié."}}}},
    "That request was missing the Mac or the key it belongs to.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"In der Anfrage fehlte der Mac oder der zugehörige Schlüssel."}},"es":{"stringUnit":{"state":"translated","value":"Falta el Mac o la clave correspondiente en la solicitud."}},"it":{"stringUnit":{"state":"translated","value":"Nella richiesta manca il Mac o la chiave corrispondente."}},"fr":{"stringUnit":{"state":"translated","value":"Le Mac ou la clé correspondante manque dans la demande."}}}},
    "The activation service has no record of that key.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Aktivierungsdienst kennt diesen Schlüssel nicht."}},"es":{"stringUnit":{"state":"translated","value":"El servicio de activación no encuentra esa clave."}},"it":{"stringUnit":{"state":"translated","value":"Il servizio di attivazione non trova questa chiave."}},"fr":{"stringUnit":{"state":"translated","value":"Le service d’activation ne trouve pas cette clé."}}}},
    "The activation service refused this request (%lld). Paste a key from your email instead, or write to support.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Aktivierungsdienst hat die Anfrage abgelehnt (%lld). Füge stattdessen einen Schlüssel aus deiner E-Mail ein oder kontaktiere den Support."}},"es":{"stringUnit":{"state":"translated","value":"El servicio de activación ha rechazado la solicitud (%lld). Pega una clave del correo que recibiste o escribe al equipo de asistencia."}},"it":{"stringUnit":{"state":"translated","value":"Il servizio di attivazione ha rifiutato la richiesta (%lld). Incolla una chiave ricevuta via email oppure contatta l’assistenza."}},"fr":{"stringUnit":{"state":"translated","value":"Le service d’activation a refusé la demande (%lld). Collez une clé reçue par e-mail ou contactez l’assistance."}}}},
    "This build carries no license authority key, so it cannot check any license. It is a development build.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Entwicklungs-Version enthält keinen öffentlichen Lizenzschlüssel und kann keine Lizenz prüfen."}},"es":{"stringUnit":{"state":"translated","value":"Esta compilación no contiene la clave necesaria para verificar licencias. Es una versión de desarrollo."}},"it":{"stringUnit":{"state":"translated","value":"Questa build non contiene la chiave necessaria per verificare le licenze. È una versione di sviluppo."}},"fr":{"stringUnit":{"state":"translated","value":"Cette version ne contient pas la clé nécessaire pour vérifier les licences. Il s’agit d’une version de développement."}}}},
    "This build has no activation service. Paste a license key instead, or use a build from the product website.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Version hat keinen Aktivierungsdienst. Füge einen Lizenzschlüssel ein oder verwende eine Version von der Produktwebsite."}},"es":{"stringUnit":{"state":"translated","value":"Esta compilación no tiene servicio de activación. Pega una clave de licencia o instala una versión descargada del sitio web del producto."}},"it":{"stringUnit":{"state":"translated","value":"Questa build non dispone del servizio di attivazione. Incolla una chiave di licenza oppure installa una versione scaricata dal sito del prodotto."}},"fr":{"stringUnit":{"state":"translated","value":"Cette version ne dispose d’aucun service d’activation. Collez une clé de licence ou installez une version téléchargée depuis le site du produit."}}}},
    "This build sent an identifier the activation service does not recognize. Update Witness and try again.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Version hat eine unbekannte Kennung gesendet. Aktualisiere Witness und versuche es erneut."}},"es":{"stringUnit":{"state":"translated","value":"Esta versión ha enviado un identificador que el servicio de activación no reconoce. Actualiza Witness e inténtalo de nuevo."}},"it":{"stringUnit":{"state":"translated","value":"Questa versione ha inviato un identificatore che il servizio di attivazione non riconosce. Aggiorna Witness e riprova."}},"fr":{"stringUnit":{"state":"translated","value":"Cette version a envoyé un identifiant que le service d’activation ne reconnaît pas. Mettez Witness à jour et réessayez."}}}},
    "This key did not verify. It may have been edited in transit — paste it again straight from the email.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Schlüssel konnte nicht bestätigt werden. Füge ihn erneut direkt aus der E-Mail ein."}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido verificar la clave. Puede haberse modificado al copiarla: vuelve a pegarla directamente desde el correo."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile verificare la chiave. Potrebbe essere stata modificata durante la copia: incollala di nuovo direttamente dall’email."}},"fr":{"stringUnit":{"state":"translated","value":"La clé n’a pas pu être vérifiée. Elle a peut-être été modifiée lors de la copie : recollez-la directement depuis l’e-mail."}}}},
    "This key is version %@, which this build does not know how to read. Update Witness.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Schlüssel hat Version %@, die diese App-Version nicht lesen kann. Aktualisiere Witness."}},"es":{"stringUnit":{"state":"translated","value":"Esta clave utiliza la versión %@, que esta versión de Witness no sabe leer. Actualiza Witness."}},"it":{"stringUnit":{"state":"translated","value":"Questa chiave usa la versione %@, che questa versione di Witness non sa leggere. Aggiorna Witness."}},"fr":{"stringUnit":{"state":"translated","value":"Cette clé utilise la version %@, que cette version de Witness ne sait pas lire. Mettez Witness à jour."}}}},
    "This key was issued for a different Mac. Each Mac gets its own key, and a license covers two.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Schlüssel wurde für einen anderen Mac ausgestellt. Jeder Mac erhält einen eigenen Schlüssel; eine Lizenz gilt für zwei Macs."}},"es":{"stringUnit":{"state":"translated","value":"Esta clave se emitió para otro Mac. Cada Mac recibe su propia clave y una licencia cubre dos equipos."}},"it":{"stringUnit":{"state":"translated","value":"Questa chiave è stata emessa per un altro Mac. Ogni Mac riceve la propria chiave e una licenza copre due computer."}},"fr":{"stringUnit":{"state":"translated","value":"Cette clé a été émise pour un autre Mac. Chaque Mac reçoit sa propre clé et une licence couvre deux appareils."}}}},
    "This key's dates do not make sense, which means it was not issued by us.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Datumsangaben dieses Schlüssels sind ungültig. Er wurde nicht von uns ausgestellt."}},"es":{"stringUnit":{"state":"translated","value":"Las fechas de esta clave no son válidas, por lo que no ha sido emitida por Witness."}},"it":{"stringUnit":{"state":"translated","value":"Le date di questa chiave non sono valide, quindi la chiave non è stata emessa da Witness."}},"fr":{"stringUnit":{"state":"translated","value":"Les dates de cette clé ne sont pas valides. Elle n’a donc pas été émise par Witness."}}}},
    "Your lifetime license covers version %1$@ and every update to it. This is version %2$@. Version %1$@ keeps working forever.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine Dauerlizenz gilt für Version %1$@ und alle zugehörigen Updates. Dies ist Version %2$@. Version %1$@ funktioniert dauerhaft weiter."}},"es":{"stringUnit":{"state":"translated","value":"Tu licencia de por vida cubre la versión %1$@ y todas sus actualizaciones. Esta es la versión %2$@. La versión %1$@ seguirá funcionando para siempre."}},"it":{"stringUnit":{"state":"translated","value":"La licenza a vita copre la versione %1$@ e tutti i relativi aggiornamenti. Questa è la versione %2$@. La versione %1$@ continuerà a funzionare per sempre."}},"fr":{"stringUnit":{"state":"translated","value":"Votre licence à vie couvre la version %1$@ et toutes ses mises à jour. Il s’agit de la version %2$@. La version %1$@ continuera de fonctionner indéfiniment."}}}},
    "a shortcut needs at least one of ⌘ ⌥ ⌃ ⇧, or it would take that key away from every app": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"ein Tastenkürzel benötigt mindestens eine der Tasten ⌘ ⌥ ⌃ ⇧"}},"es":{"stringUnit":{"state":"translated","value":"el atajo debe incluir al menos una de estas teclas: ⌘ ⌥ ⌃ ⇧; de lo contrario, esa tecla dejaría de funcionar en las demás apps"}},"it":{"stringUnit":{"state":"translated","value":"la scorciatoia deve includere almeno uno dei tasti ⌘ ⌥ ⌃ ⇧, altrimenti quel tasto non sarebbe più disponibile nelle altre app"}},"fr":{"stringUnit":{"state":"translated","value":"le raccourci doit inclure au moins l’une des touches ⌘ ⌥ ⌃ ⇧ ; sinon, cette touche ne serait plus disponible dans les autres apps"}}}},
    "it answered with an error (%lld).": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"der Dienst antwortete mit einem Fehler (%lld)."}},"es":{"stringUnit":{"state":"translated","value":"ha respondido con un error (%lld)."}},"it":{"stringUnit":{"state":"translated","value":"ha risposto con un errore (%lld)."}},"fr":{"stringUnit":{"state":"translated","value":"a renvoyé une erreur (%lld)."}}}},
    "it is asking us to wait a moment. Try again shortly.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"der Dienst bittet um etwas Geduld. Versuche es gleich erneut."}},"es":{"stringUnit":{"state":"translated","value":"ha pedido que esperemos un momento. Vuelve a intentarlo dentro de poco."}},"it":{"stringUnit":{"state":"translated","value":"ha chiesto di attendere un momento. Riprova tra poco."}},"fr":{"stringUnit":{"state":"translated","value":"demande de patienter un instant. Réessayez dans quelques instants."}}}},
    "macOS cannot find this copy of the app to start it. Move Witness to your Applications folder and try again.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"macOS kann diese App-Version nicht zum Starten finden. Verschiebe Witness in den Programme-Ordner und versuche es erneut."}},"es":{"stringUnit":{"state":"translated","value":"macOS no encuentra esta copia de la app para abrirla. Mueve Witness a la carpeta Aplicaciones e inténtalo de nuevo."}},"it":{"stringUnit":{"state":"translated","value":"macOS non trova questa copia dell’app. Sposta Witness nella cartella Applicazioni e riprova."}},"fr":{"stringUnit":{"state":"translated","value":"macOS ne trouve pas cette copie de l’app. Déplacez Witness dans le dossier Applications, puis réessayez."}}}},
    "macOS gave an answer this app does not recognize.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"macOS hat eine unbekannte Antwort geliefert."}},"es":{"stringUnit":{"state":"translated","value":"macOS ha dado una respuesta que la app no reconoce."}},"it":{"stringUnit":{"state":"translated","value":"macOS ha fornito una risposta che l’app non riconosce."}},"fr":{"stringUnit":{"state":"translated","value":"macOS a fourni une réponse que l’app ne reconnaît pas."}}}},
    "macOS is holding this off. Open Login Items in System Settings and allow Witness there.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"macOS verhindert dies. Öffne die Anmeldeobjekte in den Systemeinstellungen und erlaube Witness dort."}},"es":{"stringUnit":{"state":"translated","value":"macOS mantiene esta opción desactivada. Abre Ítems de inicio en Ajustes del Sistema y permite Witness allí."}},"it":{"stringUnit":{"state":"translated","value":"macOS mantiene questa opzione disattivata. Apri Elementi login in Impostazioni di Sistema e autorizza Witness."}},"fr":{"stringUnit":{"state":"translated","value":"macOS maintient cette option désactivée. Ouvrez Éléments d’ouverture dans Réglages Système et autorisez Witness."}}}},
    "macOS refused: %@ A build running from Xcode cannot open at login — move Witness to your Applications folder and open it from there.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"macOS hat abgelehnt: %@ Eine aus Xcode gestartete Version kann nicht automatisch geöffnet werden. Verschiebe Witness in den Programme-Ordner und starte es dort."}},"es":{"stringUnit":{"state":"translated","value":"macOS lo ha rechazado: %@ Una compilación ejecutada desde Xcode no puede abrirse al iniciar sesión; mueve Witness a la carpeta Aplicaciones y ábrelo desde allí."}},"it":{"stringUnit":{"state":"translated","value":"macOS ha rifiutato: %@ Una build eseguita da Xcode non può aprirsi all’accesso; sposta Witness nella cartella Applicazioni e aprilo da lì."}},"fr":{"stringUnit":{"state":"translated","value":"macOS a refusé : %@ Une version exécutée depuis Xcode ne peut pas s’ouvrir à la connexion ; déplacez Witness dans le dossier Applications et ouvrez-le depuis cet emplacement."}}}},
    "registration failed (OSStatus %d)": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Registrierung fehlgeschlagen (OSStatus %d)"}},"es":{"stringUnit":{"state":"translated","value":"no se ha podido registrar (OSStatus %d)"}},"it":{"stringUnit":{"state":"translated","value":"registrazione non riuscita (OSStatus %d)"}},"fr":{"stringUnit":{"state":"translated","value":"échec de l’enregistrement (OSStatus %d)"}}}},
    "the event handler could not be installed (OSStatus %d)": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"der Ereignishandler konnte nicht installiert werden (OSStatus %d)"}},"es":{"stringUnit":{"state":"translated","value":"no se ha podido instalar el controlador de eventos (OSStatus %d)"}},"it":{"stringUnit":{"state":"translated","value":"impossibile installare il gestore degli eventi (OSStatus %d)"}},"fr":{"stringUnit":{"state":"translated","value":"impossible d’installer le gestionnaire d’événements (OSStatus %d)"}}}},
    "the reply was not an HTTP response": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"die Antwort war keine HTTP-Antwort"}},"es":{"stringUnit":{"state":"translated","value":"la respuesta recibida no era una respuesta HTTP"}},"it":{"stringUnit":{"state":"translated","value":"la risposta ricevuta non era una risposta HTTP"}},"fr":{"stringUnit":{"state":"translated","value":"la réponse reçue n’était pas une réponse HTTP"}}}},
    "Audio stays in memory on this Mac. Nothing is written to disk during normal capture, and nothing you dictate is ever sent anywhere. A recording is discarded as soon as the app decides no review is needed, and otherwise when the review ends.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audio bleibt im Arbeitsspeicher dieses Macs. Bei einer normalen Aufnahme wird nichts auf die Festplatte geschrieben und keine Diktatinhalte werden versendet. Die Aufnahme wird gelöscht, sobald keine Überprüfung nötig ist – andernfalls nach Abschluss der Überprüfung."}},"es":{"stringUnit":{"state":"translated","value":"El audio permanece en la memoria de este Mac. Durante una grabación normal no se escribe nada en el disco y nada de lo que dictas se envía a ningún sitio. La grabación se descarta en cuanto la app determina que no necesita revisión o, si la necesita, cuando termina la revisión."}},"it":{"stringUnit":{"state":"translated","value":"L’audio resta nella memoria di questo Mac. Durante la registrazione normale non viene scritto nulla su disco e nulla di ciò che detti viene mai inviato altrove. La registrazione viene eliminata non appena l’app stabilisce che non serve una verifica oppure, se serve, al termine della verifica."}},"fr":{"stringUnit":{"state":"translated","value":"L’audio reste dans la mémoire de ce Mac. Rien n’est écrit sur le disque pendant l’enregistrement normal et rien de ce que vous dictez n’est jamais envoyé. L’enregistrement est supprimé dès que l’app détermine qu’aucune vérification n’est nécessaire ou, dans le cas contraire, à la fin de la vérification."}}}},
    "On, a result with nothing worth checking goes straight into the application you were typing in. Off, it waits in this menu for an explicit insert. A result that does need review always waits for you either way.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wenn aktiviert, wird ein Ergebnis ohne Prüfhinweise direkt in die zuvor verwendete App eingefügt. Wenn deaktiviert, wartet es in diesem Menü auf dein Einfügen. Ergebnisse mit Prüfhinweisen warten immer auf dich."}},"es":{"stringUnit":{"state":"translated","value":"Si está activado, un resultado sin nada que revisar se inserta directamente en la aplicación donde estabas escribiendo. Si está desactivado, espera en este menú hasta que lo insertes. Un resultado que necesita revisión siempre espera tu decisión."}},"it":{"stringUnit":{"state":"translated","value":"Se attiva, un risultato senza elementi da verificare viene inserito direttamente nell’applicazione in cui stavi scrivendo. Se disattiva, resta in questo menu finché non lo inserisci. Un risultato che richiede una verifica attende sempre la tua decisione."}},"fr":{"stringUnit":{"state":"translated","value":"Lorsque cette option est activée, un résultat sans élément à vérifier est inséré directement dans l’application où vous écriviez. Lorsqu’elle est désactivée, il reste dans ce menu jusqu’à votre demande d’insertion. Un résultat à vérifier attend toujours votre décision."}}}},
    "Without Accessibility access the text is copied to the clipboard instead. A development build loses this permission on every rebuild, because macOS keys it to the code signature.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ohne Bedienungshilfen-Zugriff wird der Text stattdessen in die Zwischenablage kopiert. Eine Entwicklungs-Version verliert diese Berechtigung nach jeder neuen Signatur."}},"es":{"stringUnit":{"state":"translated","value":"Sin acceso a Accesibilidad, el texto se copia al portapapeles. Una compilación de desarrollo pierde este permiso con cada recompilación porque macOS lo vincula a la firma del código."}},"it":{"stringUnit":{"state":"translated","value":"Senza l’accesso ad Accessibilità, il testo viene copiato negli appunti. Una build di sviluppo perde questa autorizzazione a ogni ricompilazione perché macOS la lega alla firma del codice."}},"fr":{"stringUnit":{"state":"translated","value":"Sans accès à Accessibilité, le texte est copié dans le presse-papiers. Une version de développement perd cette autorisation à chaque recompilation, car macOS la lie à la signature du code."}}}},
    "The review step appears only when a fragment is worth checking — an amount, a date, a name, a dictionary near-miss, or a word the app removed. When nothing is marked, the text is simply ready and the recording is discarded immediately.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Überprüfung erscheint nur für Stellen, die du prüfen solltest – etwa Beträge, Daten, Namen, ähnliche Wörterbucheinträge oder entfernte Wörter. Wenn nichts markiert ist, ist der Text sofort fertig und die Aufnahme wird verworfen."}},"es":{"stringUnit":{"state":"translated","value":"La revisión solo aparece cuando conviene comprobar un fragmento: un importe, una fecha, un nombre, una coincidencia aproximada del diccionario o una palabra eliminada por la app. Si no se marca nada, el texto queda listo y la grabación se descarta inmediatamente."}},"it":{"stringUnit":{"state":"translated","value":"La verifica appare solo quando vale la pena controllare un frammento: un importo, una data, un nome, una corrispondenza simile nel dizionario o una parola rimossa dall’app. Se non viene segnalato nulla, il testo è semplicemente pronto e la registrazione viene eliminata immediatamente."}},"fr":{"stringUnit":{"state":"translated","value":"La vérification apparaît uniquement lorsqu’un fragment mérite d’être contrôlé : un montant, une date, un nom, une correspondance proche du dictionnaire ou un mot supprimé par l’app. Si rien n’est signalé, le texte est simplement prêt et l’enregistrement est immédiatement supprimé."}}}},
    "Phase 6 adds the trial, activation, and licensing. Dictation itself is unchanged: the words still go straight into the application you were typing in, and everything about them still stays on this Mac.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Phase 6 ergänzt Testphase, Aktivierung und Lizenzierung. Das Diktieren bleibt unverändert: Der Text gelangt direkt in die zuvor verwendete App und alle Inhalte bleiben auf diesem Mac."}},"es":{"stringUnit":{"state":"translated","value":"La prueba, la activación y la licencia no cambian el dictado: el texto sigue apareciendo directamente en la aplicación donde estabas escribiendo y todo su contenido permanece en este Mac."}},"it":{"stringUnit":{"state":"translated","value":"Il periodo di prova, l’attivazione e la licenza non cambiano la dettatura: il testo continua ad apparire direttamente nell’app in cui stavi scrivendo e tutto il suo contenuto resta su questo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"L’essai, l’activation et la licence ne changent rien à la dictée : le texte apparaît toujours directement dans l’app où vous écriviez et tout son contenu reste sur ce Mac."}}}},
    "Debug builds only. Writes a file solely to the location you choose in the save panel; normal capture never touches the file system.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nur für Debug-Versionen. Eine Datei wird ausschließlich am im Speicherdialog gewählten Ort geschrieben; normale Aufnahmen greifen nicht auf das Dateisystem zu."}},"es":{"stringUnit":{"state":"translated","value":"Solo en compilaciones de depuración. Escribe un archivo únicamente en la ubicación que elijas en el panel de guardado; la captura normal nunca accede al sistema de archivos."}},"it":{"stringUnit":{"state":"translated","value":"Solo nelle build di debug. Scrive un file esclusivamente nella posizione scelta nel pannello di salvataggio; la normale acquisizione non accede mai al file system."}},"fr":{"stringUnit":{"state":"translated","value":"Uniquement dans les versions de débogage. Écrit un fichier seulement à l’emplacement choisi dans la fenêtre d’enregistrement ; la capture normale n’accède jamais au système de fichiers."}}}},
    "The shortcut is not registered, so the hotkey does nothing. Pick another combination.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Tastenkürzel ist nicht registriert und hat daher keine Wirkung. Wähle eine andere Kombination."}},"es":{"stringUnit":{"state":"translated","value":"El atajo no está registrado y no responde. Elige otra combinación."}},"it":{"stringUnit":{"state":"translated","value":"La scorciatoia non è registrata e non funziona. Scegli un’altra combinazione."}},"fr":{"stringUnit":{"state":"translated","value":"Le raccourci n’est pas enregistré et ne fonctionne pas. Choisissez une autre combinaison."}}}},
    "At least one of ⌘ ⌥ ⌃ ⇧ is required. A bare key would be taken away from every application on this Mac.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mindestens eine der Tasten ⌘ ⌥ ⌃ ⇧ ist erforderlich. Eine einzelne Taste würde in allen Apps dieses Macs blockiert."}},"es":{"stringUnit":{"state":"translated","value":"Se necesita al menos una tecla entre ⌘ ⌥ ⌃ ⇧. Una tecla sola dejaría de estar disponible en todas las aplicaciones de este Mac."}},"it":{"stringUnit":{"state":"translated","value":"È necessario almeno un tasto tra ⌘ ⌥ ⌃ ⇧. Un tasto senza modificatori verrebbe sottratto a tutte le applicazioni di questo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Au moins une touche parmi ⌘ ⌥ ⌃ ⇧ est requise. Une touche seule ne serait plus disponible dans les autres applications de ce Mac."}}}},
    "Witness needs Accessibility access to put text into other applications. Without it, results go to the clipboard.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Witness benötigt Bedienungshilfen-Zugriff, um Text in andere Apps einzufügen. Ohne diesen Zugriff werden Ergebnisse in die Zwischenablage kopiert."}},"es":{"stringUnit":{"state":"translated","value":"Witness necesita acceso a Accesibilidad para insertar texto en otras aplicaciones. Sin este permiso, los resultados se copian al portapapeles."}},"it":{"stringUnit":{"state":"translated","value":"Witness ha bisogno dell’accesso ad Accessibilità per inserire il testo in altre applicazioni. Senza questa autorizzazione, i risultati vengono copiati negli appunti."}},"fr":{"stringUnit":{"state":"translated","value":"Witness a besoin de l’accès à Accessibilité pour insérer du texte dans d’autres applications. Sans cette autorisation, les résultats sont copiés dans le presse-papiers."}}}},
    "Send my license key as soon as I have paid. I understand that I give up my right of withdrawal once delivery begins.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sende meinen Lizenzschlüssel sofort nach der Zahlung. Mir ist bewusst, dass mein Widerrufsrecht mit Beginn der Lieferung erlischt."}}}},
    "OK": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"OK"}},"es":{"stringUnit":{"state":"translated","value":"Aceptar"}},"it":{"stringUnit":{"state":"translated","value":"OK"}},"fr":{"stringUnit":{"state":"translated","value":"OK"}}}},
    "Getting the speech model": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprachmodell wird geladen"}},"es":{"stringUnit":{"state":"translated","value":"Descargando el modelo de voz"}},"it":{"stringUnit":{"state":"translated","value":"Download del modello vocale"}},"fr":{"stringUnit":{"state":"translated","value":"Téléchargement du modèle vocal"}}}},
    "Removing…": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wird entfernt …"}},"es":{"stringUnit":{"state":"translated","value":"Eliminando…"}},"it":{"stringUnit":{"state":"translated","value":"Rimozione…"}},"fr":{"stringUnit":{"state":"translated","value":"Suppression…"}}}},
    "Open Witness when I log in": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Witness beim Anmelden öffnen"}},"es":{"stringUnit":{"state":"translated","value":"Abrir Witness al iniciar sesión"}},"it":{"stringUnit":{"state":"translated","value":"Apri Witness all’accesso"}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrir Witness à l’ouverture de session"}}}},
    "Remove from this Mac": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Von diesem Mac entfernen"}},"es":{"stringUnit":{"state":"translated","value":"Eliminar de este Mac"}},"it":{"stringUnit":{"state":"translated","value":"Rimuovi da questo Mac"}},"fr":{"stringUnit":{"state":"translated","value":"Supprimer de ce Mac"}}}},
    "Continue with your email": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mit deiner E-Mail fortfahren"}},"es":{"stringUnit":{"state":"translated","value":"Continuar con tu correo electrónico"}},"it":{"stringUnit":{"state":"translated","value":"Continua con il tuo indirizzo email"}},"fr":{"stringUnit":{"state":"translated","value":"Continuer avec votre adresse e-mail"}}}},
    "Ready to use": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Bereit zur Nutzung"}},"es":{"stringUnit":{"state":"translated","value":"Listo para usar"}},"it":{"stringUnit":{"state":"translated","value":"Pronto all’uso"}},"fr":{"stringUnit":{"state":"translated","value":"Prêt à l’emploi"}}}},
    "Annual subscription": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Jahresabonnement"}},"es":{"stringUnit":{"state":"translated","value":"Suscripción anual"}},"it":{"stringUnit":{"state":"translated","value":"Abbonamento annuale"}},"fr":{"stringUnit":{"state":"translated","value":"Abonnement annuel"}}}},
    "Subscription not renewed": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Abonnement nicht verlängert"}},"es":{"stringUnit":{"state":"translated","value":"Suscripción no renovada"}},"it":{"stringUnit":{"state":"translated","value":"Abbonamento non rinnovato"}},"fr":{"stringUnit":{"state":"translated","value":"Abonnement non renouvelé"}}}},
    "Dictation keeps working until %@.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Diktieren funktioniert bis zum %@ weiter."}},"es":{"stringUnit":{"state":"translated","value":"El dictado seguirá funcionando hasta el %@."}},"it":{"stringUnit":{"state":"translated","value":"La dettatura continuerà a funzionare fino al %@."}},"fr":{"stringUnit":{"state":"translated","value":"La dictée continuera de fonctionner jusqu’au %@."}}}},
    "Your key ends today": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Schlüssel läuft heute ab"}},"es":{"stringUnit":{"state":"translated","value":"Tu clave caduca hoy"}},"it":{"stringUnit":{"state":"translated","value":"La tua chiave scade oggi"}},"fr":{"stringUnit":{"state":"translated","value":"Votre clé expire aujourd’hui"}}}},
    "Your key ends in %lld days": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Schlüssel läuft in %lld Tagen ab"}},"es":{"stringUnit":{"state":"translated","value":"Tu clave caduca en %lld días"}},"it":{"stringUnit":{"state":"translated","value":"La tua chiave scade tra %lld giorni"}},"fr":{"stringUnit":{"state":"translated","value":"Votre clé expire dans %lld jours"}}}},
    "The first three days are over. Enter your email address under Settings → License to carry on. No payment is needed at this step.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die ersten drei Tage sind vorbei. Gib deine E-Mail-Adresse unter Einstellungen → Lizenz ein, um weiterzumachen. Dafür ist keine Zahlung nötig."}},"es":{"stringUnit":{"state":"translated","value":"Los tres primeros días han terminado. Introduce tu correo electrónico en Ajustes → Licencia para continuar. No tienes que pagar en este paso."}},"it":{"stringUnit":{"state":"translated","value":"I primi tre giorni sono terminati. Inserisci il tuo indirizzo email in Impostazioni → Licenza per continuare. In questo passaggio non devi pagare."}},"fr":{"stringUnit":{"state":"translated","value":"Les trois premiers jours sont terminés. Saisissez votre adresse e-mail dans Réglages → Licence pour continuer. Aucun paiement n’est nécessaire à cette étape."}}}},
    "Witness could not renew its key, and the last one ran out %@. Open Settings → License to put it right.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Witness konnte den Schlüssel nicht erneuern, und der letzte ist am %@ abgelaufen. Öffne Einstellungen → Lizenz, um das zu beheben."}},"es":{"stringUnit":{"state":"translated","value":"Witness no ha podido renovar la clave y la anterior caducó el %@. Abre Ajustes → Licencia para solucionarlo."}},"it":{"stringUnit":{"state":"translated","value":"Witness non è riuscito a rinnovare la chiave e la precedente è scaduta il %@. Apri Impostazioni → Licenza per risolvere il problema."}},"fr":{"stringUnit":{"state":"translated","value":"Witness n’a pas pu renouveler la clé et la précédente a expiré le %@. Ouvrez Réglages → Licence pour résoudre le problème."}}}},
    "The activation service could not be reached: %@. Check your connection and try again.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Aktivierungsdienst war nicht erreichbar: %@. Prüfe deine Verbindung und versuche es erneut."}},"es":{"stringUnit":{"state":"translated","value":"No se ha podido conectar con el servicio de activación: %@. Comprueba la conexión e inténtalo de nuevo."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile contattare il servizio di attivazione: %@. Controlla la connessione e riprova."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de joindre le service d’activation : %@. Vérifiez votre connexion, puis réessayez."}}}},
    "This address has no active subscription. If you subscribed, check the payment under Manage subscription. A subscription that ended or was refunded no longer unlocks Witness.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zu dieser Adresse gibt es kein aktives Abonnement. Falls du abonniert hast, prüfe die Zahlung unter „Abonnement verwalten“. Ein beendetes oder erstattetes Abonnement schaltet Witness nicht mehr frei."}},"es":{"stringUnit":{"state":"translated","value":"No hay ninguna suscripción activa para esta dirección. Si te has suscrito, comprueba el pago en Gestionar suscripción. Una suscripción finalizada o reembolsada ya no desbloquea Witness."}},"it":{"stringUnit":{"state":"translated","value":"Non risulta alcun abbonamento attivo per questo indirizzo. Se ti sei abbonato, controlla il pagamento in Gestisci abbonamento. Un abbonamento terminato o rimborsato non sblocca più Witness."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun abonnement actif n’est associé à cette adresse. Si vous vous êtes abonné, vérifiez le paiement dans Gérer l’abonnement. Un abonnement arrivé à échéance ou remboursé ne déverrouille plus Witness."}}}},
    "Subscription": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Abonnement"}},"es":{"stringUnit":{"state":"translated","value":"Suscripción"}},"it":{"stringUnit":{"state":"translated","value":"Abbonamento"}},"fr":{"stringUnit":{"state":"translated","value":"Abonnement"}}}},
    "Manage subscription": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Abonnement verwalten"}},"es":{"stringUnit":{"state":"translated","value":"Gestionar suscripción"}},"it":{"stringUnit":{"state":"translated","value":"Gestisci abbonamento"}},"fr":{"stringUnit":{"state":"translated","value":"Gérer l’abonnement"}}}},
    "Check for updates automatically": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Automatisch nach Updates suchen"}},"es":{"stringUnit":{"state":"translated","value":"Buscar actualizaciones automáticamente"}},"it":{"stringUnit":{"state":"translated","value":"Controlla automaticamente gli aggiornamenti"}},"fr":{"stringUnit":{"state":"translated","value":"Rechercher automatiquement les mises à jour"}}}},
    "Once a day Witness asks GitHub whether a newer signed version exists, and offers it if so. Nothing is installed until you confirm. You can also check yourself with the button above.": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Einmal am Tag fragt Witness bei GitHub nach, ob es eine neuere signierte Version gibt, und bietet sie dir an. Installiert wird erst nach deiner Bestätigung. Du kannst auch selbst mit der Taste oben suchen."}},"es":{"stringUnit":{"state":"translated","value":"Una vez al día, Witness pregunta a GitHub si hay una versión firmada más reciente y te la ofrece si existe. No se instala nada hasta que lo confirmes. También puedes comprobarlo con el botón de arriba."}},"it":{"stringUnit":{"state":"translated","value":"Una volta al giorno Witness verifica su GitHub se esiste una versione firmata più recente e, in tal caso, la propone. Non viene installato nulla finché non confermi. Puoi anche controllare manualmente con il pulsante qui sopra."}},"fr":{"stringUnit":{"state":"translated","value":"Une fois par jour, Witness vérifie sur GitHub s’il existe une version signée plus récente et vous la propose le cas échéant. Rien n’est installé sans votre confirmation. Vous pouvez aussi vérifier avec le bouton ci-dessus."}}}},
    "Current": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktuell"}},"es":{"stringUnit":{"state":"translated","value":"Actual"}},"it":{"stringUnit":{"state":"translated","value":"Attuale"}},"fr":{"stringUnit":{"state":"translated","value":"Actuel"}}}},
    "Buffer capacity": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Pufferkapazität"}},"es":{"stringUnit":{"state":"translated","value":"Capacidad del búfer"}},"it":{"stringUnit":{"state":"translated","value":"Capacità del buffer"}},"fr":{"stringUnit":{"state":"translated","value":"Capacité du tampon"}}}},
    "Export last utterance": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Letzte Aufnahme exportieren"}},"es":{"stringUnit":{"state":"translated","value":"Exportar la última grabación"}},"it":{"stringUnit":{"state":"translated","value":"Esporta l’ultima registrazione"}},"fr":{"stringUnit":{"state":"translated","value":"Exporter le dernier enregistrement"}}}},
    "%1$lld Hz · mono · Float32": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%1$lld Hz · Mono · Float32"}},"es":{"stringUnit":{"state":"translated","value":"%1$lld Hz · mono · Float32"}},"it":{"stringUnit":{"state":"translated","value":"%1$lld Hz · mono · Float32"}},"fr":{"stringUnit":{"state":"translated","value":"%1$lld Hz · mono · Float32"}}}},
    "%1$lld Hz · %2$lld ch · Float32": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%1$lld Hz · %2$lld Kanäle · Float32"}},"es":{"stringUnit":{"state":"translated","value":"%1$lld Hz · %2$lld canales · Float32"}},"it":{"stringUnit":{"state":"translated","value":"%1$lld Hz · %2$lld canali · Float32"}},"fr":{"stringUnit":{"state":"translated","value":"%1$lld Hz · %2$lld canaux · Float32"}}}},
    "%.3f": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%.3f"}},"es":{"stringUnit":{"state":"translated","value":"%.3f"}},"it":{"stringUnit":{"state":"translated","value":"%.3f"}},"fr":{"stringUnit":{"state":"translated","value":"%.3f"}}}},
    "%.0f s": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%.0f s"}},"es":{"stringUnit":{"state":"translated","value":"%.0f s"}},"it":{"stringUnit":{"state":"translated","value":"%.0f s"}},"fr":{"stringUnit":{"state":"translated","value":"%.0f s"}}}},
    "%lld frames": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%lld Frames"}},"es":{"stringUnit":{"state":"translated","value":"%lld tramas"}},"it":{"stringUnit":{"state":"translated","value":"%lld frame"}},"fr":{"stringUnit":{"state":"translated","value":"%lld trames"}}}},
    "%.2f s": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%.2f s"}},"es":{"stringUnit":{"state":"translated","value":"%.2f s"}},"it":{"stringUnit":{"state":"translated","value":"%.2f s"}},"fr":{"stringUnit":{"state":"translated","value":"%.2f s"}}}},
    "%1$lld / %2$lld": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%1$lld / %2$lld"}},"es":{"stringUnit":{"state":"translated","value":"%1$lld / %2$lld"}},"it":{"stringUnit":{"state":"translated","value":"%1$lld / %2$lld"}},"fr":{"stringUnit":{"state":"translated","value":"%1$lld / %2$lld"}}}},
    "%.1f %%": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%.1f %%"}},"es":{"stringUnit":{"state":"translated","value":"%.1f %%"}},"it":{"stringUnit":{"state":"translated","value":"%.1f %%"}},"fr":{"stringUnit":{"state":"translated","value":"%.1f %%"}}}},
    "%.2f": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%.2f"}},"es":{"stringUnit":{"state":"translated","value":"%.2f"}},"it":{"stringUnit":{"state":"translated","value":"%.2f"}},"fr":{"stringUnit":{"state":"translated","value":"%.2f"}}}},
    "%lld Hz": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%lld Hz"}},"es":{"stringUnit":{"state":"translated","value":"%lld Hz"}},"it":{"stringUnit":{"state":"translated","value":"%lld Hz"}},"fr":{"stringUnit":{"state":"translated","value":"%lld Hz"}}}},
    "%lld": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%lld"}},"es":{"stringUnit":{"state":"translated","value":"%lld"}},"it":{"stringUnit":{"state":"translated","value":"%lld"}},"fr":{"stringUnit":{"state":"translated","value":"%lld"}}}},
    "Hotkey released": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Tastenkürzel losgelassen"}},"es":{"stringUnit":{"state":"translated","value":"Atajo soltado"}},"it":{"stringUnit":{"state":"translated","value":"Scorciatoia rilasciata"}},"fr":{"stringUnit":{"state":"translated","value":"Raccourci relâché"}}}},
    "Maximum duration reached": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Maximale Dauer erreicht"}},"es":{"stringUnit":{"state":"translated","value":"Duración máxima alcanzada"}},"it":{"stringUnit":{"state":"translated","value":"Durata massima raggiunta"}},"fr":{"stringUnit":{"state":"translated","value":"Durée maximale atteinte"}}}},
    "Interrupted": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Unterbrochen"}},"es":{"stringUnit":{"state":"translated","value":"Interrumpida"}},"it":{"stringUnit":{"state":"translated","value":"Interrotta"}},"fr":{"stringUnit":{"state":"translated","value":"Interrompue"}}}},
    "Surface normalization": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Oberflächennormalisierung"}},"es":{"stringUnit":{"state":"translated","value":"Formato tipográfico ajustado"}},"it":{"stringUnit":{"state":"translated","value":"Grafia uniformata"}},"fr":{"stringUnit":{"state":"translated","value":"Typographie harmonisée"}}}},
    "Boundary duplicate removed": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Duplikat an der Grenze entfernt"}},"es":{"stringUnit":{"state":"translated","value":"Repetición eliminada"}},"it":{"stringUnit":{"state":"translated","value":"Ripetizione rimossa"}},"fr":{"stringUnit":{"state":"translated","value":"Répétition supprimée"}}}},
    "Inferred punctuation": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Abgeleitete Zeichensetzung"}},"es":{"stringUnit":{"state":"translated","value":"Puntuación añadida"}},"it":{"stringUnit":{"state":"translated","value":"Punteggiatura aggiunta"}},"fr":{"stringUnit":{"state":"translated","value":"Ponctuation ajoutée"}}}},
    "Inferred paragraph break": {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Abgeleiteter Absatzumbruch"}},"es":{"stringUnit":{"state":"translated","value":"Salto de párrafo añadido"}},"it":{"stringUnit":{"state":"translated","value":"Interruzione di paragrafo aggiunta"}},"fr":{"stringUnit":{"state":"translated","value":"Saut de paragraphe ajouté"}}}},
    "Choose a model": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Modell auswählen"}},"es":{"stringUnit":{"state":"translated","value":"Elegir un modelo"}},"it":{"stringUnit":{"state":"translated","value":"Scegli un modello"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir un modèle"}}}},
    "Choose a speech model": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprachmodell auswählen"}},"es":{"stringUnit":{"state":"translated","value":"Elige un modelo de voz"}},"it":{"stringUnit":{"state":"translated","value":"Scegli un modello vocale"}},"fr":{"stringUnit":{"state":"translated","value":"Choisir un modèle vocal"}}}},
    "Try different models and choose the one that recognizes your speech best. They differ in speed, supported languages, recognition quality and size. A larger model does not always give a better result.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Probiere verschiedene Modelle aus und wähle das, das deine Sprache am besten erkennt. Sie unterscheiden sich in Geschwindigkeit, unterstützten Sprachen, Erkennungsqualität und Größe. Ein größeres Modell liefert nicht immer bessere Ergebnisse."}},"es":{"stringUnit":{"state":"translated","value":"Prueba distintos modelos y elige el que mejor reconozca tu voz. Se diferencian en velocidad, idiomas, calidad de reconocimiento y tamaño. Un modelo más grande no siempre ofrece mejores resultados."}},"it":{"stringUnit":{"state":"translated","value":"Prova diversi modelli e scegli quello che riconosce meglio la tua voce. Differiscono per velocità, lingue supportate, qualità e dimensioni. Un modello più grande non dà sempre risultati migliori."}},"fr":{"stringUnit":{"state":"translated","value":"Essayez différents modèles et choisissez celui qui reconnaît le mieux votre voix. Ils diffèrent par leur vitesse, les langues prises en charge, la qualité et la taille. Un modèle plus grand ne donne pas toujours de meilleurs résultats."}}}},
    "Balanced speed and recognition quality. Supports all Witness languages.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Ausgewogenes Verhältnis von Geschwindigkeit und Erkennungsqualität. Unterstützt alle Witness-Sprachen."}},"es":{"stringUnit":{"state":"translated","value":"Equilibrio entre velocidad y calidad. Compatible con todos los idiomas de Witness."}},"it":{"stringUnit":{"state":"translated","value":"Equilibrio tra velocità e qualità. Supporta tutte le lingue di Witness."}},"fr":{"stringUnit":{"state":"translated","value":"Bon équilibre entre vitesse et qualité. Prend en charge toutes les langues de Witness."}}}},
    "A larger Whisper model. Recognition may take longer; results can differ from turbo. Supports all Witness languages.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Ein größeres Whisper-Modell. Die Erkennung kann länger dauern; die Ergebnisse können von Turbo abweichen. Unterstützt alle Witness-Sprachen."}},"es":{"stringUnit":{"state":"translated","value":"Un modelo Whisper más grande. Puede tardar más y dar resultados distintos a turbo. Compatible con todos los idiomas de Witness."}},"it":{"stringUnit":{"state":"translated","value":"Un modello Whisper più grande. Può richiedere più tempo e dare risultati diversi da turbo. Supporta tutte le lingue di Witness."}},"fr":{"stringUnit":{"state":"translated","value":"Un modèle Whisper plus grand. La reconnaissance peut être plus lente et donner des résultats différents de turbo. Prend en charge toutes les langues de Witness."}}}},
    "Fast recognition for 25 European languages. Language selection is less strict than Whisper.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Schnelle Erkennung für 25 europäische Sprachen. Die Sprachauswahl ist weniger strikt als bei Whisper."}},"es":{"stringUnit":{"state":"translated","value":"Reconocimiento rápido para 25 idiomas europeos. La selección de idioma es menos estricta que en Whisper."}},"it":{"stringUnit":{"state":"translated","value":"Riconoscimento rapido per 25 lingue europee. La selezione della lingua è meno rigorosa rispetto a Whisper."}},"fr":{"stringUnit":{"state":"translated","value":"Reconnaissance rapide pour 25 langues européennes. Le choix de la langue est moins strict qu’avec Whisper."}}}},
    "Another fast option for 25 European languages. Try it alongside Ultra to compare results.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Eine weitere schnelle Option für 25 europäische Sprachen. Vergleiche die Ergebnisse mit Ultra."}},"es":{"stringUnit":{"state":"translated","value":"Otra opción rápida para 25 idiomas europeos. Compárala con Ultra para ver los resultados."}},"it":{"stringUnit":{"state":"translated","value":"Un’altra opzione rapida per 25 lingue europee. Provala insieme a Ultra per confrontare i risultati."}},"fr":{"stringUnit":{"state":"translated","value":"Une autre option rapide pour 25 langues européennes. Comparez ses résultats à ceux d’Ultra."}}}},
    "Dictation and Notetaker use the same selected model. Audio and transcripts stay on this Mac.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Diktat und Notetaker verwenden dasselbe ausgewählte Modell. Audio und Transkripte bleiben auf diesem Mac."}},"es":{"stringUnit":{"state":"translated","value":"Dictado y Notetaker usan el mismo modelo seleccionado. El audio y las transcripciones permanecen en este Mac."}},"it":{"stringUnit":{"state":"translated","value":"Dettatura e Notetaker usano lo stesso modello. Audio e trascrizioni restano su questo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"La dictée et Notetaker utilisent le même modèle. L’audio et les transcriptions restent sur ce Mac."}}}},
    "Sizes are approximate. macOS preparation uses additional disk space. You can remove inactive models to free space.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Größen sind ungefähre Angaben. Die Vorbereitung durch macOS benötigt zusätzlichen Speicherplatz. Nicht aktive Modelle können entfernt werden."}},"es":{"stringUnit":{"state":"translated","value":"Los tamaños son aproximados. La preparación de macOS ocupa espacio adicional. Puedes eliminar modelos inactivos para liberar espacio."}},"it":{"stringUnit":{"state":"translated","value":"Le dimensioni sono indicative. La preparazione di macOS usa spazio aggiuntivo. Puoi rimuovere i modelli inattivi per liberare spazio."}},"fr":{"stringUnit":{"state":"translated","value":"Les tailles sont approximatives. La préparation par macOS utilise de l’espace supplémentaire. Vous pouvez supprimer les modèles inactifs pour libérer de l’espace."}}}},
    "This model does not support all your selected languages.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieses Modell unterstützt nicht alle ausgewählten Sprachen."}},"es":{"stringUnit":{"state":"translated","value":"Este modelo no admite todos los idiomas seleccionados."}},"it":{"stringUnit":{"state":"translated","value":"Questo modello non supporta tutte le lingue selezionate."}},"fr":{"stringUnit":{"state":"translated","value":"Ce modèle ne prend pas en charge toutes les langues sélectionnées."}}}},
    "Downloading %@": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ wird heruntergeladen"}},"es":{"stringUnit":{"state":"translated","value":"Descargando %@"}},"it":{"stringUnit":{"state":"translated","value":"Download di %@"}},"fr":{"stringUnit":{"state":"translated","value":"Téléchargement de %@"}}}},
    "Model download progress": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Fortschritt des Modelldownloads"}},"es":{"stringUnit":{"state":"translated","value":"Progreso de descarga del modelo"}},"it":{"stringUnit":{"state":"translated","value":"Avanzamento del download"}},"fr":{"stringUnit":{"state":"translated","value":"Progression du téléchargement"}}}},
    "Your model is downloading. We will notify you when it finishes. Restart Witness afterwards to apply it. Your current model keeps working.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Modell wird heruntergeladen. Du wirst benachrichtigt, sobald es fertig ist. Starte Witness danach neu, um es anzuwenden. Dein aktuelles Modell funktioniert weiter."}},"es":{"stringUnit":{"state":"translated","value":"El modelo se está descargando. Te avisaremos al terminar. Después reinicia Witness para aplicarlo. Tu modelo actual sigue funcionando."}},"it":{"stringUnit":{"state":"translated","value":"Il modello è in download. Ti avviseremo al termine. Riavvia poi Witness per applicarlo. Il modello attuale continua a funzionare."}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle est en cours de téléchargement. Nous vous avertirons à la fin. Redémarrez ensuite Witness pour l’appliquer. Votre modèle actuel continue de fonctionner."}}}},
    "Cancel download": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Download abbrechen"}},"es":{"stringUnit":{"state":"translated","value":"Cancelar descarga"}},"it":{"stringUnit":{"state":"translated","value":"Annulla download"}},"fr":{"stringUnit":{"state":"translated","value":"Annuler le téléchargement"}}}},
    "%@ is downloaded and ready to apply.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ wurde heruntergeladen und kann angewendet werden."}},"es":{"stringUnit":{"state":"translated","value":"%@ está descargado y listo para aplicar."}},"it":{"stringUnit":{"state":"translated","value":"%@ è stato scaricato ed è pronto."}},"fr":{"stringUnit":{"state":"translated","value":"%@ est téléchargé et prêt à être appliqué."}}}},
    "Restart and apply": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Neu starten und anwenden"}},"es":{"stringUnit":{"state":"translated","value":"Reiniciar y aplicar"}},"it":{"stringUnit":{"state":"translated","value":"Riavvia e applica"}},"fr":{"stringUnit":{"state":"translated","value":"Redémarrer et appliquer"}}}},
    "Keep active model": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktives Modell behalten"}},"es":{"stringUnit":{"state":"translated","value":"Mantener el modelo activo"}},"it":{"stringUnit":{"state":"translated","value":"Mantieni il modello attivo"}},"fr":{"stringUnit":{"state":"translated","value":"Conserver le modèle actif"}}}},
    "Finish dictation or the meeting note before restarting.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Beende das Diktat oder die Besprechungsnotiz vor dem Neustart."}},"es":{"stringUnit":{"state":"translated","value":"Termina el dictado o la nota de reunión antes de reiniciar."}},"it":{"stringUnit":{"state":"translated","value":"Termina la dettatura o la nota della riunione prima di riavviare."}},"fr":{"stringUnit":{"state":"translated","value":"Terminez la dictée ou la note de réunion avant de redémarrer."}}}},
    "Installed": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Installiert"}},"es":{"stringUnit":{"state":"translated","value":"Instalado"}},"it":{"stringUnit":{"state":"translated","value":"Installato"}},"fr":{"stringUnit":{"state":"translated","value":"Installé"}}}},
    "Use this model": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieses Modell verwenden"}},"es":{"stringUnit":{"state":"translated","value":"Usar este modelo"}},"it":{"stringUnit":{"state":"translated","value":"Usa questo modello"}},"fr":{"stringUnit":{"state":"translated","value":"Utiliser ce modèle"}}}},
    "Download and select": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Herunterladen und auswählen"}},"es":{"stringUnit":{"state":"translated","value":"Descargar y seleccionar"}},"it":{"stringUnit":{"state":"translated","value":"Scarica e seleziona"}},"fr":{"stringUnit":{"state":"translated","value":"Télécharger et sélectionner"}}}},
    "Remove model…": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Modell entfernen…"}},"es":{"stringUnit":{"state":"translated","value":"Eliminar modelo…"}},"it":{"stringUnit":{"state":"translated","value":"Rimuovi modello…"}},"fr":{"stringUnit":{"state":"translated","value":"Supprimer le modèle…"}}}},
    "Remove this model from your Mac?": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieses Modell vom Mac entfernen?"}},"es":{"stringUnit":{"state":"translated","value":"¿Eliminar este modelo del Mac?"}},"it":{"stringUnit":{"state":"translated","value":"Rimuovere questo modello dal Mac?"}},"fr":{"stringUnit":{"state":"translated","value":"Supprimer ce modèle du Mac ?"}}}},
    "Move to Trash": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"In den Papierkorb legen"}},"es":{"stringUnit":{"state":"translated","value":"Mover a la papelera"}},"it":{"stringUnit":{"state":"translated","value":"Sposta nel Cestino"}},"fr":{"stringUnit":{"state":"translated","value":"Placer dans la corbeille"}}}},
    "You can download this model again later. Your active model will keep working.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Du kannst dieses Modell später erneut herunterladen. Dein aktives Modell funktioniert weiter."}},"es":{"stringUnit":{"state":"translated","value":"Puedes volver a descargar este modelo más adelante. El modelo activo seguirá funcionando."}},"it":{"stringUnit":{"state":"translated","value":"Puoi scaricare di nuovo questo modello in seguito. Il modello attivo continuerà a funzionare."}},"fr":{"stringUnit":{"state":"translated","value":"Vous pourrez télécharger à nouveau ce modèle plus tard. Le modèle actif continuera de fonctionner."}}}},
    "Notifications are off or could not be delivered. You can check progress here and enable notifications for Witness in System Settings.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Mitteilungen sind deaktiviert oder konnten nicht zugestellt werden. Prüfe den Fortschritt hier und aktiviere Witness-Mitteilungen in den Systemeinstellungen."}},"es":{"stringUnit":{"state":"translated","value":"Las notificaciones están desactivadas o no se pudieron entregar. Puedes consultar el progreso aquí y activarlas para Witness en Ajustes del Sistema."}},"it":{"stringUnit":{"state":"translated","value":"Le notifiche sono disattivate o non sono state recapitate. Puoi controllare i progressi qui e attivarle per Witness nelle Impostazioni di Sistema."}},"fr":{"stringUnit":{"state":"translated","value":"Les notifications sont désactivées ou n’ont pas pu être envoyées. Consultez la progression ici et activez les notifications de Witness dans Réglages Système."}}}},
    "Preparing this model for your Mac. This may take a few minutes. We will notify you when it is ready to use.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieses Modell wird für deinen Mac vorbereitet. Das kann einige Minuten dauern. Du wirst benachrichtigt, sobald es einsatzbereit ist."}},"es":{"stringUnit":{"state":"translated","value":"Preparando el modelo para tu Mac. Puede tardar unos minutos. Te avisaremos cuando esté listo."}},"it":{"stringUnit":{"state":"translated","value":"Preparazione del modello per il tuo Mac. Potrebbe richiedere alcuni minuti. Ti avviseremo quando sarà pronto."}},"fr":{"stringUnit":{"state":"translated","value":"Préparation du modèle pour votre Mac. Cela peut prendre quelques minutes. Nous vous avertirons lorsqu’il sera prêt."}}}},
    "You can close this window. Preparation continues while Witness is running.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Du kannst dieses Fenster schließen. Die Vorbereitung läuft weiter, solange Witness geöffnet ist."}},"es":{"stringUnit":{"state":"translated","value":"Puedes cerrar esta ventana. La preparación continúa mientras Witness esté abierto."}},"it":{"stringUnit":{"state":"translated","value":"Puoi chiudere questa finestra. La preparazione continua finché Witness è aperto."}},"fr":{"stringUnit":{"state":"translated","value":"Vous pouvez fermer cette fenêtre. La préparation continue tant que Witness est ouvert."}}}},
    "Your model has downloaded": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Modell wurde heruntergeladen"}},"es":{"stringUnit":{"state":"translated","value":"El modelo se ha descargado"}},"it":{"stringUnit":{"state":"translated","value":"Il modello è stato scaricato"}},"fr":{"stringUnit":{"state":"translated","value":"Votre modèle a été téléchargé"}}}},
    "%@ is downloaded. Restart Witness to apply it.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ wurde heruntergeladen. Starte Witness neu, um es anzuwenden."}},"es":{"stringUnit":{"state":"translated","value":"%@ se ha descargado. Reinicia Witness para aplicarlo."}},"it":{"stringUnit":{"state":"translated","value":"%@ è stato scaricato. Riavvia Witness per applicarlo."}},"fr":{"stringUnit":{"state":"translated","value":"%@ est téléchargé. Redémarrez Witness pour l’appliquer."}}}},
    "%@ is ready. You can start dictating.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ ist bereit. Du kannst mit dem Diktieren beginnen."}},"es":{"stringUnit":{"state":"translated","value":"%@ está listo. Ya puedes dictar."}},"it":{"stringUnit":{"state":"translated","value":"%@ è pronto. Puoi iniziare a dettare."}},"fr":{"stringUnit":{"state":"translated","value":"%@ est prêt. Vous pouvez commencer à dicter."}}}},
    "The model file list could not be verified. Please try again.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Modelldateiliste konnte nicht überprüft werden. Versuche es erneut."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo verificar la lista de archivos. Inténtalo de nuevo."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile verificare l’elenco dei file. Riprova."}},"fr":{"stringUnit":{"state":"translated","value":"La liste des fichiers du modèle n’a pas pu être vérifiée. Réessayez."}}}},
    "The model could not be downloaded. Check your connection and try again.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Modell konnte nicht heruntergeladen werden. Prüfe deine Verbindung und versuche es erneut."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo descargar el modelo. Comprueba la conexión e inténtalo de nuevo."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile scaricare il modello. Controlla la connessione e riprova."}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle n’a pas pu être téléchargé. Vérifiez votre connexion et réessayez."}}}},
    "A model file could not be verified. Please try again.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Eine Modelldatei konnte nicht überprüft werden. Versuche es erneut."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo verificar un archivo del modelo. Inténtalo de nuevo."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile verificare un file del modello. Riprova."}},"fr":{"stringUnit":{"state":"translated","value":"Un fichier du modèle n’a pas pu être vérifié. Réessayez."}}}},
    "There is not enough free space for this model. Free some space and try again.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Für dieses Modell ist nicht genug Speicherplatz frei. Gib Speicherplatz frei und versuche es erneut."}},"es":{"stringUnit":{"state":"translated","value":"No hay espacio suficiente para este modelo. Libera espacio e inténtalo de nuevo."}},"it":{"stringUnit":{"state":"translated","value":"Spazio insufficiente per questo modello. Libera spazio e riprova."}},"fr":{"stringUnit":{"state":"translated","value":"L’espace disponible est insuffisant. Libérez de l’espace et réessayez."}}}},
    "The model could not be removed. Please try again.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Modell konnte nicht entfernt werden. Versuche es erneut."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo eliminar el modelo. Inténtalo de nuevo."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile rimuovere il modello. Riprova."}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle n’a pas pu être supprimé. Réessayez."}}}},
    "Could not restart Witness. Quit and reopen it to apply the selected model.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Witness konnte nicht neu gestartet werden. Beende und öffne die App erneut, um das ausgewählte Modell anzuwenden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo reiniciar Witness. Ciérralo y vuelve a abrirlo para aplicar el modelo."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile riavviare Witness. Chiudilo e riaprilo per applicare il modello."}},"fr":{"stringUnit":{"state":"translated","value":"Witness n’a pas pu redémarrer. Quittez puis rouvrez l’app pour appliquer le modèle."}}}},
    "Your current model stays selected. You can keep it or try another model. This step is optional; you can change models later in Settings → Speech model.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein aktuelles Modell bleibt ausgewählt. Du kannst es weiterverwenden oder ein anderes ausprobieren. Dieser Schritt ist optional. Du kannst Modelle später unter Einstellungen → Sprachmodell ändern."}},"es":{"stringUnit":{"state":"translated","value":"Tu modelo actual sigue seleccionado. Puedes seguir usándolo o probar otro. Este paso es opcional; puedes cambiar el modelo después en Ajustes → Modelo de voz."}},"it":{"stringUnit":{"state":"translated","value":"Il modello attuale rimane selezionato. Puoi continuare a usarlo o provarne un altro. Questo passaggio è facoltativo: potrai cambiare modello in Impostazioni → Modello vocale."}},"fr":{"stringUnit":{"state":"translated","value":"Votre modèle actuel reste sélectionné. Vous pouvez le conserver ou en essayer un autre. Cette étape est facultative ; vous pourrez changer de modèle dans Réglages → Modèle vocal."}}}},
    "Active model": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktives Modell"}},"es":{"stringUnit":{"state":"translated","value":"Modelo activo"}},"it":{"stringUnit":{"state":"translated","value":"Modello attivo"}},"fr":{"stringUnit":{"state":"translated","value":"Modèle actif"}}}},
    "Model licenses": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Modelllizenzen"}},"es":{"stringUnit":{"state":"translated","value":"Licencias de modelos"}},"it":{"stringUnit":{"state":"translated","value":"Licenze dei modelli"}},"fr":{"stringUnit":{"state":"translated","value":"Licences des modèles"}}}},
    "Speech model": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprachmodell"}},"es":{"stringUnit":{"state":"translated","value":"Modelo de voz"}},"it":{"stringUnit":{"state":"translated","value":"Modello vocale"}},"fr":{"stringUnit":{"state":"translated","value":"Modèle vocal"}}}},
    "Dictation": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Diktat"}},"es":{"stringUnit":{"state":"translated","value":"Dictado"}},"it":{"stringUnit":{"state":"translated","value":"Dettatura"}},"fr":{"stringUnit":{"state":"translated","value":"Dictée"}}}},
    "Text cleanup": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Textbearbeitung"}},"es":{"stringUnit":{"state":"translated","value":"Edición del texto"}},"it":{"stringUnit":{"state":"translated","value":"Revisione del testo"}},"fr":{"stringUnit":{"state":"translated","value":"Traitement du texte"}}}},
    "Audio tuning": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Audioeinstellungen"}},"es":{"stringUnit":{"state":"translated","value":"Ajustes de audio"}},"it":{"stringUnit":{"state":"translated","value":"Impostazioni audio"}},"fr":{"stringUnit":{"state":"translated","value":"Réglages audio"}}}},
    "Step %lld of %lld": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Schritt %lld von %lld"}},"es":{"stringUnit":{"state":"translated","value":"Paso %lld de %lld"}},"it":{"stringUnit":{"state":"translated","value":"Passaggio %lld di %lld"}},"fr":{"stringUnit":{"state":"translated","value":"Étape %lld sur %lld"}}}},
    "Language support": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprachunterstützung"}},"es":{"stringUnit":{"state":"translated","value":"Compatibilidad de idiomas"}},"it":{"stringUnit":{"state":"translated","value":"Supporto delle lingue"}},"fr":{"stringUnit":{"state":"translated","value":"Prise en charge des langues"}}}},
    "Microphone changes apply to the next recording.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Ein anderes Mikrofon wird ab der nächsten Aufnahme verwendet."}},"es":{"stringUnit":{"state":"translated","value":"El cambio de micrófono se aplica a la próxima grabación."}},"it":{"stringUnit":{"state":"translated","value":"Il cambio di microfono si applica alla prossima registrazione."}},"fr":{"stringUnit":{"state":"translated","value":"Le changement de microphone s’applique au prochain enregistrement."}}}},
    "When enabled, text is inserted at your cursor. Any review marks remain available afterwards.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Wenn diese Option aktiv ist, wird der Text an der Cursorposition eingefügt. Markierte Stellen kannst du danach prüfen."}},"es":{"stringUnit":{"state":"translated","value":"Si activas esta opción, el texto se inserta donde está el cursor. Después puedes revisar los fragmentos marcados."}},"it":{"stringUnit":{"state":"translated","value":"Se attivi questa opzione, il testo viene inserito dove si trova il cursore. Puoi poi controllare i passaggi evidenziati."}},"fr":{"stringUnit":{"state":"translated","value":"Si cette option est activée, le texte est inséré à l’emplacement du curseur. Vous pouvez ensuite vérifier les passages signalés."}}}},
    "Without Accessibility access, you can copy your dictation and paste it into another app.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Ohne Zugriff auf die Bedienungshilfen kannst du dein Diktat kopieren und in einer anderen App einfügen."}},"es":{"stringUnit":{"state":"translated","value":"Sin el permiso de accesibilidad, puedes copiar el dictado y pegarlo en otra app."}},"it":{"stringUnit":{"state":"translated","value":"Senza il permesso di accessibilità, puoi copiare il dettato e incollarlo in un’altra app."}},"fr":{"stringUnit":{"state":"translated","value":"Sans l’autorisation d’accessibilité, vous pouvez copier votre dictée et la coller dans une autre app."}}}},
    "Witness marks details worth checking, such as amounts, dates, names and cleanup changes. A mark is a prompt to check, not a verdict.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Witness markiert Stellen zum Prüfen, etwa Beträge, Daten, Namen und Änderungen am Text. Eine Markierung bedeutet nicht, dass etwas falsch ist."}},"es":{"stringUnit":{"state":"translated","value":"Witness señala detalles que conviene revisar, como importes, fechas, nombres y cambios en el texto. Una marca no significa que haya un error."}},"it":{"stringUnit":{"state":"translated","value":"Witness evidenzia dettagli da controllare, come importi, date, nomi e modifiche al testo. Un’evidenziazione non indica necessariamente un errore."}},"fr":{"stringUnit":{"state":"translated","value":"Witness signale les détails à vérifier : montants, dates, noms et modifications du texte. Un signalement ne signifie pas forcément qu’il y a une erreur."}}}},
    "Speech recognition and text cleanup run locally.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Spracherkennung und Textbearbeitung laufen auf diesem Mac."}},"es":{"stringUnit":{"state":"translated","value":"El reconocimiento de voz y la edición del texto se realizan en este Mac."}},"it":{"stringUnit":{"state":"translated","value":"Il riconoscimento vocale e la revisione del testo avvengono su questo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"La reconnaissance vocale et le traitement du texte s’effectuent sur ce Mac."}}}},
    "Audio stays in memory until processing or review ends. Recordings and transcripts are not saved or sent to a server.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Audio bleibt bis zum Ende der Verarbeitung oder Prüfung im Arbeitsspeicher. Aufnahmen und Transkripte werden weder gespeichert noch an einen Server gesendet."}},"es":{"stringUnit":{"state":"translated","value":"El audio se mantiene en memoria hasta terminar el procesamiento o la revisión. Las grabaciones y transcripciones no se guardan ni se envían a un servidor."}},"it":{"stringUnit":{"state":"translated","value":"L’audio resta in memoria fino al termine dell’elaborazione o del controllo. Registrazioni e trascrizioni non vengono salvate né inviate a un server."}},"fr":{"stringUnit":{"state":"translated","value":"L’audio reste en mémoire jusqu’à la fin du traitement ou de la vérification. Les enregistrements et les transcriptions ne sont ni sauvegardés ni envoyés à un serveur."}}}},
    "Product events": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Nutzungsereignisse"}},"es":{"stringUnit":{"state":"translated","value":"Eventos de uso"}},"it":{"stringUnit":{"state":"translated","value":"Eventi di utilizzo"}},"fr":{"stringUnit":{"state":"translated","value":"Événements d’utilisation"}}}},
    "Share setup and trial events": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Ereignisse zu Einrichtung und Testphase teilen"}},"es":{"stringUnit":{"state":"translated","value":"Compartir eventos de configuración y prueba"}},"it":{"stringUnit":{"state":"translated","value":"Condividi eventi di configurazione e prova"}},"fr":{"stringUnit":{"state":"translated","value":"Partager les événements de configuration et d’essai"}}}},
    "Nine event types help us understand setup and the trial. They never include your audio, text, dictionary or app contents.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Neun Ereignistypen helfen uns, Einrichtung und Testphase zu verbessern. Audio, Texte, Wörterbuch und App-Inhalte gehören nie dazu."}},"es":{"stringUnit":{"state":"translated","value":"Nueve tipos de eventos nos ayudan a entender la configuración y la prueba. Nunca incluyen audio, texto, diccionario ni contenido de tus apps."}},"it":{"stringUnit":{"state":"translated","value":"Nove tipi di eventi ci aiutano a capire come funzionano la configurazione e la prova. Non includono mai audio, testo, dizionario o contenuti delle app."}},"fr":{"stringUnit":{"state":"translated","value":"Neuf types d’événements nous aident à comprendre la configuration et l’essai. Ils ne contiennent jamais votre audio, vos textes, votre dictionnaire ou le contenu de vos apps."}}}},
    "What is shared": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Was geteilt wird"}},"es":{"stringUnit":{"state":"translated","value":"Qué se comparte"}},"it":{"stringUnit":{"state":"translated","value":"Cosa viene condiviso"}},"fr":{"stringUnit":{"state":"translated","value":"Ce qui est partagé"}}}},
    "Privacy policy": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Datenschutzerklärung"}},"es":{"stringUnit":{"state":"translated","value":"Política de privacidad"}},"it":{"stringUnit":{"state":"translated","value":"Informativa sulla privacy"}},"fr":{"stringUnit":{"state":"translated","value":"Politique de confidentialité"}}}},
    "Read the privacy policy": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Datenschutzerklärung lesen"}},"es":{"stringUnit":{"state":"translated","value":"Leer la política de privacidad"}},"it":{"stringUnit":{"state":"translated","value":"Leggi l’informativa sulla privacy"}},"fr":{"stringUnit":{"state":"translated","value":"Lire la politique de confidentialité"}}}},
    "The policy lists what is sent for activation, payments, updates and product events, who receives it and how long it is kept.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Erklärung nennt die Daten für Aktivierung, Zahlungen, Updates und Nutzungsereignisse sowie Empfänger und Speicherdauer."}},"es":{"stringUnit":{"state":"translated","value":"La política indica qué se envía para la activación, los pagos, las actualizaciones y los eventos de uso, quién lo recibe y cuánto tiempo se conserva."}},"it":{"stringUnit":{"state":"translated","value":"L’informativa indica quali dati vengono inviati per attivazione, pagamenti, aggiornamenti ed eventi di utilizzo, chi li riceve e per quanto tempo vengono conservati."}},"fr":{"stringUnit":{"state":"translated","value":"La politique précise les données transmises pour l’activation, les paiements, les mises à jour et les événements d’utilisation, leurs destinataires et leur durée de conservation."}}}},
    "Witness checks GitHub for updates once a day. You choose when to install them.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Witness sucht einmal täglich auf GitHub nach Updates. Du entscheidest, wann sie installiert werden."}},"es":{"stringUnit":{"state":"translated","value":"Witness busca actualizaciones en GitHub una vez al día. Tú decides cuándo instalarlas."}},"it":{"stringUnit":{"state":"translated","value":"Witness cerca aggiornamenti su GitHub una volta al giorno. Decidi tu quando installarli."}},"fr":{"stringUnit":{"state":"translated","value":"Witness recherche des mises à jour sur GitHub une fois par jour. Vous choisissez quand les installer."}}}},
    "Insert text automatically": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Text automatisch einfügen"}},"es":{"stringUnit":{"state":"translated","value":"Insertar texto automáticamente"}},"it":{"stringUnit":{"state":"translated","value":"Inserisci il testo automaticamente"}},"fr":{"stringUnit":{"state":"translated","value":"Insérer le texte automatiquement"}}}},
    "Setup and practice": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Einrichtung und Übung"}},"es":{"stringUnit":{"state":"translated","value":"Configuración y práctica"}},"it":{"stringUnit":{"state":"translated","value":"Configurazione e prova"}},"fr":{"stringUnit":{"state":"translated","value":"Configuration et prise en main"}}}},
    "Choose the languages you speak. Witness detects them automatically as you dictate.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Wähle deine Sprachen. Witness erkennt beim Diktieren automatisch, welche du sprichst."}},"es":{"stringUnit":{"state":"translated","value":"Elige los idiomas que hablas. Witness los detecta automáticamente al dictar."}},"it":{"stringUnit":{"state":"translated","value":"Scegli le lingue che parli. Witness le riconosce automaticamente mentre detti."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez les langues que vous parlez. Witness les détecte automatiquement pendant la dictée."}}}},
    "Choose your languages and a shortcut, then try dictation. Your speech stays on this Mac.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Wähle deine Sprachen und einen Kurzbefehl und probiere das Diktieren aus. Deine Sprache bleibt auf diesem Mac."}},"es":{"stringUnit":{"state":"translated","value":"Elige tus idiomas y un atajo, y prueba a dictar. Tu voz se queda en este Mac."}},"it":{"stringUnit":{"state":"translated","value":"Scegli le lingue e una scorciatoia, poi prova a dettare. La tua voce resta su questo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez vos langues et un raccourci, puis essayez de dicter. Votre voix reste sur ce Mac."}}}},
    "Witness downloads a speech model during setup. This usually takes 5–15 minutes. You can try dictation as soon as it is ready.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Witness lädt bei der Einrichtung ein Sprachmodell herunter. Das dauert meist 5–15 Minuten. Sobald es bereit ist, kannst du das Diktieren ausprobieren."}},"es":{"stringUnit":{"state":"translated","value":"Witness descarga un modelo de voz durante la configuración. Suele tardar entre 5 y 15 minutos. En cuanto esté listo, podrás probar el dictado."}},"it":{"stringUnit":{"state":"translated","value":"Durante la configurazione, Witness scarica un modello vocale. Di solito servono 5–15 minuti. Appena è pronto, puoi provare a dettare."}},"fr":{"stringUnit":{"state":"translated","value":"Witness télécharge un modèle vocal pendant la configuration. Cela prend généralement 5 à 15 minutes. Dès qu’il est prêt, vous pouvez essayer de dicter."}}}},
    "Choose your shortcut": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Kurzbefehl wählen"}},"es":{"stringUnit":{"state":"translated","value":"Elige tu atajo"}},"it":{"stringUnit":{"state":"translated","value":"Scegli la scorciatoia"}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez votre raccourci"}}}},
    "You’re ready to dictate": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Bereit zum Diktieren"}},"es":{"stringUnit":{"state":"translated","value":"Todo listo para dictar"}},"it":{"stringUnit":{"state":"translated","value":"Puoi iniziare a dettare"}},"fr":{"stringUnit":{"state":"translated","value":"Vous pouvez commencer à dicter"}}}},
    "Enable Witness in System Settings → Privacy & Security → Microphone. On a managed Mac, you may need an administrator’s help.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktiviere Witness unter Systemeinstellungen → Datenschutz & Sicherheit → Mikrofon. Auf einem verwalteten Mac hilft dir gegebenenfalls die Administration."}},"es":{"stringUnit":{"state":"translated","value":"Activa Witness en Ajustes del Sistema → Privacidad y seguridad → Micrófono. Si el Mac está administrado, quizá necesites ayuda del administrador."}},"it":{"stringUnit":{"state":"translated","value":"Abilita Witness in Impostazioni di Sistema → Privacy e sicurezza → Microfono. Su un Mac gestito potrebbe servire l’aiuto di un amministratore."}},"fr":{"stringUnit":{"state":"translated","value":"Activez Witness dans Réglages Système → Confidentialité et sécurité → Microphone. Sur un Mac géré, l’aide d’un administrateur peut être nécessaire."}}}},
    "Enable Witness in System Settings → Privacy & Security → Accessibility. This lets it insert text at your cursor. We’ll check the permission when you return.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktiviere Witness unter Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen. So kann die App Text an der Cursorposition einfügen. Wir prüfen den Zugriff, wenn du zurückkommst."}},"es":{"stringUnit":{"state":"translated","value":"Activa Witness en Ajustes del Sistema → Privacidad y seguridad → Accesibilidad para insertar texto donde está el cursor. Comprobaremos el permiso cuando vuelvas."}},"it":{"stringUnit":{"state":"translated","value":"Abilita Witness in Impostazioni di Sistema → Privacy e sicurezza → Accessibilità per inserire il testo dove si trova il cursore. Verificheremo il permesso al tuo ritorno."}},"fr":{"stringUnit":{"state":"translated","value":"Activez Witness dans Réglages Système → Confidentialité et sécurité → Accessibilité pour insérer le texte à l’emplacement du curseur. Nous vérifierons l’autorisation à votre retour."}}}},
    "Witness needs a speech model to recognize your voice on this Mac. The first download and preparation usually take 5–15 minutes.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Für die Spracherkennung auf diesem Mac benötigt Witness ein Sprachmodell. Der erste Download und die Vorbereitung dauern meist 5–15 Minuten."}},"es":{"stringUnit":{"state":"translated","value":"Witness necesita un modelo para reconocer tu voz en este Mac. La primera descarga y preparación suelen tardar entre 5 y 15 minutos."}},"it":{"stringUnit":{"state":"translated","value":"Witness ha bisogno di un modello per riconoscere la tua voce su questo Mac. Il primo download e la preparazione richiedono di solito 5–15 minuti."}},"fr":{"stringUnit":{"state":"translated","value":"Witness a besoin d’un modèle pour reconnaître votre voix sur ce Mac. Le premier téléchargement et la préparation prennent généralement 5 à 15 minutes."}}}},
    "The progress appears below. Once the model is ready, you can try your first dictation.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Den Fortschritt siehst du unten. Sobald das Modell bereit ist, kannst du dein erstes Diktat ausprobieren."}},"es":{"stringUnit":{"state":"translated","value":"Puedes ver el progreso abajo. En cuanto el modelo esté listo, podrás probar tu primer dictado."}},"it":{"stringUnit":{"state":"translated","value":"Puoi seguire l’avanzamento qui sotto. Appena il modello è pronto, puoi provare il tuo primo dettato."}},"fr":{"stringUnit":{"state":"translated","value":"La progression s’affiche ci-dessous. Dès que le modèle est prêt, vous pouvez essayer votre première dictée."}}}},
    "You can minimize or close this window. Preparation continues while Witness is running. Return from the menu bar → Setup and practice.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Du kannst dieses Fenster minimieren oder schließen. Die Vorbereitung läuft weiter, solange Witness geöffnet ist. Zurück geht es über die Menüleiste → Einrichtung und Übung."}},"es":{"stringUnit":{"state":"translated","value":"Puedes minimizar o cerrar esta ventana. La preparación continúa mientras Witness esté abierto. Vuelve desde la barra de menús → Configuración y práctica."}},"it":{"stringUnit":{"state":"translated","value":"Puoi ridurre a icona o chiudere questa finestra. La preparazione continua finché Witness è aperto. Puoi tornare dalla barra dei menu → Configurazione e prova."}},"fr":{"stringUnit":{"state":"translated","value":"Vous pouvez réduire ou fermer cette fenêtre. La préparation continue tant que Witness est ouvert. Revenez depuis la barre des menus → Configuration et prise en main."}}}},
    "Find Witness in the menu bar. You can reopen Setup and practice at any time.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Du findest Witness in der Menüleiste. Einrichtung und Übung kannst du jederzeit erneut öffnen."}},"es":{"stringUnit":{"state":"translated","value":"Encontrarás Witness en la barra de menús. Puedes volver a Configuración y práctica cuando quieras."}},"it":{"stringUnit":{"state":"translated","value":"Trovi Witness nella barra dei menu. Puoi riaprire Configurazione e prova in qualsiasi momento."}},"fr":{"stringUnit":{"state":"translated","value":"Witness se trouve dans la barre des menus. Vous pouvez rouvrir Configuration et prise en main à tout moment."}}}},
    "Your dictation stays on this Mac. Witness can share nine types of setup and trial events, with the app version, macOS version and a random installation ID. These include installation, model download progress and failures, attempts before the model is ready, microphone denial, trial start, the email prompt and offers shown. You can turn sharing off in Settings → Privacy.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine Diktate bleiben auf diesem Mac. Witness kann neun Ereignistypen zu Einrichtung und Testphase teilen, zusammen mit App-Version, macOS-Version und einer zufälligen Installations-ID: Installation, Modelldownload und Fehler, Startversuche vor Modellbereitschaft, verweigerter Mikrofonzugriff, Testbeginn, E-Mail-Abfrage und angezeigte Angebote. Unter Einstellungen → Datenschutz kannst du dies ausschalten."}},"es":{"stringUnit":{"state":"translated","value":"Tus dictados se quedan en este Mac. Witness puede compartir nueve tipos de eventos de configuración y prueba, con las versiones de la app y macOS y un identificador aleatorio de instalación: instalación, descarga del modelo y errores, intentos antes de que esté listo, permiso de micrófono denegado, inicio de la prueba, solicitud de correo y ofertas mostradas. Puedes desactivarlo en Ajustes → Privacidad."}},"it":{"stringUnit":{"state":"translated","value":"I dettati restano su questo Mac. Witness può condividere nove tipi di eventi di configurazione e prova, con le versioni dell’app e di macOS e un ID casuale di installazione: installazione, download del modello ed errori, tentativi prima che sia pronto, permesso del microfono negato, inizio della prova, richiesta dell’email e offerte mostrate. Puoi disattivare la condivisione in Impostazioni → Privacy."}},"fr":{"stringUnit":{"state":"translated","value":"Vos dictées restent sur ce Mac. Witness peut partager neuf types d’événements de configuration et d’essai, avec les versions de l’app et de macOS et un identifiant d’installation aléatoire : installation, téléchargement du modèle et échecs, tentatives avant sa disponibilité, refus du microphone, début de l’essai, demande d’adresse e-mail et offres affichées. Vous pouvez désactiver ce partage dans Réglages → Confidentialité."}}}},
    "Shared events cover installation; model download start, completion or failure; attempts before the model is ready; microphone denial; trial start; the email prompt; and offers shown. Each includes the app version, macOS version and a random installation ID. The six setup events are sent once per installation. Turning this off stops all nine event types.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Geteilt werden Installation, Beginn, Abschluss oder Fehlschlag des Modelldownloads, Startversuche vor Modellbereitschaft, verweigerter Mikrofonzugriff, Testbeginn, E-Mail-Abfrage und angezeigte Angebote. Enthalten sind App-Version, macOS-Version und eine zufällige Installations-ID. Die sechs Einrichtungsereignisse werden je Installation einmal gesendet. Ausschalten stoppt alle neun Ereignistypen."}},"es":{"stringUnit":{"state":"translated","value":"Se comparten la instalación; el inicio, finalización o fallo de la descarga del modelo; los intentos antes de que esté listo; el permiso de micrófono denegado; el inicio de la prueba; la solicitud de correo; y las ofertas mostradas. Se incluyen las versiones de la app y macOS y un identificador aleatorio de instalación. Los seis eventos de configuración se envían una vez por instalación. Al desactivar la opción dejan de enviarse los nueve tipos."}},"it":{"stringUnit":{"state":"translated","value":"Vengono condivisi installazione; inizio, completamento o errore del download del modello; tentativi prima che sia pronto; permesso del microfono negato; inizio della prova; richiesta dell’email; e offerte mostrate. Sono incluse le versioni dell’app e di macOS e un ID casuale di installazione. I sei eventi di configurazione vengono inviati una volta per installazione. Disattivando l’opzione si interrompono tutti e nove i tipi."}},"fr":{"stringUnit":{"state":"translated","value":"Les événements partagés concernent l’installation ; le début, la fin ou l’échec du téléchargement du modèle ; les tentatives avant sa disponibilité ; le refus du microphone ; le début de l’essai ; la demande d’adresse e-mail ; et les offres affichées. Ils incluent les versions de l’app et de macOS et un identifiant d’installation aléatoire. Les six événements de configuration sont envoyés une fois par installation. Désactiver l’option arrête les neuf types."}}}},
    "German, English, Russian and Ukrainian support tested recognition, cleanup and review. Spanish, Italian and French also have calibrated review marks; advanced cleanup remains limited. Other languages support recognition without language-specific review rules.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Deutsch, Englisch, Russisch und Ukrainisch bieten geprüfte Erkennung, Textbearbeitung und Prüfung. Spanisch, Italienisch und Französisch haben ebenfalls abgestimmte Prüfmarkierungen; die erweiterte Textbearbeitung ist noch eingeschränkt. Andere Sprachen werden ohne sprachspezifische Prüfregeln erkannt."}},"es":{"stringUnit":{"state":"translated","value":"El alemán, inglés, ruso y ucraniano tienen reconocimiento, edición y revisión probados. El español, italiano y francés también cuentan con marcas de revisión ajustadas al idioma; la edición avanzada sigue limitada. Los demás idiomas permiten reconocer voz sin reglas de revisión específicas."}},"it":{"stringUnit":{"state":"translated","value":"Tedesco, inglese, russo e ucraino offrono riconoscimento, revisione del testo e controlli verificati. Anche spagnolo, italiano e francese dispongono di segnalazioni calibrate; la revisione avanzata resta limitata. Le altre lingue supportano il riconoscimento senza regole di controllo specifiche."}},"fr":{"stringUnit":{"state":"translated","value":"L’allemand, l’anglais, le russe et l’ukrainien bénéficient d’une reconnaissance, d’un traitement et d’une vérification testés. L’espagnol, l’italien et le français disposent aussi de signalements adaptés ; le traitement avancé reste limité. Les autres langues permettent la reconnaissance sans règles de vérification propres à la langue."}}}},
    "Recognition, cleanup and review": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Erkennung, Textbearbeitung und Prüfung"}},"es":{"stringUnit":{"state":"translated","value":"Reconocimiento, edición y revisión"}},"it":{"stringUnit":{"state":"translated","value":"Riconoscimento, revisione e controlli"}},"fr":{"stringUnit":{"state":"translated","value":"Reconnaissance, traitement et vérification"}}}},
    "Recognition and review": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Erkennung und Prüfung"}},"es":{"stringUnit":{"state":"translated","value":"Reconocimiento y revisión"}},"it":{"stringUnit":{"state":"translated","value":"Riconoscimento e controlli"}},"fr":{"stringUnit":{"state":"translated","value":"Reconnaissance et vérification"}}}},
    "More recognition languages": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Weitere Erkennungssprachen"}},"es":{"stringUnit":{"state":"translated","value":"Más idiomas de reconocimiento"}},"it":{"stringUnit":{"state":"translated","value":"Altre lingue di riconoscimento"}},"fr":{"stringUnit":{"state":"translated","value":"Autres langues de reconnaissance"}}}},
    "For short or ambiguous phrases, Witness favors your preferred language.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Bei kurzen oder mehrdeutigen Sätzen bevorzugt Witness diese Sprache."}},"es":{"stringUnit":{"state":"translated","value":"Para las frases cortas o ambiguas, Witness da prioridad a este idioma."}},"it":{"stringUnit":{"state":"translated","value":"Per le frasi brevi o ambigue, Witness dà la preferenza a questa lingua."}},"fr":{"stringUnit":{"state":"translated","value":"Pour les phrases courtes ou ambiguës, Witness privilégie cette langue."}}}},
    "Choose the languages you use regularly. A smaller selection can help with short or similar-sounding phrases.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Wähle die Sprachen, die du regelmäßig nutzt. Eine kleinere Auswahl hilft bei kurzen oder ähnlich klingenden Sätzen."}},"es":{"stringUnit":{"state":"translated","value":"Elige los idiomas que usas habitualmente. Una selección más reducida puede ayudar con frases cortas o que suenan parecidas."}},"it":{"stringUnit":{"state":"translated","value":"Scegli le lingue che usi abitualmente. Una selezione più ristretta può aiutare con frasi brevi o dal suono simile."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez les langues que vous utilisez régulièrement. Une sélection plus restreinte peut aider pour les phrases courtes ou aux sonorités proches."}}}},
    "Witness recognizes the languages you select.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Witness erkennt die ausgewählten Sprachen."}},"es":{"stringUnit":{"state":"translated","value":"Witness reconoce los idiomas que selecciones."}},"it":{"stringUnit":{"state":"translated","value":"Witness riconosce le lingue che selezioni."}},"fr":{"stringUnit":{"state":"translated","value":"Witness reconnaît les langues que vous sélectionnez."}}}},
    "No languages match “%@”.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Keine Sprachen für „%@“ gefunden."}},"es":{"stringUnit":{"state":"translated","value":"No se encontraron idiomas para «%@»."}},"it":{"stringUnit":{"state":"translated","value":"Nessuna lingua trovata per “%@”."}},"fr":{"stringUnit":{"state":"translated","value":"Aucune langue ne correspond à « %@ »."}}}},
    "Witness needs to be running for your shortcut to work.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Kurzbefehl funktioniert, solange Witness geöffnet ist."}},"es":{"stringUnit":{"state":"translated","value":"Witness debe estar abierto para que funcione el atajo."}},"it":{"stringUnit":{"state":"translated","value":"Witness deve essere aperto perché la scorciatoia funzioni."}},"fr":{"stringUnit":{"state":"translated","value":"Witness doit être ouvert pour que votre raccourci fonctionne."}}}},
    "Start Witness at login so your dictation shortcut is always available.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Starte Witness bei der Anmeldung, damit dein Diktierkurzbefehl immer verfügbar ist."}},"es":{"stringUnit":{"state":"translated","value":"Abre Witness al iniciar sesión para tener siempre disponible el atajo de dictado."}},"it":{"stringUnit":{"state":"translated","value":"Avvia Witness all’accesso per avere sempre disponibile la scorciatoia di dettatura."}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrez Witness à la connexion pour que votre raccourci de dictée reste disponible."}}}},
    "Your dictionary is saved on this Mac. Recordings and transcripts stay in memory.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Wörterbuch wird auf diesem Mac gespeichert. Aufnahmen und Transkripte bleiben im Arbeitsspeicher."}},"es":{"stringUnit":{"state":"translated","value":"Tu diccionario se guarda en este Mac. Las grabaciones y transcripciones se mantienen en memoria."}},"it":{"stringUnit":{"state":"translated","value":"Il dizionario viene salvato su questo Mac. Registrazioni e trascrizioni restano in memoria."}},"fr":{"stringUnit":{"state":"translated","value":"Votre dictionnaire est enregistré sur ce Mac. Les enregistrements et les transcriptions restent en mémoire."}}}},
    "Add names, words or phrases you use often.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Füge Namen, Wörter oder Ausdrücke hinzu, die du häufig verwendest."}},"es":{"stringUnit":{"state":"translated","value":"Añade nombres, palabras o frases que uses a menudo."}},"it":{"stringUnit":{"state":"translated","value":"Aggiungi nomi, parole o frasi che usi spesso."}},"fr":{"stringUnit":{"state":"translated","value":"Ajoutez les noms, mots ou expressions que vous utilisez souvent."}}}},
    "Similar spellings are marked for review. Exact matches are left unchanged.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Ähnliche Schreibweisen werden zur Prüfung markiert. Genaue Treffer bleiben unverändert."}},"es":{"stringUnit":{"state":"translated","value":"Las palabras parecidas se marcan para revisión. Las coincidencias exactas no cambian."}},"it":{"stringUnit":{"state":"translated","value":"Le grafie simili vengono segnalate per il controllo. Le corrispondenze esatte restano invariate."}},"fr":{"stringUnit":{"state":"translated","value":"Les graphies proches sont signalées pour vérification. Les correspondances exactes restent inchangées."}}}},
    "Add a correction to replace a specific phrase. Without one, the term is only used to flag similar spellings. Your dictionary stays on this Mac.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Mit einer Korrektur ersetzt du einen bestimmten Ausdruck. Ohne Korrektur werden nur ähnliche Schreibweisen markiert. Dein Wörterbuch bleibt auf diesem Mac."}},"es":{"stringUnit":{"state":"translated","value":"Añade una corrección para sustituir una frase concreta. Sin ella, el término solo sirve para señalar palabras parecidas. Tu diccionario se queda en este Mac."}},"it":{"stringUnit":{"state":"translated","value":"Aggiungi una correzione per sostituire una frase precisa. Senza correzione, il termine serve solo a segnalare grafie simili. Il dizionario resta su questo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Ajoutez une correction pour remplacer une expression précise. Sinon, le terme sert uniquement à signaler les graphies proches. Votre dictionnaire reste sur ce Mac."}}}},
    "Gentle": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Behutsam"}},"es":{"stringUnit":{"state":"translated","value":"Suave"}},"it":{"stringUnit":{"state":"translated","value":"Leggera"}},"fr":{"stringUnit":{"state":"translated","value":"Léger"}}}},
    "Extended": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Erweitert"}},"es":{"stringUnit":{"state":"translated","value":"Avanzada"}},"it":{"stringUnit":{"state":"translated","value":"Avanzata"}},"fr":{"stringUnit":{"state":"translated","value":"Avancé"}}}},
    "Fixes spacing, capitalization and punctuation, and removes clear filler words.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Korrigiert Abstände, Großschreibung und Satzzeichen und entfernt eindeutige Füllwörter."}},"es":{"stringUnit":{"state":"translated","value":"Corrige espacios, mayúsculas y puntuación, y elimina muletillas claras."}},"it":{"stringUnit":{"state":"translated","value":"Corregge spazi, maiuscole e punteggiatura ed elimina i riempitivi evidenti."}},"fr":{"stringUnit":{"state":"translated","value":"Corrige les espaces, les majuscules et la ponctuation, et supprime les mots de remplissage évidents."}}}},
    "Also applies spoken commands and explicit corrections, and formats lists and values.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Setzt außerdem gesprochene Befehle und ausdrückliche Korrekturen um und formatiert Listen und Werte."}},"es":{"stringUnit":{"state":"translated","value":"También aplica comandos de voz y correcciones explícitas, y da formato a listas y valores."}},"it":{"stringUnit":{"state":"translated","value":"Applica anche comandi vocali e correzioni esplicite e formatta elenchi e valori."}},"fr":{"stringUnit":{"state":"translated","value":"Applique aussi les commandes vocales et les corrections explicites, et met en forme les listes et les valeurs."}}}},
    "Press once to start recording. Press again to stop.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Einmal drücken startet die Aufnahme. Erneut drücken beendet sie."}},"es":{"stringUnit":{"state":"translated","value":"Pulsa una vez para empezar a grabar. Vuelve a pulsar para terminar."}},"it":{"stringUnit":{"state":"translated","value":"Premi una volta per iniziare a registrare. Premi di nuovo per terminare."}},"fr":{"stringUnit":{"state":"translated","value":"Appuyez une fois pour enregistrer, puis une seconde fois pour arrêter."}}}},
    "Hold the shortcut while you speak. Release it to stop recording.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Halte den Kurzbefehl beim Sprechen gedrückt. Loslassen beendet die Aufnahme."}},"es":{"stringUnit":{"state":"translated","value":"Mantén pulsado el atajo mientras hablas. Suéltalo para terminar."}},"it":{"stringUnit":{"state":"translated","value":"Tieni premuta la scorciatoia mentre parli. Rilasciala per terminare."}},"fr":{"stringUnit":{"state":"translated","value":"Maintenez le raccourci pendant que vous parlez. Relâchez-le pour arrêter."}}}},
    "Finishing recording": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Aufnahme wird beendet"}},"es":{"stringUnit":{"state":"translated","value":"Terminando la grabación"}},"it":{"stringUnit":{"state":"translated","value":"Fine della registrazione"}},"fr":{"stringUnit":{"state":"translated","value":"Fin de l’enregistrement"}}}},
    "Preparing your recording for transcription.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine Aufnahme wird für die Transkription vorbereitet."}},"es":{"stringUnit":{"state":"translated","value":"Preparando la grabación para transcribirla."}},"it":{"stringUnit":{"state":"translated","value":"Preparazione della registrazione per la trascrizione."}},"fr":{"stringUnit":{"state":"translated","value":"Préparation de votre enregistrement pour la transcription."}}}},
    "Starting recording": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Aufnahme wird gestartet"}},"es":{"stringUnit":{"state":"translated","value":"Iniciando la grabación"}},"it":{"stringUnit":{"state":"translated","value":"Avvio della registrazione"}},"fr":{"stringUnit":{"state":"translated","value":"Démarrage de l’enregistrement"}}}},
    "Downloading the speech model": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprachmodell wird heruntergeladen"}},"es":{"stringUnit":{"state":"translated","value":"Descargando el modelo de voz"}},"it":{"stringUnit":{"state":"translated","value":"Download del modello vocale"}},"fr":{"stringUnit":{"state":"translated","value":"Téléchargement du modèle vocal"}}}},
    "The speech model could not be downloaded": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprachmodell konnte nicht geladen werden"}},"es":{"stringUnit":{"state":"translated","value":"No se pudo descargar el modelo de voz"}},"it":{"stringUnit":{"state":"translated","value":"Impossibile scaricare il modello vocale"}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de télécharger le modèle vocal"}}}},
    "%@ You can dictate when preparation is complete.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ Nach der Vorbereitung kannst du diktieren."}},"es":{"stringUnit":{"state":"translated","value":"%@ Podrás dictar cuando termine la preparación."}},"it":{"stringUnit":{"state":"translated","value":"%@ Potrai dettare al termine della preparazione."}},"fr":{"stringUnit":{"state":"translated","value":"%@ Vous pourrez dicter une fois la préparation terminée."}}}},
    "Shows the insertion method and target app. Dictated text is not included in diagnostics or logs.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Zeigt die Einfügemethode und die Ziel-App. Diktierter Text erscheint weder in der Diagnose noch in Protokollen."}},"es":{"stringUnit":{"state":"translated","value":"Muestra el método de inserción y la app de destino. El texto dictado no se incluye en los diagnósticos ni en los registros."}},"it":{"stringUnit":{"state":"translated","value":"Mostra il metodo di inserimento e l’app di destinazione. Il testo dettato non compare nella diagnostica né nei log."}},"fr":{"stringUnit":{"state":"translated","value":"Indique la méthode d’insertion et l’app cible. Le texte dicté ne figure ni dans le diagnostic ni dans les journaux."}}}},
    "Audio is kept in memory while review is available. Zero means the last recording has been released.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Audio bleibt im Arbeitsspeicher, solange eine Prüfung möglich ist. Null bedeutet, dass die letzte Aufnahme freigegeben wurde."}},"es":{"stringUnit":{"state":"translated","value":"El audio se mantiene en memoria mientras esté disponible la revisión. Cero indica que la última grabación se ha liberado."}},"it":{"stringUnit":{"state":"translated","value":"L’audio resta in memoria finché il controllo è disponibile. Zero indica che l’ultima registrazione è stata rilasciata."}},"fr":{"stringUnit":{"state":"translated","value":"L’audio reste en mémoire tant que la vérification est disponible. Zéro signifie que le dernier enregistrement a été libéré."}}}},
    "These settings apply to the next recording and reset when Witness restarts. Trailing silence is measured but never used to trim speech.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Einstellungen gelten ab der nächsten Aufnahme und werden beim Neustart zurückgesetzt. Abschließende Stille wird gemessen, aber Sprache wird dadurch nicht gekürzt."}},"es":{"stringUnit":{"state":"translated","value":"Estos ajustes se aplican a la próxima grabación y se restablecen al reiniciar Witness. Se mide el silencio final, pero no se usa para recortar la voz."}},"it":{"stringUnit":{"state":"translated","value":"Queste impostazioni si applicano alla prossima registrazione e si azzerano al riavvio di Witness. Il silenzio finale viene misurato, ma non viene usato per tagliare la voce."}},"fr":{"stringUnit":{"state":"translated","value":"Ces réglages s’appliquent au prochain enregistrement et sont réinitialisés au redémarrage de Witness. Le silence final est mesuré, sans servir à couper la parole."}}}},
    "Use the email address from your purchase to activate this Mac. We send only your email and this Mac’s identifier. Annual subscriptions refresh automatically about once a month.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktiviere diesen Mac mit der E-Mail-Adresse deines Kaufs. Übertragen werden nur deine Adresse und die Kennung dieses Macs. Jahresabonnements werden etwa monatlich automatisch aktualisiert."}},"es":{"stringUnit":{"state":"translated","value":"Usa el correo de tu compra para activar este Mac. Solo se envían tu dirección y el identificador de este Mac. Las suscripciones anuales se actualizan automáticamente aproximadamente cada mes."}},"it":{"stringUnit":{"state":"translated","value":"Usa l’email dell’acquisto per attivare questo Mac. Inviamo solo il tuo indirizzo e l’identificatore di questo Mac. Gli abbonamenti annuali si aggiornano automaticamente circa una volta al mese."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez l’adresse e-mail de votre achat pour activer ce Mac. Seuls votre adresse et l’identifiant de ce Mac sont transmis. Les abonnements annuels sont actualisés automatiquement environ une fois par mois."}}}},
    "We’re also sending a copy of your key by email for reinstalling Witness or moving to another Mac. If it doesn’t arrive, request the key again. Witness is already activated.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Wir senden dir eine Kopie des Schlüssels per E-Mail, falls du Witness neu installierst oder einen anderen Mac nutzt. Kommt sie nicht an, fordere den Schlüssel erneut an. Witness ist bereits aktiviert."}},"es":{"stringUnit":{"state":"translated","value":"También te enviamos una copia de la clave por correo para reinstalar Witness o usar otro Mac. Si no llega, solicita la clave de nuevo. Witness ya está activado."}},"it":{"stringUnit":{"state":"translated","value":"Ti inviamo anche una copia della chiave via email per reinstallare Witness o passare a un altro Mac. Se non arriva, richiedi di nuovo la chiave. Witness è già attivato."}},"fr":{"stringUnit":{"state":"translated","value":"Nous vous envoyons aussi une copie de la clé par e-mail pour réinstaller Witness ou changer de Mac. Si elle n’arrive pas, demandez-la à nouveau. Witness est déjà activé."}}}},
    "Trial activated. You have ten free days from today.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Testphase aktiviert. Ab heute hast du zehn kostenlose Tage."}},"es":{"stringUnit":{"state":"translated","value":"Prueba activada. Tienes diez días gratis a partir de hoy."}},"it":{"stringUnit":{"state":"translated","value":"Prova attivata. Hai dieci giorni gratuiti da oggi."}},"fr":{"stringUnit":{"state":"translated","value":"Essai activé. Vous disposez de dix jours gratuits à partir d’aujourd’hui."}}}},
    "Your annual subscription is active on this Mac.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Jahresabonnement ist auf diesem Mac aktiv."}},"es":{"stringUnit":{"state":"translated","value":"Tu suscripción anual está activa en este Mac."}},"it":{"stringUnit":{"state":"translated","value":"L’abbonamento annuale è attivo su questo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Votre abonnement annuel est actif sur ce Mac."}}}},
    "Your lifetime license is active on this Mac. No renewal is needed.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine Dauerlizenz ist auf diesem Mac aktiv. Eine Verlängerung ist nicht nötig."}},"es":{"stringUnit":{"state":"translated","value":"Tu licencia de por vida está activa en este Mac. No necesita renovación."}},"it":{"stringUnit":{"state":"translated","value":"La licenza perpetua è attiva su questo Mac. Non richiede rinnovi."}},"fr":{"stringUnit":{"state":"translated","value":"Votre licence à vie est active sur ce Mac. Aucun renouvellement n’est nécessaire."}}}},
    "Trial active": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Testphase aktiv"}},"es":{"stringUnit":{"state":"translated","value":"Prueba activa"}},"it":{"stringUnit":{"state":"translated","value":"Prova attiva"}},"fr":{"stringUnit":{"state":"translated","value":"Essai actif"}}}},
    "Manage your subscription, payment method and invoices in your browser. Sign in with the email address you used to pay.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Verwalte Abonnement, Zahlungsmethode und Rechnungen im Browser. Melde dich mit der E-Mail-Adresse deines Kaufs an."}},"es":{"stringUnit":{"state":"translated","value":"Gestiona tu suscripción, método de pago y facturas en el navegador. Inicia sesión con el correo que usaste para pagar."}},"it":{"stringUnit":{"state":"translated","value":"Gestisci abbonamento, metodo di pagamento e fatture nel browser. Accedi con l’email usata per il pagamento."}},"fr":{"stringUnit":{"state":"translated","value":"Gérez votre abonnement, votre moyen de paiement et vos factures dans le navigateur. Connectez-vous avec l’adresse e-mail utilisée pour payer."}}}},
    "This identifier links your license to this Mac. It is derived from the hardware UUID using a one-way hash and does not contain your serial number.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Kennung verknüpft deine Lizenz mit diesem Mac. Sie wird mit einem Einweg-Hash aus der Hardware-UUID gebildet und enthält keine Seriennummer."}},"es":{"stringUnit":{"state":"translated","value":"Este identificador vincula la licencia a este Mac. Se genera a partir del UUID del equipo mediante un hash unidireccional y no contiene el número de serie."}},"it":{"stringUnit":{"state":"translated","value":"Questo identificatore associa la licenza a questo Mac. Deriva dall’UUID hardware tramite un hash unidirezionale e non contiene il numero di serie."}},"fr":{"stringUnit":{"state":"translated","value":"Cet identifiant associe votre licence à ce Mac. Il est dérivé de l’UUID matériel par une empreinte à sens unique et ne contient pas votre numéro de série."}}}},
    "Enter a promo code on the payment page. A code from a partner link may already be filled in.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Gib deinen Aktionscode auf der Zahlungsseite ein. Ein Code aus einem Partnerlink ist möglicherweise schon eingetragen."}},"es":{"stringUnit":{"state":"translated","value":"Introduce el código promocional en la página de pago. Puede que un enlace de colaborador ya lo haya añadido."}},"it":{"stringUnit":{"state":"translated","value":"Inserisci il codice promozionale nella pagina di pagamento. Un codice da un link partner potrebbe essere già presente."}},"fr":{"stringUnit":{"state":"translated","value":"Saisissez votre code promotionnel sur la page de paiement. Un lien partenaire peut l’avoir déjà renseigné."}}}},
    "Email activation is unavailable in this build. You can still activate offline with a license key below.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Aktivierung per E-Mail ist in dieser Version nicht verfügbar. Du kannst unten einen Lizenzschlüssel für die Offline-Aktivierung eingeben."}},"es":{"stringUnit":{"state":"translated","value":"La activación por correo no está disponible en esta versión. Puedes activar sin conexión con una clave de licencia abajo."}},"it":{"stringUnit":{"state":"translated","value":"L’attivazione via email non è disponibile in questa versione. Puoi attivare offline con una chiave di licenza qui sotto."}},"fr":{"stringUnit":{"state":"translated","value":"L’activation par e-mail n’est pas disponible dans cette version. Vous pouvez activer hors ligne avec une clé de licence ci-dessous."}}}},
    "Email activation is unavailable in this build. Choose “Enter a key…” to activate offline.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Aktivierung per E-Mail ist in dieser Version nicht verfügbar. Wähle „Schlüssel eingeben …“ für die Offline-Aktivierung."}},"es":{"stringUnit":{"state":"translated","value":"La activación por correo no está disponible en esta versión. Elige «Introducir una clave…» para activar sin conexión."}},"it":{"stringUnit":{"state":"translated","value":"L’attivazione via email non è disponibile in questa versione. Scegli “Inserisci una chiave…” per attivare offline."}},"fr":{"stringUnit":{"state":"translated","value":"L’activation par e-mail n’est pas disponible dans cette version. Choisissez « Saisir une clé… » pour activer hors ligne."}}}},
    "Setup": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Einrichtung"}},"es":{"stringUnit":{"state":"translated","value":"Configuración"}},"it":{"stringUnit":{"state":"translated","value":"Configurazione"}},"fr":{"stringUnit":{"state":"translated","value":"Configuration"}}}},
    "Three days free, no email needed": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Drei Tage kostenlos, ohne E-Mail"}},"es":{"stringUnit":{"state":"translated","value":"Tres días gratis, sin correo"}},"it":{"stringUnit":{"state":"translated","value":"Tre giorni gratis, senza email"}},"fr":{"stringUnit":{"state":"translated","value":"Trois jours gratuits, sans e-mail"}}}},
    "Your three free days start with your first successful dictation. Add your email afterwards for ten more free days. Your speech stays on this Mac.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine drei kostenlosen Tage beginnen mit dem ersten erfolgreichen Diktat. Danach erhältst du mit deiner E-Mail-Adresse zehn weitere kostenlose Tage. Deine Sprache bleibt auf diesem Mac."}},"es":{"stringUnit":{"state":"translated","value":"Tus tres días gratis empiezan con el primer dictado correcto. Después, añade tu correo para obtener diez días gratis más. Tu voz se queda en este Mac."}},"it":{"stringUnit":{"state":"translated","value":"I tre giorni gratuiti iniziano con il primo dettato riuscito. Poi aggiungi l’email per altri dieci giorni gratuiti. La tua voce resta su questo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Vos trois jours gratuits commencent à la première dictée réussie. Ajoutez ensuite votre adresse e-mail pour dix jours gratuits supplémentaires. Votre voix reste sur ce Mac."}}}},
    "You can change these choices later in Settings. Open Witness from the menu bar.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Du kannst diese Auswahl später in den Einstellungen ändern. Öffne Witness über die Menüleiste."}},"es":{"stringUnit":{"state":"translated","value":"Puedes cambiar estas opciones en Ajustes. Abre Witness desde la barra de menús."}},"it":{"stringUnit":{"state":"translated","value":"Puoi cambiare queste opzioni nelle Impostazioni. Apri Witness dalla barra dei menu."}},"fr":{"stringUnit":{"state":"translated","value":"Vous pouvez modifier ces choix dans Réglages. Ouvrez Witness depuis la barre des menus."}}}},
    "Release the shortcut to finish. Your text appears at the cursor.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Lass den Kurzbefehl los, um die Aufnahme zu beenden. Dein Text erscheint an der Cursorposition."}},"es":{"stringUnit":{"state":"translated","value":"Suelta el atajo para terminar. El texto aparece donde está el cursor."}},"it":{"stringUnit":{"state":"translated","value":"Rilascia la scorciatoia per terminare. Il testo compare dove si trova il cursore."}},"fr":{"stringUnit":{"state":"translated","value":"Relâchez le raccourci pour terminer. Le texte apparaît à l’emplacement du curseur."}}}},
    "A license covers this Mac and one more.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Eine Lizenz gilt für diesen und einen weiteren Mac."}},"es":{"stringUnit":{"state":"translated","value":"Una licencia cubre este Mac y otro más."}},"it":{"stringUnit":{"state":"translated","value":"Una licenza copre questo Mac e un altro."}},"fr":{"stringUnit":{"state":"translated","value":"Une licence couvre ce Mac et un autre."}}}},
    "Licensed to %@. Your subscription renews automatically. You can manage or cancel it at any time.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Lizenziert für %@. Dein Abonnement verlängert sich automatisch. Du kannst es jederzeit verwalten oder kündigen."}},"es":{"stringUnit":{"state":"translated","value":"Licencia de %@. Tu suscripción se renueva automáticamente. Puedes gestionarla o cancelarla cuando quieras."}},"it":{"stringUnit":{"state":"translated","value":"Licenza intestata a %@. L’abbonamento si rinnova automaticamente. Puoi gestirlo o annullarlo in qualsiasi momento."}},"fr":{"stringUnit":{"state":"translated","value":"Licence de %@. Votre abonnement se renouvelle automatiquement. Vous pouvez le gérer ou le résilier à tout moment."}}}},
    "Licensed to %1$@. Includes version %2$lld and its updates. No renewal or internet connection is needed for dictation.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Lizenziert für %1$@. Enthält Version %2$lld und deren Updates. Zum Diktieren sind weder Verlängerung noch Internetverbindung nötig."}},"es":{"stringUnit":{"state":"translated","value":"Licencia de %1$@. Incluye la versión %2$lld y sus actualizaciones. No necesitas renovar ni conectarte a internet para dictar."}},"it":{"stringUnit":{"state":"translated","value":"Licenza intestata a %1$@. Include la versione %2$lld e i relativi aggiornamenti. Per dettare non servono rinnovi né una connessione internet."}},"fr":{"stringUnit":{"state":"translated","value":"Licence de %1$@. Inclut la version %2$lld et ses mises à jour. Aucune reconduction ni connexion internet n’est nécessaire pour dicter."}}}},
    "Your trial ended on %@. Choose a license to continue. Your dictionary and settings are still here.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine Testphase ist am %@ abgelaufen. Wähle eine Lizenz, um fortzufahren. Dein Wörterbuch und deine Einstellungen bleiben erhalten."}},"es":{"stringUnit":{"state":"translated","value":"Tu prueba terminó el %@. Elige una licencia para continuar. Tu diccionario y ajustes se conservan."}},"it":{"stringUnit":{"state":"translated","value":"La prova è terminata il %@. Scegli una licenza per continuare. Il dizionario e le impostazioni sono ancora disponibili."}},"fr":{"stringUnit":{"state":"translated","value":"Votre essai s’est terminé le %@. Choisissez une licence pour continuer. Votre dictionnaire et vos réglages sont conservés."}}}},
    "Your subscription key expired on %@. Check your payment under Manage subscription, then request your key again. Your dictionary and settings are unchanged.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Abonnementschlüssel ist am %@ abgelaufen. Prüfe deine Zahlung unter Abonnement verwalten und fordere den Schlüssel erneut an. Wörterbuch und Einstellungen bleiben erhalten."}},"es":{"stringUnit":{"state":"translated","value":"La clave de tu suscripción caducó el %@. Comprueba el pago en Gestionar suscripción y solicita de nuevo la clave. Tu diccionario y ajustes no cambian."}},"it":{"stringUnit":{"state":"translated","value":"La chiave dell’abbonamento è scaduta il %@. Controlla il pagamento in Gestisci abbonamento e richiedi di nuovo la chiave. Il dizionario e le impostazioni restano invariati."}},"fr":{"stringUnit":{"state":"translated","value":"La clé de votre abonnement a expiré le %@. Vérifiez le paiement dans Gérer l’abonnement, puis redemandez votre clé. Votre dictionnaire et vos réglages sont conservés."}}}},
    "Your license expired on %@. Renew it to continue dictating. Your local data is unchanged.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine Lizenz ist am %@ abgelaufen. Verlängere sie, um weiter zu diktieren. Deine lokalen Daten bleiben erhalten."}},"es":{"stringUnit":{"state":"translated","value":"Tu licencia caducó el %@. Renuévala para seguir dictando. Tus datos locales no cambian."}},"it":{"stringUnit":{"state":"translated","value":"La licenza è scaduta il %@. Rinnovala per continuare a dettare. I dati locali restano invariati."}},"fr":{"stringUnit":{"state":"translated","value":"Votre licence a expiré le %@. Renouvelez-la pour continuer à dicter. Vos données locales sont conservées."}}}},
    "Your subscription key expires on %@ and could not be renewed. Connect to the internet and open Witness. If needed, check your payment under Manage subscription.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Abonnementschlüssel läuft am %@ ab und konnte nicht erneuert werden. Verbinde dich mit dem Internet und öffne Witness. Prüfe bei Bedarf deine Zahlung unter Abonnement verwalten."}},"es":{"stringUnit":{"state":"translated","value":"La clave de tu suscripción caduca el %@ y no se ha podido renovar. Conéctate a internet y abre Witness. Si es necesario, comprueba el pago en Gestionar suscripción."}},"it":{"stringUnit":{"state":"translated","value":"La chiave dell’abbonamento scade il %@ e non è stato possibile rinnovarla. Connettiti a internet e apri Witness. Se necessario, controlla il pagamento in Gestisci abbonamento."}},"fr":{"stringUnit":{"state":"translated","value":"La clé de votre abonnement expire le %@ et n’a pas pu être renouvelée. Connectez-vous à internet et ouvrez Witness. Au besoin, vérifiez le paiement dans Gérer l’abonnement."}}}},
    "This license key looks incomplete. Copy the full key from your email, including the LD1 prefix.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Lizenzschlüssel scheint unvollständig. Kopiere den ganzen Schlüssel aus deiner E-Mail, einschließlich LD1 am Anfang."}},"es":{"stringUnit":{"state":"translated","value":"La clave parece incompleta. Copia la clave entera del correo, incluido el prefijo LD1."}},"it":{"stringUnit":{"state":"translated","value":"La chiave sembra incompleta. Copia l’intera chiave dall’email, incluso il prefisso LD1."}},"fr":{"stringUnit":{"state":"translated","value":"Cette clé semble incomplète. Copiez la clé entière depuis votre e-mail, y compris le préfixe LD1."}}}},
    "About %@ to download once. Keep Witness running while it downloads. After setup, recognition works offline.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Einmaliger Download von etwa %@. Lass Witness währenddessen geöffnet. Nach der Einrichtung funktioniert die Erkennung offline."}},"es":{"stringUnit":{"state":"translated","value":"Una descarga única de unos %@. Mantén Witness abierto mientras se descarga. Después, el reconocimiento funciona sin conexión."}},"it":{"stringUnit":{"state":"translated","value":"Un solo download di circa %@. Tieni Witness aperto durante il download. Dopo la configurazione, il riconoscimento funziona offline."}},"fr":{"stringUnit":{"state":"translated","value":"Un téléchargement unique d’environ %@. Laissez Witness ouvert pendant le téléchargement. Ensuite, la reconnaissance fonctionne hors ligne."}}}},
    "Preparing the speech model for this Mac. This can take several minutes after a macOS update.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprachmodell wird für diesen Mac vorbereitet. Nach einem macOS-Update kann dies einige Minuten dauern."}},"es":{"stringUnit":{"state":"translated","value":"Preparando el modelo de voz para este Mac. Puede tardar varios minutos después de actualizar macOS."}},"it":{"stringUnit":{"state":"translated","value":"Preparazione del modello vocale per questo Mac. Dopo un aggiornamento di macOS possono servire alcuni minuti."}},"fr":{"stringUnit":{"state":"translated","value":"Préparation du modèle vocal pour ce Mac. Cela peut prendre plusieurs minutes après une mise à jour de macOS."}}}},
    "The microphone changed, so recording stopped. The audio captured before the change was kept.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Mikrofon wurde gewechselt und die Aufnahme beendet. Das bis dahin aufgenommene Audio wurde behalten."}},"es":{"stringUnit":{"state":"translated","value":"La grabación se detuvo al cambiar el micrófono. Se conservó el audio grabado hasta ese momento."}},"it":{"stringUnit":{"state":"translated","value":"La registrazione si è fermata perché il microfono è cambiato. L’audio già acquisito è stato conservato."}},"fr":{"stringUnit":{"state":"translated","value":"L’enregistrement s’est arrêté après un changement de microphone. L’audio capturé jusque-là a été conservé."}}}},
    "The microphone disconnected, so recording stopped. The audio captured before disconnection was kept.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Mikrofon wurde getrennt und die Aufnahme beendet. Das bis dahin aufgenommene Audio wurde behalten."}},"es":{"stringUnit":{"state":"translated","value":"La grabación se detuvo al desconectarse el micrófono. Se conservó el audio grabado hasta ese momento."}},"it":{"stringUnit":{"state":"translated","value":"La registrazione si è fermata perché il microfono si è scollegato. L’audio già acquisito è stato conservato."}},"fr":{"stringUnit":{"state":"translated","value":"L’enregistrement s’est arrêté après la déconnexion du microphone. L’audio capturé jusque-là a été conservé."}}}},
    "Use Witness for three days without an email address. Then add your email to continue.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Nutze Witness drei Tage ohne E-Mail-Adresse. Danach kannst du mit deiner E-Mail-Adresse fortfahren."}},"es":{"stringUnit":{"state":"translated","value":"Usa Witness durante tres días sin correo electrónico. Después añade tu dirección para continuar."}},"it":{"stringUnit":{"state":"translated","value":"Usa Witness per tre giorni senza email. Poi aggiungi il tuo indirizzo per continuare."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez Witness pendant trois jours sans adresse e-mail. Ajoutez ensuite votre adresse pour continuer."}}}},
    "Use Witness until %@. Add your email afterwards to continue.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Nutze Witness bis %@. Danach kannst du mit deiner E-Mail-Adresse fortfahren."}},"es":{"stringUnit":{"state":"translated","value":"Usa Witness hasta el %@. Después añade tu correo para continuar."}},"it":{"stringUnit":{"state":"translated","value":"Usa Witness fino al %@. Poi aggiungi l’email per continuare."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez Witness jusqu’au %@. Ajoutez ensuite votre adresse e-mail pour continuer."}}}},
    "Your first three days are over. Enter your email to continue. No payment is needed at this step. Your dictation stays on this Mac.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine ersten drei Tage sind vorbei. Gib deine E-Mail-Adresse ein, um fortzufahren. Für diesen Schritt ist keine Zahlung nötig. Deine Diktate bleiben auf diesem Mac."}},"es":{"stringUnit":{"state":"translated","value":"Han terminado tus primeros tres días. Introduce tu correo para continuar. Este paso no requiere ningún pago. Tus dictados se quedan en este Mac."}},"it":{"stringUnit":{"state":"translated","value":"I primi tre giorni sono terminati. Inserisci l’email per continuare. Questo passaggio non richiede pagamenti. I dettati restano su questo Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Vos trois premiers jours sont terminés. Saisissez votre adresse e-mail pour continuer. Aucun paiement n’est nécessaire à cette étape. Vos dictées restent sur ce Mac."}}}},
    "Enter your email to activate Witness here, with no key to paste. We send your email and this Mac’s identifier; subscriptions refresh about once a month. Audio, text and dictionary contents are never sent.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Gib deine E-Mail-Adresse ein, um Witness hier zu aktivieren. Du musst keinen Schlüssel einfügen. Übertragen werden deine Adresse und die Kennung dieses Macs; Abonnements werden etwa monatlich aktualisiert. Audio, Texte und Wörterbuchinhalte werden nie übertragen."}},"es":{"stringUnit":{"state":"translated","value":"Introduce tu correo para activar Witness aquí, sin tener que pegar una clave. Se envían tu dirección y el identificador de este Mac; las suscripciones se actualizan aproximadamente cada mes. Nunca se envían audio, texto ni contenido del diccionario."}},"it":{"stringUnit":{"state":"translated","value":"Inserisci l’email per attivare Witness qui, senza dover incollare una chiave. Inviamo il tuo indirizzo e l’identificatore di questo Mac; gli abbonamenti si aggiornano circa una volta al mese. Audio, testo e contenuto del dizionario non vengono mai inviati."}},"fr":{"stringUnit":{"state":"translated","value":"Saisissez votre adresse e-mail pour activer Witness ici, sans clé à coller. Nous transmettons votre adresse et l’identifiant de ce Mac ; les abonnements sont actualisés environ une fois par mois. L’audio, les textes et le dictionnaire ne sont jamais transmis."}}}},
    "Processing": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Verarbeitung"}},"es":{"stringUnit":{"state":"translated","value":"Procesando"}},"it":{"stringUnit":{"state":"translated","value":"Elaborazione"}},"fr":{"stringUnit":{"state":"translated","value":"Traitement"}}}},
    "Your lifetime license includes version %1$lld and its updates. You are using version %2$lld. You can keep using version %1$lld forever or buy a license for version %2$lld.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine Dauerlizenz umfasst Version %1$lld und deren Updates. Du nutzt Version %2$lld. Du kannst Version %1$lld dauerhaft weiterverwenden oder eine Lizenz für Version %2$lld kaufen."}},"es":{"stringUnit":{"state":"translated","value":"Tu licencia de por vida incluye la versión %1$lld y sus actualizaciones. Usas la versión %2$lld. Puedes seguir usando la versión %1$lld para siempre o comprar una licencia para la %2$lld."}},"it":{"stringUnit":{"state":"translated","value":"La licenza perpetua include la versione %1$lld e i relativi aggiornamenti. Stai usando la versione %2$lld. Puoi continuare a usare la %1$lld per sempre o acquistare una licenza per la %2$lld."}},"fr":{"stringUnit":{"state":"translated","value":"Votre licence à vie inclut la version %1$lld et ses mises à jour. Vous utilisez la version %2$lld. Vous pouvez continuer avec la version %1$lld indéfiniment ou acheter une licence pour la %2$lld."}}}},
    "Your dictation is on the clipboard. Check the text in the target app; Witness could not confirm that the latest result was pasted.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Dein Diktat liegt in der Zwischenablage. Prüfe den Text in der Ziel-App: Witness konnte nicht bestätigen, dass das neueste Ergebnis eingefügt wurde."}},"es":{"stringUnit":{"state":"translated","value":"Tu dictado está en el portapapeles. Revisa el texto en la app de destino: Witness no pudo confirmar que se pegara el último resultado."}},"it":{"stringUnit":{"state":"translated","value":"Il dettato è negli appunti. Controlla il testo nell’app di destinazione: Witness non ha potuto confermare che sia stato incollato l’ultimo risultato."}},"fr":{"stringUnit":{"state":"translated","value":"Votre dictée est dans le presse-papiers. Vérifiez le texte dans l’app cible : Witness n’a pas pu confirmer que le dernier résultat a été collé."}}}},
    "Text copied. To restore automatic insertion, turn Witness off and on in System Settings → Privacy & Security → Accessibility.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Text kopiert. Um das automatische Einfügen wiederherzustellen, schalte Witness unter Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen aus und wieder ein."}},"es":{"stringUnit":{"state":"translated","value":"Texto copiado. Para recuperar la inserción automática, desactiva y vuelve a activar Witness en Ajustes del Sistema → Privacidad y seguridad → Accesibilidad."}},"it":{"stringUnit":{"state":"translated","value":"Testo copiato. Per ripristinare l’inserimento automatico, disattiva e riattiva Witness in Impostazioni di Sistema → Privacy e sicurezza → Accessibilità."}},"fr":{"stringUnit":{"state":"translated","value":"Texte copié. Pour rétablir l’insertion automatique, désactivez puis réactivez Witness dans Réglages Système → Confidentialité et sécurité → Accessibilité."}}}},
    "%@ has Secure Input enabled, which blocks dictation. Switch to a regular text field in that app or quit it, then try again. Your text remains in Witness and was not copied.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"In %@ ist die sichere Eingabe aktiv und blockiert das Diktieren. Wechsle dort in ein normales Textfeld oder beende die App und versuche es erneut. Dein Text bleibt in Witness und wurde nicht kopiert."}},"es":{"stringUnit":{"state":"translated","value":"%@ tiene activada la entrada segura, que bloquea el dictado. Ve a un campo de texto normal en esa app o ciérrala e inténtalo de nuevo. El texto sigue en Witness y no se ha copiado."}},"it":{"stringUnit":{"state":"translated","value":"%@ ha attivato l’inserimento sicuro, che blocca la dettatura. Passa a un normale campo di testo in quell’app o chiudila e riprova. Il testo resta in Witness e non è stato copiato."}},"fr":{"stringUnit":{"state":"translated","value":"La saisie sécurisée est activée dans %@ et bloque la dictée. Passez à un champ de texte ordinaire dans cette app ou quittez-la, puis réessayez. Votre texte reste dans Witness et n’a pas été copié."}}}},
    "An app has Secure Input enabled, which blocks dictation. Leave the password field or close that app, then try again. Your text remains in Witness and was not copied.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Eine App blockiert das Diktieren durch sichere Eingabe. Verlasse das Passwortfeld oder schließe die App und versuche es erneut. Dein Text bleibt in Witness und wurde nicht kopiert."}},"es":{"stringUnit":{"state":"translated","value":"Una app tiene activada la entrada segura, que bloquea el dictado. Sal del campo de contraseña o cierra esa app e inténtalo de nuevo. El texto sigue en Witness y no se ha copiado."}},"it":{"stringUnit":{"state":"translated","value":"Un’app ha attivato l’inserimento sicuro, che blocca la dettatura. Esci dal campo della password o chiudi quell’app e riprova. Il testo resta in Witness e non è stato copiato."}},"fr":{"stringUnit":{"state":"translated","value":"Une app utilise la saisie sécurisée et bloque la dictée. Quittez le champ de mot de passe ou fermez cette app, puis réessayez. Votre texte reste dans Witness et n’a pas été copié."}}}},
    "No speech was detected during %1$@. Check that %2$@ is the microphone you are using and that it is not muted.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"In %1$@ wurde keine Sprache erkannt. Prüfe, ob du in %2$@ sprichst und das Mikrofon nicht stummgeschaltet ist."}},"es":{"stringUnit":{"state":"translated","value":"No se detectó voz durante %1$@. Comprueba que estás usando %2$@ y que el micrófono no está silenciado."}},"it":{"stringUnit":{"state":"translated","value":"Nessuna voce rilevata per %1$@. Verifica che il microfono in uso sia %2$@ e che non sia disattivato."}},"fr":{"stringUnit":{"state":"translated","value":"Aucune parole n’a été détectée pendant %1$@. Vérifiez que vous utilisez bien %2$@ et que le microphone n’est pas coupé."}}}},
    "The speech model is not ready, so nothing was recorded. %@ Witness is retrying. Check progress in the menu bar.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprachmodell ist noch nicht bereit, daher wurde nichts aufgenommen. %@ Witness versucht es erneut. Den Fortschritt siehst du in der Menüleiste."}},"es":{"stringUnit":{"state":"translated","value":"El modelo de voz no está listo, así que no se ha grabado nada. %@ Witness está reintentándolo. Consulta el progreso en la barra de menús."}},"it":{"stringUnit":{"state":"translated","value":"Il modello vocale non è pronto, quindi non è stato registrato nulla. %@ Witness sta riprovando. Puoi seguire l’avanzamento nella barra dei menu."}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle vocal n’est pas prêt, donc rien n’a été enregistré. %@ Witness réessaie. Consultez la progression dans la barre des menus."}}}},
    "Your trial ends on %@. Choose a license to keep dictating on two Macs. Your dictionary and settings are kept. Promo codes can be entered at checkout.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine Testphase endet am %@. Mit einer Lizenz diktierst du auf zwei Macs weiter. Wörterbuch und Einstellungen bleiben erhalten. Aktionscodes kannst du auf der Zahlungsseite eingeben."}},"es":{"stringUnit":{"state":"translated","value":"Tu prueba termina el %@. Elige una licencia para seguir dictando en dos Macs. Tu diccionario y ajustes se conservan. Puedes introducir un código promocional al pagar."}},"it":{"stringUnit":{"state":"translated","value":"La prova termina il %@. Scegli una licenza per continuare a dettare su due Mac. Il dizionario e le impostazioni vengono conservati. Puoi inserire un codice promozionale al pagamento."}},"fr":{"stringUnit":{"state":"translated","value":"Votre essai se termine le %@. Choisissez une licence pour continuer à dicter sur deux Mac. Votre dictionnaire et vos réglages sont conservés. Les codes promotionnels se saisissent au paiement."}}}},
    "Your first three days end on %@. Add your email to keep dictating after that.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine ersten drei Tage enden am %@. Gib deine E-Mail-Adresse ein, um danach weiter zu diktieren."}},"es":{"stringUnit":{"state":"translated","value":"Tus primeros tres días terminan el %@. Añade tu correo para seguir dictando después."}},"it":{"stringUnit":{"state":"translated","value":"I primi tre giorni terminano il %@. Aggiungi l’email per continuare a dettare dopo."}},"fr":{"stringUnit":{"state":"translated","value":"Vos trois premiers jours se terminent le %@. Ajoutez votre adresse e-mail pour continuer à dicter ensuite."}}}},
    "Renews each year. Cancel anytime; access continues until the paid period ends. Covers two Macs.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlängert sich jährlich. Jederzeit kündbar; der Zugang bleibt bis zum Ende des bezahlten Zeitraums bestehen. Für zwei Macs."}},"es":{"stringUnit":{"state":"translated","value":"Se renueva cada año. Cancela cuando quieras; el acceso continúa hasta que termine el periodo pagado. Cubre dos Macs."}},"it":{"stringUnit":{"state":"translated","value":"Si rinnova ogni anno. Puoi annullare in qualsiasi momento; l’accesso continua fino alla fine del periodo pagato. Copre due Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Renouvellement annuel. Résiliez à tout moment ; l’accès reste actif jusqu’à la fin de la période payée. Pour deux Mac."}}}},
    "Purchases are not available yet. When they open, payment will take place in your browser through Stripe.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Kauf ist noch nicht verfügbar. Sobald er möglich ist, erfolgt die Zahlung über Stripe im Browser."}},"es":{"stringUnit":{"state":"translated","value":"Las compras aún no están disponibles. Cuando se habiliten, el pago se realizará con Stripe en el navegador."}},"it":{"stringUnit":{"state":"translated","value":"Gli acquisti non sono ancora disponibili. Quando lo saranno, il pagamento avverrà con Stripe nel browser."}},"fr":{"stringUnit":{"state":"translated","value":"Les achats ne sont pas encore disponibles. Lorsqu’ils le seront, le paiement s’effectuera avec Stripe dans votre navigateur."}}}},
    "Purchases are not available yet. Payment will take place in your browser; Witness never receives your card details.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Kauf ist noch nicht verfügbar. Die Zahlung erfolgt später im Browser. Witness erhält keine Kartendaten."}},"es":{"stringUnit":{"state":"translated","value":"Las compras aún no están disponibles. El pago se realizará en el navegador; Witness nunca recibe los datos de tu tarjeta."}},"it":{"stringUnit":{"state":"translated","value":"Gli acquisti non sono ancora disponibili. Il pagamento avverrà nel browser; Witness non riceve mai i dati della carta."}},"fr":{"stringUnit":{"state":"translated","value":"Les achats ne sont pas encore disponibles. Le paiement s’effectuera dans votre navigateur ; Witness ne reçoit jamais vos coordonnées bancaires."}}}},
    "License verification is unavailable in this development build because no verification key is configured.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"In dieser Entwicklungsversion ist kein Prüfschlüssel hinterlegt. Lizenzen können deshalb nicht geprüft werden."}},"es":{"stringUnit":{"state":"translated","value":"Esta versión de desarrollo no tiene configurada una clave de verificación y no puede comprobar licencias."}},"it":{"stringUnit":{"state":"translated","value":"Questa versione di sviluppo non ha una chiave di verifica configurata e non può verificare le licenze."}},"fr":{"stringUnit":{"state":"translated","value":"Cette version de développement ne dispose pas de clé de vérification configurée et ne peut pas vérifier les licences."}}}},
    "Mark similar spellings": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Ähnliche Schreibweisen markieren"}},"es":{"stringUnit":{"state":"translated","value":"Señalar palabras parecidas"}},"it":{"stringUnit":{"state":"translated","value":"Segnala grafie simili"}},"fr":{"stringUnit":{"state":"translated","value":"Signaler les graphies proches"}}}},
    "Unusual spelling": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Ungewöhnliche Schreibweise"}},"es":{"stringUnit":{"state":"translated","value":"Escritura inusual"}},"it":{"stringUnit":{"state":"translated","value":"Grafia insolita"}},"fr":{"stringUnit":{"state":"translated","value":"Graphie inhabituelle"}}}},
    "Example (English)": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"Beispiel (Englisch)"}},"es":{"stringUnit":{"state":"translated","value":"Ejemplo (inglés)"}},"it":{"stringUnit":{"state":"translated","value":"Esempio (inglese)"}},"fr":{"stringUnit":{"state":"translated","value":"Exemple (anglais)"}}}},
    "No words were recognized in %1$@ of audio. Try again or check your language selection: %2$@.": {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"In %1$@ Audio wurden keine Wörter erkannt. Versuche es erneut oder prüfe deine Sprachauswahl: %2$@."}},"es":{"stringUnit":{"state":"translated","value":"No se reconocieron palabras en %1$@ de audio. Inténtalo de nuevo o revisa la selección de idiomas: %2$@."}},"it":{"stringUnit":{"state":"translated","value":"Nessuna parola riconosciuta in %1$@ di audio. Riprova o controlla le lingue selezionate: %2$@."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun mot n’a été reconnu dans %1$@ d’audio. Réessayez ou vérifiez les langues sélectionnées : %2$@."}}}}
  },
  "version": "1.0"
}
