<Window x:Class="Witness.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Witness"
        Width="900"
        Height="620"
        MinWidth="720"
        MinHeight="520"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}">
    <Grid Margin="24" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Witness"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock Text="Private dictation on this PC"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24" />
            <Button Content="General" automation:AutomationProperties.Name="General settings" />
            <Button Content="Languages" automation:AutomationProperties.Name="Language settings" />
            <Button Content="Boundary" automation:AutomationProperties.Name="Boundary settings" />
            <Button Content="Dictionary" automation:AutomationProperties.Name="Dictionary settings" />
            <Button Content="License" automation:AutomationProperties.Name="License settings" />
            <Button Content="Diagnostics" automation:AutomationProperties.Name="Diagnostics settings" />
        </StackPanel>

        <Border Grid.Column="2"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="28"
                IsHitTestVisible="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Windows implementation preview"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />
                <TextBlock Text="This preview is intentionally not a beta. Microphone capture, speech recognition, and verified text insertion stay on this PC. Review, licensing, and production updates remain disabled until later verified slices."
                           TextWrapping="Wrap"
                           MaxWidth="560"
                           HorizontalAlignment="Left" />
                <Border Margin="0,24,0,0"
                        Padding="12"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock x:Name="StatusText"
                                   Text="Choose a speech language profile below before capturing audio."
                                   TextWrapping="Wrap"
                                   automation:AutomationProperties.LiveSetting="Polite"
                                   automation:AutomationProperties.Name="Witness status" />
                        <Button x:Name="PrivacySettingsButton"
                                Content="Open microphone privacy settings"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Visibility="Collapsed"
                                Click="OpenMicrophonePrivacySettings"
                                automation:AutomationProperties.Name="Open Windows microphone privacy settings" />
                    </StackPanel>
                </Border>
                <Border Margin="0,16,0,0"
                        x:Name="AttentionPanel"
                        Padding="12"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                        CornerRadius="4"
                        Visibility="Collapsed"
                        automation:AutomationProperties.Name="Dictation review attention">
                    <StackPanel>
                        <TextBlock x:Name="AttentionText"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   automation:AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Review"
                                    Click="OpenLatestReview"
                                    automation:AutomationProperties.Name="Review the latest dictation" />
                            <Button Content="Not now"
                                    Margin="8,0,0,8"
                                    Click="DismissLatestAttention"
                                    automation:AutomationProperties.Name="Dismiss dictation review attention" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Margin="0,16,0,0"
                        x:Name="ReviewPanel"
                        Padding="12"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        CornerRadius="4"
                        Visibility="Collapsed"
                        automation:AutomationProperties.Name="Latest dictation review">
                    <StackPanel>
                        <TextBlock Text="Latest dictation review"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="ReviewModeText"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="ReviewTranscriptText"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxHeight="132"
                                 Padding="8"
                                 automation:AutomationProperties.Name="Latest dictation text" />
                        <ItemsControl x:Name="ReviewReasonsList" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="ToggleRawButton"
                                    Content="Show raw transcript"
                                    Click="ToggleRawTranscript"
                                    automation:AutomationProperties.Name="Toggle raw and cleaned dictation text" />
                            <Button Content="Close review"
                                    Margin="8,0,0,8"
                                    Click="CloseLatestReview"
                                    automation:AutomationProperties.Name="Close latest dictation review" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Expander x:Name="HistoryExpander"
                          Header="Recent dictations — this session only"
                          Margin="0,16,0,0"
                          Visibility="Collapsed"
                          automation:AutomationProperties.Name="Recent dictations from this session">
                    <Border Padding="12"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            CornerRadius="4">
                        <ScrollViewer MaxHeight="180"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      KeyboardNavigation.TabNavigation="Local">
                            <ItemsControl x:Name="RecentDictationsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Text}"
                                                 IsReadOnly="True"
                                                 IsReadOnlyCaretVisible="True"
                                                 TextWrapping="Wrap"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Margin="0,0,0,8"
                                                 automation:AutomationProperties.Name="Recent dictation text" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Expander>
                <Border Margin="0,16,0,0"
                        Padding="12"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Speech language profile"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="W3 supports the measured DE/EN/RU/UK automatic profile or any single language known to the engine. Custom multi-language profiles arrive with onboarding in W5."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <ComboBox x:Name="LanguageProfileBox"
                                  MinHeight="32"
                                  SelectionChanged="ChangeLanguageProfile"
                                  automation:AutomationProperties.Name="Speech language profile" />
                    </StackPanel>
                </Border>
                <Border x:Name="ModelSetupPanel"
                        Margin="0,16,0,0"
                        Padding="12"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        CornerRadius="4"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Speech model"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="ModelStatusText"
                                   TextWrapping="Wrap"
                                   automation:AutomationProperties.LiveSetting="Polite"
                                   automation:AutomationProperties.Name="Speech model status" />
                        <ProgressBar x:Name="ModelProgress"
                                     Height="12"
                                     Margin="0,12,0,0"
                                     Minimum="0"
                                     Maximum="1"
                                     Visibility="Collapsed"
                                     automation:AutomationProperties.Name="Speech model download progress" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="ModelDownloadButton"
                                    Content="Download speech model"
                                    MinHeight="32"
                                    Padding="12,4"
                                    Click="DownloadModel"
                                    automation:AutomationProperties.Name="Download the speech model" />
                            <Button x:Name="ModelCancelButton"
                                    Content="Cancel"
                                    MinHeight="32"
                                    Padding="12,4"
                                    Margin="8,0,0,0"
                                    Visibility="Collapsed"
                                    Click="CancelModelDownload"
                                    automation:AutomationProperties.Name="Cancel speech model download" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.ColumnSpan="3"
                BorderBrush="Transparent"
                BorderThickness="0"
                IsHitTestVisible="False"
                automation:AutomationProperties.Name="Decorative overlay" />
    </Grid>
</Window>
