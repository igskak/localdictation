<Window x:Class="Witness.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{DynamicResource AppTitle}"
        Width="980"
        Height="720"
        MinWidth="760"
        MinHeight="560"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}">
    <Window.CommandBindings>
        <CommandBinding Command="Copy" CanExecute="CanCopyProtectedText" Executed="CopyProtectedText" />
    </Window.CommandBindings>

    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid x:Name="SettingsShell" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource AppTitle}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="{DynamicResource AppSubtitle}" Style="{StaticResource MutedText}" Margin="0,0,0,24" />
                <RadioButton Content="{DynamicResource GeneralTitle}" Tag="General" IsChecked="True" Checked="NavigateSettings"
                             Style="{StaticResource NavigationButton}" automation:AutomationProperties.Name="{DynamicResource GeneralTitle}" />
                <RadioButton Content="{DynamicResource LanguagesTitle}" Tag="Languages" Checked="NavigateSettings"
                             Style="{StaticResource NavigationButton}" automation:AutomationProperties.Name="{DynamicResource LanguagesTitle}" />
                <RadioButton Content="{DynamicResource BoundaryTitle}" Tag="Boundary" Checked="NavigateSettings"
                             Style="{StaticResource NavigationButton}" automation:AutomationProperties.Name="{DynamicResource BoundaryTitle}" />
                <RadioButton Content="{DynamicResource DictionaryTitle}" Tag="Dictionary" Checked="NavigateSettings"
                             Style="{StaticResource NavigationButton}" automation:AutomationProperties.Name="{DynamicResource DictionaryTitle}" />
                <RadioButton Content="{DynamicResource LicenseTitle}" Tag="License" Checked="NavigateSettings"
                             Style="{StaticResource NavigationButton}" automation:AutomationProperties.Name="{DynamicResource LicenseTitle}" />
                <RadioButton Content="{DynamicResource DiagnosticsTitle}" Tag="Diagnostics" Checked="NavigateSettings"
                             Style="{StaticResource NavigationButton}" automation:AutomationProperties.Name="{DynamicResource DiagnosticsTitle}" />
            </StackPanel>

            <Border Grid.Column="2" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="8" Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="{DynamicResource GeneralTitle}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="PageDescription" Text="{DynamicResource GeneralDescription}"
                                   Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <ScrollViewer x:Name="GeneralPanel" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Local">
                            <StackPanel>
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="StatusText" Text="{DynamicResource InitialStatus}"
                                                   TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite"
                                                   automation:AutomationProperties.Name="{DynamicResource AutomationWitnessStatus}" />
                                        <Button x:Name="PrivacySettingsButton" Content="{DynamicResource OpenMicrophonePrivacy}"
                                                HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"
                                                Click="OpenMicrophonePrivacySettings"
                                                automation:AutomationProperties.Name="{DynamicResource AutomationOpenMicrophonePrivacy}" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="AttentionPanel" Style="{StaticResource SectionCard}"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                        Visibility="Collapsed" automation:AutomationProperties.Name="{DynamicResource AutomationReviewAttention}">
                                    <StackPanel>
                                        <TextBlock x:Name="AttentionText" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   automation:AutomationProperties.LiveSetting="Polite" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="{DynamicResource ReviewAction}" Click="OpenLatestReview" />
                                            <Button Content="{DynamicResource NotNow}" Margin="8,0,0,8" Click="DismissLatestAttention" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ReviewPanel" Style="{StaticResource SectionCard}" Visibility="Collapsed"
                                        automation:AutomationProperties.Name="{DynamicResource AutomationLatestReview}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LatestReview}" Style="{StaticResource SectionHeading}" />
                                        <TextBlock x:Name="ReviewModeText" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                        <TextBox x:Name="ReviewTranscriptText" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 MaxHeight="132" Padding="8" automation:AutomationProperties.Name="{DynamicResource AutomationLatestText}" />
                                        <ItemsControl x:Name="ReviewReasonsList" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                                        <Button Content="{DynamicResource Replay}" DockPanel.Dock="Right" MinHeight="32" Padding="10,3"
                                                                Margin="8,0,0,0" IsEnabled="{Binding CanReplay}" Tag="{Binding Span}"
                                                                Click="ReplayReviewFragment" />
                                                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button x:Name="ToggleRawButton" Content="{DynamicResource ShowRawTranscript}" Click="ToggleRawTranscript" />
                                            <Button Content="{DynamicResource CopyDisplayedText}" Margin="8,0,0,8" Click="CopyDisplayedReviewText" />
                                            <Button Content="{DynamicResource CloseReview}" Margin="8,0,0,8" Click="CloseLatestReview" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Expander x:Name="HistoryExpander" Header="{DynamicResource RecentDictations}"
                                          Margin="0,0,0,16" Visibility="Collapsed">
                                    <Border Style="{StaticResource SectionCard}" Margin="0,8,0,0">
                                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Local">
                                            <ItemsControl x:Name="RecentDictationsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Text}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                                                 TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                                                 Margin="0,0,0,8" automation:AutomationProperties.Name="{DynamicResource AutomationRecentText}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Expander>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ShortcutSection}" Style="{StaticResource SectionHeading}" />
                                        <TextBlock Text="Ctrl+Shift+Space" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBlock Text="{DynamicResource ActivationModeLabel}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="ActivationModeBox" MinHeight="32" SelectionChanged="ChangeActivationMode"
                                                  automation:AutomationProperties.Name="{DynamicResource AutomationActivationMode}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource StartupSection}" Style="{StaticResource SectionHeading}" />
                                        <CheckBox x:Name="LaunchAtStartupCheckBox" Content="{DynamicResource LaunchAtLogin}"
                                                  Click="ToggleLaunchAtStartup" Padding="0,8" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource MicrophoneSection}" Style="{StaticResource SectionHeading}" />
                                        <TextBlock Text="{DynamicResource InputSourceLabel}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="AudioInputBox" MinHeight="32" SelectionChanged="ChangeAudioInput"
                                                  automation:AutomationProperties.Name="{DynamicResource AutomationAudioInput}" />
                                        <Button Content="{DynamicResource RefreshInputs}" HorizontalAlignment="Left"
                                                Margin="0,10,0,0" Click="RefreshAudioInputs" />
                                        <TextBlock x:Name="AudioInputStatusText" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource PrivacySection}" Style="{StaticResource SectionHeading}" />
                                        <TextBlock Text="{DynamicResource PrivacyDetail}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ModelSetupPanel" Style="{StaticResource SectionCard}" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ModelSection}" Style="{StaticResource SectionHeading}" />
                                        <TextBlock x:Name="ModelStatusText" TextWrapping="Wrap"
                                                   automation:AutomationProperties.LiveSetting="Polite" />
                                        <ProgressBar x:Name="ModelProgress" Height="12" Margin="0,12,0,0"
                                                     Minimum="0" Maximum="1" Visibility="Collapsed" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button x:Name="ModelDownloadButton" Content="{DynamicResource DownloadModel}" Click="DownloadModel" />
                                            <Button x:Name="ModelCancelButton" Content="{DynamicResource Cancel}" Margin="8,0,0,0"
                                                    Visibility="Collapsed" Click="CancelModelDownload" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid x:Name="LanguagesPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LanguageSearch}" Margin="0,0,0,4" />
                                <TextBox x:Name="LanguageFilterBox" MinHeight="36" Margin="0,0,0,8"
                                         TextChanged="FilterLanguages" automation:AutomationProperties.Name="{DynamicResource AutomationFilterLanguages}" />
                            </StackPanel>
                            <TextBlock x:Name="SelectedLanguageCountText" Grid.Row="1"
                                       Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                            <ListBox x:Name="LanguagesList" Grid.Row="2" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     KeyboardNavigation.TabNavigation="Local">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Tag="{Binding Code}" Click="ToggleLanguage" Padding="4,8" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <ScrollViewer x:Name="BoundaryPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource VoiceThresholds}" Style="{StaticResource SectionHeading}" />
                                        <TextBlock x:Name="SpeechThresholdValue" Margin="0,0,0,4" />
                                        <Slider x:Name="SpeechThresholdSlider" Minimum="0.002" Maximum="0.2" ValueChanged="ChangeBoundary" />
                                        <TextBlock x:Name="SilenceThresholdValue" Margin="0,12,0,4" />
                                        <Slider x:Name="SilenceThresholdSlider" Minimum="0.001" Maximum="0.2" ValueChanged="ChangeBoundary" />
                                        <TextBlock x:Name="TrailingSilenceValue" Margin="0,12,0,4" />
                                        <Slider x:Name="TrailingSilenceSlider" Minimum="0.2" Maximum="5" ValueChanged="ChangeBoundary" />
                                        <TextBlock x:Name="MaximumUtteranceValue" Margin="0,12,0,4" />
                                        <Slider x:Name="MaximumUtteranceSlider" Minimum="5" Maximum="600" ValueChanged="ChangeBoundary" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{DynamicResource BoundaryHelp}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </ScrollViewer>

                        <Grid x:Name="DictionaryPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource DictionarySessionNotice}" Style="{StaticResource MutedText}"
                                       Margin="0,0,0,12" />
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource TermLabel}" Margin="0,0,0,4" />
                                    <TextBox x:Name="GlossaryTermBox" MinHeight="36" automation:AutomationProperties.Name="{DynamicResource AutomationDictionaryTerm}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource LanguageLabel}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="GlossaryLanguageBox" MinHeight="36" />
                                </StackPanel>
                                <Button Grid.Column="4" Content="{DynamicResource AddTerm}" VerticalAlignment="Bottom" Click="AddGlossaryTerm" />
                            </Grid>
                            <StackPanel Grid.Row="2">
                                <TextBlock x:Name="GlossaryStatusText" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                                           automation:AutomationProperties.LiveSetting="Polite" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="GlossaryList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,8">
                                                    <Button DockPanel.Dock="Right" Content="{DynamicResource RemoveTerm}"
                                                            MinHeight="32" Padding="10,3" Margin="8,0,0,0"
                                                            Tag="{Binding Entry}" Click="RemoveGlossaryTerm" />
                                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="LicensePanel" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LicenseHeading}" Style="{StaticResource SectionHeading}" />
                                    <TextBlock Text="{DynamicResource LicenseBody}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <ScrollViewer x:Name="DiagnosticsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource DiagnosticsInput}" Style="{StaticResource SectionHeading}" />
                                        <TextBlock x:Name="DiagnosticsInputText" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource DiagnosticsReview}" Style="{StaticResource SectionHeading}" />
                                        <TextBlock x:Name="DiagnosticsReviewText" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="DecorativeOverlay" Grid.ColumnSpan="3" BorderBrush="Transparent" BorderThickness="0"
                    IsHitTestVisible="False" automation:AutomationProperties.Name="{DynamicResource AutomationDecorativeOverlay}" />
        </Grid>

        <Grid x:Name="OnboardingPanel" Visibility="Collapsed"
              Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
              KeyboardNavigation.TabNavigation="Cycle" automation:AutomationProperties.Name="{DynamicResource AutomationSetup}">
            <Border Width="600" MaxHeight="660" Margin="24" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid x:Name="OnboardingLanguagesStep">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource OnboardingStepOne}" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="{DynamicResource OnboardingQuestion}"
                                   FontSize="28" FontWeight="SemiBold" Margin="0,12,0,6" />
                        <TextBlock Grid.Row="2" Text="{DynamicResource OnboardingLanguageDetail}"
                                   Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                        <ListBox x:Name="OnboardingLanguagesList" Grid.Row="3" MaxHeight="420"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Tag="{Binding Code}" Click="ToggleOnboardingLanguage" Padding="4,8" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <DockPanel Grid.Row="4" Margin="0,16,0,0">
                            <TextBlock x:Name="OnboardingLanguageCountText" VerticalAlignment="Center"
                                       Style="{StaticResource MutedText}" />
                            <Button Content="{DynamicResource Continue}" DockPanel.Dock="Right"
                                    IsDefault="True" Click="OnboardingContinue" />
                        </DockPanel>
                    </Grid>

                    <StackPanel x:Name="OnboardingReadyStep" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource OnboardingStepTwo}" Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource ReadyTitle}" FontSize="28" FontWeight="SemiBold" Margin="0,12,0,6" />
                        <TextBlock Text="{DynamicResource ReadyDetail}" Style="{StaticResource MutedText}" Margin="0,0,0,18" />
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ReadyPrivacy}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <TextBlock Text="{DynamicResource ReadyModel}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <DockPanel LastChildFill="False">
                            <Button Content="{DynamicResource Back}" HorizontalAlignment="Left"
                                    Click="OnboardingBack" />
                            <Button Content="{DynamicResource StartDictating}" DockPanel.Dock="Right"
                                    IsDefault="True" Click="OnboardingFinish" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
